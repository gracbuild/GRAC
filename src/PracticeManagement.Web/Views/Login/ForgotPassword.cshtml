@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model PracticeManagement.Web.Models.ForgotPasswordViewModel
@{
    Layout = null;
    // Forgot password (migration 529, 2026-11-10). Same explicit action
    // construction as Login/Index.cshtml and ChangePassword.cshtml.
    var pathBase = Context.Request.PathBase.Value?.TrimEnd('/') ?? "";
    var isOrgMgmt = string.Equals(Configuration["Module:Key"], "OrganizationManagement", StringComparison.OrdinalIgnoreCase)
        || string.Equals(pathBase, "/OrganizationManagement", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrEmpty(pathBase) && Context.Request.Path.StartsWithSegments("/OrganizationManagement", StringComparison.OrdinalIgnoreCase));
    var loginRoot = isOrgMgmt && string.IsNullOrEmpty(pathBase)
        ? "/OrganizationManagement/Login"
        : $"{pathBase}/Login";
    var forgotAction = $"{loginRoot}/ForgotPassword";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GRAC | Forgot password</title>
    <link rel="icon" type="image/x-icon" href="~/css/Images/favicon.ico" />
    @* GRAC design tokens -- must load before every other stylesheet. *@
    <link rel="stylesheet" href="~/css/grac-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/FrontEnd/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/FrontEnd/plugins/icheck-bootstrap/icheck-bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/sweet-alert.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/FrontEnd/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cacca-styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-split">
    <div id="Loader" class="div-loader" style="display:none;">
        <div class="loader"></div>
    </div>

    <div class="login-wrapper">
        <div class="split-card">
            @* Brand side shared with Index / ChangePassword (_BrandPanel). *@
            <partial name="_BrandPanel" />

            <div class="form-panel">
                <div class="form-card">
                    <div class="greeting">
                        <h1>Forgot password</h1>
                        <p>Enter your User ID or Email ID. We will email you a link to set a new password.</p>
                    </div>

                    @if (Model.Sent)
                    {
                        @* One answer whether or not an account matched. *@
                        <p class="login-notice" role="status">
                            If an active account matches, a password reset link has been sent to its email address.
                            The link can be used once and expires shortly. Check your inbox (and spam folder).
                        </p>
                    }
                    else
                    {
                        <form action="@forgotAction" method="post" id="ForgotPasswordForm" novalidate>
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>

                            <div class="form-group">
                                <label asp-for="LoginId" class="sr-only">User ID / Email ID</label>
                                <div class="input-icon">
                                    <i class="far fa-user" aria-hidden="true"></i>
                                    <input asp-for="LoginId" type="text" class="form-control" placeholder="User ID / Email ID" autocomplete="username" tabindex="1" autofocus />
                                </div>
                                <span asp-validation-for="LoginId" class="validation-message"></span>
                            </div>

                            <button type="submit" id="btnForgotPassword" class="btn btn-signin mt-4" tabindex="2">Send reset link</button>
                        </form>
                    }

                    <div class="login-back">
                        <a class="forgot-link" href="@loginRoot" tabindex="3"><i class="fas fa-arrow-left" aria-hidden="true"></i>&nbsp;Back to sign in</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/FrontEnd/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/FrontEnd/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/FrontEnd/dist/js/adminlte.min.js"></script>
    <script src="~/js/crypto-js.min.js"></script>
    <script src="~/js/sweet-alert.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
