@model PracticeManagement.Web.Models.PracticeScreen
@{
    ViewData["Title"] = Model.Title;
    var permissions = ViewBag.Permissions as string[] ?? [];
}

<div class="pm-page-heading">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
    <div class="pm-actions">
        <a class="pm-button" asp-controller="Practice" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</a>
    </div>
</div>

<section class="pm-panel pm-calendar-container">
    <!-- Toolbar -->
    <div class="cal-toolbar">
        <div class="cal-toolbar-left">
            <select id="calOrganizationFilter"><option value="">All organizations</option></select>
            <button class="pm-button primary small" id="calGenerate" type="button" title="Generate schedules from practice instances with assurance frequency">
                <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> Generate Schedules
            </button>
        </div>
        <div class="cal-toolbar-center">
            <button class="pm-button icon" id="calPrev" type="button" title="Previous"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
            <button class="pm-button small" id="calToday" type="button">Today</button>
            <button class="pm-button icon" id="calNext" type="button" title="Next"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
            <h2 id="calTitle" class="cal-title">July 2026</h2>
        </div>
        <div class="cal-toolbar-right">
            <div class="cal-view-toggle">
                <button class="pm-button small active" data-cal-view="month">Month</button>
                <button class="pm-button small" data-cal-view="week">Week</button>
                <button class="pm-button small" data-cal-view="day">Day</button>
            </div>
        </div>
    </div>

    <!--
        Unified Calendar filters. The frontend keeps these values in
        localStorage so returning to the page restores the same view.
        Every filter narrows the merged event set (Practice Instance +
        Assurance Plan / Plan Item / Execution / Observation / Gap).
        Owner picker reuses window.__roleHolderPicker from
        _workflow-common.cshtml, matching every Assurance dialog.
    -->
    <div class="cal-filter-panel" id="calFilterPanel">
        <div class="cal-filter-row">
            <div class="cal-filter-group" data-cal-filter-group="sourceModules">
                <span class="cal-filter-label">Modules</span>
                <div class="cal-chip-row" data-cal-chip-row>
                    <button type="button" class="cal-chip source-PracticeInstance active" data-cal-chip-value="PracticeInstance"><span class="cal-chip-dot"></span>Practice Instance</button>
                    <button type="button" class="cal-chip source-AssurancePlan active" data-cal-chip-value="AssurancePlan"><span class="cal-chip-dot"></span>Plan</button>
                    <button type="button" class="cal-chip source-AssurancePlanItem active" data-cal-chip-value="AssurancePlanItem"><span class="cal-chip-dot"></span>Plan Item</button>
                    <button type="button" class="cal-chip source-AssuranceExecution active" data-cal-chip-value="AssuranceExecution"><span class="cal-chip-dot"></span>Execution</button>
                    <button type="button" class="cal-chip source-AssuranceObservation active" data-cal-chip-value="AssuranceObservation"><span class="cal-chip-dot"></span>Observation</button>
                    <button type="button" class="cal-chip source-AssuranceGap active" data-cal-chip-value="AssuranceGap"><span class="cal-chip-dot"></span>Gap</button>
                </div>
            </div>
        </div>
        <div class="cal-filter-row">
            <div class="cal-filter-group" data-cal-filter-group="statuses">
                <span class="cal-filter-label">Status</span>
                <div class="cal-chip-row" data-cal-chip-row>
                    <button type="button" class="cal-chip status-chip status-Upcoming" data-cal-chip-value="Upcoming">Upcoming</button>
                    <button type="button" class="cal-chip status-chip status-InProgress" data-cal-chip-value="InProgress">In Progress</button>
                    <button type="button" class="cal-chip status-chip status-Overdue" data-cal-chip-value="Overdue">Overdue</button>
                    <button type="button" class="cal-chip status-chip status-Open" data-cal-chip-value="Open">Open</button>
                    <button type="button" class="cal-chip status-chip status-Planned" data-cal-chip-value="Planned">Planned</button>
                    <button type="button" class="cal-chip status-chip status-Closed" data-cal-chip-value="Closed">Closed</button>
                    <button type="button" class="cal-chip status-chip status-Skipped" data-cal-chip-value="Skipped">Skipped</button>
                    <button type="button" class="cal-chip status-chip status-Moved" data-cal-chip-value="Moved">Moved</button>
                </div>
            </div>
            <div class="cal-filter-group" data-cal-filter-group="criticalities">
                <span class="cal-filter-label">Criticality</span>
                <div class="cal-chip-row" data-cal-chip-row>
                    <button type="button" class="cal-chip crit-chip crit-Critical" data-cal-chip-value="Critical">Critical</button>
                    <button type="button" class="cal-chip crit-chip crit-High"     data-cal-chip-value="High">High</button>
                    <button type="button" class="cal-chip crit-chip crit-Medium"   data-cal-chip-value="Medium">Medium</button>
                    <button type="button" class="cal-chip crit-chip crit-Low"      data-cal-chip-value="Low">Low</button>
                </div>
            </div>
        </div>
        <div class="cal-filter-row">
            <div class="cal-filter-group cal-filter-owner">
                <span class="cal-filter-label">Owner</span>
                <select id="calFilterOwnerRole" class="cal-filter-select" aria-label="Owner Role">
                    <option value="">Loading roles...</option>
                </select>
                <select id="calFilterOwnerEmp" class="cal-filter-select" aria-label="Owner Employee (current holder)">
                    <option value="">-- pick a role first --</option>
                </select>
            </div>
            <div class="cal-filter-group">
                <span class="cal-filter-label">Definition</span>
                <select id="calFilterDefinition" class="cal-filter-select">
                    <option value="">All definitions</option>
                </select>
            </div>
            <div class="cal-filter-group cal-filter-search">
                <span class="cal-filter-label">Search</span>
                <input id="calFilterSearch" type="search" class="cal-filter-input" placeholder="Title, owner or entity..." />
            </div>
            <button type="button" class="pm-button small" id="calFilterReset" title="Clear all filters">
                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Reset
            </button>
        </div>
    </div>

    <!-- Legend: one dot per source module so users can decode chip colors. -->
    <div class="cal-legend" id="calLegend" aria-label="Event color legend">
        <div class="cal-legend-item"><span class="cal-legend-swatch source-PracticeInstance"></span>Practice Instance</div>
        <div class="cal-legend-item"><span class="cal-legend-swatch source-AssurancePlan"></span>Plan</div>
        <div class="cal-legend-item"><span class="cal-legend-swatch source-AssurancePlanItem"></span>Plan Item</div>
        <div class="cal-legend-item"><span class="cal-legend-swatch source-AssuranceExecution"></span>Execution</div>
        <div class="cal-legend-item"><span class="cal-legend-swatch source-AssuranceObservation"></span>Observation</div>
        <div class="cal-legend-item"><span class="cal-legend-swatch source-AssuranceGap"></span>Gap</div>
        <div class="cal-legend-sep"></div>
        <div class="cal-legend-item"><span class="cal-legend-swatch status-Overdue"></span>Overdue border</div>
    </div>

    <!-- Calendar grid -->
    <div id="calGrid" class="cal-grid cal-month-view">
        <!-- Rendered by JavaScript -->
    </div>
</section>

<!-- Side panel for event details -->
<div id="calSidePanel" class="cal-side-panel" hidden>
    <div class="cal-side-header">
        <h3 id="calSideTitle">Event Details</h3>
        <button class="pm-icon-button" id="calSideClose" type="button" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <div id="calSideBody" class="cal-side-body">
        <!-- Event details rendered by JS -->
    </div>
</div>

<!-- Generate Schedules Dialog -->
<dialog id="calGenerateDialog">
    <form id="calGenerateForm">
        <div class="pm-dialog-heading">
            <div><h2>Generate Assurance Schedules</h2><p>Create schedule rules from practice instances with an assurance frequency.</p></div>
            <button type="button" id="calGenerateClose" class="pm-icon-button" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        <div id="calGenerateMessage" class="pm-message" hidden></div>
        <div class="pm-form-grid">
            <label class="pm-field"><span>Organization</span><select id="genOrganization" required><option value="">Select organization</option></select></label>
            <label class="pm-field"><span>Anchor Date (first occurrence)</span><input id="genAnchorDate" type="date" required /></label>
        </div>
        <div id="genInstanceList" class="cal-gen-instance-list">
            <p class="pm-empty">Select an organization to see eligible practice instances.</p>
        </div>
        <div class="pm-dialog-actions">
            <button type="button" class="pm-button" id="calGenerateCancel">Cancel</button>
            <button type="button" class="pm-button primary" id="calGenerateSubmit">Generate Selected</button>
        </div>
    </form>
</dialog>

<!-- Edit Schedule Dialog -->
<dialog id="calEditDialog">
    <form id="calEditForm">
        <div class="pm-dialog-heading">
            <div><h2 id="calEditTitle">Edit Schedule</h2><p>Move, skip, or modify this assurance occurrence.</p></div>
            <button type="button" id="calEditClose" class="pm-icon-button" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        <div id="calEditMessage" class="pm-message" hidden></div>
        <div class="pm-form-grid">
            <label class="pm-field"><span>Practice Instance</span><input id="editPracticeInstance" type="text" readonly /></label>
            <label class="pm-field"><span>Current Date</span><input id="editCurrentDate" type="date" readonly /></label>
            <label class="pm-field" id="editActionField"><span>Action</span>
                <select id="editAction">
                    <option value="Move" id="editActionMoveOption">Move to a different date</option>
                    <option value="Skip">Skip this occurrence</option>
                </select>
            </label>
            <label class="pm-field" id="editNewDateField"><span>New Date</span><input id="editNewDate" type="date" /></label>
            @* Reason takes its own full-width row so the textarea can breathe.
               The apply-future checkbox drops onto a dedicated row below it so
               its label never has to fight the textarea for row height. *@
            <label class="pm-field full"><span>Reason</span><textarea id="editReason" rows="2" placeholder="Reason for change..."></textarea></label>
            <label class="pm-field full pm-field-checkbox" id="editApplyFutureField"><input id="editApplyFuture" type="checkbox" /> <span>Apply to this and all future occurrences</span></label>
        </div>
        <div class="pm-dialog-actions">
            <button type="button" class="pm-button" id="calEditCancel">Cancel</button>
            <button type="button" class="pm-button primary" id="calEditSubmit">Save Change</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script>
        window.pmScreen=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        window.pmApi="@ViewBag.ApiBaseUrl";
        window.pmPermissions=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(permissions));
    </script>
    <link rel="stylesheet" href="~/css/practice-calendar.css" asp-append-version="true" />
    <script src="~/js/practice-calendar.js" asp-append-version="true"></script>
}
