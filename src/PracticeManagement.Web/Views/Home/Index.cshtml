@{
    ViewData["Title"] = "Practice Management";
}

<section class="pm-hero">
    <p class="pm-eyebrow">GRAC Part 2</p>
    <h1>Practice Management</h1>
    <p>
        Convert repository requirements into organization-specific operational practices, ownership, evidence,
        dependencies, assurance attributes, and future integration triggers.
    </p>
</section>

<p><a class="pm-button primary" asp-controller="Practice" asp-action="Index">Open Practice Management</a></p>

<section class="pm-grid">
    <article>
        <span>01</span>
        <h2>Organization Foundation</h2>
        <p>Onboarding, organization metadata, business functions, and applicability discovery inputs.</p>
    </article>
    <article>
        <span>02</span>
        <h2>Standards & Frameworks</h2>
        <p>Subscribe organizations to repository artifacts and releases without copying Part 1 records.</p>
    </article>
    <article>
        <span>03</span>
        <h2>Control Statements & Practices</h2>
        <p>Manage repository-origin, organization-origin, and hybrid source-statement and practice context.</p>
    </article>
    <article>
        <span>04</span>
        <h2>Practice Instances</h2>
        <p>The central operational object for ownership, criticality, dependencies, evidence, assurance, and resilience.</p>
    </article>
</section>

<section class="pm-panel">
    <h2>Phase 1 Screens</h2>
    <div class="pm-list">
        <div>Organization Onboarding</div>
        <div>Organization Metadata</div>
        <div>Organization Dashboard</div>
        <div>Standards & Frameworks Foundation</div>
    </div>
</section>
