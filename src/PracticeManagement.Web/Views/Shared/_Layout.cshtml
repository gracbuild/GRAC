    <script src="~/lib/FrontEnd/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/js/crypto-js.min.js"></script>
    <script src="~/js/sweet-alert.min.js"></script>
    <script src="~/js/sweetalert-compat.js"></script>
    <script src="~/js/grac-dialog.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cacca-scripts.js" asp-append-version="true"></script>
    <script>
        window.pmPathBase = "@appBasePath";
        window.appBasePath = window.pmPathBase || "";
        window.pmBuildUrl = function (path) {
            path = String(path || "");
            if (!path || path === "#") return path || "#";
            if (/^(?:[a-z][a-z0-9+.-]*:)?\/\//i.test(path)) return path;
            var base = (window.appBasePath || "").replace(/\/+$/, "");
            return base + "/" + path.replace(/^\/+/, "");
        };
        window.HostName = $("#HostName").val();
        window.pmCurrentArea = "@currentArea";
        window.addEventListener('error', function (event) {
            console.error('PracticeManagement menu/rendering error', event.message, event.filename, event.lineno, event.error);
        });
        // Parent menu rows that are also pages (Audit Definition / Audit
        // Configuration, migration 276). AdminLTE's treeview swallows the
        // click with preventDefault() so the subtree can expand, which
        // would leave these pages unreachable from the sidebar. Its
        // preventDefault only stops the browser's default navigation, not
        // ours, so navigate explicitly. Deliberately unconditional rather
        // than keyed on event.defaultPrevented: both handlers are bound on
        // document, so which one runs first depends on load order and
        // defaultPrevented would be an unreliable signal. Rows without
        // data-nav-href -- every pre-276 parent and every leaf -- are
        // untouched.
        document.addEventListener('click', function (event) {
            var link = event.target && event.target.closest
                ? event.target.closest('a.nav-link[data-nav-href]')
                : null;
            if (!link) return;
            var href = link.getAttribute('data-nav-href');
            if (!href || href === '#') return;
            event.preventDefault();
            window.location.href = href;
        });

        function syncPracticeMenuState() {
            try {
                var nav = document.querySelector('.nav-sidebar');
                if (!nav) return;

                var activeLinks = Array.prototype.slice.call(nav.querySelectorAll('.nav-link.active, .nav-link.active-parent, .nav-link.active-current'));
                if (!activeLinks.length && window.pmCurrentArea) {
                    activeLinks = Array.prototype.slice.call(nav.querySelectorAll('[data-menu-key="' + window.pmCurrentArea + '"] > .nav-link'));
                    activeLinks.forEach(function (link) {
                        link.classList.add('active', 'active-current');
                        var li = link.closest('.nav-item');
                        if (li) li.classList.add('active');
                    });
                }
                if (!activeLinks.length) {
                    var currentUrl = new URL(window.location.href);
                    var currentPath = currentUrl.pathname.replace(/\/+$/, '').toLowerCase();
                    var currentSearch = currentUrl.search.toLowerCase();
                    activeLinks = Array.prototype.slice.call(nav.querySelectorAll('a.nav-link[href]')).filter(function (link) {
                        var href = link.getAttribute('href') || '';
                        if (!href || href === '#') return false;
                        var linkPath = new URL(href, window.location.origin);
                        var pathMatches = linkPath.pathname.replace(/\/+$/, '').toLowerCase() === currentPath;
                        var search = linkPath.search.toLowerCase();
                        return pathMatches && (!search || search === currentSearch);
                    });
                    activeLinks.forEach(function (link) {
                        link.classList.add('active', 'active-current');
                        var li = link.closest('.nav-item');
                        if (li) li.classList.add('active');
                    });
                }

                activeLinks.forEach(function (link) {
                    var item = link.closest('.nav-item');
                    while (item) {
                        var manuallyCollapsed = item.dataset.userCollapsed === 'true';
                        item.classList.toggle('menu-open', !manuallyCollapsed);
                        var parentLink = item.querySelector(':scope > .nav-link');
                        if (parentLink && parentLink !== link && parentLink.getAttribute('href') === '#') {
                            parentLink.classList.add('active-parent');
                        }
                        var tree = item.querySelector(':scope > .nav-treeview');
                        if (tree) {
                            tree.style.display = manuallyCollapsed ? 'none' : 'block';
                            if (manuallyCollapsed) tree.setAttribute('hidden', 'hidden');
                            else tree.removeAttribute('hidden');
                        }
                        item = item.parentElement && item.parentElement.closest('.nav-item');
                    }
                });
                var activeItem = nav.querySelector('.nav-item.active > .nav-link.active');
                if (activeItem && activeItem.scrollIntoView) activeItem.scrollIntoView({ block: 'nearest' });
            } catch (error) {
                console.error('PracticeManagement menu state sync failed', error);
            }
        }
        function bindPracticeMenuClickPersistence() {
            var nav = document.querySelector('.nav-sidebar');
            if (!nav || nav.dataset.activeStateBound === 'true') return;
            nav.dataset.activeStateBound = 'true';
            nav.addEventListener('click', function (event) {
                var link = event.target.closest && event.target.closest('a.nav-link');
                if (!link || !nav.contains(link)) return;
                var href = (link.getAttribute('href') || '').trim();
                var item = link.closest('.nav-item');
                var childTree = item && item.querySelector(':scope > .nav-treeview');

                if (href === '#' && childTree) {
                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();
                    var shouldOpen = !item.classList.contains('menu-open');
                    item.dataset.userCollapsed = shouldOpen ? 'false' : 'true';
                    item.classList.toggle('menu-open', shouldOpen);
                    link.classList.toggle('active-parent', shouldOpen);
                    childTree.style.display = shouldOpen ? 'block' : 'none';
                    if (shouldOpen) childTree.removeAttribute('hidden');
                    else childTree.setAttribute('hidden', 'hidden');
                    return false;
                }

                if (href && href !== '#') {
                    nav.querySelectorAll('.nav-link.active-current').forEach(function (active) {
                        active.classList.remove('active-current');
                        if (!active.classList.contains('active-parent')) active.classList.remove('active');
                    });
                    link.classList.add('active', 'active-current');
                    if (item) item.classList.add('active');
                    var parent = item;
                    while (parent) {
                        parent.dataset.userCollapsed = 'false';
                        parent.classList.add('menu-open');
                        var parentLink = parent.querySelector(':scope > .nav-link');
                        if (parentLink && parentLink !== link && parentLink.getAttribute('href') === '#') {
                            parentLink.classList.add('active-parent');
                        }
                        var tree = parent.querySelector(':scope > .nav-treeview');
                        if (tree) {
                            tree.style.display = 'block';
                            tree.removeAttribute('hidden');
                        }
                        parent = parent.parentElement && parent.parentElement.closest('.nav-item');
                    }
                }
            }, true);
        }
        function enforcePracticeMenuState() {
            bindPracticeMenuClickPersistence();
            syncPracticeMenuState();
            window.setTimeout(syncPracticeMenuState, 50);
            window.setTimeout(syncPracticeMenuState, 250);
            window.setTimeout(syncPracticeMenuState, 750);
        }
        document.addEventListener('DOMContentLoaded', enforcePracticeMenuState);
        window.addEventListener('load', enforcePracticeMenuState);
        try {
            new MutationObserver(function () {
                if (document.body.classList.contains('sidebar-collapse')) syncPracticeMenuState();
            }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
        } catch (e) { }
        $(document).on('shown.lte.treeview collapsed.lte.treeview expanded.lte.treeview', syncPracticeMenuState);
        // Only a DELIBERATE hamburger press should be remembered. AdminLTE
        // fires these same collapsed/shown events for its automatic
        // width<=992 collapse, which it re-checks on every window resize
        // (DevTools docked, 125%+ zoom, window snap, a transient wide form).
        // Persisting those pinned the sidebar collapsed for all later loads
        // -- even back on a wide screen -- because the inline restore script
        // re-applies localStorage on every page. Gate the write on an
        // explicit pointerdown of the pushmenu button; a flag that clears
        // itself after the click tick, so resize-driven collapses never
        // persist. window.__pmSidebarUserToggle is defined here so it exists
        // before cacca-scripts.js (which shares the same gate) initialises.
        window.__pmSidebarUserToggle = false;
        $(document).on('pointerdown mousedown', '[data-widget="pushmenu"]', function () {
            window.__pmSidebarUserToggle = true;
            window.setTimeout(function () { window.__pmSidebarUserToggle = false; }, 0);
        });
        $(document).on('collapsed.lte.pushmenu shown.lte.pushmenu', function () {
            if (window.__pmSidebarUserToggle) {
                try { localStorage.setItem('cacca_sidebar_collapsed', document.body.classList.contains('sidebar-collapse')); } catch (e) { }
            }
            syncPracticeMenuState();
        });

        // While the sidebar is collapsed to its icon rail, AdminLTE's own
        // CSS (adminlte.css, the Layout widget) expands .main-sidebar to
        // 250px on :hover or the .sidebar-focused class (which it adds on
        // keyboard focus of a sidebar link) -- a pure CSS flyout that never
        // touches .content-wrapper/.main-header/.main-footer's margin, so
        // the flyout sits on top of the page. Reserve that same 250px by
        // toggling a body class (master-layout.css section 7c reacts to
        // it) for both triggers, mirroring AdminLTE's own two triggers
        // exactly -- .main-header can't be reached with a CSS sibling
        // selector alone because it sits BEFORE .main-sidebar in the
        // markup above, hence doing this in script.
        (function () {
            function syncSidebarHoverPush() {
                var $sidebar = $('.main-sidebar');
                var flying = document.body.classList.contains('sidebar-collapse')
                    && ($sidebar.is(':hover') || $sidebar.hasClass('sidebar-focused'));
                document.body.classList.toggle('sidebar-hover-push', flying);
            }
            $(document).on('mouseenter mouseleave', '.main-sidebar', syncSidebarHoverPush);
            $(document).on('focusin focusout', '.main-sidebar a', syncSidebarHoverPush);
        })();
    </script>

    @*
        Unread notification badge on the "My Notifications" sidebar item
        (Task Centre v2, Phase 5 — BRD §13).

        WHY IN THE LAYOUT AND NOT THE MENU PARTIAL
        The menu tree is rendered server-side from menu_master and knows
        nothing about any one feature's counts. Teaching it about
        notifications would couple a generic navigation component to one
        module. Instead this attaches to the `data-menu-key` hook the tree
        already emits, so the tree stays feature-agnostic.

        WHY THE WHOLE THING IS BEST-EFFORT
        A badge must never break navigation. Every failure path — endpoint
        missing (Phase 3 not deployed), account not mapped to an employee,
        network down — leaves the sidebar exactly as it was.
    *@
    <script>
        (function () {
            'use strict';
            var host = document.querySelector('li[data-menu-key="my-notifications"] a .nav-link-text, li[data-menu-key="my-notifications"] a p');
            if (!host) return;   // screen not permitted for this user, or feature flag off

            var base = String(window.appBasePath || window.pmPathBase || '').replace(/\/+$/, '');

            function render(count) {
                var existing = host.querySelector('.pm-notif-badge');
                if (!count) { if (existing) existing.remove(); return; }

                var el = existing || document.createElement('span');
                el.className = 'badge badge-danger right pm-notif-badge';
                // Cap the display, not the meaning: "99+" reads instantly,
                // a four-digit number does not.
                el.textContent = count > 99 ? '99+' : String(count);
                el.title = count + ' unread task notification' + (count === 1 ? '' : 's');
                if (!existing) host.appendChild(el);
            }

            function poll() {
                fetch(base + '/practice/api/task-notifications/me/counts', { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (c) { if (c) render(Number(c.pendingCount) || 0); })
                    .catch(function () { /* leave the sidebar untouched */ });
            }

            poll();
            // Five minutes, matching the sweeper's default interval — a
            // tighter poll could not surface anything new.
            window.setInterval(poll, 300000);

            // The notifications screen marks things read; refresh the badge
            // when the user comes back to the tab rather than making them
            // wait out the interval.
            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) poll();
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
