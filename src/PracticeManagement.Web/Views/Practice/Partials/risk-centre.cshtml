=================================================================== *@
<div class="pm-modal" id="riskAcceptModal" hidden>
    <div class="pm-modal-panel pm-modal-wide">
        <header>
            <h2>Accept risk candidate <span class="pm-hint">(legacy triage)</span></h2>
            <button class="pm-modal-close" type="button" data-close-risk-accept aria-label="Close">&times;</button>
        </header>
        <form id="riskAcceptForm" enctype="multipart/form-data">
            <input type="hidden" id="riskAcceptId" />
            <dl class="risk-meta" id="riskAcceptMeta"></dl>

            <div class="pm-form-grid">
                <label class="pm-form-grid-full">
                    <span>Acceptance note<span class="pm-required">*</span></span>
                    <textarea id="riskAcceptNote" rows="4" maxlength="5000" required
                              placeholder="Why this is being tracked as a formal risk; approvals obtained; owner..."></textarea>
                </label>
                <label class="pm-form-grid-full">
                    <span>Formal risk reference <span class="pm-hint">(if already logged in an external risk register)</span></span>
                    <input type="text" id="riskAcceptFormalRef" maxlength="200"
                           placeholder="e.g. RSK-2026-01452" />
                </label>

                @* Evidence-style capture -- same vocabulary as exception centre. *@
                <label class="pm-form-grid-full">
                    <span>Supporting evidence <span class="pm-hint">(optional)</span></span>
                    <select id="riskAcceptMethod">
                        <option value="">-- none --</option>
                        <option value="Manual">Manual (upload a file)</option>
                        <option value="Automated">Automated (link an external record)</option>
                    </select>
                </label>
                <label class="pm-form-grid-full" id="riskAcceptFileWrap" hidden>
                    <span>File<span class="pm-required">*</span></span>
                    <input type="file" id="riskAcceptFile" />
                </label>
                <label id="riskAcceptLocationWrap" hidden>
                    <span>Location<span class="pm-required">*</span></span>
                    <input type="text" id="riskAcceptLocation" maxlength="500"
                           placeholder="e.g. Archer / ServiceNow / SharePoint" />
                </label>
                <label id="riskAcceptLocatorWrap" hidden>
                    <span>Locator<span class="pm-required">*</span></span>
                    <input type="text" id="riskAcceptLocator" maxlength="500"
                           placeholder="e.g. https://... or record id" />
                </label>
            </div>
            <p class="pm-form-message" id="riskAcceptMessage" role="status" aria-live="polite"></p>
            <footer class="pm-modal-footer">
                <button type="button" class="pm-button" data-close-risk-accept>Cancel</button>
                <button type="submit" class="pm-button primary"><i class="fa-solid fa-check"></i> Accept</button>
            </footer>
        </form>
    </div>
</div>

@* ================= Reject modal (BRD §8B) =========================== *@
<div class="pm-modal" id="riskRejectModal" hidden>
    <div class="pm-modal-panel">
        <header>
            <h2>Reject risk candidate</h2>
            <button class="pm-modal-close" type="button" data-close-risk-reject aria-label="Close">&times;</button>
        </header>
        <form id="riskRejectForm">
            <input type="hidden" id="riskRejectId" />
            <dl class="risk-meta" id="riskRejectMeta"></dl>
            <div class="pm-form-grid">
                <label class="pm-form-grid-full">
                    <span>Rejection reason<span class="pm-required">*</span></span>
                    <textarea id="riskRejectReason" rows="4" maxlength="5000" required
                              placeholder="Not a real risk / already tracked elsewhere / does not require registration..."></textarea>
                </label>
            </div>
            <p class="pm-form-message" id="riskRejectMessage" role="status" aria-live="polite"></p>
            <footer class="pm-modal-footer">
                <button type="button" class="pm-button" data-close-risk-reject>Cancel</button>
                <button type="submit" class="pm-button primary"><i class="fa-solid fa-ban"></i> Reject</button>
            </footer>
        </form>
    </div>
</div>

@* The "Return for clarification" (BRD §8C) and "Withdraw" modals were
   removed with the two-action candidate menu. Their API endpoints and
   stored procedures remain and still enforce their rules; §8C's
   ClarificationRequired status is still reached — and still rendered —
   when an approver returns a risk for further assessment. *@

<style>
    /* ---- tabs ---- */
    .risk-tabs { display: flex; gap: 4px; margin: 0 0 12px 0; border-bottom: 1px solid #e2e8f0; }
    .risk-tab {
        background: transparent; border: 0; border-bottom: 2px solid transparent;
        padding: 10px 16px; font-size: 14px; font-weight: 600; color: #718096; cursor: pointer;
    }
    .risk-tab:hover { color: #2d3748; }
    .risk-tab.is-active { color: #2b6cb0; border-bottom-color: #2b6cb0; }

    /* ---- chips ---- */
    .risk-status-chip { display: inline-block; padding: 2px 8px; border-radius: 999px;
        font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .risk-pending    { background: #fefcbf; color: #744210; }
    .risk-analysing  { background: #bee3f8; color: #2a4365; }
    .risk-clarify    { background: #feebc8; color: #7b341e; }
    .risk-analysed   { background: #c4f1f9; color: #234e52; }
    .risk-registered { background: #c6f6d5; color: #22543d; }
    .risk-accepted   { background: #c6f6d5; color: #22543d; }
    .risk-rejected   { background: #fed7d7; color: #742a2a; }
    .risk-duplicate  { background: #e9d8fd; color: #44337a; }
    .risk-withdrawn  { background: #edf2f7; color: #4a5568; }

    .risk-severity-chip { display: inline-block; padding: 2px 8px; border-radius: 4px;
        font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .risk-sev-critical { background: #742a2a; color: #fff; }
    .risk-sev-high     { background: #fed7d7; color: #742a2a; }
    .risk-sev-medium   { background: #fefcbf; color: #744210; }
    .risk-sev-low      { background: #c6f6d5; color: #22543d; }

    .risk-source-chip { display: inline-block; padding: 2px 8px; border-radius: 4px;
        background: #edf2f7; color: #2d3748; font-size: 11px; font-weight: 600; }

    /* ---- meta / history / trace ---- */
    .risk-meta {
        display: grid; grid-template-columns: 150px 1fr; row-gap: 6px; column-gap: 12px;
        margin: 0 0 16px 0; padding: 12px 14px; background: #f7fafc; border-radius: 6px; font-size: 13px;
    }
    .risk-meta dt { color: #718096; font-weight: 600; margin: 0;
                    text-transform: uppercase; font-size: 11px; align-self: center; }
    .risk-meta dd { margin: 0; color: #2d3748; word-break: break-word; }

    /* .risk-meta is a TRACK grid (label column | value column) and so it
       needs dt and dd to be separate grid items — the exact opposite of
       .pm-detail-grid, which needs the PAIR to be one item. Both are fed
       by the same dd() helper, so the wrapper it emits is made to
       generate no box here: its dt/dd then land in the tracks directly
       and all 13 .risk-meta lists render exactly as they did before.
       Safe on a plain <div> — it carries no ARIA role to lose, which is
       the one real hazard of display:contents. */
    .risk-meta .pm-detail-item { display: contents; }

    /* ==================================================================
       Bulk accept: one screen, no scrollbar.

       Scoped to .risk-accept-panel on purpose. Every value below is a
       tightening of a shared rule (.pm-modal-panel's padding, the
       header's and footer's rules, .pm-form-grid's gap), and tightening
       those globally would reflow every modal in the product to fix one.

       SINGLE accept is a full page now (#riskAcceptancePageView) and
       needs none of this -- .risk-page supplies its spacing. What is
       left here dresses #riskBulkAcceptModal, which is still a modal
       and still has to fit on one screen.
       ================================================================== */
    .risk-accept-panel { padding: 16px 18px; }
    .risk-accept-panel > header { margin-bottom: 12px; padding-bottom: 10px; }
    .risk-accept-panel .risk-meta { margin-bottom: 10px; padding: 10px 12px; row-gap: 5px; }
    .risk-accept-panel .risk-gate { margin: 0 0 10px; padding: 8px 10px; }
    .risk-accept-panel .pm-form-message { margin: 10px 0 0; }
    .risk-accept-panel .pm-modal-footer { margin-top: 12px; padding-top: 10px; }

    /* WHO/WHEN on the left, WHY on the right. The four left fields are
       auto-placed and flow down column 1; the rationale is placed into
       column 2 across all four of their rows, so the textarea gets its
       height from the column beside it instead of adding a row.

       Four since 293 added Review frequency above the date it drives.
       The span below tracks that count -- left at three, the fourth field
       would have sat beside empty space with the textarea ending short
       of it.

       Ratio, not fixed widths: 1 : 1.15 gives a date input about 350px
       and the textarea about 400px at 820px, both comfortably readable.
       Nothing here shrinks the type or the controls -- the height comes
       out of empty space, not out of legibility. */
    /* .pm-form-grid.ac-grid, not .ac-grid alone: both are single-class
       selectors, so on equal specificity this would be winning on source
       order alone -- true today, and quietly false the day this block
       moves into a stylesheet that loads first. */
    .pm-form-grid.ac-grid {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: 10px 18px;
        align-items: start;
    }
    .ac-grid .ac-note {
        grid-column: 2;
        grid-row: 1 / span 4;
        display: flex;
        flex-direction: column;
        /* The container is align-items:start so the four left fields sit
           at the top of their rows. This one must opt back into
           stretching, or it would size to its own content and the
           four-row span would buy nothing. */
        align-self: stretch;
    }
    /* Fills its column rather than sitting at rows="3" with a gap under
       it. The rows attribute stays as the pre-CSS floor. */
    .ac-grid .ac-note textarea {
        flex: 1 1 auto;
        min-height: 116px;
        resize: vertical;
    }
    .ac-grid .pm-hint { display: block; margin-top: 4px; }

    /* The ratio above was tuned for an 820px modal. On the full-width
       acceptance page the same two columns would stretch a date input
       to 700px and the rationale textarea to 800 -- a form does not get
       more usable by getting wider, and four short answers spread across
       a whole screen stop reading as one decision. Capped at roughly the
       width they were designed for, left-aligned within the panel.
       Scoped to .risk-page, so the bulk modal is untouched. */
    .risk-page .pm-form-grid.ac-grid { max-width: 860px; }

    /* Below two usable columns the span placement would strand the
       textarea, so it goes back to being the last row of one column. */
    @@media (max-width: 720px) {
        .pm-form-grid.ac-grid { grid-template-columns: minmax(0, 1fr); }
        .ac-grid .ac-note { grid-column: 1; grid-row: auto; }
        .ac-grid .ac-note textarea { min-height: 84px; }
    }

    .risk-subhead { font-size: 13px; text-transform: uppercase; letter-spacing: .04em;
                    color: #718096; margin: 16px 0 8px; }
    .risk-history table { width: 100%; font-size: 12px; border-collapse: collapse; }
    .risk-history th, .risk-history td { padding: 6px 8px; border-bottom: 1px solid #edf2f7; text-align: left; }
    .risk-history th { color: #718096; font-weight: 600; text-transform: uppercase; font-size: 11px; }

    .risk-trace { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; }
    .risk-trace-step { padding: 6px 10px; background: #edf2f7; border-radius: 6px; color: #2d3748; }
    .risk-trace-step a { color: #2b6cb0; text-decoration: none; }
    .risk-trace-step a:hover { text-decoration: underline; }
    .risk-trace-arrow { color: #a0aec0; }

    /* ---- dashboard (BRD §23) ---- */
    .risk-tab-action { margin-left: auto; align-self: center; }
    .risk-inline-label { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #4a5568; }

    .risk-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                  gap: 10px; margin-bottom: 8px; }
    .risk-tile { background: #f7fafc; border: 1px solid #e2e8f0; border-radius: 8px;
                 padding: 12px 14px; }
    .risk-tile .v { font-size: 24px; font-weight: 700; color: #2d3748; line-height: 1.1; }
    .risk-tile .k { font-size: 11px; text-transform: uppercase; letter-spacing: .04em;
                    color: #718096; margin-top: 4px; }
    .risk-tile.is-clickable { cursor: pointer; }
    .risk-tile.is-clickable:hover { border-color: #2b6cb0; background: #ebf8ff; }
    .risk-tile.is-alert .v { color: #c53030; }

    .risk-grid-4 { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                   gap: 16px; margin-bottom: 8px; }
    .risk-two-col { display: grid; grid-template-columns: minmax(220px, 1fr) 2fr; gap: 16px; }
    @@media (max-width: 900px) { .risk-two-col { grid-template-columns: 1fr; } }

    /* A bar chart made of divs. Deliberate: this dashboard must render
       with no charting dependency, and a labelled proportional bar is
       what these tiles actually need. */
    .risk-bars { display: flex; flex-direction: column; gap: 6px; }
    .risk-bar-row { display: grid; grid-template-columns: 130px 1fr 46px;
                    align-items: center; gap: 8px; font-size: 12px; }
    .risk-bar-row .lbl { color: #4a5568; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .risk-bar-row .trk { background: #edf2f7; border-radius: 4px; height: 14px; overflow: hidden; }
    .risk-bar-row .fil { background: #2b6cb0; height: 100%; border-radius: 4px; }
    .risk-bar-row .num { text-align: right; color: #2d3748; font-weight: 600; }
    .risk-bar-row.is-clickable { cursor: pointer; }
    .risk-bar-row.is-clickable:hover .lbl { color: #2b6cb0; text-decoration: underline; }

    .risk-check { display: flex; align-items: flex-start; gap: 8px; }
    .risk-check input { margin-top: 3px; }

    .risk-rating-preview {
        padding: 8px 12px; border-radius: 6px; background: #edf2f7; color: #4a5568;
        font-weight: 600; font-size: 13px; display: inline-block; min-width: 220px;
    }
    .risk-rating-preview[data-rating="Critical"] { background: #742a2a; color: #fff; }
    .risk-rating-preview[data-rating="High"]     { background: #fed7d7; color: #742a2a; }
    .risk-rating-preview[data-rating="Medium"]   { background: #fefcbf; color: #744210; }
    .risk-rating-preview[data-rating="Low"]      { background: #c6f6d5; color: #22543d; }

    /* Modal overlay (defensive CSS same as exception + gap-detail so
       pm-modal renders as a proper popup regardless of global stylesheet). */



    .pm-modal-panel.pm-modal-wide { max-width: 820px; }


    /* .pm-modal / .pm-modal-panel / .pm-modal-footer moved to
           practice-management.css -- they were identical in three
           views and absent from any fourth that used the classes.
           The .pm-modal-close override below is kept deliberately:
           the global rule is a bordered button, this is a glyph. */
        .pm-modal-close { background: transparent; border: 0; padding: 0;
        font-size: 26px; line-height: 1; cursor: pointer; color: #718096; }
    .pm-modal-close:hover { color: #e53e3e; }

    /* ==================================================================
       `pm-form-grid-full` — an alias, and why it is needed.

       This partial uses .pm-form-grid-full 40+ times to mean "this field
       spans both columns", and so do exception-centre, exception-analysis,
       gap-detail and document-uploads. It is not defined in
       practice-management.css or anywhere else: the real class is `.full`
       (`.pm-form-grid label.full { grid-column: 1 / -1; }`).

       So every field marked full-width in this screen has in fact been
       rendering at HALF width inside a two-column grid — which is a large
       part of why these forms felt cramped. Long textareas (risk
       statement, consequence, controls, remarks) were the worst affected.

       Aliased rather than renamed in the markup: one rule fixes all 40
       occurrences here with no churn, and the new page below uses the
       correct `.full` so nothing new depends on the alias.

       SCOPED TO THIS PARTIAL ON PURPOSE. The other four screens have the
       same latent bug, but fixing them is a change to screens this task
       did not ask about, and their layouts should be looked at rather
       than silently reflowed.
       ================================================================== */
    .pm-form-grid > .pm-form-grid-full { grid-column: 1 / -1; }

    /* ==================================================================
       Full-page views — Risk Analysis and Risk Treatment.

       SCOPED TO .risk-page, NOT TO A PAGE ID.
       These rules were originally written as `#riskAnalysisPageView ...`.
       When Risk Treatment reused the same class names under a different
       id, not one of them matched it: the split row never became a grid,
       the detail list never got its columns, the action bar never became
       sticky. The page rendered as a single stacked column down the left
       of a very wide panel -- which looked like a layout that had not
       been written rather than one that had not been applied.

       A shared class is what makes "the full-page shell" a thing both
       pages have, and what stops the next page silently missing it.

       The layout rules the page needs, and nothing the site stylesheet
       already provides: pm-panel, pm-page-heading, pm-section-heading,
       pm-form-grid, pm-detail-grid and pm-button all come from
       practice-management.css and are deliberately not restated.
       ================================================================== */
    .risk-page { display: block; }

    /* Vertical rhythm between sections. One rule, so "proper spacing
       between sections" is a property of the page rather than something
       each section has to remember. */
    .risk-page .ra-form > * + * { margin-top: 14px; }
    .risk-page .ra-head { margin-bottom: 14px; }
    .risk-page .ra-head-actions { display: flex; align-items: center; gap: 10px; }

    /* Split rows (residual analysis, treatment work). Risk context and
       Inherent scoring no longer use this — they are full-width rows of
       their own. minmax(0,...) on both tracks stops a long unbroken
       value from widening its column and squeezing the controls beside
       it — the classic CSS-grid overflow. */
    .risk-page .ra-row-split {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
        gap: 14px;
        align-items: start;
    }

    /* Panels still inside a split row keep two columns. The Review page
       still has two of them, so this rule stays as it is. */
    .risk-page .ra-grid-1 { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    /* Residual scoring, once the Justification card beside it was
       removed and the panel went full width.

       Four columns, same shape and cap as .ra-grid-score above, so the
       two scoring panels on this product look like siblings: the whole
       calculation reads left to right on one line --
       likelihood x impact -> rating -> movement -- instead of the two
       read-outs each taking a full-width row of their own.

       Capped for the same reason .ra-grid-score is: four fields stretched
       across a 1600px monitor look like a mistake. The remark below spans
       the row (.pm-form-grid label.full), which keeps the textarea a
       comfortable reading width rather than one line 1600px wide. */
    .risk-page .ra-grid-residual {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        max-width: 1280px;
    }

    /* Inherent scoring: category, likelihood, impact AND the resolved
       rating all on one row. The rating used to span a second full-width
       row on its own, which left most of that row empty; as a fourth
       cell the panel is one line and reads in the order it is worked
       out. Capped, because four fields stretched across a 1600px monitor
       look like a mistake — the panel is left-aligned to the page grid
       and simply stops. */
    .risk-page .ra-grid-score {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        max-width: 1280px;
    }
    /* Match the select box exactly (34px tall, same 6px gap under the
       label), or the rating chip sits a few pixels proud of the three
       controls beside it — the kind of misalignment that is only
       visible once they share a row. */
    /* Residual scoring shares the row shape, so it shares the alignment
       fix. Without this the residual chip sits proud of the two selects
       beside it, exactly as the inherent one did. */
    .risk-page .ra-grid-score .risk-rating-preview,
    .risk-page .ra-grid-residual .risk-rating-preview {
        align-items: center; display: flex; height: 34px;
        line-height: 1.2; padding: 7px 12px;
    }
    /* Same treatment for the delta line, which is the fourth cell on
       that row and would otherwise be the only one not 34px tall. */
    .risk-page .ra-grid-residual .risk-delta {
        align-items: center; display: flex; flex-wrap: wrap;
        gap: 6px; min-height: 34px; line-height: 1.2;
    }

    /* Risk Category (375, 376) reuses pm-checkcombo -- see raCategory's
       markup comment above -- but it still has to sit in this same
       34px-tall row beside raLikelihood/raImpact/raRating.
       .pm-checkcombo-trigger's own min-height is 40px (correct for the
       multi-row Impacted Assets/dependency pickers it was built for),
       so it is trimmed here to match, exactly the way the rating chip
       above it was. margin-top:6px matches every other control's gap
       under its label in this grid -- .form-field (display:block, no
       gap) does not give it that for free the way .pm-field's grid
       layout would. */
    .risk-page .ra-grid-score .pm-checkcombo-trigger {
        min-height: 34px; margin-top: 6px; padding: 6px 9px;
    }

    /* Analysis detail asks for Impact Analysis and Risk Type (313) --
       both full-width, so this stays a single column at every width. A
       dedicated class rather than reusing .ra-grid-1, which the scoring
       panel already owns at two columns. */
    .risk-page .ra-grid-single { grid-template-columns: minmax(0, 1fr); }

    /* Analysis detail: three columns on a wide screen. These are the
       long-form fields, and three of them side by side is what actually
       uses the width the master layout gives us. */
    .risk-page .ra-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .risk-page .ra-span-2 { grid-column: span 2; }

    /* Responsive: collapse in two steps rather than one, so a 1200px
       laptop gets a sensible middle layout instead of jumping straight
       to a single column. */
    @@media (max-width: 1400px) {
        .risk-page .ra-grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .risk-page .ra-span-2 { grid-column: span 2; }
    }
    @@media (max-width: 1100px) {
        .risk-page .ra-row-split { grid-template-columns: minmax(0, 1fr); }
    }
    @@media (max-width: 1200px) {
        /* Four fields need ~230px each before "Inherent risk rating"
           and the rating text start wrapping. Below that, two rows of
           two — which still pairs likelihood with impact, and pairs the
           rating with the delta it is being compared against. */
        .risk-page .ra-grid-score,
        .risk-page .ra-grid-residual { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 760px) {
        .risk-page .ra-grid-3,
        .risk-page .ra-grid-score,
        .risk-page .ra-grid-residual,
        .risk-page .ra-grid-1 { grid-template-columns: minmax(0, 1fr); }
        .risk-page .ra-span-2 { grid-column: span 1; }
        .risk-page .ra-actionbar { flex-direction: column; align-items: stretch; }
    }

    /* The context list.

       THE GRID ITEM IS .pm-detail-item, NOT dt/dd. A <dl> laid out as a
       grid treats every <dt> and every <dd> as its own item, so across
       three columns they interleave — label, value, label / value,
       label, value — and each label ends up above somebody else's
       value. dd() in risk-centre.js wraps each pair in a .pm-detail-item
       so the PAIR occupies one cell, which is what a multi-column
       label/value layout requires. Never style dt/dd as items here.

       240px, auto-fit: three columns at the width this full-width card
       now has, two on a laptop, one on a phone, without a media query
       per breakpoint. */
    .risk-page .pm-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px 28px;
        margin: 0;
        align-items: start;
    }
    /* min-width:0 so a long unbroken statement wraps inside its cell
       instead of widening the track and pushing the columns out. */
    .risk-page .pm-detail-item { min-width: 0; }
    /* For the one value that is a sentence, not a field. */
    .risk-page .pm-detail-grid .pm-detail-span { grid-column: 1 / -1; }
    .risk-page .pm-detail-grid dt {
        font-size: 11px; text-transform: uppercase; letter-spacing: .04em;
        color: var(--grac-muted, #758095); margin: 0 0 3px;
    }
    /* margin:0 — the grid gap owns the spacing now. A bottom margin here
       would add to the gap and only under the last row of each column,
       which is what made the old list look ragged. */
    .risk-page .pm-detail-grid dd {
        margin: 0; font-size: 13px; color: var(--grac-ink, #172033);
        overflow-wrap: anywhere; line-height: 1.45;
    }

    /* The rating preview is a block in a grid cell here, not an inline
       chip in a modal, so it fills its cell. */
    .risk-page .risk-rating-preview { display: block; width: 100%; min-width: 0; }
    .risk-page .form-field > span {
        color: #536077; display: block; font-size: 13px; font-weight: 650; margin-bottom: 6px;
    }

    @* The 220px cap this rule used to lift is gone: the mapped practices
       are a parent/child table now and it never had an inner scroller.
       The principle still holds -- a scrollbar inside a section inside a
       scrolling page hides rows the page has room to show -- so nothing
       replaces it, and .risk-map-cols has been deleted as dead. *@

    /* Four treatment cards across the full width on a wide screen. */
    .risk-page .risk-treat-options {
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }

    /* Sticky action bar. On a form this tall, a footer that scrolls away
       means scrolling to the end to save and back to read the validation
       message that stopped it. */
    .risk-page .ra-actionbar {
        position: sticky; bottom: 0; z-index: 5;
        display: flex; align-items: center; justify-content: space-between;
        gap: 14px; flex-wrap: wrap;
        background: #fff;
        border: 1px solid var(--grac-line, #e2e7f0);
        border-radius: 8px;
        box-shadow: 0 -2px 10px rgba(37, 52, 90, 0.06);
        padding: 12px 14px;
    }
    .risk-page .ra-actionbar-buttons { display: flex; gap: 10px; margin-left: auto; }
    .risk-page .ra-actionbar .pm-form-message { margin: 0; }

    /* ==================================================================
       The Inherent -> Treatment -> Residual rail, and the step markers
       that carry it down the page (Residual Risk Analysis).

       WHY A RAIL AND NOT THREE MORE PANELS.
       The residual page asks one question -- what is left? -- that is
       only answerable in terms of two things that happened before it.
       Stacked panels of equal weight read as a form with a long preamble;
       a numbered rail reads as a sequence, which is what it is. The rail
       carries the actual values (the inherent chip, the option and its
       task counts, the residual chip as it is chosen), so the three
       steps are the summary as well as the navigation.

       Built from the same palette and the same chips as everything else
       on this screen -- risk-severity-chip inside the boxes, the gate's
       amber/green for state. Nothing here is a new visual language.
       ================================================================== */
    .risk-page .risk-flow {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: stretch;
        gap: 0;
        list-style: none;
        margin: 0 0 14px;
        padding: 0;
    }
    .risk-flow-step {
        background: #fff;
        border: 1px solid var(--grac-line, #e2e7f0);
        border-radius: 8px;
        padding: 10px 12px;
        min-width: 0;
    }
    /* The step the page is FOR. Nothing else on the rail competes with it. */
    .risk-flow-step.is-current { border-color: #90cdf4; box-shadow: 0 0 0 2px #ebf8ff inset; }
    /* Treatment that is not finished. Same amber the gate uses, so the
       two say the same thing in the same colour. */
    .risk-flow-step.is-warn    { border-color: #fbd38d; background: #fffaf0; }
    .risk-flow-step .n {
        align-items: center; background: #edf2f7; border-radius: 999px;
        color: #4a5568; display: inline-flex; font-size: 10px; font-weight: 750;
        height: 16px; justify-content: center; margin-right: 6px; width: 16px;
    }
    .risk-flow-step .k {
        color: #718096; font-size: 11px; font-weight: 700;
        letter-spacing: .04em; text-transform: uppercase;
    }
    .risk-flow-step .v { font-size: 13px; margin-top: 6px; }
    .risk-flow-step .s { color: var(--grac-muted, #758095); font-size: 11px; margin-top: 4px; }
    .risk-flow-arrow {
        align-items: center; color: #a0aec0; display: flex;
        font-size: 14px; padding: 0 10px;
    }

    /* ---- Read-only Risk Details page ---------------------------------
       Reuses .risk-flow for its rail; these are the only two states it
       adds. A stage the risk has reached is solid; one it has not is
       faded, so "how far has this got" is answered before reading a
       word. Deliberately NOT a colour difference: the chips inside the
       steps already carry severity colour and a second colour system on
       top of them would fight it. */
    .rd-step.is-pending { background: #fbfcfe; border-style: dashed; }
    .rd-step.is-pending .v, .rd-step.is-pending .s { opacity: .7; }
    .rd-step.is-done .n { background: #c6f6d5; color: #22543d; }

    .rd-body { display: flex; flex-direction: column; gap: 14px; }

    /* A section with nothing to show yet. It says what has to happen
       first — an empty panel reads as a broken feature. */
    .rd-na {
        align-items: center; background: #f9fafb; border: 1px dashed var(--grac-line, #e2e7f0);
        border-radius: 8px; display: flex; flex-wrap: wrap; gap: 10px; padding: 14px 16px;
    }
    .rd-na-tag {
        background: #edf2f7; border-radius: 999px; color: #718096; font-size: 10px;
        font-weight: 700; letter-spacing: .05em; padding: 3px 9px; text-transform: uppercase;
        white-space: nowrap;
    }
    .rd-na p { color: #718096; font-size: 12px; margin: 0; }
    .rd-na strong { color: #4a5568; }

    /* Where a required field has no value. Muted, so a page of real
       values is not shouted at by its gaps. */
    .rd-none { color: #a0aec0; font-style: italic; }

    /* ---- Print --------------------------------------------------------
       The page is a record of one risk, so printing it should produce
       that record and nothing else: no sidebar, no top bar, no tab
       chrome, no buttons. Panels get a real border and are kept off page
       breaks, since a section split across two sheets is the thing that
       makes printed reports unreadable. */
    @@media print {
        .main-sidebar, .main-header, .main-footer, .pm-breadcrumb,
        .risk-tabs, .ra-head-actions, .pm-action-trigger { display: none !important; }
        .content-wrapper, body { background: #fff !important; margin: 0 !important; }
        #riskDetailPageView .pm-panel {
            border: 1px solid #cbd5e0 !important; box-shadow: none !important;
            break-inside: avoid; page-break-inside: avoid;
        }
        #riskDetailPageView .rmp-card,
        #riskDetailPageView .risk-flow-step { break-inside: avoid; page-break-inside: avoid; }
        #riskDetailPageView .pm-table-wrap { overflow: visible !important; }
    }
    /* Stacked, the arrows would point sideways between rows. */
    @@media (max-width: 900px) {
        .risk-page .risk-flow { grid-template-columns: minmax(0, 1fr); gap: 8px; }
        .risk-flow-arrow { display: none; }
    }

    /* ---- FOUR-STEP RAIL: four equal columns, chevrons in the gaps -----
       `.risk-flow-4`, a modifier on .risk-flow. Carried by BOTH four-step
       rails — Risk Details (#rdFlow) and Residual Analysis (#rrFlow).

       .risk-page .risk-flow above is a fixed FIVE-track grid,
       1fr auto 1fr auto 1fr, sized for THREE steps and the two <li>
       arrows between them — which is still exactly what the Review rail
       is. A four-step rail is seven items in five tracks, and the
       overflow is what pushed Risk acceptance onto a second row with an
       orphaned arrow beside it. Both four-step rails now use four tracks
       and emit no arrow items at all.

       These rules sit AFTER the shared ones, and after the 900px block,
       deliberately: `.risk-page .risk-flow-4` and `.risk-page .risk-flow`
       have identical specificity, so source order is what decides, and
       the single-column rule above would otherwise win on every screen
       narrower than 900px. */
    .risk-page .risk-flow-4 {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        align-items: stretch;
    }
    /* Equal height comes from align-items:stretch. This lines up the
       INSIDE of the cards too — heading at the top, supporting line on
       the bottom edge — so four cards carrying different amounts of text
       still read as one row rather than four ragged blocks.
       .risk-flow-step, not .rd-step: the Residual rail's steps carry
       only the shared class. */
    .risk-page .risk-flow-4 .risk-flow-step { display: flex; flex-direction: column; position: relative; }
    .risk-page .risk-flow-4 .risk-flow-step .s { margin-top: auto; padding-top: 4px; }

    /* The connector, drawn in the gap rather than added as a grid item —
       an extra item is exactly what broke the row. Borders, not an icon
       font, so it cannot depend on which Font Awesome build is loaded. */
    .risk-page .risk-flow-4 .risk-flow-step:not(:last-child)::after {
        border-right: 1.5px solid #cbd5e0;
        border-top: 1.5px solid #cbd5e0;
        content: "";
        height: 6px; width: 6px;
        margin-top: -4px;
        position: absolute; right: -8px; top: 50%;
        transform: rotate(45deg);
    }

    @@media (max-width: 1200px) {
        .risk-page .risk-flow-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        /* At two columns the second card's chevron would point at a card
           on the row below. */
        .risk-page .risk-flow-4 .risk-flow-step:nth-child(2n)::after { content: none; }
    }
    @@media (max-width: 700px) {
        .risk-page .risk-flow-4 { grid-template-columns: minmax(0, 1fr); }
        .risk-page .risk-flow-4 .risk-flow-step::after { content: none; }
    }

    /* ---- Risk Details label/value grids -------------------------------
       A fixed FOUR columns rather than pm-detail-grid's auto-fit, so
       every section on the page sits on the same rhythm instead of
       resolving to a different column count per panel depending on how
       many fields it happens to have. Fields keep label above value and
       wrap inside their own column: .pm-detail-item already carries
       min-width:0 and dd carries overflow-wrap:anywhere, which is what
       stops a long statement widening its track.

       Id selector, so it beats .risk-page .pm-detail-grid wherever this
       block ends up in the file. Traceability is outside the <dl>, so it
       stays a full-width row below the grid. */
    #riskDetailPageView .pm-detail-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    @@media (max-width: 1400px) {
        #riskDetailPageView .pm-detail-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @@media (max-width: 1000px) {
        #riskDetailPageView .pm-detail-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 640px) {
        #riskDetailPageView .pm-detail-grid { grid-template-columns: minmax(0, 1fr); }
    }

    /* The step number on each section heading, tying the panels below to
       the rail above. */
    /* The three primary sections carry .ra-step so the rail's steps and
       the panels below it are one sequence rather than two lists that
       happen to be numbered the same. The rule is a scroll anchor, not
       decoration: the sticky action bar would otherwise cover a heading
       jumped to from the rail. */
    .risk-page .ra-step { scroll-margin-top: 12px; }

    .ra-step-badge {
        align-items: center; background: #2b6cb0; border-radius: 999px;
        color: #fff; display: inline-flex; font-size: 11px; font-weight: 750;
        height: 18px; justify-content: center; margin-right: 7px; width: 18px;
    }
    /* A heading with an action on its right (step 2's link to the
       Treatment page). */
    .risk-page .ra-heading-row {
        align-items: flex-start; display: flex; gap: 12px; justify-content: space-between;
    }
    .risk-page .ra-heading-row > div { min-width: 0; }

    /* Inherent -> residual, in words, under the rating preview. */
    .risk-delta { font-size: 13px; font-weight: 650; color: #2d3748; padding: 4px 0; }
    .risk-delta .arrow { color: #a0aec0; margin: 0 6px; }

    /* Step 2 is a read-only lens on Task Center's data. Its table is the
       Treatment page's, minus the actions column. */
    .risk-page #rrTaskTable td,
    .risk-page #rrTaskTable th { padding-top: 5px; padding-bottom: 5px; }

    /* ==================================================================
       Migrations 261-264: stage, treatment, scope, acceptance, calendar.

       Every colour below is already in this file's palette. The point of
       the new screens is that they look like the Risk Centre, not like
       a bolt-on -- so the stage chip borrows the status chip's shape,
       the source badges borrow the severity chip's, and the calendar
       borrows practice-calendar.css's grid proportions.
       ================================================================== */

    .risk-tab-badge { margin-left: 6px; }

    /* ---- Stage chip -------------------------------------------------
       Three visual weights, because the stages fall into three kinds:
       something is DUE (amber, act), something is IN FLIGHT (blue,
       wait), something is SETTLED (green/grey, nothing to do). Colour
       carries the same meaning as the wording so the column can be
       scanned rather than read. */
    .risk-stage-chip { display: inline-block; padding: 2px 8px; border-radius: 10px;
                       font-size: 11px; font-weight: 600; white-space: nowrap;
                       background: #edf2f7; color: #4a5568; }
    .risk-stage-chip[data-stage="AnalysisDue"],
    .risk-stage-chip[data-stage="TreatmentDue"],
    .risk-stage-chip[data-stage="ResidualDue"],
    .risk-stage-chip[data-stage="AcceptanceDue"] { background: #fefcbf; color: #744210; }
    .risk-stage-chip[data-stage="ReviewDue"]     { background: #fed7d7; color: #742a2a; }
    .risk-stage-chip[data-stage="InTreatment"]   { background: #bee3f8; color: #2a4365; }
    .risk-stage-chip[data-stage="Accepted"]      { background: #c6f6d5; color: #22543d; }
    .risk-stage-chip[data-stage="Closed"]        { background: #e2e8f0; color: #718096; }

    /* ---- Treatment option picker ------------------------------------
       Radio cards rather than a <select>. Four options whose
       CONSEQUENCES differ (three raise work, one does not) need their
       consequences visible at the moment of choosing -- a dropdown shows
       four words and hides the thing that matters. */
    .risk-treat-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
                          gap: 8px; margin: 8px 0 4px; }
    .risk-treat-opt { display: grid; grid-template-columns: auto 1fr; gap: 4px 8px;
                      align-items: start; padding: 10px 12px; cursor: pointer;
                      border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; }
    .risk-treat-opt:hover { border-color: #2b6cb0; background: #ebf8ff; }
    .risk-treat-opt input { margin-top: 2px; }
    .risk-treat-opt .t { font-weight: 600; font-size: 13px; color: #2d3748; }
    .risk-treat-opt .d { grid-column: 2; font-size: 11px; color: #718096; line-height: 1.35; }
    .risk-treat-opt:has(input:checked) { border-color: #2b6cb0; background: #ebf8ff;
                                         box-shadow: inset 0 0 0 1px #2b6cb0; }

    /* ---- Scope panel (practices + assets) ---------------------------
       Two columns on desktop because practices and assets are read
       together -- "which practice put that asset here?" is the question
       the panel exists to answer, and answering it should not require
       scrolling between two stacked lists. */
    .risk-map-host { margin-top: 8px; }

    /* Practices first, dependency categories underneath — two stacked
       full-width rows, NOT two columns.

       The old two-column split gave practices a 260px lane. That was
       survivable while a practice was just a name; once each one had to
       show framework > structure root > statement plus its tasks, every
       line wrapped and the column read as a ransom note. Both halves now
       get the whole panel width and the page is scanned downward. */
    .risk-scope { display: flex; flex-direction: column; gap: 26px; }
    .risk-scope-block { min-width: 0; }
    /* A rule rather than a nested card: this already sits inside a
       pm-panel, and a white card on a white card only adds edges. The
       gap above it is generous on purpose — the practice blocks are
       themselves bordered, so a thin divider alone would have read as
       one more block rather than as a change of subject.
       ONLY when it follows another block. Impact Details now has a panel
       of its own above Existing Controls, and a top border on the first
       thing in a panel is a stray rule under the heading, not a
       divider between two subjects. */
    .risk-scope-block + .risk-scope-deps { border-top: 1px solid #e2e8f0; padding-top: 22px; }
    .risk-scope h4 { margin: 0 0 6px; font-size: 12px; text-transform: uppercase;
                     letter-spacing: .04em; color: #718096; }
    /* Section title and its one action share a line, so the action does
       not cost a row of vertical space of its own. */
    .risk-scope-head { display: flex; align-items: center; justify-content: space-between;
                       gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
    .risk-scope-head h4 { margin: 0; display: flex; align-items: center; gap: 8px;
                          flex-wrap: wrap; }
    .risk-scope-head h4 .pm-hint { margin: 0; text-transform: none; letter-spacing: 0; }

    /* One row per Operationalize category, carrying the shared
       pm-checkcombo multi-select — the same widget and the same table
       shape the Operationalize dependency section uses.

       No .pm-checkcombo rules here on purpose: practice-management.css
       already styles the widget and practice.js already drives it. The
       only thing this screen adds is the row it sits in. */
    .risk-dep-table td { vertical-align: middle; }
    .risk-dep-table td:first-child { white-space: nowrap; }

    /* Locked options are inherited from a mapped practice — visibly
       present and visibly not yours to untick. */
    .risk-dep-table [data-checkcombo-option].is-locked { opacity: .72; cursor: not-allowed; }
    .risk-dep-table [data-checkcombo-option].is-locked span { font-style: italic; }

    .risk-dep-savebar { display: flex; align-items: center; justify-content: space-between;
                        gap: 12px; flex-wrap: wrap; margin-top: 10px; }
    .risk-dep-savebar .pm-hint { margin: 0; }

    /* The Asset row: three cascade filters and the picker share ONE flex
       line, the same proportions the Operationalize Asset row uses
       (filters 1fr each, picker 2fr). Stacking them would make the Asset
       row twice the height of every other one and put the filters a
       glance away from the list they narrow.

       min-width:0 on every cell is what stops a long asset or category
       name widening its flex item and pushing the row past the table —
       the usual flexbox overflow trap. */
    .risk-asset-row { display: flex; gap: 8px; align-items: flex-end; width: 100%; }
    .risk-asset-filter { flex: 1 1 0; min-width: 0; }
    .risk-asset-picker { flex: 2 1 0; min-width: 0; }
    .risk-asset-row .pm-hint { display: block; margin: 0 0 2px; }
    .risk-asset-row .pm-checkcombo { width: 100%; }

    @@media (max-width: 1100px) {
        /* Two lines rather than four: filters wrap among themselves and
           the picker takes a full line under them. */
        .risk-asset-row { flex-wrap: wrap; }
        .risk-asset-filter { flex: 1 1 30%; }
        .risk-asset-picker { flex: 1 1 100%; }
    }

    @* .risk-map-cols / .risk-map-col removed: no markup in this partial,
       any other view, or any script used them. Dead since the scope panel
       stopped being two columns. *@
    /* ---- Mapped practice blocks ---------------------------------------
       ONE BORDERED BLOCK PER PRACTICE. The flat table this replaces gave
       the practice name, its provenance, its dependency count and its
       tasks rows of equal visual weight, so nothing said which belonged
       to what. Each block now has three tiers that are read in order:
       title + badge, labelled facts, then the tasks inset and shaded so
       they are plainly subordinate to both.

       Colours, radius and type are the page's existing ones — this is a
       regrouping of the same values, not a new palette. */
    .rmp-list { display: flex; flex-direction: column; gap: 12px; }

    .rmp-card {
        border: 1px solid #e2e8f0; border-radius: 8px; background: #fff;
        padding: 14px 16px; transition: border-color .12s ease;
    }
    .rmp-card:hover { border-color: #cbd5e0; }

    .rmp-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .rmp-title { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; min-width: 0; }
    .rmp-title h5 { margin: 0; font-size: 14px; font-weight: 650; line-height: 1.35;
                    color: var(--grac-ink, #172033); overflow-wrap: anywhere; }

    /* Lighter than the old row button: an unmap is destructive and rare,
       so it should be findable, not prominent. Colour arrives on hover. */
    .rmp-remove { background: transparent; border: 0; cursor: pointer; color: #cbd5e0;
                  font-size: 13px; line-height: 1; padding: 5px 7px; border-radius: 6px;
                  flex: 0 0 auto; }
    .rmp-remove:hover { color: #e53e3e; background: #fff5f5; }
    .rmp-remove[disabled] { color: #edf2f7; cursor: not-allowed; }
    .rmp-remove[disabled]:hover { color: #edf2f7; background: transparent; }

    /* Named facts instead of an undecoded breadcrumb. auto-fit so they
       use the block's width and wrap as a set rather than one per line. */
    .rmp-facts {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 10px 20px; margin: 12px 0 0; padding: 12px 0 0;
        border-top: 1px dashed #edf1f6;
    }
    .rmp-fact { min-width: 0; }
    .rmp-facts dt { margin: 0 0 2px; font-size: 10px; font-weight: 600;
                    text-transform: uppercase; letter-spacing: .05em; color: #a0aec0; }
    .rmp-facts dd { margin: 0; font-size: 12px; line-height: 1.45;
                    color: #2d3748; overflow-wrap: anywhere; }

    /* Tasks: inset, shaded, one step smaller. */
    .rmp-tasks { margin-top: 12px; padding: 9px 11px; border-radius: 6px;
                 background: #f8fafc; border: 1px solid #eef2f7; }
    .rmp-tasks-label { display: flex; align-items: center; gap: 6px; margin-bottom: 6px;
                       font-size: 10px; font-weight: 600; text-transform: uppercase;
                       letter-spacing: .05em; color: #a0aec0; }
    .rmp-task-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .rmp-task-table th { padding: 0 8px 5px; text-align: left; font-size: 10px;
                         font-weight: 600; text-transform: uppercase; letter-spacing: .04em;
                         color: #a0aec0; }
    .rmp-task-table td { padding: 6px 8px; color: #2d3748; vertical-align: middle;
                         border-top: 1px solid #e8eef5; overflow-wrap: anywhere; }
    .rmp-task-table th:first-child, .rmp-task-table td:first-child { padding-left: 0; }
    .rmp-task-table th:last-child,  .rmp-task-table td:last-child  { padding-right: 0; }
    .rmp-dash { color: #cbd5e0; }
    .rmp-no-tasks { margin: 0; font-size: 11px; font-style: italic; color: #a0aec0; }

    /* ---- The practice's own dependencies, read-only ------------------
       Same inset treatment as .rmp-tasks, so both read as subordinate to
       the practice they sit under. Chips, not a table: these are names
       with no other attribute worth a column, and there is nothing to do
       to them here -- the practice owns them and unmapping the practice
       is what removes them. No pointer cursor, no hover state, nothing
       that would suggest otherwise. */
    .rmp-deps { margin-top: 12px; padding: 9px 11px; border-radius: 6px;
                background: #f8fafc; border: 1px solid #eef2f7; }
    .rmp-deps-label { display: flex; align-items: center; gap: 6px; margin-bottom: 6px;
                      font-size: 10px; font-weight: 600; text-transform: uppercase;
                      letter-spacing: .05em; color: #a0aec0; }
    .rmp-dep-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
                      gap: 8px 18px; margin: 0; }
    .rmp-dep-group { min-width: 0; }
    .rmp-dep-groups dt { margin: 0 0 3px; font-size: 10px; font-weight: 600;
                         text-transform: uppercase; letter-spacing: .04em; color: #a0aec0; }
    .rmp-dep-groups dd { margin: 0; display: flex; flex-wrap: wrap; gap: 4px; }
    .rmp-dep-chip { display: inline-block; padding: 2px 8px; border-radius: 10px;
                    background: #edf2f7; border: 1px solid #e2e8f0; color: #2d3748;
                    font-size: 11px; line-height: 1.5; overflow-wrap: anywhere; }
    .rmp-no-deps { margin: 0; font-size: 11px; font-style: italic; color: #a0aec0; }

    /* The read-only Impact Details cell: chips, wrapping, in the box the
       picker would have occupied. Same chip as the practice cards, so
       "a mapped record" looks the same wherever it is read. */
    .risk-dep-chips { display: flex; flex-wrap: wrap; gap: 4px; padding: 2px 0; }

    /* Count pill beside a section or group title. */
    .rmp-count { display: inline-block; min-width: 20px; padding: 1px 7px; border-radius: 9px;
                 background: #edf2f7; color: #4a5568; font-size: 11px; font-weight: 650;
                 text-align: center; letter-spacing: 0; }
    .rmp-count.sm { min-width: 16px; padding: 0 5px; font-size: 10px; }

    /* ---- Source badges ----------------------------------------------
       The requirement asks the UI to distinguish assets inherited from
       the primary practice, assets inherited through an additional
       practice, and assets mapped directly. Four badges, because an
       asset can legitimately be BOTH direct and inherited -- and that
       combination is exactly the one that survives unmapping a
       practice, so it must be visible rather than collapsed into one of
       the other two. */
    .risk-src-badge { display: inline-block; padding: 1px 6px; border-radius: 8px;
                      font-size: 10px; font-weight: 600; letter-spacing: .02em;
                      text-transform: uppercase; }
    .risk-src-badge[data-src="Primary"]            { background: #bee3f8; color: #2a4365; }
    .risk-src-badge[data-src="Additional"]         { background: #e9d8fd; color: #44337a; }
    .risk-src-badge[data-src="Direct"]             { background: #c6f6d5; color: #22543d; }
    .risk-src-badge[data-src="DirectAndInherited"] { background: #feebc8; color: #7b341e; }

    /* ---- Gate notice -------------------------------------------------
       A disabled button that cannot say why is a dead end. Every gate in
       this flow returns its own reason text, and this is where it goes. */
    .risk-gate { padding: 10px 12px; border-radius: 6px; font-size: 12px;
                 background: #ebf8ff; border: 1px solid #bee3f8; color: #2a4365;
                 margin-bottom: 10px; }
    .risk-gate.is-blocked { background: #fffaf0; border-color: #fbd38d; color: #7b341e; }
    .risk-gate.is-ready   { background: #f0fff4; border-color: #9ae6b4; color: #22543d; }

    /* ---- Risk calendar ----------------------------------------------
       A month grid, borrowing practice-calendar.css's proportions so the
       two calendars in the product feel like one idea. Deliberately not
       a week or day view: a review date has no time component, so hours
       would be a grid of empty cells. */
    .risk-cal-title { font-weight: 600; color: #2d3748; min-width: 160px; text-align: center; }
    .risk-cal { border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; margin-bottom: 14px; }
    .risk-cal-head, .risk-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
    .risk-cal-head > div { padding: 6px 8px; font-size: 11px; font-weight: 600;
                           text-transform: uppercase; letter-spacing: .04em;
                           color: #718096; background: #f7fafc; border-bottom: 1px solid #e2e8f0; }
    .risk-cal-cell { min-height: 92px; padding: 4px 6px; border-right: 1px solid #edf2f7;
                     border-bottom: 1px solid #edf2f7; background: #fff; }
    .risk-cal-cell:nth-child(7n) { border-right: 0; }
    .risk-cal-cell.is-outside { background: #fafafa; }
    .risk-cal-cell.is-outside .d { color: #cbd5e0; }
    .risk-cal-cell.is-today { background: #ebf8ff; }
    .risk-cal-cell .d { font-size: 11px; font-weight: 600; color: #4a5568; }
    .risk-cal-cell.is-today .d { color: #2b6cb0; }
    .risk-cal-ev { display: block; width: 100%; text-align: left; margin-top: 3px;
                   padding: 2px 5px; border: 0; border-radius: 4px; cursor: pointer;
                   font-size: 10px; line-height: 1.3; overflow: hidden;
                   text-overflow: ellipsis; white-space: nowrap;
                   background: #edf2f7; color: #2d3748; }
    .risk-cal-ev:hover { filter: brightness(0.95); }
    .risk-cal-ev[data-rating="Critical"] { background: #742a2a; color: #fff; }
    .risk-cal-ev[data-rating="High"]     { background: #fed7d7; color: #742a2a; }
    .risk-cal-ev[data-rating="Medium"]   { background: #fefcbf; color: #744210; }
    .risk-cal-ev[data-rating="Low"]      { background: #c6f6d5; color: #22543d; }
    .risk-cal-ev.is-overdue { box-shadow: inset 2px 0 0 #c53030; font-weight: 700; }
    .risk-cal-more { font-size: 10px; color: #718096; margin-top: 2px; }

    .risk-overdue { color: #c53030; font-weight: 600; }
    .risk-duetoday { color: #b7791f; font-weight: 600; }

    /* ---- Treatment task hierarchy -----------------------------------
       Parent tasks own the commitment; sub tasks distribute the work.
       Rendered flat, the two read as unrelated rows and the relationship
       -- which is the whole point of BRD §11/§12 -- has to be inferred
       from a parent id nobody can see.

       So the parent is the row, and its sub tasks are disclosed beneath
       it. Collapsed on load: a risk with four treatment tasks and a
       dozen sub tasks otherwise opens as a wall, and the reader wanted
       the four.

       The indent is drawn with a left border on the first cell rather
       than padding alone, so the child rows read as one group hanging
       off the parent instead of four separately-shifted rows. */
    .tw-toggle {
        background: none; border: 0; cursor: pointer; padding: 0 6px 0 0;
        color: #4a5568; font-size: 11px; line-height: 1;
    }
    .tw-toggle:hover { color: #2b6cb0; }
    .tw-toggle i { transition: transform .12s ease; display: inline-block; }
    .tw-toggle[aria-expanded="true"] i { transform: rotate(90deg); }

    /* Keeps the task number of a childless parent aligned with one that
       has a toggle -- otherwise the column looks ragged. */
    .tw-toggle-spacer { display: inline-block; width: 17px; }

    .risk-page tr.tw-parent.is-open > td { background: #f7fafc; }

    .risk-page tr.tw-sub > td { background: #fbfdff; }
    .risk-page tr.tw-sub > td:first-child {
        padding-left: 26px;
        box-shadow: inset 3px 0 0 #bee3f8;
    }
    .risk-page tr.tw-sub .tw-sub-mark { color: #90cdf4; margin-right: 4px; }

    /* Compact: the hierarchy adds rows, so each row gives some back.
       Only the treatment table -- the register grids are untouched. */
    .risk-page #twTable td,
    .risk-page #twTable th { padding-top: 5px; padding-bottom: 5px; }

    /* A child whose parent is not in this list (raised against a legacy
       candidate, say) has no toggle to reveal it, so it is never hidden
       and says why it is standing on its own. */
    .risk-page tr.tw-orphan > td:first-child { box-shadow: inset 3px 0 0 #fbd38d; }

</style>

@* ================= Map a practice (Practice Picker) ==================
   The four cascading dropdowns need real width. Inline in the scope
   panel they were squeezed into the narrow "mapped practices" column and
   the labels wrapped. A dialog gives them a full row each and keeps the
   scope panel to a single Map button, so no other column has to move.
   The picker itself is unchanged -- it is mounted into #riskMapPickerHost
   instead of into the panel. *@
<div class="pm-modal" id="riskMapPracticeModal" hidden>
    <div class="pm-modal-panel pm-modal-wide">
        <header>
            <h2>Map a practice</h2>
            <button class="pm-modal-close" type="button" data-close-map-practice aria-label="Close">&times;</button>
        </header>
        <p class="pm-hint">
            Choose the framework, then narrow down to the practice. Each list loads only
            what sits under the selection above it, so a large practice set is never
            fetched in one go. Practices already mapped to this risk are not offered.
        </p>
        <div id="riskMapPickerHost"></div>
        <p class="pm-form-message" id="riskMapPickerMessage" role="status" aria-live="polite"></p>
        <footer class="pm-modal-footer">
            <button type="button" class="pm-button" data-close-map-practice>Cancel</button>
            <button type="button" class="pm-button primary" id="riskMapPickerConfirm">
                <i class="fa-solid fa-link" aria-hidden="true"></i> Map practice
            </button>
        </footer>
    </div>
</div>

