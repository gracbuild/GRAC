@using PracticeManagement.Web.Models
@{
    ViewData["Title"] = "Home";
    var screens = ViewBag.Screens as PracticeScreen[] ?? Array.Empty<PracticeScreen>();
    // Home "My work" (change request 2026-09-27). Access flags come from
    // PracticeController.Dashboard -- the same permission check that
    // guards each section's detailed page.
    var access = ViewBag.HomeAccess as IDictionary<string, bool> ?? new Dictionary<string, bool>();
    bool Can(string key) => access.TryGetValue(key, out var allowed) && allowed;
    // repositoryUpdates (395) only adds attention items; on its own it does
    // not bring up the My work panel.
    var anyWork = access.Where(kv => !kv.Key.Equals("repositoryUpdates", StringComparison.OrdinalIgnoreCase)).Any(kv => kv.Value);
    var displayName = Convert.ToString(ViewBag.DisplayName) ?? "";
    var employeeId = Convert.ToString(ViewBag.EmployeeId) ?? "";
}

<section class="pm-page-heading compact pm-dashboard-heading">
    <div>
        <p class="pm-eyebrow">Home</p>
        <h1>@(string.IsNullOrWhiteSpace(displayName) ? "Welcome" : $"Welcome, {displayName}")</h1>
        <p>What needs your attention, then where the organization's practices stand.</p>
    </div>
    <label class="pm-dashboard-org-filter">
        <span>Organization</span>
        <select id="dashboardOrganization"><option value="">Loading organizations...</option></select>
    </label>
</section>

@* Home layout (change request 2026-09-29):
     Row 1 is a two-column grid -- My work on the left, the Organization
     overview on the right (expanded by default, its cards three across so
     the panel stays short). Row 2 is "Needs your attention", full width.
     The overview collapse control still narrows its column (width only,
     cards stay visible); when there is no My work access the section is a
     plain wrapper and the overview fills the width. My work data comes
     from the existing session-scoped APIs (wwwroot/js/home-my-work.js);
     the overview counts come from practice-dashboard.js. Only layout is
     changed -- no API, permission gate or calculation. *@
<section class="@(anyWork ? "pm-home-work" : null)" id="@(anyWork ? "homeMyWork" : null)"
         aria-label="My work and organization overview"
         data-employee-id="@(anyWork ? employeeId : null)"
         data-access-notifications="@(anyWork ? (Can("notifications") ? "1" : "0") : null)"
         data-access-tasks="@(anyWork ? (Can("tasks") ? "1" : "0") : null)"
         data-access-practices="@(anyWork ? (Can("practices") ? "1" : "0") : null)"
         data-access-approvals="@(anyWork ? (Can("approvals") ? "1" : "0") : null)"
         data-access-acknowledgements="@(anyWork ? (Can("acknowledgements") ? "1" : "0") : null)"
         data-access-repository-updates="@(anyWork ? (Can("repositoryUpdates") ? "1" : "0") : null)">
@if (anyWork)
{
    @* Left column: My work. (Needs your attention is a full-width row below.) *@
    <aside class="pm-panel pm-home-summary" aria-labelledby="homeSummaryHeading">
            <div class="pm-section-heading">
                <h2 id="homeSummaryHeading">My work</h2>
                <p>Everything assigned to you, by area.</p>
            </div>
            <ul class="pm-home-summary-list">
                @if (Can("notifications"))
                {
                    <li data-home-section="notifications">
                        <i class="fa-solid fa-bell" aria-hidden="true"></i>
                        <div><strong>Notifications</strong><span class="pm-home-detail" data-home-detail>Loading...</span></div>
                        <b class="pm-home-count" data-home-count>&ndash;</b>
                        <a href="@Url.Content("~/Practice/Index/my-notifications")" data-home-link>View all notifications</a>
                    </li>
                }
                @if (Can("tasks"))
                {
                    <li data-home-section="tasks">
                        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                        <div><strong>Tasks</strong><span class="pm-home-detail" data-home-detail>Loading...</span></div>
                        <b class="pm-home-count" data-home-count>&ndash;</b>
                        <a href="@Url.Content("~/Practice/Index/tasks")" data-home-link>Open Task Board</a>
                    </li>
                }
                @if (Can("practices"))
                {
                    <li data-home-section="practices">
                        <i class="fa-solid fa-network-wired" aria-hidden="true"></i>
                        <div><strong>Practice instances</strong><span class="pm-home-detail" data-home-detail>Loading...</span></div>
                        <b class="pm-home-count" data-home-count>&ndash;</b>
                        <a href="@Url.Content("~/Practice/Index/resolve")" data-home-link>View my practice instances</a>
                    </li>
                }
                @if (Can("approvals"))
                {
                    <li data-home-section="approvals">
                        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                        <div><strong>Approvals</strong><span class="pm-home-detail" data-home-detail>Loading...</span></div>
                        <b class="pm-home-count" data-home-count>&ndash;</b>
                        <a href="@Url.Content("~/Practice/Index/risk-centre-candidates")" data-home-link>Open approval queue</a>
                    </li>
                }
                @if (Can("acknowledgements"))
                {
                    <li data-home-section="acknowledgements">
                        <i class="fa-solid fa-file-signature" aria-hidden="true"></i>
                        <div><strong>Acknowledgements</strong><span class="pm-home-detail" data-home-detail>Loading...</span></div>
                        <b class="pm-home-count" data-home-count>&ndash;</b>
                        <a href="@Url.Content("~/Practice/Index/my-acknowledgements")" data-home-link>View my acknowledgements</a>
                    </li>
                }
            </ul>
        </aside>
}
    @* Organization overview: secondary and compact. Rendered once,
       unconditionally, so it is the section's only child (and fills the
       width) when there is no My work. *@
    <div class="pm-panel pm-home-org">
        <div class="pm-section-heading pm-home-org-heading">
            <div class="pm-home-org-heading-row">
                <button type="button" class="pm-home-org-toggle" id="homeOrgToggle"
                        aria-expanded="true" aria-controls="homeOrgBody"
                        aria-label="Collapse overview">
                    <i class="fa-solid fa-angles-right" aria-hidden="true"></i>
                </button>
                <h2>Overview</h2>
            </div>
            <p>Operational view of source statements, practices, instances, dependencies and evidence.</p>
        </div>
        <section class="pm-dashboard-kpi-grid" id="homeOrgBody" aria-label="Practice Management dashboard summaries">
            <article class="pm-dashboard-card" data-dashboard-section="controls">
                <div class="pm-dashboard-card-title"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><h2>Control Statements</h2></div>
                <div class="pm-dashboard-primary"><span data-summary="TotalOrganizationControls">0</span><small>Total</small></div>
                <div class="pm-mini-metrics">
                    <span><b data-summary="NotUpdatedControls">0</b> Not Updated</span>
                    <span><b data-summary="ApplicableControls">0</b> Applicable</span>
                    <span><b data-summary="NotApplicableControls">0</b> Not Applicable</span>
                    <span><b data-summary="DeferredControls">0</b> Deferred</span>
                    <span><b data-summary="AcceptedRiskControls">0</b> Accepted Risk</span>
                </div>
            </article>
            <article class="pm-dashboard-card" data-dashboard-section="practices">
                <div class="pm-dashboard-card-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i><h2>Practices</h2></div>
                <div class="pm-dashboard-primary"><span data-summary="TotalPractices">0</span><small>Total</small></div>
                <div class="pm-mini-metrics">
                    <span><b data-summary="ApplicablePractices">0</b> Applicable</span>
                    <span><b data-summary="NotUpdatedPractices">0</b> Not Updated</span>
                    <span><b data-summary="NotApplicablePractices">0</b> Not Applicable</span>
                </div>
            </article>
            <article class="pm-dashboard-card" data-dashboard-section="instances">
                <div class="pm-dashboard-card-title"><i class="fa-solid fa-network-wired" aria-hidden="true"></i><h2>Practice Instances</h2></div>
                <div class="pm-dashboard-primary"><span data-summary="TotalPracticeInstances">0</span><small>Total</small></div>
                <div class="pm-mini-metrics">
                    <span><b data-summary="ActivePracticeInstances">0</b> Active</span>
                    <span><b data-summary="CriticalPracticeInstances">0</b> Critical</span>
                    <span><b data-summary="InstancesWithoutOwner">0</b> No Owner</span>
                    <span><b data-summary="InstancesWithoutDependencies">0</b> No Dependencies</span>
                    <span><b data-summary="InstancesWithoutEvidenceConfiguration">0</b> No Evidence</span>
                </div>
            </article>
            <article class="pm-dashboard-card" data-dashboard-section="dependencies">
                <div class="pm-dashboard-card-title"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i><h2>Dependencies</h2></div>
                <div class="pm-dashboard-primary"><span data-summary="OpenDependencyMappingItems">0</span><small>Open Mapping</small></div>
                <div class="pm-mini-metrics">
                    <span><b data-summary="ToolDependencies">0</b> Tools</span>
                    <span><b data-summary="VendorDependencies">0</b> Vendors</span>
                    <span><b data-summary="ApplicationDependencies">0</b> Applications</span>
                    <span><b data-summary="AssetDependencies">0</b> Assets</span>
                    <span><b data-summary="PersonDependencies">0</b> People</span>
                </div>
            </article>
            <article class="pm-dashboard-card" data-dashboard-section="evidence">
                <div class="pm-dashboard-card-title"><i class="fa-solid fa-file-circle-check" aria-hidden="true"></i><h2>Evidence</h2></div>
                <div class="pm-dashboard-primary"><span data-summary="EvidenceConfiguredCount">0</span><small>Configured</small></div>
                <div class="pm-mini-metrics">
                    <span><b data-summary="EvidenceNotConfiguredCount">0</b> Not Configured</span>
                    <span><b data-summary="AlignedEvidence">0</b> Aligned</span>
                    <span><b data-summary="EnhancedEvidence">0</b> Enhanced</span>
                    <span><b data-summary="NotAlignedEvidence">0</b> Not Aligned</span>
                </div>
            </article>
            <article class="pm-dashboard-card" data-dashboard-section="resolve">
                <div class="pm-dashboard-card-title"><i class="fa-solid fa-arrows-spin" aria-hidden="true"></i><h2>Resolve Status</h2></div>
                <div class="pm-dashboard-primary"><span data-summary="PendingResolveItems">0</span><small>Pending</small></div>
                <div class="pm-mini-metrics">
                    <span><b data-summary="ResolvedItems">0</b> Resolved</span>
                    <span><b data-summary="PartiallyResolvedItems">0</b> Partial</span>
                    <span><b data-summary="OpenDependencyMappingItems">0</b> Open Mapping</span>
                </div>
            </article>
        </section>
    </div>
</section>

@if (anyWork)
{
    @* Row 2: Needs your attention -- full width, below the two-column row. *@
    <article class="pm-panel pm-home-attention">
        <div class="pm-section-heading">
            <h2>Needs your attention</h2>
            <p>Overdue and due-soon work assigned to you, unread alerts and items waiting on you &mdash; most urgent first.</p>
        </div>
        <div class="pm-attention-list is-empty" id="homeAttentionList">
            <div class="pm-empty compact">Loading your work...</div>
        </div>
        <p class="pm-home-footnote" id="homeAttentionMore" hidden></p>
    </article>
}

@section Scripts {
    <script>window.pmApi="@ViewBag.ApiBaseUrl";</script>
    @* home-my-work.js first: it listens for the organization practice-dashboard.js publishes. *@
    <script src="~/js/home-my-work.js" asp-append-version="true"></script>
    <script src="~/js/practice-dashboard.js" asp-append-version="true"></script>
    @* Organization overview collapse/expand -- same chevron pattern as the
       Risk Centre / mapping trees: fa-chevron-down when open, -right when
       closed; only the cards (#homeOrgBody) hide, the heading stays. *@
    <script>
        (function () {
            var btn = document.getElementById("homeOrgToggle");
            var body = document.getElementById("homeOrgBody");
            // The grid host: collapsing narrows the overview column so the
            // panel expands toward / away from the left. Absent when the user
            // has no My work (overview is already full width).
            var grid = document.getElementById("homeMyWork");
            if (!btn || !body) return;
            btn.addEventListener("click", function () {
                var open = btn.getAttribute("aria-expanded") === "true";
                var next = !open;
                btn.setAttribute("aria-expanded", next ? "true" : "false");
                btn.setAttribute("aria-label", next ? "Collapse overview" : "Expand overview");
                var icon = btn.querySelector("i");
                if (icon) {
                    // angles-right when expanded (click collapses to the
                    // right); angles-left when collapsed (click expands left).
                    icon.classList.toggle("fa-angles-right", next);
                    icon.classList.toggle("fa-angles-left", !next);
                }
                // Width-only collapse: the cards stay visible (reflowing to a
                // single column), so the panel keeps its height.
                if (grid) grid.classList.toggle("org-collapsed", !next);
            });
        })();
    </script>
}
