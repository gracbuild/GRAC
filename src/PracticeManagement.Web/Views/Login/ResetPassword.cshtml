@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model PracticeManagement.Web.Models.ResetPasswordViewModel
@{
    Layout = null;
    // Forgot password (migration 529, 2026-11-10): the page the emailed
    // link opens. Same explicit action construction as ChangePassword.cshtml.
    var pathBase = Context.Request.PathBase.Value?.TrimEnd('/') ?? "";
    var isOrgMgmt = string.Equals(Configuration["Module:Key"], "OrganizationManagement", StringComparison.OrdinalIgnoreCase)
        || string.Equals(pathBase, "/OrganizationManagement", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrEmpty(pathBase) && Context.Request.Path.StartsWithSegments("/OrganizationManagement", StringComparison.OrdinalIgnoreCase));
    var loginRoot = isOrgMgmt && string.IsNullOrEmpty(pathBase)
        ? "/OrganizationManagement/Login"
        : $"{pathBase}/Login";
    var resetAction = $"{loginRoot}/ResetPassword";
    var forgotUrl = $"{loginRoot}/ForgotPassword";
    var minimumLength = Configuration.GetValue("UserProvisioning:MinimumPasswordLength", 8);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>GRAC | Reset password</title>
    <link rel="icon" type="image/x-icon" href="~/css/Images/favicon.ico" />
    @* GRAC design tokens -- must load before every other stylesheet. *@
    <link rel="stylesheet" href="~/css/grac-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/FrontEnd/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/FrontEnd/plugins/icheck-bootstrap/icheck-bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/sweet-alert.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/FrontEnd/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cacca-styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-split">
    <div id="Loader" class="div-loader" style="display:none;">
        <div class="loader"></div>
    </div>

    <div class="login-wrapper">
        <div class="split-card">
            @* Brand side shared with Index / ChangePassword (_BrandPanel). *@
            <partial name="_BrandPanel" />

            <div class="form-panel">
                <div class="form-card">
                    <div class="greeting">
                        <h1>Reset password</h1>
                    </div>

                    @if (Model.LinkInvalid)
                    {
                        <p class="validation-message" role="alert">
                            This password reset link is invalid or has expired. Links work once and only for a short time.
                        </p>
                        <a class="btn btn-signin mt-4 d-flex align-items-center justify-content-center" href="@forgotUrl">Request a new link</a>
                    }
                    else
                    {
                        <form action="@resetAction" method="post" id="ResetPasswordForm" novalidate>
                            @Html.AntiForgeryToken()
                            <input asp-for="Token" type="hidden" />
                            <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>

                            <div class="form-group mb-3">
                                <label class="form-label" for="resetAccount">Account</label>
                                <input id="resetAccount" type="text" class="form-control" value="@Model.Account" autocomplete="username" readonly />
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="NewPassword" class="form-label">New Password</label>
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="At least @minimumLength characters" autocomplete="new-password" tabindex="1" autofocus />
                                <span asp-validation-for="NewPassword" class="validation-message"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter the new password" autocomplete="new-password" tabindex="2" />
                                <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
                            </div>

                            <button type="submit" id="btnResetPassword" class="btn btn-signin mt-4" tabindex="3">Save password</button>
                        </form>
                    }

                    <div class="login-back">
                        <a class="forgot-link" href="@loginRoot" tabindex="4"><i class="fas fa-arrow-left" aria-hidden="true"></i>&nbsp;Back to sign in</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/FrontEnd/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/FrontEnd/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/FrontEnd/dist/js/adminlte.min.js"></script>
    <script src="~/js/crypto-js.min.js"></script>
    <script src="~/js/sweet-alert.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
