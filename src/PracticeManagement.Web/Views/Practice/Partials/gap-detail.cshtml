@*
    Gap Detail  (Gap Centre v2 -- simplified lifecycle, migration 174)
    Rendered from Manage.cshtml when Model.Key == "gap-detail".

    Route: /Practice/Index/gap-detail?gapId=NNN

    Layout (single column):
      - Top toolbar: back link, state chip, compact stepper pills, refresh
      - Action strip: only Mark Duplicate is offered as a clickable
        action here -- Mark Invalid exists identically at the lifecycle/
        API layer (sp_custom_gap_lifecycle_transition, action_code
        'MarkInvalid') but its button is deliberately hidden from this
        UI on request; nothing server-side changed. "Analyse" happens
        implicitly via the Save Analysis button; auto-transition to
        Delegated fires server-side after save succeeds.
      - Tabs: Analysis, Metadata (History moved inside Metadata as a
        compact timeline). A third Practice Instance tab embedding
        resolve-workspace via iframe was tried (321) and dropped in
        favour of a plain "View Practice Instance" link at the top of
        the Analysis tab (still 321-sourced: PracticeInstanceId off the
        gap header) -- same destination gaps.cshtml's row menu already
        opens, just not framed.
      - Analysis tab: Practice Instance link (when the gap has one) +
        form + linked-artefacts chip strip that appears below the form
        and shows the Task / Exception / Risk auto-created when analysis
        was saved.
      - Decision checkboxes (migration 323): Generate Task / Request
        Exception / Create Risk, each independent -- any combination,
        including all three or none. Replaces the 168 model of two
        mandatory Yes/No dropdowns (Remediation possible? / Is there a
        business Risk?) that forced exactly one of Task/Exception and
        gated Risk on a second, separate decision. No schema change --
        these bind straight to custom_gap_analysis.recommend_task/
        recommend_exception/recommend_risk, which is what those columns
        meant before 168 added the branching this migration removes.
      - Downstream tab / #dsAddModal / Left-side pane / Link Artefact
        top button REMOVED (sir's full simplification). Task, Exception
        and Risk all auto-create in their respective Centres from the
        analysis decisions -- no manual linking needed.

    Every write path stamps caller identity server-side (Web tier),
    never trusts the browser field.
*@
@model PracticeManagement.Web.Models.PracticeScreen

<div class="pm-page-heading compact">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1 id="gapDetailTitle">Gap Details</h1>
        <p id="gapDetailSubtitle">Validate, analyse, delegate.</p>
    </div>
</div>

<section class="pm-panel" id="gapDetailRoot" hidden>

    <div class="pm-toolbar gap-detail-toolbar">
        <a class="pm-button" href="~/Practice/Index/gaps">
            <i class="fa-solid fa-arrow-left"></i> Back to Gap Centre
        </a>
        @* Migration 325. The read-only "everything about this gap"
           companion page -- full details plus Task/Exception/Risk cards.
           Built once gapDetailLoaded() knows the gap id + org. *@
        <a class="pm-button" id="gapOpenViewLink" href="#" hidden>
            <i class="fa-solid fa-circle-info"></i> Gap View
        </a>
        @* Compact horizontal stepper -- current state is highlighted so a
           standalone chip is redundant. JS labels states by display name
           (state_code 'Delegated' shows as 'Analysed' per migration 175). *@
        <div class="gap-stepper-compact" id="gapStepperCompact" aria-label="Gap lifecycle"></div>
        <button class="pm-button icon" id="gapDetailRefresh" type="button" title="Refresh" aria-label="Refresh">
            <i class="fa-solid fa-arrows-rotate"></i>
        </button>
    </div>

    @* Available actions strip. JS populates with the transitions the
       current state allows (Mark Invalid, Mark Duplicate, sometimes
       nothing). Auto-hidden in terminal states. *@
    <div class="gap-action-strip" id="gapActionStrip"></div>

    @* Read-only banner (from 173). Kept identical. *@
    <div id="gapTerminalInvalidBanner" class="gap-terminal-banner" hidden>
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <div>
            <strong id="gapTerminalInvalidTitle">This gap is closed to further analysis.</strong>
            <p id="gapTerminalInvalidText">
                The gap was marked as Invalid or Duplicate during validation.
                Analysis and downstream artefacts are not applicable. Data
                below (if any) is kept read-only for audit.
            </p>
        </div>
    </div>

    @* Migration 324: "already Analysed" read-only banner -- request C
       part 2 ("Show View only. Hide/disable Analyse."). A friendlier,
       green counterpart to the red terminal-invalid banner above: being
       Analysed is the successful outcome, not a problem. Shown/hidden
       and the form locked by the SAME applyTerminalInvalidMode() in
       gap-detail.js that already handles Invalid/Duplicate -- this is
       reuse, not a second lock mechanism. The server enforces the same
       rule independently (sp_custom_gap_analysis_save THROWs 55143 on a
       second save), so this banner is a courtesy, not the only guard. *@
    <div id="gapAlreadyAnalysedBanner" class="gap-analysed-banner" hidden>
        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        <div>
            <strong>This gap has already been analysed.</strong>
            <p>
                You are viewing the saved analysis below in read-only mode.
                Generate Task / Request Exception / Create Risk cannot be
                re-triggered from here -- use the linked artefacts strip
                below the form to open what was already created.
            </p>
        </div>
    </div>

    @* Migration 367: "blocked pending obligations/Operationalization"
       read-only banner. Amber, between the red terminal-invalid banner
       and the green already-Analysed banner in severity -- this gap is
       still fully open and expected to be worked on, just not ready for
       Analysis yet. Shown/hidden and the form locked by the SAME
       applyTerminalInvalidMode() in gap-detail.js that already handles
       the two banners above -- reuse, not a third lock mechanism. The
       server enforces the same rule independently
       (sp_custom_gap_analysis_save THROWs 55144/55145), so this banner
       is a courtesy, not the only guard. Only ever shown for a gap
       materialized from a Practice Instance -- see
       isBlockedByUnresolvedObligations() in gap-detail.js. *@
    <div id="gapObligationsBlockedBanner" class="gap-obligations-blocked-banner" hidden>
        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
        <div>
            <strong>This gap cannot be analysed yet.</strong>
            <p id="gapObligationsBlockedText">
                @* Migration 372: placeholder text only -- always overwritten by
                   applyTerminalInvalidMode() in gap-detail.js before this banner
                   is ever shown, to match the live Not-Set/Operationalized count. *@
                Analysis is blocked until every obligation displayed below has
                been assessed (Not Set) and the related Practice has been
                Operationalized.
            </p>
        </div>
    </div>

    @* Compact duplicate-parent strip. Full parent analysis is rendered
       into the Analysis tab (below) since the current gap has no
       analysis of its own; showing it in the disabled form fields
       avoids duplicating the same data twice on the page. *@
    <div id="gapDuplicateCard" class="gap-duplicate-strip" hidden>
        <i class="fa-solid fa-clone" aria-hidden="true"></i>
        <div>
            <strong>Duplicate of <a id="gapDuplicateParentLink" href="#"></a></strong>
            <p class="pm-hint">The analysis shown below is the parent gap's -- this gap has no analysis of its own.</p>
        </div>
    </div>

    @* Invalid rationale card (also 177). Shown when the current gap is
       Invalid; renders the reason captured at mark-invalid time. *@
    <div id="gapInvalidReasonCard" class="gap-invalid-card" hidden>
        <strong>Invalid rationale</strong>
        <p id="gapInvalidReasonText"></p>
    </div>

    @* SLA banner (migration 184). Populated by gap-detail.js from the
       gap header once loaded. Shows the auto-matched or overridden SLA
       for this gap and exposes the Override action. Hidden when the gap
       has no severity_code (nothing to match against). *@
    <div id="gapSlaCard"
         style="display:none; margin:12px 0; padding:10px 14px; border:1px solid #cbd5e1; border-radius:8px; background:#f8fafc;">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-size:13px; color:#0f172a;">
                <span id="gapSlaSourceBadge" class="pm-badge"
                      style="background:#dcfce7; color:#166534; padding:2px 8px; border-radius:12px; font-size:11px; font-weight:600;">Auto</span>
                <strong id="gapSlaMasterName">--</strong>
                <span id="gapSlaDaysText" style="color:#475569;">-- days</span>
                <span id="gapSlaDueText" style="color:#475569;"></span>
                <span id="gapSlaPendingHint" style="color:#78350f; font-size:12px;" hidden>
                    <i class="fa-solid fa-clock" aria-hidden="true"></i>
                    Override request pending approval.
                </span>
            </div>
            <button type="button" id="gapSlaOverrideBtn" class="pm-button">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> Override SLA
            </button>
        </div>
    </div>

    <div class="pm-tabs" role="tablist" aria-label="Gap detail tabs">
        <button role="tab" class="active" data-tab="analysis" aria-selected="true">Analysis</button>
        <button role="tab" data-tab="metadata" aria-selected="false">Metadata &amp; History</button>
    </div>

    <div class="pm-tab-panel" data-panel="analysis">
        @* Migration 321, simplified. An iframe embed (tried first) hit
           connectivity issues an ordinary link doesn't -- this is a
           plain "open in a new tab" link instead, same destination
           (resolve-workspace, ?mode=view) gaps.cshtml's row menu
           already uses. Shown only when the header resolves a
           PracticeInstanceId -- Custom/Assurance gaps and an
           un-materialized Implementation row have nothing to link to. *@
        <p class="pm-hint gap-instance-link-wrap" id="gapInstanceLinkWrap" hidden>
            <a id="gapInstanceLink" href="#" target="_blank" rel="noopener">
                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> View Practice Instance
            </a>
        </p>

        @* Obligations to Resolve -- migration 317, broadened by 367.
           Shown only for an automatically generated gap (materialized
           from a Practice Instance) -- a manually created gap has
           nothing to show here and this strip stays hidden for it. Since
           367, lists every obligation currently displayed under the gap
           (Not Implemented, Partially Implemented, and Not Set/Not
           Started) -- not only the one whose failure originally raised
           it -- because Gap Analysis is blocked (55144) until every one
           of them is resolved. Populated by refreshLinkedArtefacts() in
           gap-detail.js from the SAME /linked-artefacts call the
           Task/Exception/Risk chips already use
           (result.failedObligations), so this is one round trip, not a
           second one. Placed above the analysis form so the analyst sees
           WHY the gap exists, and what is still outstanding, before
           filling it in. *@
        <div class="gap-failed-obligations-strip" id="gapFailedObligationsStrip" hidden>
            <h3>Obligations to Resolve</h3>
            <p class="pm-hint">The Obligation(s) under this Practice that are not yet Implemented. All of them must be resolved -- and the Practice Operationalized -- before this gap can be analysed.</p>
            <div class="gap-linked-chips" id="gapFailedObligationsChips"></div>
        </div>

        <form id="gapAnalysisForm" novalidate>
            <div class="pm-form-grid">
                <label>
                    <span>Detection Method</span>
                    <select id="anDetectionMethodCode">
                        <option value="">--</option>
                        <option value="Manual">Manual</option>
                        <option value="Assurance">Assurance observation</option>
                        <option value="Audit">Audit finding</option>
                        <option value="AutoScan">Automated scan</option>
                        <option value="External">External report</option>
                    </select>
                </label>
                <label>
                    @* Severity is now auto-derived at gap creation time
                       (post-187 for Implementation, always for
                       Assurance, and post-189 for Custom via priority).
                       Locked read-only in the analysis form so an
                       analyst does not accidentally break the SLA
                       auto-match by editing it. If a genuine
                       reclassification is needed, do it via the source
                       (practice_instance.criticality / observation /
                       custom-gap priority). *@
                    <span>Severity <small style="color:#94a3b8; font-weight:normal;">(auto)</small></span>
                    @* Explicit disabled="disabled" -- Razor/HTML sanitisers
                       sometimes strip boolean attributes when they carry
                       no value. Belt-and-suspenders JS lock lives in
                       gap-detail.js applyAnalysisToForm(). *@
                    <select id="anSeverityCode"
                            disabled="disabled"
                            aria-disabled="true"
                            style="background:#f1f5f9; color:#475569; cursor:not-allowed;"
                            title="Severity is auto-derived from the gap source. Not editable here.">
                        <option value="">--</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </label>
                <label>
                    <span>Business Impact</span>
                    <select id="anBusinessImpactCode">
                        <option value="">--</option>
                        <option value="None">None</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </label>
                <label>
                    <span>Regulatory Impact</span>
                    <select id="anRegulatoryImpactCode">
                        <option value="">--</option>
                        <option value="None">None</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </label>
                <label class="pm-form-grid-full">
                    <span>Business Impact Summary</span>
                    <textarea id="anBusinessImpactSummary" rows="2" maxlength="5000"></textarea>
                </label>
                <label class="pm-form-grid-full">
                    <span>Regulatory Impact Summary</span>
                    <textarea id="anRegulatoryImpactSummary" rows="2" maxlength="5000"></textarea>
                </label>
                @* RCA is optional. The tick opens a dedicated card below;
                   before the tick the RCA / Corrective / Preventive
                   inputs are not part of the form at all -- so an analyst
                   who does not need RCA is not looking at an empty grid.
                   RCA Method dropdown retired: the taxonomy was noise on
                   an already-optional workflow.

                   The tick row spans BOTH columns of the outer grid so
                   the RCA card can open right below it edge-to-edge,
                   rather than starting at the right half. *@
                <label class="pm-rca-tick-row">
                    <input type="checkbox" id="anRcaRequired" />
                    <span>RCA Required</span>
                    <span class="pm-rca-hint">Tick to record root cause + corrective / preventive actions</span>
                </label>
                <fieldset class="pm-rca-block" id="anRcaBlock" hidden>
                    <legend>Root cause analysis</legend>
                    <div class="pm-form-grid">
                        <label class="full">
                            <span>RCA Summary</span>
                            <textarea id="anRcaSummary" rows="3" maxlength="10000"
                                      placeholder="The reason this gap arose."></textarea>
                        </label>
                        <label>
                            <span>Corrective Action</span>
                            @* Renamed from "Recommended Action Summary".
                               Same store column; only the label + id change.
                               Feeds the auto-created Task / Exception /
                               Risk artefacts on save. *@
                            <textarea id="anCorrectiveAction" rows="3" maxlength="10000"
                                      placeholder="What we will do to fix the specific gap."></textarea>
                        </label>
                        <label>
                            <span>Preventive Action</span>
                            @* New free-text column added by migration 249. *@
                            <textarea id="anPreventiveAction" rows="3" maxlength="10000"
                                      placeholder="Change to controls / process so this class of gap does not recur."></textarea>
                        </label>
                    </div>
                </fieldset>
                @* Migration 323: three independent decisions, replacing the
                   168 Remediation-possible/business-Risk Yes-No dropdowns
                   (which forced exactly one of Task/Exception and coupled
                   Risk to a second, separate Yes/No). Each checkbox here
                   is its own decision -- any combination, including all
                   three or none, is valid. They map 1:1 onto
                   recommend_task/recommend_exception/recommend_risk,
                   which is where this app started (156) before 168 added
                   the branching; this migration removes that branching
                   rather than adding new columns. None is required --
                   an analyst who has nothing to trigger yet just saves
                   the analysis with all three unchecked. *@
                <div class="pm-decision-checkboxes" id="gapDecisionChecks">
                    <label class="pm-decision-check">
                        <input type="checkbox" id="anGenerateTask" />
                        <span>Generate Task</span>
                    </label>
                    <label class="pm-decision-check">
                        <input type="checkbox" id="anRequestException" />
                        <span>Request Exception</span>
                    </label>
                    <label class="pm-decision-check">
                        <input type="checkbox" id="anCreateRisk" />
                        <span>Create Risk</span>
                    </label>
                </div>
            </div>
            <p class="pm-form-message" id="anMessage" role="status" aria-live="polite"></p>
            <div class="pm-toolbar" style="justify-content: flex-end;">
                <button type="submit" class="pm-button primary">
                    <i class="fa-solid fa-save"></i> Save Analysis
                </button>
            </div>
        </form>

        @* Linked artefacts chip strip -- one row per Task/Exception/Risk
           auto-created for this gap. Populated by JS from
           /gaps/{id}/linked-artefacts after every analysis save. *@
        <div class="gap-linked-strip" id="gapLinkedArtefactsStrip" hidden>
            <h3>Linked artefacts</h3>
            <div class="gap-linked-chips" id="gapLinkedArtefactsChips"></div>
        </div>
    </div>

    <div class="pm-tab-panel" data-panel="metadata" hidden>
        <dl class="gap-detail-meta" id="gapDetailMetadata"></dl>

        @*
            BRD §15 — the source displays the tasks it generated, and §14's
            task-action status line. Filled by renderRelatedTasks() in
            gap-detail.js via the shared panel below; a gap with no task
            work renders an explicit empty state rather than nothing.
        *@
        <div id="gapRelatedTasks" style="margin-top:14px;"></div>

        <div class="gap-history-compact">
            <h3>Lifecycle history</h3>
            <ul id="gapHistoryList"><li class="pm-hint">Loading...</li></ul>
        </div>
    </div>

</section>

@* Shared across Gap / Risk / Observation — see the partial's header. *@
<partial name="Partials/_related-tasks-panel" />

@* ---- action-confirmation modal (Mark Invalid / Mark Duplicate) ---- *@
<div class="pm-modal" id="gapActionModal" hidden>
    <div class="pm-modal-panel">
        <header>
            <h2 id="gapActionModalTitle">Confirm action</h2>
            <button class="pm-modal-close" type="button" data-close-gap-action aria-label="Close">&times;</button>
        </header>
        <form id="gapActionForm">
            <input type="hidden" id="gapActionCode" />
            <div class="pm-form-grid">
                <label class="pm-form-grid-full" id="gapActionDuplicateWrap" hidden>
                    <span>Duplicate of <span class="pm-required">*</span></span>
                    <select id="gapActionDuplicateOfId">
                        <option value="">-- select the gap this duplicates --</option>
                    </select>
                    <span class="pm-hint" id="gapActionDuplicateOfHint"></span>
                </label>
                <label class="pm-form-grid-full" id="gapActionRemarkWrap">
                    <span>Remark <span id="gapActionRemarkHint" class="pm-hint"></span></span>
                    <textarea id="gapActionRemark" rows="3" maxlength="5000"></textarea>
                </label>
                <label class="pm-form-grid-full" id="gapActionInvalidWrap" hidden>
                    <span>Invalid reason <span class="pm-required">*</span></span>
                    <input type="text" id="gapActionInvalidReason" maxlength="1000" />
                </label>
            </div>
            <p class="pm-form-message" id="gapActionMessage" role="status" aria-live="polite"></p>
            <footer class="pm-modal-footer">
                <button type="button" class="pm-button" data-close-gap-action>Cancel</button>
                <button type="submit" class="pm-button primary">Confirm</button>
            </footer>
        </form>
    </div>
</div>

<style>
    /* --- Gap Centre v2 detail (simplified) --- */
    .gap-detail-toolbar { align-items: center; gap: 10px; flex-wrap: wrap; }

    /* RCA card. The parent .pm-form-grid is 2 columns; the fieldset
       spans both, sits as its own card with an inset background so it
       reads as a subsection rather than a naked form region. The inner
       grid is a plain 2-col that collapses to 1-col on narrow widths,
       matching how the outer form behaves. */
    .pm-rca-block {
        grid-column: 1 / -1;
        margin: 4px 0 4px;
        padding: 14px 16px 12px;
        border: 1px solid #cbd5e0;
        border-radius: 8px;
        background: #f7fafc;
    }
    .pm-rca-block > legend {
        padding: 0 6px;
        font-size: 12px; font-weight: 700; letter-spacing: 0.04em;
        text-transform: uppercase; color: #2d3748;
    }
    .pm-rca-block .pm-form-grid { gap: 10px 14px; }
    .pm-rca-block textarea { background: #fff; }
    /* One-column at narrow widths; the outer 2-col grid does the same. */
    @@media (max-width: 900px) {
        .pm-rca-block .pm-form-grid { grid-template-columns: 1fr; }
    }
    /* Small "since ticked" hint next to the checkbox so the operator
       sees why the block appeared -- no separate row needed. */
    .pm-rca-tick-row {
        grid-column: 1 / -1;
        display: flex; align-items: center; gap: 8px;
        margin: 0;
    }
    .pm-rca-tick-row > input[type="checkbox"] { margin: 0; }
    .pm-rca-tick-row > .pm-rca-hint {
        font-size: 11px; color: #718096;
    }

    /* Migration 323: three independent decision checkboxes (Generate
       Task / Request Exception / Create Risk), replacing the two
       mandatory Yes/No dropdowns. Same card treatment as .pm-rca-block
       so it reads as its own decision area, not a plain form row. */
    .pm-decision-checkboxes {
        grid-column: 1 / -1;
        display: flex; flex-wrap: wrap; gap: 10px 22px;
        margin: 4px 0 4px;
        padding: 12px 16px;
        border: 1px solid #cbd5e0;
        border-radius: 8px;
        background: #f7fafc;
    }
    .pm-decision-checkboxes .pm-decision-check {
        display: flex; align-items: center; gap: 8px;
        font-weight: 600; color: #2d3748;
        cursor: pointer;
    }
    .pm-decision-checkboxes .pm-decision-check input[type="checkbox"] { margin: 0; }

    /* Compact horizontal stepper -- shows only active states, current
       state highlighted. Terminal-invalid states render red. */
    .gap-stepper-compact {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 8px; background: #f7fafc; border-radius: 999px;
        font-size: 11px; color: #4a5568;
    }
    .gap-stepper-compact .step {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 2px 8px; border-radius: 999px;
    }
    .gap-stepper-compact .step.past    { color: #22543d; }
    .gap-stepper-compact .step.current { background: #bee3f8; color: #2c5282; font-weight: 700; }
    .gap-stepper-compact .step.terminal-invalid { background: #fed7d7; color: #742a2a; font-weight: 700; }
    .gap-stepper-compact .sep { color: #cbd5e0; }

    .gap-action-strip {
        display: flex; flex-wrap: wrap; gap: 6px;
        padding: 12px 16px; margin-bottom: 12px;
        background: #edf2f7; border: 1px solid #cbd5e0; border-radius: 6px;
    }
    .gap-action-strip:empty { display: none; }
    .gap-action-strip::before {
        content: "Actions:"; font-size: 11px; font-weight: 600;
        color: #4a5568; text-transform: uppercase; letter-spacing: 0.02em;
        align-self: center; margin-right: 8px;
    }

    .gap-detail-meta {
        display: grid; grid-template-columns: 140px 1fr; row-gap: 6px; column-gap: 12px;
        margin: 0 0 16px 0; padding: 12px 14px; background: #f7fafc; border-radius: 6px; font-size: 13px;
    }
    .gap-detail-meta dt { color: #718096; font-weight: 600; margin: 0;
                          text-transform: uppercase; font-size: 11px; align-self: center; }
    .gap-detail-meta dd { margin: 0; color: #2d3748; word-break: break-word; }

    /* Practice Instance link (321) -- plain "open in a new tab" line
       above the analysis form; no dedicated tab/panel any more.
       Right-aligned within its own row on request -- same position,
       just pushed to the right edge instead of sitting flush left. */
    .gap-instance-link-wrap { margin: 0 0 14px; text-align: right; }
    .gap-instance-link-wrap a { font-weight: 600; }

    /* History compact -- lives inside Metadata tab now. */
    .gap-history-compact h3 { font-size: 12px; text-transform: uppercase; color: #718096;
                              margin: 16px 0 8px 0; letter-spacing: 0.02em; }
    .gap-history-compact ul { list-style: none; padding: 0; margin: 0; font-size: 12px; }
    .gap-history-compact li { padding: 6px 10px; border-bottom: 1px dashed #e2e8f0; }

    /* Linked artefacts chips -- one card per Task/Exception/Risk. */
    .gap-linked-strip { margin-top: 20px; padding-top: 16px; border-top: 1px solid #e2e8f0; }
    .gap-linked-strip[hidden] { display: none !important; }
    .gap-linked-strip h3 { font-size: 12px; text-transform: uppercase; color: #718096;
                           margin: 0 0 10px 0; letter-spacing: 0.02em; }
    .gap-linked-chips { display: flex; flex-wrap: wrap; gap: 10px; }
    .gap-linked-chip {
        display: flex; flex-direction: column; gap: 4px;
        padding: 10px 14px; border: 1px solid #cbd5e0; border-radius: 6px;
        background: #fff; min-width: 220px; text-decoration: none; color: inherit;
        transition: box-shadow 0.15s ease;
    }
    .gap-linked-chip:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); border-color: #3182ce; }
    .gap-linked-chip .chip-type {
        font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
        color: #718096;
    }
    .gap-linked-chip.type-task      .chip-type { color: #2c5282; }
    .gap-linked-chip.type-exception .chip-type { color: #744210; }
    .gap-linked-chip.type-risk      .chip-type { color: #742a2a; }
    .gap-linked-chip.type-obligation .chip-type { color: #9b2c2c; }
    .gap-linked-chip .chip-title  { font-size: 13px; font-weight: 600; color: #2d3748; }
    .gap-linked-chip .chip-status {
        display: inline-block; align-self: flex-start; padding: 2px 8px; border-radius: 999px;
        font-size: 10px; font-weight: 700; text-transform: uppercase;
        background: #edf2f7; color: #4a5568;
    }
    /* Failed Obligation(s) strip -- migration 317. Same chip shape as the
       Task/Exception/Risk strip below (.gap-linked-chip, reused rather
       than duplicated), its own heading and a warm-red chip-status so a
       "Not Implemented" / "Partially Implemented" tag reads as the
       problem it is rather than a neutral state label. Placed above the
       Analysis form instead of near the other strip -- this is the cause
       of the gap, not something the gap created. */
    .gap-failed-obligations-strip { margin: 0 0 20px; }
    .gap-failed-obligations-strip[hidden] { display: none !important; }
    .gap-failed-obligations-strip h3 { font-size: 12px; text-transform: uppercase; color: #718096;
                           margin: 0 0 4px 0; letter-spacing: 0.02em; }
    .gap-failed-obligations-strip .pm-hint { margin: 0 0 10px; }
    .gap-linked-chip.type-obligation .chip-status {
        background: #fff5f5; color: #9b2c2c;
    }

    .gap-state-chip {
        display: inline-block; padding: 4px 10px; border-radius: 999px;
        font-size: 12px; font-weight: 600;
    }
    .gap-state-chip.state-new { background: #edf2f7; color: #4a5568; }
    .gap-state-chip.state-validation, .gap-state-chip.state-analysis { background: #fefcbf; color: #744210; }
    .gap-state-chip.state-delegated { background: #c6f6d5; color: #22543d; }
    .gap-state-chip.state-invalid, .gap-state-chip.state-duplicate { background: #fed7d7; color: #742a2a; }
    /* Dormant states (retained for historical gaps) */
    .gap-state-chip.state-resolutionplanning,
    .gap-state-chip.state-execution,
    .gap-state-chip.state-verification { background: #e9d8fd; color: #553c9a; }
    .gap-state-chip.state-closed { background: #c6f6d5; color: #22543d; }

    /* Read-only banner (from 173). */
    .gap-terminal-banner {
        display: flex; align-items: flex-start; gap: 12px;
        background: #fff5f5; border: 1px solid #fc8181; color: #742a2a;
        border-radius: 6px; padding: 12px 14px; margin: 12px 0;
    }
    .gap-terminal-banner[hidden] { display: none !important; }
    .gap-terminal-banner i { font-size: 18px; padding-top: 2px; }
    .gap-terminal-banner strong { display: block; font-size: 14px; margin-bottom: 4px; }
    .gap-terminal-banner p { margin: 0; font-size: 12px; line-height: 1.5; }

    /* Already-Analysed read-only banner (migration 324). Same layout as
       .gap-terminal-banner above, green instead of red -- being Analysed
       is the successful outcome, not a problem. */
    .gap-analysed-banner {
        display: flex; align-items: flex-start; gap: 12px;
        background: #f0fff4; border: 1px solid #9ae6b4; color: #22543d;
        border-radius: 6px; padding: 12px 14px; margin: 12px 0;
    }
    .gap-analysed-banner[hidden] { display: none !important; }
    .gap-analysed-banner i { font-size: 18px; padding-top: 2px; }
    .gap-analysed-banner strong { display: block; font-size: 14px; margin-bottom: 4px; }
    .gap-analysed-banner p { margin: 0; font-size: 12px; line-height: 1.5; }

    /* Blocked-pending-obligations/Operationalization banner (migration
       367). Same layout as .gap-terminal-banner/.gap-analysed-banner
       above, amber -- this gap is still open and expected to be worked
       on, not a terminal state and not yet a success. */
    .gap-obligations-blocked-banner {
        display: flex; align-items: flex-start; gap: 12px;
        background: #fffbeb; border: 1px solid #fbd38d; color: #7b341e;
        border-radius: 6px; padding: 12px 14px; margin: 12px 0;
    }
    .gap-obligations-blocked-banner[hidden] { display: none !important; }
    .gap-obligations-blocked-banner i { font-size: 18px; padding-top: 2px; }
    .gap-obligations-blocked-banner strong { display: block; font-size: 14px; margin-bottom: 4px; }
    .gap-obligations-blocked-banner p { margin: 0; font-size: 12px; line-height: 1.5; }

    /* Compact duplicate strip (from 177 -- simplified per sir).
       Parent gap link + hint; the parent analysis populates the
       (disabled) Analysis form fields below to avoid duplication. */
    .gap-duplicate-strip {
        display: flex; align-items: flex-start; gap: 12px;
        margin: 12px 0; padding: 10px 14px;
        border: 1px solid #b794f4; background: #faf5ff; color: #44337a;
        border-radius: 6px;
    }
    .gap-duplicate-strip[hidden] { display: none !important; }
    .gap-duplicate-strip i { font-size: 16px; padding-top: 2px; }
    .gap-duplicate-strip strong { display: block; font-size: 13px; margin-bottom: 2px; }
    .gap-duplicate-strip p { margin: 0; font-size: 12px; line-height: 1.4; }
    .gap-duplicate-strip a { color: #44337a; font-weight: 700; text-decoration: underline; }

    .gap-invalid-card {
        margin: 12px 0; padding: 12px 14px;
        border: 1px solid #fc8181; background: #fff5f5; border-radius: 6px;
        color: #742a2a;
    }
    .gap-invalid-card[hidden] { display: none !important; }
    .gap-invalid-card strong { display: block; font-size: 13px; margin-bottom: 4px;
                                text-transform: uppercase; letter-spacing: 0.02em; }
    .gap-invalid-card p { margin: 0; font-size: 13px; line-height: 1.5; white-space: pre-wrap; }

    /* Modal overlay (scoped to this partial). */





    /* .pm-modal / .pm-modal-panel / .pm-modal-footer moved to
           practice-management.css -- they were identical in three
           views and absent from any fourth that used the classes.
           The .pm-modal-close override below is kept deliberately:
           the global rule is a bordered button, this is a glyph. */
        .pm-modal-close {
        background: transparent; border: 0; padding: 0;
        font-size: 26px; line-height: 1; cursor: pointer; color: #718096;
    }
    .pm-modal-close:hover { color: #e53e3e; }

    /* Mark Duplicate / Mark Invalid dialog (#gapActionModal) -- a bit
       roomier than the shared .pm-modal-panel default (560px / content-
       height only), now that it carries a gap picker as well as the
       remark field. Scoped to this one dialog's id, not to
       .pm-modal-wide, so Exception Centre and Risk Centre's dialogs
       (which share the same base class) are unaffected. */
    #gapActionModal .pm-modal-panel {
        max-width: 680px;
        min-height: 360px;
    }

    /* Remark + "Duplicate of" (or Remark + Invalid reason) were sitting
       side by side because .pm-form-grid is a 2-column grid by default
       and the "-full" class on these labels is pm-form-grid-full, which
       practice-management.css does not define (the real full-width
       class there is plain .full) -- so it never took grid-column: 1/-1
       and both fields just fell into the grid's two columns. Forcing a
       single column here, scoped to this dialog, stacks them into their
       own rows without touching the shared .pm-form-grid used by every
       other screen (some of which may be relying on today's 2-column
       behaviour on purpose). */
    #gapActionModal .pm-form-grid {
        grid-template-columns: 1fr;
    }

</style>

@* SLA Override dialog (migration 184). Raises an SLA_CANDIDATE
   exception request; goes to Exception Centre "SLA Candidate" tab. *@
<dialog id="gapSlaOverrideDialog"
        style="border:none; border-radius:8px; padding:0; max-width:520px; width:96%; box-shadow:0 10px 40px rgba(15,23,42,.25);">
    <form id="gapSlaOverrideForm" method="dialog" style="margin:0; padding:20px 24px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h2 style="margin:0; font-size:18px;">Request SLA Override</h2>
            <button type="button" id="gapSlaOverrideClose" aria-label="Close"
                    style="background:none; border:none; font-size:20px; cursor:pointer;">&times;</button>
        </div>
        <p style="margin:0 0 12px; color:#475569; font-size:13px;">
            Override goes to the Exception Centre <strong>SLA Candidate</strong> tab.
            The new SLA applies to this gap only if the request is approved.
        </p>
        <div id="gapSlaOverrideMessage" style="display:none; margin-bottom:10px; padding:8px 12px; border-radius:4px; font-size:13px;"></div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Current SLA (days)</span>
                <input id="gapSlaOverrideCurrent" type="text" disabled
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; background:#f1f5f9;" />
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Requested SLA (days) <span style="color:#b91c1c;">*</span></span>
                <input id="gapSlaOverrideRequested" type="number" min="0" step="1" required
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
        </div>

        <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
            <span>Reason <span style="color:#b91c1c;">*</span></span>
            <textarea id="gapSlaOverrideReason" rows="3" maxlength="4000" required
                      placeholder="Why is a different SLA needed for this gap?"
                      style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; resize:vertical;"></textarea>
        </label>

        <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
            <button type="button" id="gapSlaOverrideCancel" class="pm-button">Cancel</button>
            <button type="submit" id="gapSlaOverrideSubmit" class="pm-button primary">Send Request</button>
        </div>
    </form>
</dialog>

<script src="~/js/GapLifecycle/gap-detail.js" asp-append-version="true"></script>
