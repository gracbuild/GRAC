    // -----------------------------------------------------------------
    // 3-dot menus
    // -----------------------------------------------------------------
    function trigger(id, kind) {
        return '<button type="button" class="pm-action-trigger"'
             + ' data-id="' + id + '" data-kind="' + wf.escape(kind) + '"'
             + ' aria-haspopup="menu" aria-expanded="false" title="Actions">'
             + '<i class="fas fa-ellipsis-v fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>'
             + '<span class="visually-hidden">Actions</span>'
             + '</button>';
    }
    // 2026-11-04: status is passed in (was read from the row) so the
    // selected plan's Actions menu can build the same plan items.
    function buildMenu(id, kind, statusCode) {
        if (kind === 'plan') {
            const items = [
                { icon: 'fa-pen',   label: 'Edit',             action: function () { openPlanDialog(id); } },
            ];
            // 2026-11-14: Add Item on the plan's own menu (the separate
            // button went with the items panel); same Draft / Submitted rule.
            // 565: a plan gets programmes first; engagements go into a programme.
            if (statusCode === 'Draft' || statusCode === 'Submitted')
                items.push({ icon: 'fa-layer-group', label: 'Add Programme', action: function () { openProgrammeForm(id, null); } });
            if (statusCode === 'Draft' || statusCode === 'Submitted')
                items.push({ icon: 'fa-plus', label: 'Add Engagement', action: function () {
                    state.selectedPlanId = Number(id);
                    state.selectedPlan   = state.plansById[String(id)] || null;
                    selectPlan(Number(id));
                    openItemDialog(null);
                } });
            if (statusCode === 'Draft')     items.push({ icon: 'fa-paper-plane', label: 'Submit',   action: function () { transition(id, 'submit');   } });
            // 547 (sir): approving makes the plan Active at once (the approve
            // procedure runs Approved and then Active). Activate stays only
            // for a plan left Approved before 547.
            if (statusCode === 'Submitted') items.push({ icon: 'fa-check',       label: 'Approve',  action: async function () {
                if (!await window.gracUi.confirm('Approve this plan? Approving makes it Active, and its engagements can then be started as executions.',
                      { type: 'confirm', title: 'Approve and activate', confirmText: 'Approve' })) return;
                transition(id, 'approve');
            } });
            if (statusCode === 'Approved')  items.push({ icon: 'fa-play',       label: 'Activate', action: function () { transition(id, 'activate'); } });
            if (statusCode === 'Active')    items.push({ icon: 'fa-flag-checkered', label: 'Close', action: function () { transition(id, 'close');    } });
            // 565: an Approved / Active plan is revised (back to Draft, version + 1).
            if (statusCode === 'Approved' || statusCode === 'Active')
                items.push({ icon: 'fa-code-branch', label: 'Revise', action: function () { revisePlan(id); } });
            items.push({ icon: 'fa-trash', label: 'Delete', action: function () { deletePlan(id); } });
            return items;
        }
        // 565: a programme -- Edit / Add Engagement / Remove while the plan
        // is Draft or Submitted.
        if (kind === 'programme') {
            const pid = String(state.selectedPlanId);
            const progMenu = [];
            if (planEditable(pid)) {
                progMenu.push({ icon: 'fa-pen', label: 'Edit', action: function () { openProgrammeForm(pid, id); } });
                progMenu.push({ icon: 'fa-plus', label: 'Add Engagement', action: function () {
                    state.presetProgrammeId = String(id);
                    openItemDialog(null);
                } });
                progMenu.push({ icon: 'fa-trash', label: 'Remove', action: function () { deleteProgramme(pid, id); } });
            }
            return progMenu;
        }
        // 546: Edit / Remove while the plan is Draft or Submitted and the
        // slot has no execution; Start Execution once the plan is Approved
        // or Active, for a Planned slot of an Active audit.
        const row     = state.itemsById[String(id)] || {};
        const slot    = row.slotStatus || row.SlotStatus || 'Planned';
        const planSt  = selectedPlanStatus();
        const defSt   = row.definitionStatusCode || row.DefinitionStatusCode || '';
        const itemMenu = [];
        if (planEditable(state.selectedPlanId) && slot === 'Planned') {
            itemMenu.push({ icon: 'fa-pen',   label: 'Edit',   action: function () { openItemDialog(id); } });
            itemMenu.push({ icon: 'fa-trash', label: 'Remove', action: function () { deleteItem(id); } });
        }
        // 551: the audit has an Active version (a revision may be in Draft).
        const plannable = (row.definitionIsPlannable != null || row.DefinitionIsPlannable != null)
            ? !!(row.definitionIsPlannable != null ? row.definitionIsPlannable : row.DefinitionIsPlannable)
            : defSt === 'Active';
        // 552: View Scope always; Start Execution while an audit of the
        // engagement is left to start (CanStart), once the plan is Approved / Active.
        itemMenu.push({ icon: 'fa-eye', label: 'View Scope', action: function () {
            // 554: a saved engagement is narrowed to its own branch (server side).
            const bId = row.assignedBranchId || row.AssignedBranchId;
            window.gracEngagementForm.openScope(state.orgId, { planItemId: Number(id) }, (row.engagementCode || row.EngagementCode || '') + '  ' + (row.engagementName || row.EngagementName || '')
                      + (bId ? '  at ' + (row.assignedBranchName || row.AssignedBranchName || '') : ''));
        } });
        const canStart = (row.canStart != null || row.CanStart != null)
            ? !!(row.canStart != null ? row.canStart : row.CanStart)
            : (slot === 'Planned' && plannable);
        if ((planSt === 'Approved' || planSt === 'Active') && canStart)
            itemMenu.push({ icon: 'fa-play', label: 'Start Execution', action: function () { startExecution(id); } });
        return itemMenu;
    }
    function closeRowMenu() {
        if (openMenuEl) { openMenuEl.remove(); openMenuEl = null; }
        if (openMenuTrigger) { openMenuTrigger.setAttribute('aria-expanded', 'false'); openMenuTrigger = null; }
    }
    function positionRowMenu(trg) {
        if (!openMenuEl) return;
        const r  = trg.getBoundingClientRect();
        const mr = openMenuEl.getBoundingClientRect();
        const gap = 6;
        let top = r.bottom + gap, left = r.right - mr.width;
        if (top + mr.height > window.innerHeight - 8) top = Math.max(8, r.top - mr.height - gap);
        if (left < 8) left = 8;
        if (left + mr.width > window.innerWidth - 8) left = window.innerWidth - mr.width - 8;
        openMenuEl.style.top  = top  + 'px';
        openMenuEl.style.left = left + 'px';
    }
    function openRowMenu(trg, items) {
        closeRowMenu();
        openMenuTrigger = trg;
        trg.setAttribute('aria-expanded', 'true');
        openMenuEl = document.createElement('div');
        openMenuEl.className = 'pm-action-menu';
        openMenuEl.setAttribute('role', 'menu');
        // 546: a slot can have nothing to do (e.g. In Progress) -- say so,
        // the shared page-actions menu's wording.
        if (!items.length) {
            const p = document.createElement('div');
            p.style.cssText = 'padding:8px 12px; font-size:12px; color:var(--fg-subtle); white-space:nowrap;';
            p.textContent = 'No actions available';
            openMenuEl.appendChild(p);
        }
        for (const it of items) {
            const b = document.createElement('button');
            b.type = 'button'; b.setAttribute('role', 'menuitem');
            b.innerHTML = '<i class="fa-solid ' + wf.escape(it.icon) + '" aria-hidden="true"></i> ' + wf.escape(it.label);
            b.addEventListener('click', function (e) {
                e.preventDefault(); e.stopPropagation();
                closeRowMenu();
                try { it.action(); } catch (err) { console.error('[plans] menu action failed', err); }
            });
            openMenuEl.appendChild(b);
        }
        document.body.appendChild(openMenuEl);
        positionRowMenu(trg);
    }
    function wireRowMenus() {
        function attach(bodyId) {
            const body = document.getElementById(bodyId);
            if (!body) return;
            body.addEventListener('click', function (e) {
                const trg = e.target.closest('.pm-action-trigger');
                if (!trg || !body.contains(trg)) return;
                e.preventDefault(); e.stopPropagation();
                if (openMenuTrigger === trg) { closeRowMenu(); return; }
                const id   = trg.getAttribute('data-id');
                const kind = trg.getAttribute('data-kind') || '';
                const tr   = trg.closest('tr');
                // A slot's menu acts on its own plan.
                if ((kind === 'item' || kind === 'programme') && tr && tr.getAttribute('data-plan')) {   // 565: programmes too
                    state.selectedPlanId = Number(tr.getAttribute('data-plan'));
                    state.selectedPlan   = state.plansById[tr.getAttribute('data-plan')] || null;
                }
                openRowMenu(trg, buildMenu(id, kind, (tr && tr.getAttribute('data-status')) || ''));
            });
        }
        attach('oaPlPlanBody');   // plan rows and, inside them, slot rows
        document.addEventListener('click', function (e) {
            if (!openMenuEl) return;
            if (e.target.closest('.pm-action-menu'))    return;
            if (e.target.closest('.pm-action-trigger')) return;
            closeRowMenu();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeRowMenu(); });
        window.addEventListener('resize', closeRowMenu);
        window.addEventListener('scroll',  closeRowMenu, true);
    }

    // -----------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------
    function showPlanMessage(kind, text) {
        const el = document.getElementById('oaPlPlanMessage');
        el.style.display    = 'block';
        el.style.background = kind === 'error' ? 'var(--danger-100)' : 'var(--success-100)';
        el.style.color      = kind === 'error' ? 'var(--danger-700)' : 'var(--success-700)';
        el.textContent      = text;
    }
    function clearPlanMessage() {
        const el = document.getElementById('oaPlPlanMessage');
        el.style.display = 'none'; el.textContent = '';
    }
    function planTypeName(code) {
        const t = state.planTypes.find(function (x) { return (x.planTypeCode || x.PlanTypeCode) === code; });
        return t ? (t.planTypeName || t.PlanTypeName) : code || '';
    }
    function periodLabel(from, to) {
        const f = onlyDate(from); const t = onlyDate(to);
        if (!f && !t) return '';
        return f + (t ? ' — ' + t : '');
    }
    function onlyDate(v) {
        if (!v) return '';
        if (typeof window.gracFormatDisplayDate === "function") { var _g = window.gracFormatDisplayDate(v); if (_g !== v) return _g; }
        const s = String(v);
        return s.indexOf('T') >= 0 ? s.slice(0, 10) : s.slice(0, 10);
    }
    async function safeJson(r) { try { return await r.json(); } catch (_) { return null; } }
})();
</script>
