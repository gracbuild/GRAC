@*
    THE TPRM form dialog (migrations 486-490).

    One pm-modal shared by every Third-Party Risk screen for its smaller
    forms (a status change, a finding, a decision, a review outcome ...).
    window.gracTprm.form({ title, fields, submitText }) fills it, shows it
    and resolves with the values (or null on Cancel) -- the screens describe
    the fields instead of each carrying its own copy of the same modal
    markup. Larger editors (third party, engagement, configuration items)
    use the same dialog with more fields -- or, for a screen that carries
    one, a full page with the same data-tf-part elements (form({ page })):
    the Vendor Registry's register / edit vendor page (2026-11-07).

    Included ONCE per page (the ids are global) by tprm-third-parties,
    tprm-engagements, tprm-reviews, tprm-configuration and (524)
    tprm-risk-register. Its style block also carries the few tprm- classes
    those screens share (info grid,
    notes, action rows, wide modal, step chips), so they are written once.
    Script: wwwroot/js/Tprm/tprm-common.js
*@
<div class="pm-modal" id="tprmFormModal" hidden>
    <div class="pm-modal-panel tprm-form-panel">
        <header>
            <h2 id="tprmFormTitle" data-tf-part="title">Edit</h2>
            <button class="pm-modal-close" type="button" id="tprmFormClose" data-tf-part="close" aria-label="Close">&times;</button>
        </header>
        <p class="tprm-note" id="tprmFormIntro" data-tf-part="intro" hidden></p>
        <form id="tprmForm" class="pm-form-grid" data-tf-part="form" novalidate>
            <div class="full tprm-form-fields" id="tprmFormFields" data-tf-part="fields"></div>
            <p class="pm-message full" id="tprmFormMessage" data-tf-part="message" role="status" aria-live="polite" hidden></p>
            <div class="full" id="tprmFormExtra" data-tf-part="extra" hidden></div>
            <footer class="pm-modal-footer full">
                <button type="button" class="pm-button" id="tprmFormCancel" data-tf-part="cancel">Cancel</button>
                <button type="submit" class="pm-button primary" id="tprmFormSubmit" data-tf-part="submit"><i class="fa-solid fa-floppy-disk"></i> Save</button>
            </footer>
        </form>
    </div>
</div>

<style>
    .tprm-form-panel { max-width: 860px; width: 100%; }
    .tprm-form-panel.wide { max-width: 1100px; }
    .tprm-form-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 14px; }
    .tprm-form-fields > label.full, .tprm-form-fields > div.full { grid-column: 1 / -1; }
    .tprm-form-fields .tprm-help { color: var(--fg-secondary); font-size: 11px; display: block; margin-top: 2px; }
    .tprm-form-fields .tprm-check { display: flex; gap: 8px; align-items: center; }
    .tprm-form-fields .tprm-section { grid-column: 1 / -1; font-weight: 600; font-size: 13px; margin: 6px 0 0; border-bottom: 1px solid var(--border-subtle, #e5e7eb); padding-bottom: 4px; }
    /* Multi-select fields use the shared .pm-checkcombo (practice-management.css
       "14b"). Its caption is a span (a label cannot hold the option labels), styled
       like the other field captions; the option rows keep the combo's own look
       instead of .pm-form-grid's block, bold label rule. */
    .tprm-form-fields > div > span:first-child { display: block; color: var(--fg-secondary); font-size: 13px; font-weight: 650; }
    .tprm-form-fields .pm-checkcombo { margin-top: 6px; }
    .tprm-form-fields .pm-checkcombo-search { margin-top: 0; }
    .tprm-form-fields .pm-checkcombo [data-checkcombo-option] { display: flex; font-size: 12px; font-weight: 500; color: var(--neutral-700); }
    .tprm-form-fields .pm-checkcombo [data-checkcombo-option][hidden] { display: none; }
    .tprm-note { color: var(--fg-secondary); font-size: 12px; margin: 0 0 8px; }
    .tprm-muted { color: var(--fg-secondary); font-size: 12px; }
    .tprm-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .tprm-inline-check { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; }
    .pm-modal-panel.tprm-wide { max-width: 1100px; width: 100%; }
    .tprm-info { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px 16px; font-size: 13px; margin-bottom: 12px; }
    .tprm-info span { display: block; color: var(--fg-secondary); font-size: 11px; }
    .tprm-sample { background: var(--warning-50); color: var(--warning-700); }
    .tprm-alert { color: var(--danger-700); font-weight: 600; }
    .tprm-step-chip { display: inline-block; margin-left: 6px; min-width: 8px; height: 8px; border-radius: 50%; background: var(--border-subtle, #d1d5db); vertical-align: middle; }
    .tprm-step-chip.done { background: var(--success-700, #15803d); }
    .tprm-step-chip.current { background: var(--warning-700, #b45309); }
    .tprm-subhead { font-size: 14px; font-weight: 600; margin: 16px 0 8px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    /* Full-page form (form({ page })): the page's width takes three columns,
       and the Save / Cancel bar stays in view at the bottom while scrolling. */
    .tprm-page-form .tprm-form-fields { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tprm-page-form .pm-modal-footer { position: sticky; bottom: 0; background: var(--bg-surface); z-index: 5; padding-bottom: 12px; }
    /* A full page hides the screen heading while it is open (tpHeading,
       enHeading); .pm-page-heading's own display would otherwise beat the
       browser's [hidden] default. */
    .pm-page-heading[hidden] { display: none; }
    /* showWhen (522, CR 2 5.3): a field whose condition is not met is hidden
       whatever display its element normally has. */
    .tprm-form-fields > [data-tf-index][hidden] { display: none !important; }
    /* Repeating rows (522): one input per cell, the radio and remove columns narrow. */
    .tprm-rows-field .pm-table-wrap { margin: 6px 0; }
    .tprm-rows td { vertical-align: middle; }
    .tprm-rows td input[type=text], .tprm-rows td select { width: 100%; min-width: 120px; }
    .tprm-rows td.tprm-rows-radio, .tprm-rows td.tprm-rows-remove { width: 1%; white-space: nowrap; text-align: center; }
    @@media (max-width: 1100px) { .tprm-page-form .tprm-form-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 720px) { .tprm-form-fields, .tprm-page-form .tprm-form-fields { grid-template-columns: 1fr; } }
</style>
