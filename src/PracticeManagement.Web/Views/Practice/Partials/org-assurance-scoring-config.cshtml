@*
    Assurance Scoring Config (BRD Part 2 Sec 7) -- Phase 2 Stage 2.

    Screen key : `org-assurance-scoring-config`
    Group      : Organization Assurance
    Menu       : nav-assurance -> Scoring Config (migration 088)
    Feature    : screen.org-assurance-scoring-config
    Backend    :
        GET  /practice/api/org-assurance/admin-scoring-models
        GET  /practice/api/org-assurance/scoring-model-types
        GET  /practice/api/org-assurance/definitions/{id}?organizationId=
        GET  /practice/api/org-assurance/definitions?organizationId=&search=&page=&pageSize=
        GET  /practice/api/org-assurance/definitions/{id}/scoring-config?organizationId=
        POST /practice/api/org-assurance/definitions/{id}/scoring-config

    UX:
      * Same picker + header + summary-table + dialog pattern used by
        Evidence / Workflow.
      * Header form: Model Type (6 fixed BRD values), Admin Scoring
        Model (optional soft ref), Max Score, Pass / Warning / Fail
        thresholds, description.
      * Bands table (visible when the model type supports bands):
        Order, Code, Name, Min, Max, Outcome, Color, Description,
        row 3-dot menu (Edit / Remove).
      * Add / Edit Band dialog.
      * Editable only when the current version is Draft.
      * NO user formulas -- controlled representation only per BRD.
*@
@model PracticeManagement.Web.Models.PracticeScreen

<partial name="Partials/_workflow-common" />

<div class="pm-page-heading compact">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1 id="oaScHeading">@Model.Title</h1>
        <p id="oaScSubtitle">@Model.Description</p>
    </div>
    <div>
        <a class="pm-button" id="oaScBackBtn" href="#">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to Definitions
        </a>
    </div>
</div>

<section class="pm-panel" id="oaScUnavailable" hidden>
    <div class="pm-empty">
        <i class="fa-solid fa-gauge pm-empty-icon" aria-hidden="true"></i>
        <h2 id="oaScUnavailableTitle">Scoring Config is not available.</h2>
        <p id="oaScUnavailableBody">Ask a GRAC Admin to enable this screen.</p>
    </div>
</section>

<section class="pm-panel" id="oaScRoot" hidden>
    @* Picker toolbar *@
    <div class="pm-toolbar" style="flex-wrap:wrap; gap:8px; align-items:end;">
        <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
            <span>Organization</span>
            <select id="oaScPickOrg" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; min-width:220px;">
                <option value="">Loading...</option>
            </select>
        </label>
        <label style="display:flex; flex-direction:column; font-size:12px; color:#475569; flex:1; min-width:320px;">
            <span>Audit</span>
            <select id="oaScPickDef" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;">
                <option value="">Select an organization first</option>
            </select>
        </label>
    </div>

    <div id="oaScBanner" hidden class="pm-toolbar" style="justify-content:space-between; flex-wrap:wrap; gap:8px;">
        <div style="display:flex; align-items:center; gap:8px; font-size:13px;">
            <span style="font-weight:600;" id="oaScDefName">Definition</span>
            <span class="pm-badge" id="oaScDefStatus">Status</span>
            <span style="color:#64748b;" id="oaScDefVersion">Version</span>
        </div>
        <div style="display:flex; gap:6px;">
            <button class="pm-button" id="oaScReloadBtn" type="button">Reload</button>
            <button class="pm-button primary" id="oaScSaveBtn" type="button" disabled>Save Scoring</button>
        </div>
    </div>

    <div id="oaScReadonlyBanner" hidden
         style="margin:8px 0; padding:10px 12px; border-radius:6px; background:#fef3c7; color:#78350f; font-size:13px;">
        This version is not a Draft, so the scoring config is shown read-only.
    </div>

    <div id="oaScMessage" hidden
         style="margin:8px 0; padding:8px 12px; border-radius:6px; font-size:13px;"></div>

    @* Header form *@
    <div id="oaScHeaderForm" hidden
         style="margin-top:12px; padding:12px; border:1px solid #e2e8f0; border-radius:8px; background:#f8fafc;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; align-items:start;">
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Model Type <span style="color:#b91c1c;">*</span></span>
                <select id="oaScHeaderType" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; background:#fff;"></select>
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Admin Scoring Model (optional)</span>
                <select id="oaScHeaderModel" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; background:#fff;">
                    <option value="">-- none --</option>
                </select>
            </label>
        </div>

        <div id="oaScThresholdRow" style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:10px; align-items:start; margin-top:10px;">
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Max Score</span>
                <input id="oaScHeaderMax" type="number" step="0.01"
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Pass Threshold</span>
                <input id="oaScHeaderPass" type="number" step="0.01"
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Warning Threshold</span>
                <input id="oaScHeaderWarn" type="number" step="0.01"
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Fail Threshold</span>
                <input id="oaScHeaderFail" type="number" step="0.01"
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
        </div>

        <label style="display:flex; flex-direction:column; font-size:12px; color:#475569; margin-top:10px;">
            <span>Description</span>
            <textarea id="oaScHeaderDescription" rows="2" maxlength="4000"
                      style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; resize:vertical;"></textarea>
        </label>

        <div id="oaScTypeHint" style="margin-top:8px; font-size:12px; color:#64748b;"></div>
    </div>

    @* Bands table -- only visible when the type supports bands *@
    <div id="oaScBandsBlock" hidden style="margin-top:12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
            <h2 style="font-size:15px; margin:0; color:#0f172a;">Score Bands</h2>
            <button class="pm-button primary" id="oaScAddBandBtn" type="button" disabled>
                <i class="fa-solid fa-plus" aria-hidden="true"></i> Add Band
            </button>
        </div>
        <div class="pm-table-wrap" style="margin-top:8px;">
            <table>
                <thead>
                    <tr>
                        <th style="width:70px;">Order</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Min</th>
                        <th>Max</th>
                        <th>Outcome</th>
                        <th style="width:70px;">Color</th>
                        <th style="width:70px;"></th>
                    </tr>
                </thead>
                <tbody id="oaScBandBody">
                    <tr><td colspan="8" class="pm-empty">Pick a definition to configure scoring bands.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@* ---------- Add / Edit Band dialog ---------- *@
<dialog id="oaScBandDialog" style="border:none; border-radius:8px; padding:0; max-width:720px; width:96%; box-shadow:0 10px 40px rgba(15,23,42,.25);">
    <form id="oaScBandForm" method="dialog" style="margin:0; padding:20px 24px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h2 id="oaScBandDialogTitle" style="margin:0; font-size:18px;">Add Score Band</h2>
            <button type="button" id="oaScBandClose" aria-label="Close" style="background:none; border:none; font-size:20px; cursor:pointer;">&times;</button>
        </div>
        <div id="oaScBandMessage" style="display:none; margin-bottom:10px; padding:8px 12px; border-radius:4px; font-size:13px;"></div>

        <div style="display:grid; grid-template-columns:1fr 100px 130px; gap:10px; align-items:start;">
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Band Name <span style="color:#b91c1c;">*</span></span>
                <input id="oaScBandName" type="text" maxlength="160" required
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Order</span>
                <input id="oaScBandOrder" type="number" min="1" step="1"
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Outcome</span>
                <select id="oaScBandOutcome" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; background:#fff;">
                    <option value="">-- none --</option>
                    <option value="PASS">Pass</option>
                    <option value="WARNING">Warning</option>
                    <option value="FAIL">Fail</option>
                </select>
            </label>
        </div>

        <label style="display:flex; flex-direction:column; font-size:12px; color:#475569; margin-top:10px;">
            <span>Band Code</span>
            <input id="oaScBandCode" type="text" maxlength="60"
                   placeholder="Short code (auto if blank)"
                   style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
        </label>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; align-items:start; margin-top:10px;">
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Min Score <span style="color:#b91c1c;">*</span></span>
                <input id="oaScBandMin" type="number" step="0.01" required
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Max Score <span style="color:#b91c1c;">*</span></span>
                <input id="oaScBandMax" type="number" step="0.01" required
                       style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
            </label>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">
                <span>Color</span>
                <input id="oaScBandColor" type="color" value="#94a3b8"
                       style="padding:2px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; width:100%; height:32px;" />
            </label>
        </div>

        <label style="display:flex; flex-direction:column; font-size:12px; color:#475569; margin-top:10px;">
            <span>Description</span>
            <textarea id="oaScBandDescription" rows="2" maxlength="4000"
                      style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; resize:vertical;"></textarea>
        </label>

        <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
            <button type="button" id="oaScBandCancel" class="pm-button">Cancel</button>
            <button type="submit" id="oaScBandSubmit" class="pm-button primary">Save Band</button>
        </div>
    </form>
</dialog>

<script>
(function () {
    'use strict';
    const wf = window.__wfCommon;
    if (!wf) { console.error('__wfCommon missing'); return; }

    const API = '/practice/api/org-assurance';
    const U   = p => String(window.appBasePath || window.pmPathBase || '').replace(/\/+$/, '') + p;

    const state = {
        definitionId  : null,
        orgId         : null,
        allOrgs       : [],
        definitionsById : {},
        header        : null,
        definition    : null,
        modelTypes    : [],
        models        : [],
        headerForm    : null,
        bands         : [],
        editingIndex  : -1
    };

    let openMenuEl      = null;
    let openMenuTrigger = null;

    document.addEventListener('DOMContentLoaded', boot);
    if (document.readyState !== 'loading') boot();

    function readDefinitionIdFromUrl() {
        try {
            const q = new URLSearchParams(window.location.search);
            const v = q.get('definitionId');
            const n = v ? Number(v) : NaN;
            return Number.isFinite(n) && n > 0 ? n : null;
        } catch (_) { return null; }
    }
    function backHref() {
        const base = String(window.appBasePath || window.pmPathBase || '').replace(/\/+$/, '');
        return base + '/Practice/org-assurance-definitions';
    }

    async function boot() {
        document.getElementById('oaScBackBtn').setAttribute('href', backHref());
        document.getElementById('oaScRoot').hidden = false;

        try { await Promise.all([loadModelTypes(), loadModels()]); }
        catch (err) { setMessage('error', 'Failed to load lookups: ' + (err.message || err)); }

        const orgs = await wf.loadOrgs();
        state.allOrgs = orgs;
        const orgSel = document.getElementById('oaScPickOrg');
        orgSel.innerHTML = '';
        if (!orgs.length) {
            orgSel.innerHTML = '<option value="">(no accessible orgs)</option>';
            setMessage('error', 'Your account is not linked to any organizations.');
            wireStaticButtons();
            return;
        }
        orgs.forEach(function (o) {
            const opt = document.createElement('option');
            opt.value = o.value; opt.textContent = o.label || ('Organization ' + o.value);
            orgSel.appendChild(opt);
        });

        state.definitionId = readDefinitionIdFromUrl();

        orgSel.addEventListener('change', function () {
            state.orgId        = orgSel.value || null;
            state.definitionId = null;
            state.definition   = null;
            state.header       = null;
            state.headerForm   = null;
            state.bands        = [];
            renderBanner(); renderReadonlyBannerIfNeeded(); renderBands();
            document.getElementById('oaScSaveBtn').disabled     = true;
            document.getElementById('oaScAddBandBtn').disabled  = true;
            document.getElementById('oaScBanner').hidden        = true;
            document.getElementById('oaScHeaderForm').hidden    = true;
            document.getElementById('oaScBandsBlock').hidden    = true;
            populateDefinitionPicker();
        });
        document.getElementById('oaScPickDef').addEventListener('change', function (e) {
            const id = e.target.value ? Number(e.target.value) : null;
            if (id) selectDefinition(id);
        });

        wireStaticButtons();

        state.orgId = orgs[0].value;
        orgSel.value = state.orgId;
        await populateDefinitionPicker();

        if (state.definitionId) await selectDefinition(state.definitionId);
    }

    // -----------------------------------------------------------------
    // Lookups
    // -----------------------------------------------------------------
    async function loadModelTypes() {
        const r = await fetch(U(API + '/scoring-model-types'), { credentials: 'same-origin' });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const b = await r.json();
        state.modelTypes = (b && (b.data || b.Data)) || [];
    }
    async function loadModels() {
        const r = await fetch(U(API + '/admin-scoring-models'), { credentials: 'same-origin' });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const b = await r.json();
        state.models = (b && (b.data || b.Data)) || [];
    }

    function currentModelType() {
        const code = state.headerForm ? state.headerForm.scoringModelType : null;
        return state.modelTypes.find(function (t) { return (t.modelTypeCode || t.ModelTypeCode) === code; }) || null;
    }
    function typeSupportsBands()     { const t = currentModelType(); return t ? !!(t.supportsBands ?? t.SupportsBands) : false; }
    function typeSupportsThreshold() { const t = currentModelType(); return t ? !!(t.supportsThreshold ?? t.SupportsThreshold) : true; }

    // -----------------------------------------------------------------
    // Picker + org resolve
    // -----------------------------------------------------------------
    async function populateDefinitionPicker() {
        const defSel = document.getElementById('oaScPickDef');
        defSel.innerHTML = '<option value="">Loading definitions...</option>';
        defSel.disabled = true;
        if (!state.orgId) {
            defSel.innerHTML = '<option value="">Select an organization first</option>';
            return;
        }
        try {
            const qs = new URLSearchParams();
            qs.set('organizationId', state.orgId);
            qs.set('page', '1'); qs.set('pageSize', '200');
            const r = await fetch(U(API + '/definitions?' + qs.toString()), { credentials: 'same-origin' });
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const payload = await r.json();
            const rows    = payload.rows || payload.Rows || [];
            defSel.innerHTML = '';
            const ph = document.createElement('option');
            ph.value = '';
            ph.textContent = rows.length ? '-- select a definition --' : 'No definitions in this organization.';
            defSel.appendChild(ph);
            rows.forEach(function (row) {
                const id   = row.definitionId  || row.DefinitionId;
                const code = row.definitionCode|| row.DefinitionCode || '';
                const name = row.definitionName|| row.DefinitionName || '';
                const st   = row.currentStatusName || row.CurrentStatusName || '';
                if (id != null) state.definitionsById[String(id)] = row;
                const opt = document.createElement('option');
                opt.value = String(id);
                opt.textContent = name + (code ? ' (' + code + ')' : '') + (st ? '  –  ' + st : '');
                defSel.appendChild(opt);
            });
            if (state.definitionId) defSel.value = String(state.definitionId);
        } catch (err) {
            defSel.innerHTML = '<option value="">Failed to load: ' + wf.escape(err.message || err) + '</option>';
        } finally { defSel.disabled = false; }
    }

    async function selectDefinition(definitionId) {
        state.definitionId = definitionId;
        try {
            const u = new URL(window.location.href);
            u.searchParams.set('definitionId', String(definitionId));
            window.history.replaceState(null, '', u.toString());
        } catch (_) {}

        try { await resolveOrgForDefinition(definitionId); }
        catch (err) { setMessage('error', 'Could not load definition #' + definitionId + ': ' + (err.message || err)); return; }

        try { await loadScoring(); }
        catch (err) { setMessage('error', 'Failed to load scoring: ' + (err.message || err)); return; }

        document.getElementById('oaScBanner').hidden     = false;
        document.getElementById('oaScHeaderForm').hidden = false;
        renderBanner();
        renderReadonlyBannerIfNeeded();
        renderHeaderForm();
        renderBands();
        applyTypeVisibility();
        document.getElementById('oaScSaveBtn').disabled    = !state.header.isEditable;
        document.getElementById('oaScAddBandBtn').disabled = !state.header.isEditable;
    }

    async function resolveOrgForDefinition(definitionId) {
        const cached = state.definitionsById[String(definitionId)];
        const cachedOrg = cached && String(cached.organizationId || cached.OrganizationId || '');
        const seen = new Set(); const orgsToTry = [];
        function push(v) { if (v && !seen.has(v)) { seen.add(v); orgsToTry.push(v); } }
        push(cachedOrg); push(state.orgId);
        (state.allOrgs || []).forEach(function (o) { push(o.value); });

        let lastStatus = null;
        for (const oid of orgsToTry) {
            const url = U(API + '/definitions/' + definitionId + '?organizationId=' + encodeURIComponent(oid));
            let r;
            try { r = await fetch(url, { credentials: 'same-origin' }); } catch (_) { continue; }
            if (r.ok) {
                const b = await r.json().catch(function () { return null; });
                const d = (b && (b.data || b.Data)) || null;
                if (d) {
                    if (state.orgId !== String(oid)) {
                        state.orgId = String(oid);
                        const orgSel = document.getElementById('oaScPickOrg');
                        if (orgSel && orgSel.value !== state.orgId) {
                            orgSel.value = state.orgId;
                            await populateDefinitionPicker();
                            const defSel = document.getElementById('oaScPickDef');
                            if (defSel) defSel.value = String(definitionId);
                        }
                    }
                    state.definition = d;
                    return;
                }
            } else { lastStatus = r.status; }
        }
        throw new Error(lastStatus
            ? ('HTTP ' + lastStatus + ' -- definition not found in any accessible organization.')
            : 'Definition not found in any accessible organization.');
    }

    async function loadScoring() {
        if (!state.orgId || !state.definitionId) return;
        const url = U(API + '/definitions/' + state.definitionId + '/scoring-config?organizationId=' + encodeURIComponent(state.orgId));
        const r = await fetch(url, { credentials: 'same-origin' });
        if (!r.ok) throw new Error('HTTP ' + r.status + ' loading scoring config');
        const json = await r.json();
        const hdr  = (json && (json.header || json.Header)) || {};
        state.header = {
            definitionId      : hdr.definitionId      || hdr.DefinitionId,
            versionId         : hdr.versionId         || hdr.VersionId,
            currentVersionId  : hdr.currentVersionId  || hdr.CurrentVersionId,
            currentStatusCode : hdr.currentStatusCode || hdr.CurrentStatusCode,
            isEditable        : !!(hdr.isEditable    ?? hdr.IsEditable)
        };
        const cfg = (json && (json.config || json.Config)) || null;
        state.headerForm = {
            scoringModelId    : cfg ? (cfg.scoringModelId    ?? cfg.ScoringModelId    ?? null) : null,
            scoringModelCode  : cfg ? (cfg.scoringModelCode  ?? cfg.ScoringModelCode  ?? null) : null,
            scoringModelName  : cfg ? (cfg.scoringModelName  ?? cfg.ScoringModelName  ?? null) : null,
            scoringModelType  : cfg ? (cfg.scoringModelType  ?? cfg.ScoringModelType  ?? 'PASS_FAIL') : 'PASS_FAIL',
            maxScore          : cfg ? (cfg.maxScore          ?? cfg.MaxScore          ?? null) : null,
            passThreshold     : cfg ? (cfg.passThreshold     ?? cfg.PassThreshold     ?? null) : null,
            warningThreshold  : cfg ? (cfg.warningThreshold  ?? cfg.WarningThreshold  ?? null) : null,
            failThreshold     : cfg ? (cfg.failThreshold     ?? cfg.FailThreshold     ?? null) : null,
            description       : cfg ? (cfg.description       ?? cfg.Description       ?? '')   : ''
        };
        const bands = (json && (json.bands || json.Bands)) || [];
        state.bands = bands.map(function (b) {
            return {
                bandOrder   : b.bandOrder ?? b.BandOrder ?? 0,
                bandCode    : b.bandCode  ?? b.BandCode  ?? '',
                bandName    : b.bandName  ?? b.BandName  ?? '',
                minScore    : b.minScore  ?? b.MinScore  ?? 0,
                maxScore    : b.maxScore  ?? b.MaxScore  ?? 0,
                outcomeCode : b.outcomeCode ?? b.OutcomeCode ?? null,
                colorHex    : b.colorHex    ?? b.ColorHex    ?? null,
                description : b.description ?? b.Description ?? ''
            };
        });
    }

    // -----------------------------------------------------------------
    // Render
    // -----------------------------------------------------------------
    function renderBanner() {
        const d = state.definition; const h = state.header;
        if (!d || !h) {
            document.getElementById('oaScDefName').textContent    = '';
            document.getElementById('oaScDefStatus').textContent  = '';
            document.getElementById('oaScDefVersion').textContent = '';
            document.getElementById('oaScHeading').textContent    = 'Scoring Config';
            document.getElementById('oaScSubtitle').textContent   =
                'Pick an organization and an audit to configure scoring.';
            return;
        }
        document.getElementById('oaScDefName').textContent =
            (d.definitionName || d.DefinitionName || '(no name)') +
            '  (' + (d.definitionCode || d.DefinitionCode || '') + ')';
        document.getElementById('oaScDefStatus').textContent  = d.currentStatusName || d.CurrentStatusName || '';
        document.getElementById('oaScDefVersion').textContent = 'v' +
            (d.currentVersionNumber || d.CurrentVersionNumber || h.versionId || '?');
        document.getElementById('oaScHeading').textContent = 'Scoring: ' + (d.definitionName || d.DefinitionName || '');
        document.getElementById('oaScSubtitle').textContent =
            'Pick a model type (Pass/Fail, Weighted, Risk Based, Maturity Based, Percentage or Custom), thresholds and bands.';
    }
    function renderReadonlyBannerIfNeeded() {
        document.getElementById('oaScReadonlyBanner').hidden = state.header ? !!state.header.isEditable : true;
    }

    function renderHeaderForm() {
        // Model type dropdown.
        const typeSel = document.getElementById('oaScHeaderType');
        typeSel.innerHTML = '';
        state.modelTypes.forEach(function (t) {
            const opt = document.createElement('option');
            opt.value = t.modelTypeCode || t.ModelTypeCode;
            opt.textContent = t.modelTypeName || t.ModelTypeName;
            typeSel.appendChild(opt);
        });
        typeSel.value = state.headerForm.scoringModelType || 'PASS_FAIL';

        // Admin model dropdown.
        const modelSel = document.getElementById('oaScHeaderModel');
        modelSel.innerHTML = '';
        const ph = document.createElement('option');
        ph.value = '';
        ph.textContent = state.models.length ? '-- none --' : '(no models published by Admin)';
        modelSel.appendChild(ph);
        state.models.forEach(function (m) {
            const id   = m.id   ?? m.Id;
            const code = m.code ?? m.Code ?? '';
            const name = m.name ?? m.Name ?? '';
            const opt  = document.createElement('option');
            opt.value  = String(id != null ? id : '');
            opt.textContent = name + (code ? ' (' + code + ')' : '');
            opt.setAttribute('data-code', code);
            opt.setAttribute('data-name', name);
            modelSel.appendChild(opt);
        });
        modelSel.value = state.headerForm.scoringModelId != null ? String(state.headerForm.scoringModelId) : '';

        document.getElementById('oaScHeaderMax').value  = state.headerForm.maxScore         == null ? '' : String(state.headerForm.maxScore);
        document.getElementById('oaScHeaderPass').value = state.headerForm.passThreshold    == null ? '' : String(state.headerForm.passThreshold);
        document.getElementById('oaScHeaderWarn').value = state.headerForm.warningThreshold == null ? '' : String(state.headerForm.warningThreshold);
        document.getElementById('oaScHeaderFail').value = state.headerForm.failThreshold    == null ? '' : String(state.headerForm.failThreshold);
        document.getElementById('oaScHeaderDescription').value = state.headerForm.description || '';

        const disabled = !state.header.isEditable;
        ['oaScHeaderType','oaScHeaderModel','oaScHeaderMax','oaScHeaderPass','oaScHeaderWarn','oaScHeaderFail','oaScHeaderDescription']
            .forEach(function (id) { document.getElementById(id).disabled = disabled; });

        function pull() {
            const modelSel = document.getElementById('oaScHeaderModel');
            const modelOpt = modelSel.options[modelSel.selectedIndex] || null;
            state.headerForm = {
                scoringModelId    : modelSel.value ? Number(modelSel.value) : null,
                scoringModelCode  : modelOpt && modelSel.value ? (modelOpt.getAttribute('data-code') || null) : null,
                scoringModelName  : modelOpt && modelSel.value ? (modelOpt.getAttribute('data-name') || null) : null,
                scoringModelType  : document.getElementById('oaScHeaderType').value || 'PASS_FAIL',
                maxScore          : parseNum(document.getElementById('oaScHeaderMax').value),
                passThreshold     : parseNum(document.getElementById('oaScHeaderPass').value),
                warningThreshold  : parseNum(document.getElementById('oaScHeaderWarn').value),
                failThreshold     : parseNum(document.getElementById('oaScHeaderFail').value),
                description       : document.getElementById('oaScHeaderDescription').value
            };
            applyTypeVisibility();
        }
        document.getElementById('oaScHeaderType').onchange           = pull;
        document.getElementById('oaScHeaderModel').onchange          = pull;
        document.getElementById('oaScHeaderMax').oninput             = pull;
        document.getElementById('oaScHeaderPass').oninput            = pull;
        document.getElementById('oaScHeaderWarn').oninput            = pull;
        document.getElementById('oaScHeaderFail').oninput            = pull;
        document.getElementById('oaScHeaderDescription').oninput     = pull;
    }

    function applyTypeVisibility() {
        const hint = document.getElementById('oaScTypeHint');
        const supportsBands     = typeSupportsBands();
        const supportsThreshold = typeSupportsThreshold();
        document.getElementById('oaScBandsBlock').hidden   = !supportsBands || !state.definitionId;
        document.getElementById('oaScThresholdRow').style.opacity = supportsThreshold ? '1' : '0.55';
        const t = currentModelType();
        hint.textContent = t
            ? (supportsBands
                ? 'This model uses bands. Add ranges below.'
                : 'This model uses simple thresholds.')
            : '';
    }

    function renderBands() {
        const body = document.getElementById('oaScBandBody');
        if (!state.definitionId || !state.header) {
            body.innerHTML = '<tr><td colspan="8" class="pm-empty">Pick a definition to configure scoring bands.</td></tr>';
            return;
        }
        if (!state.bands.length) {
            body.innerHTML = '<tr><td colspan="8" class="pm-empty">' +
                (state.header.isEditable
                    ? 'No bands yet. Click "Add Band" to define score ranges.'
                    : 'No bands defined for this version.') + '</td></tr>';
            return;
        }
        body.innerHTML = state.bands.map(function (b, idx) {
            const outcome = b.outcomeCode ? '<span class="pm-badge">' + wf.escape(outcomeName(b.outcomeCode)) + '</span>' : '';
            const color   = b.colorHex
                ? '<span style="display:inline-block; width:20px; height:20px; border-radius:4px; background:'
                     + wf.escape(b.colorHex) + '; border:1px solid #cbd5e1;"></span>'
                : '';
            return '<tr data-idx="' + idx + '">'
                + '<td>' + wf.escape(String(b.bandOrder ?? '')) + '</td>'
                + '<td>' + wf.escape(b.bandCode || '') + '</td>'
                + '<td>' + wf.escape(b.bandName || '') + '</td>'
                + '<td>' + wf.escape(String(b.minScore)) + '</td>'
                + '<td>' + wf.escape(String(b.maxScore)) + '</td>'
                + '<td>' + outcome + '</td>'
                + '<td>' + color + '</td>'
                + '<td>' + rowTrigger(idx) + '</td>'
                + '</tr>';
        }).join('');
        wireRowMenu();
        if (!state.header.isEditable) {
            body.querySelectorAll('button').forEach(function (el) { el.disabled = true; });
        }
    }

    function outcomeName(code) {
        if (code === 'PASS')    return 'Pass';
        if (code === 'WARNING') return 'Warning';
        if (code === 'FAIL')    return 'Fail';
        return code || '';
    }

    // -----------------------------------------------------------------
    // Row 3-dot menu
    // -----------------------------------------------------------------
    function rowTrigger(idx) {
        return '<button type="button" class="pm-action-trigger" data-idx="' + idx + '"'
             + ' aria-haspopup="menu" aria-expanded="false" title="Actions">'
             + '<i class="fas fa-ellipsis-v fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>'
             + '<span class="visually-hidden">Actions</span>'
             + '</button>';
    }
    function closeRowMenu() {
        if (openMenuEl) { openMenuEl.remove(); openMenuEl = null; }
        if (openMenuTrigger) { openMenuTrigger.setAttribute('aria-expanded', 'false'); openMenuTrigger = null; }
    }
    function positionRowMenu(trg) {
        if (!openMenuEl) return;
        const r  = trg.getBoundingClientRect();
        const mr = openMenuEl.getBoundingClientRect();
        const gap = 6;
        let top = r.bottom + gap, left = r.right - mr.width;
        if (top + mr.height > window.innerHeight - 8) top = Math.max(8, r.top - mr.height - gap);
        if (left < 8) left = 8;
        if (left + mr.width > window.innerWidth - 8) left = window.innerWidth - mr.width - 8;
        openMenuEl.style.top  = top  + 'px';
        openMenuEl.style.left = left + 'px';
    }
    function openRowMenu(trg, items) {
        closeRowMenu();
        openMenuTrigger = trg;
        trg.setAttribute('aria-expanded', 'true');
        openMenuEl = document.createElement('div');
        openMenuEl.className = 'pm-action-menu';
        openMenuEl.setAttribute('role', 'menu');
        for (const it of items) {
            const b = document.createElement('button');
            b.type = 'button'; b.setAttribute('role', 'menuitem');
            b.innerHTML = '<i class="fa-solid ' + wf.escape(it.icon) + '" aria-hidden="true"></i> ' + wf.escape(it.label);
            b.addEventListener('click', function (e) {
                e.preventDefault(); e.stopPropagation();
                closeRowMenu();
                try { it.action(); } catch (err) { console.error('[scoring-config] menu action failed', err); }
            });
            openMenuEl.appendChild(b);
        }
        document.body.appendChild(openMenuEl);
        positionRowMenu(trg);
    }
    function wireRowMenu() {
        const body = document.getElementById('oaScBandBody');
        if (!body) return;
        body.onclick = function (e) {
            const trg = e.target.closest('.pm-action-trigger');
            if (!trg || !body.contains(trg)) return;
            e.preventDefault(); e.stopPropagation();
            if (openMenuTrigger === trg) { closeRowMenu(); return; }
            const idx = Number(trg.getAttribute('data-idx'));
            openRowMenu(trg, [
                { icon: 'fa-pen',   label: 'Edit',   action: function () { openBandDialog(idx); } },
                { icon: 'fa-trash', label: 'Remove', action: async function () {
                    if (!await window.gracUi.confirm('Remove this band?',
                          { type: 'warning', title: 'Remove band', confirmText: 'Remove' })) return;
                    state.bands.splice(idx, 1); renderBands();
                } }
            ]);
        };
    }
    document.addEventListener('click', function (e) {
        if (!openMenuEl) return;
        if (e.target.closest('.pm-action-menu'))    return;
        if (e.target.closest('.pm-action-trigger')) return;
        closeRowMenu();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeRowMenu(); });
    window.addEventListener('resize', closeRowMenu);
    window.addEventListener('scroll',  closeRowMenu, true);

    // -----------------------------------------------------------------
    // Band dialog
    // -----------------------------------------------------------------
    function openBandDialog(idx) {
        state.editingIndex = (idx == null || idx < 0) ? -1 : idx;
        clearBandMessage();
        const isEdit = state.editingIndex >= 0;
        const b = isEdit ? state.bands[state.editingIndex] : {
            bandOrder: state.bands.length + 1, bandCode: '', bandName: '',
            minScore: 0, maxScore: 0, outcomeCode: null, colorHex: '#94a3b8', description: ''
        };
        document.getElementById('oaScBandDialogTitle').textContent = isEdit ? 'Edit Score Band' : 'Add Score Band';
        document.getElementById('oaScBandName').value        = b.bandName || '';
        document.getElementById('oaScBandOrder').value       = String(b.bandOrder ?? (state.bands.length + 1));
        document.getElementById('oaScBandOutcome').value     = b.outcomeCode || '';
        document.getElementById('oaScBandCode').value        = b.bandCode || '';
        document.getElementById('oaScBandMin').value         = String(b.minScore ?? 0);
        document.getElementById('oaScBandMax').value         = String(b.maxScore ?? 0);
        document.getElementById('oaScBandColor').value       = b.colorHex || '#94a3b8';
        document.getElementById('oaScBandDescription').value = b.description || '';
        document.getElementById('oaScBandDialog').showModal();
    }
    function closeBandDialog() { document.getElementById('oaScBandDialog').close(); }
    function saveBandFromDialog() {
        const name = document.getElementById('oaScBandName').value.trim();
        if (!name) { showBandMessage('error', 'Band name is required.'); return; }
        const min  = parseNum(document.getElementById('oaScBandMin').value);
        const max  = parseNum(document.getElementById('oaScBandMax').value);
        if (min == null || max == null) { showBandMessage('error', 'Min and Max scores are required numbers.'); return; }
        if (max < min) { showBandMessage('error', 'Max score must be >= Min score.'); return; }

        const updated = {
            bandOrder   : Number(document.getElementById('oaScBandOrder').value || (state.bands.length + 1)),
            bandCode    : document.getElementById('oaScBandCode').value.trim(),
            bandName    : name,
            minScore    : min, maxScore: max,
            outcomeCode : document.getElementById('oaScBandOutcome').value || null,
            colorHex    : document.getElementById('oaScBandColor').value || null,
            description : document.getElementById('oaScBandDescription').value || ''
        };
        if (state.editingIndex >= 0) state.bands[state.editingIndex] = updated;
        else                          state.bands.push(updated);
        state.bands.sort(function (a, b) { return (a.bandOrder || 0) - (b.bandOrder || 0); });
        renderBands();
        closeBandDialog();
    }

    function showBandMessage(kind, text) {
        const el = document.getElementById('oaScBandMessage');
        el.style.display    = 'block';
        el.style.background = kind === 'error' ? '#fee2e2' : '#dcfce7';
        el.style.color      = kind === 'error' ? '#991b1b' : '#166534';
        el.textContent      = text;
    }
    function clearBandMessage() {
        const el = document.getElementById('oaScBandMessage');
        el.style.display = 'none'; el.textContent = '';
    }

    // -----------------------------------------------------------------
    // Static wiring
    // -----------------------------------------------------------------
    function wireStaticButtons() {
        document.getElementById('oaScAddBandBtn').addEventListener('click', function () {
            if (!state.definitionId || !state.header) { setMessage('error', 'Pick a definition first.'); return; }
            if (!state.header.isEditable) { setMessage('error', 'This version is not a Draft.'); return; }
            openBandDialog(-1);
        });

        document.getElementById('oaScBandClose').addEventListener('click', closeBandDialog);
        document.getElementById('oaScBandCancel').addEventListener('click', closeBandDialog);
        document.getElementById('oaScBandForm').addEventListener('submit', function (e) {
            e.preventDefault(); saveBandFromDialog();
        });

        document.getElementById('oaScReloadBtn').addEventListener('click', async function () {
            if (!state.definitionId || !state.orgId) { setMessage('error', 'Pick an organization and definition first.'); return; }
            try {
                await loadScoring();
                renderBanner(); renderReadonlyBannerIfNeeded();
                renderHeaderForm(); renderBands(); applyTypeVisibility();
                document.getElementById('oaScSaveBtn').disabled    = !state.header.isEditable;
                document.getElementById('oaScAddBandBtn').disabled = !state.header.isEditable;
                setMessage('ok', 'Reloaded.');
            } catch (err) { setMessage('error', 'Reload failed: ' + (err.message || err)); }
        });

        document.getElementById('oaScSaveBtn').addEventListener('click', saveScoring);
    }

    async function saveScoring() {
        if (!state.header || !state.header.isEditable) return;
        const body = {
            organizationId : Number(state.orgId),
            definitionId   : Number(state.definitionId),
            actor          : null,
            header         : state.headerForm,
            bands          : (typeSupportsBands() ? state.bands : []).map(function (b, idx) {
                return {
                    bandOrder   : b.bandOrder ?? (idx + 1),
                    bandCode    : b.bandCode || null,
                    bandName    : b.bandName,
                    minScore    : b.minScore, maxScore: b.maxScore,
                    outcomeCode : b.outcomeCode || null,
                    colorHex    : b.colorHex    || null,
                    description : b.description || null
                };
            })
        };
        try {
            const url = U(API + '/definitions/' + state.definitionId + '/scoring-config');
            const r = await fetch(url, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const j = await safeJson(r);
            if (!r.ok) {
                setMessage('error', ((j && (j.error || j.Error)) || 'HTTP ' + r.status) +
                    (j && (j.reasonCode || j.ReasonCode) ? ' [' + (j.reasonCode || j.ReasonCode) + ']' : ''));
                return;
            }
            setMessage('ok', 'Scoring config saved.');
        } catch (err) { setMessage('error', 'Save failed: ' + (err.message || err)); }
    }

    // -----------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------
    function parseNum(v) {
        if (v === '' || v == null) return null;
        const n = Number(v); return Number.isFinite(n) ? n : null;
    }
    function setMessage(kind, text) {
        const el = document.getElementById('oaScMessage');
        el.hidden = false;
        el.textContent = text;
        el.style.background = kind === 'error' ? '#fee2e2' : '#dcfce7';
        el.style.color      = kind === 'error' ? '#991b1b' : '#166534';
    }
    async function safeJson(r) { try { return await r.json(); } catch (_) { return null; } }
})();
</script>
