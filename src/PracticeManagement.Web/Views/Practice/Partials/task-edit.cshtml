@*
    Edit Task  (dedicated full page)

    Route: /Practice/Index/task-edit?taskId=NNN

    The Task Board / Task View "Edit" used to open a modal. This is the
    SAME shared edit surface (Shared/task-actions.js + the view/edit
    dialog in _task-action-dialogs.cshtml) rendered inline on its own
    page via openEdit(taskId, { host:"page" }) -- no duplicate form, no
    duplicate business logic, same API (/tasks/{id}, /edit-options).
    Save flips to the read-only outcome in place; Close returns to the
    Task Board.
*@
@model PracticeManagement.Web.Models.PracticeScreen

<div class="pm-page-heading compact">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1>Edit Task</h1>
        <p class="pm-hint">Change this task's details &mdash; or go back to the board.</p>
    </div>
    <div style="display:flex; gap:8px;">
        <a class="pm-button" href="~/Practice/Index/tasks">
            <i class="fa-solid fa-arrow-left"></i> Back to Task Board
        </a>
    </div>
</div>

<section class="pm-panel" id="taskEditNoId" hidden>
    <div class="pm-empty">
        <i class="fa-solid fa-circle-info pm-empty-icon" aria-hidden="true"></i>
        <h2>No task selected.</h2>
        <p>Open this page from the Task Board's row menu or Task View's Edit action.</p>
    </div>
</section>

@* THE shared view/edit dialog + actions module, reused inline (host:"page"). *@
<partial name="Partials/_task-action-dialogs" />
<script src="~/js/Shared/task-actions.js" asp-append-version="true"></script>

<style>
    /* Full-page host: render the shared view/edit dialog inline as a
       panel rather than a centred modal. !important only where it must
       beat the dialog's inline max-width/width. */
    #taskDetailDialog.tdd--page {
        position: static !important;
        display: block !important;
        width: 100% !important;
        max-width: none !important;
        max-height: none !important;
        margin: 0;
        border: 1px solid var(--border-subtle, var(--neutral-200));
        border-radius: var(--radius-md);
        box-shadow: none;
    }
    #taskDetailDialog.tdd--page::backdrop { display: none; }
    #taskDetailDialog.tdd--page #taskDetailBody { max-height: none; overflow: visible; }
</style>

<script>
(function () {
    const U = p => String(window.appBasePath || window.pmPathBase || "").replace(/\/+$/, "") + p;
    const taskId = Number(new URLSearchParams(location.search).get("taskId")) || 0;

    if (!taskId) {
        document.getElementById("taskEditNoId").hidden = false;
        const dlg = document.getElementById("taskDetailDialog");
        if (dlg) dlg.style.display = "none";
        return;
    }

    // The layout sets window.appBasePath in a trailing inline script that
    // runs AFTER RenderBody, so anything called at parse time here builds
    // its URLs without the deployment's PathBase and every request 404s.
    // Localhost has no PathBase, which is why this only broke on the
    // deployed site. Deferred, the same way gaps.cshtml and
    // repository-updates.cshtml do it.
    function start() {
        window.gracTaskActions.init({ onChanged: function () {} });
        window.gracTaskActions.openEdit(taskId, { host: "page", backUrl: U("/Practice/Index/tasks") });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
    else start();
})();
</script>
