@*
    Gap Center — split from Task Center as its own module.

    Purpose:
      "Gap Center identifies work that needs to be done."
      "Task Center manages tasks created to address those gaps."

    Tabs (Phase 1):
      * Implementation Gaps — Practice Instances with implementation_status in
        (Not Implemented, Partially Implemented). Backed by the existing
        /practice/api/instances/gaps endpoint (unchanged).
      * Assurance Gaps      — placeholder (future: unresolved assurance findings).
      * Custom Gaps         — placeholder (future: manually-recorded gaps).

    Screen key: `gaps`  ·  Registered in PracticeScreen.All (group = Oversight)
    Feature flag: `screen.gaps` (seeded ON per-org by migration 050)
    Menu row:     seeded by migration 050 (module_type = Oversight)

    DOM patterns mirror Views/Practice/Partials/tasks.cshtml so styling
    stays consistent: pm-tabs, pm-table-wrap, pm-pager, pm-action-trigger.
*@
@model PracticeManagement.Web.Models.PracticeScreen

<div class="pm-page-heading compact">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
</div>

<section class="pm-panel" id="gapCenterUnavailable" hidden>
    <div class="pm-empty">
        <i class="fa-solid fa-flag-checkered pm-empty-icon" aria-hidden="true"></i>
        <h2 id="gapCenterUnavailableTitle">Gap Center is not yet enabled for this organization.</h2>
        <p id="gapCenterUnavailableBody">Ask a GRAC Admin to turn on the <code>screen.gaps</code> feature flag in your organization settings.</p>
    </div>
</section>

<section class="pm-panel" id="gapCenterRoot" hidden>

    @* Migration 255. The Implementation / Assurance / Custom tabs are
       gone: they were three views of the same question ("what is not
       where it should be"), split by where the gap came from, which is
       an attribute of a gap rather than a kind of gap. One list now,
       with Source as a column and a filter — see #gapFilterSource. *@
    <div class="pm-toolbar">
        <select id="gapFilterOrganization">
            <option value="">All organizations</option>
        </select>
        <select id="gapFilterSource" title="Filter by the module that raised the gap">
            <option value="">All sources</option>
        </select>
        <input id="gapCenterSearch" type="text" placeholder="Search practice instance / practice / gap..." />
        <button class="pm-button icon" id="gapRefreshBtn" type="button" title="Refresh" aria-label="Refresh">
            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
        </button>
        <button class="pm-button primary" id="gapAddBtn" type="button" title="Add Custom Gap">
            <i class="fa-solid fa-plus" aria-hidden="true"></i> Add Gap
        </button>
    </div>

    @* One grid for every source. The observation banner stays: it is a
       cross-link target — Assurance Observations deep-links here with
       ?observationId=, and the banner is what tells the operator the
       list they are looking at is filtered. *@
    <div id="assuranceObsFilterBanner" hidden
         style="margin:8px 0; padding:8px 12px; border-radius:6px; font-size:13px;
                background:#dbeafe; color:#1e40af; display:flex; justify-content:space-between; align-items:center;">
        <span>Showing only gaps linked to Observation <strong id="assuranceObsFilterLabel">#?</strong>.</span>
        <button class="pm-button" id="assuranceObsFilterClear" type="button">
            <i class="fa-solid fa-xmark"></i> Clear filter
        </button>
    </div>

    <div class="pm-table-wrap">
        <table>
            @* Columns are the intersection the three tabs actually
               shared, plus the four aggregated status columns (change
               request, 2026-09-23). Where an origin has no answer the
               cell is blank rather than filled with a stand-in: a
               custom gap has no obligation count. Context and Due
               Date were dropped from this grid on request -- both
               data points still come back from the API (row-menu
               logic and other screens may still use them), they are
               just no longer rendered here. Source and Severity were
               dropped from the grid on the same request -- Source is
               still available as a filter (gapFilterSource below), and
               both values still come back from the API for any other
               caller. *@
            <thead>
                <tr>
                    <th>Gap</th>
                    <th>Status</th>
                    <th>Practice Instance Status</th>
                    <th>Task Status</th>
                    <th>Risk Status</th>
                    <th>Exception Status</th>
                    <th>Owner</th>
                    <th>Raised On</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="gapBody">
                <tr><td colspan="9" class="pm-empty">Select an organization to load gaps.</td></tr>
            </tbody>
        </table>
    </div>
    <div class="pm-pager" data-pager="all">
        <button class="pm-button" data-pg="prev" type="button">Previous</button>
        <span data-pg="label">Page 1</span>
        <button class="pm-button" data-pg="next" type="button">Next</button>
        <span data-pg="total" class="pm-pager-total">0 total</span>
    </div>

</section>

@* ---------- Add Custom Gap dialog ---------- *@
<dialog id="newCustomGapDialog" style="border:none; border-radius:8px; padding:0; max-width:820px; width:94%; max-height:96vh; overflow:auto; box-shadow:0 10px 40px rgba(15,23,42,.25);">
    <form id="newCustomGapForm" method="dialog" style="margin:0; padding:14px 24px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h2 style="margin:0; font-size:18px;">Add Custom Gap</h2>
            <button type="button" id="newGapClose" aria-label="Close" style="background:none; border:none; font-size:20px; cursor:pointer;">&times;</button>
        </div>
        <div id="newGapMessage" style="display:none; margin-bottom:10px; padding:8px 12px; border-radius:4px; font-size:13px;"></div>
        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:8px 12px; margin-bottom:14px;">
            <div style="font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:.04em;">Organization</div>
            <div id="newGapOrgLabel" style="font-weight:600; color:#0f172a;">-</div>
        </div>
        <div style="display:grid; grid-template-columns:1fr; gap:8px;">
            <div style="display:grid; grid-template-columns:170px 1fr; gap:10px; align-items:end;">
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Gap Type
                    <input id="newGapType" type="text" value="Custom" readonly
                           style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; background:#f1f5f9;" />
                </label>
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;"><span>Title <span style="color:#b91c1c;">*</span></span>
                    <input id="newGapTitle" type="text" maxlength="250" required
                           style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
                </label>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Description
                    <textarea id="newGapDescription" rows="2" maxlength="4000"
                              style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; resize:vertical;"></textarea>
                </label>
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Remarks
                    <textarea id="newGapRemarks" rows="2" maxlength="1000"
                              style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px; resize:vertical;"></textarea>
                </label>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Priority
                    <select id="newGapPriority" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;">
                        <option value="Low">Low</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </label>
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Status
                    <select id="newGapStatus" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;">
                        <option value="Open" selected>Open</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Closed">Closed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </label>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Owner
                    <select id="newGapOwner" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;">
                        <option value="">Loading employees...</option>
                    </select>
                </label>
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Due Date
                    <input id="newGapDueDate" type="date"
                           style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;" />
                </label>
            </div>
            @* Migration 250: Detection Method + Severity captured at Add
               time. For a Custom gap the analysis form no longer has to
               fake "auto" values -- these two flow through the header and
               pre-fill the analysis card the first time it opens. Both
               dropdowns match the vocabularies the analysis form uses,
               so a value picked here maps 1:1 to the analysis field. *@
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Detection Method
                    <select id="newGapDetectionMethod" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;">
                        <option value="">--</option>
                        <option value="Manual">Manual review</option>
                        <option value="Assurance">Assurance observation</option>
                        <option value="Audit">Audit finding</option>
                        <option value="AutoScan">Automated scan</option>
                        <option value="External">External report</option>
                    </select>
                </label>
                <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Severity
                    <select id="newGapSeverity" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; margin-top:2px;">
                        <option value="">-- default from priority --</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </label>
            </div>
            @* Migration 382: map relevant Practice(s), reusing the same
               cascading Practice Picker used by Risk Analysis. *@
            <div style="margin-top:6px;">
                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <label style="font-size:12px; color:#475569; font-weight:600;">Mapped Practices <span style="color:#b91c1c;">*</span></label>
                    <button type="button" id="newGapMapPracticeBtn" class="pm-button" style="padding:4px 10px; font-size:12px;">
                        <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Map practice
                    </button>
                </div>
                <div id="newGapPracticeList" style="margin-top:6px; display:flex; flex-wrap:wrap; gap:6px;">
                    <span class="pm-hint" style="font-size:12px; color:#94a3b8;">No practices mapped yet.</span>
                </div>
            </div>
        </div>
        <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:12px;">
            <button type="button" id="newGapCancel" class="pm-button">Cancel</button>
            <button type="submit" id="newGapSubmit" class="pm-button primary">Create Gap</button>
        </div>
    </form>
</dialog>

@* Migration 382: Map-a-practice dialog for the Add Custom Gap form.
   Reuses the shared cascading Practice Picker (practice-picker.js,
   migration 282) exactly as Risk Centre's #riskMapPracticeModal does. *@
<dialog id="gapMapPracticeModal" style="border:none; border-radius:8px; padding:0; max-width:720px; width:94%; max-height:92vh; overflow:auto; box-shadow:0 10px 40px rgba(15,23,42,.25);">
