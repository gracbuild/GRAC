<style>
    #argRoot .arg-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    #argRoot .arg-head-main { display: flex; align-items: center; gap: 12px; }
    #argRoot .arg-head-title { font-size: 15px; font-weight: 600; color: var(--fg-strong); }
    #argRoot .arg-head-meta { font-size: 12px; color: var(--fg-secondary); margin-top: 2px; }
    #argRoot .arg-head-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .arg-note { color: var(--fg-secondary); font-size: 12px; margin: 0 0 8px; }
    .arg-section { margin-bottom: 16px; }
    .arg-section h3 { font-size: 13px; font-weight: 600; color: var(--fg-strong); margin: 0 0 8px; }
    .arg-field small.arg-help { color: var(--fg-muted); font-size: 11px; }
    .arg-field.arg-invalid input, .arg-field.arg-invalid select, .arg-field.arg-invalid textarea { border-color: var(--danger-700); }
    .arg-req { color: var(--danger-700); }
    .arg-qty { display: flex; gap: 6px; }
    .arg-qty input:first-child { flex: 0 0 40%; }
    .arg-issues ul { margin: 0; padding-left: 18px; font-size: 13px; }
    .arg-issues li.arg-error { color: var(--danger-700); }
    .arg-issues li.arg-warning { color: var(--warning-700); }
    .arg-check { display: inline-flex; gap: 4px; align-items: center; }
    .arg-decision { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: 4px 0; }
    .arg-chip { display: inline-block; padding: 2px 8px; border-radius: var(--radius-pill); font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .arg-ph-acquisition { background: var(--bg-subtle); color: var(--fg-secondary); }
    .arg-ph-readiness   { background: var(--primary-100); color: var(--primary-800); }
    .arg-ph-operation   { background: var(--success-100); color: var(--success-700); }
    .arg-ph-movement    { background: var(--primary-100); color: var(--primary-800); }
    .arg-ph-exception   { background: var(--danger-100); color: var(--danger-700); }
    .arg-ph-retirement  { background: var(--neutral-200); color: var(--fg-muted); }
    .arg-pending { background: var(--warning-50); border: 1px solid var(--warning-700); border-radius: var(--radius-md); padding: 12px; margin-bottom: 16px; }
    .arg-pending-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
    .pm-modal-panel.arg-wide { max-width: 1100px; width: 100%; }
    .arg-tech-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
    .arg-tech-head h3 { margin: 0; }
    .arg-tc-warn { background: var(--warning-50); color: var(--warning-700); }
    .arg-wf-steps { margin: 8px 0 12px; padding-left: 20px; font-size: 13px; }
    .arg-wf-steps li.arg-wf-done { color: var(--success-700); }
    .arg-wf-steps li.arg-wf-current { font-weight: 600; color: var(--fg-strong); }
    .arg-wf-steps li.arg-wf-todo { color: var(--fg-muted); }
    .arg-wf-sub { font-size: 13px; font-weight: 600; color: var(--fg-strong); margin: 16px 0 8px; }
</style>

