<style>
    .aco-note { color: var(--fg-secondary); font-size: 12px; margin: 0 0 8px; }
    .aco-check { display: inline-flex; gap: 4px; align-items: center; }
    .aco-chip { display: inline-block; padding: 2px 8px; border-radius: var(--radius-pill); font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .aco-st-open    { background: var(--primary-100); color: var(--primary-800); }
    .aco-st-wait    { background: var(--warning-50); color: var(--warning-700); }
    .aco-st-active  { background: var(--success-100); color: var(--success-700); }
    .aco-st-ended   { background: var(--neutral-200); color: var(--fg-muted); }
    .aco-st-bad     { background: var(--danger-100); color: var(--danger-700); }
    .aco-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .pm-modal-panel.aco-wide { max-width: 1100px; width: 100%; }
    .aco-info { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px 16px; font-size: 13px; margin-bottom: 12px; }
    .aco-info span { display: block; color: var(--fg-secondary); font-size: 11px; }
    .aco-sub { font-size: 13px; font-weight: 600; color: var(--fg-strong); margin: 16px 0 8px; }
    .aco-warnings { margin: 0 0 12px; padding-left: 18px; color: var(--warning-700); font-size: 13px; }
    .aco-changed td { background: var(--warning-50); }
    tr[data-aco-contract], tr[data-aco-version], tr[data-aco-renewal] { cursor: pointer; }
    .aco-pick { max-height: 260px; overflow-y: auto; }
</style>

