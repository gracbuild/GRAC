@*
    Resolve workspace -- one practice instance
    Screen key: `resolve-workspace`

    Everything an instance still needs, on one page:
        1. its details, as a compact header strip
        2. an obligation card per published obligation, adopted or not
        3. a dependency card per declared category

    LAYOUT
    ------
    Two columns on a wide screen, one on a narrow one, and each card is
    collapsed to a summary line until it is opened. The point is that the
    outstanding work is visible without scrolling: a card that is done
    stays one line, only what needs attention takes space.

    The obligation edit fields appear inside the card that owns them, so
    "adopt as published" is one tick and "adopt with our own parameters"
    is that tick plus the fields underneath -- no second dialog, no
    separate mode.
*@
@model PracticeManagement.Web.Models.PracticeScreen

<style>
    #rwRoot .pm-hint { color: var(--grac-muted, #758095); font-size: 12px; margin: 0 0 10px; }
    #rwRoot .pm-panel-title { font-size: 14px; font-weight: 600; margin: 0; color: var(--grac-ink, #25345a); }
    #rwRoot .pm-badge, .pm-page-heading .pm-badge {
        display: inline-block; padding: 1px 7px; border-radius: 10px;
        background: var(--grac-line, #e2e7f0); color: var(--grac-ink, #25345a);
        font-size: 11px; font-weight: 600;
    }

    /* Read-only view (URL ?mode=view). Every action button vanishes AND
       every field is disabled (see the MutationObserver in init() -- this
       stylesheet only covers how a disabled field looks, not which fields
       get disabled). Applies across obligations, dependencies, profile,
       evidence and the retire strip -- one place, one rule, so a new
       button never sneaks through by accident.

       .pm-button, .pm-icon-button, [type="submit"] and role="menuitem"
       cover every action shape currently on the page. Anchors used as
       navigation (like rwBackBtn) are pm-button too, so they stay
       clickable via the exception below. */
    #rwRoot.rw-view-only .pm-button:not(#rwBackBtn),
    #rwRoot.rw-view-only .pm-icon-button,
    #rwRoot.rw-view-only [role="menuitem"],
    #rwRoot.rw-view-only button[type="submit"],
    #rwRoot.rw-view-only .rw-card-actions,
    #rwRoot.rw-view-only .rw-sticky { display: none !important; }
    #rwRoot.rw-view-only .rw-view-only-banner {
        display: block; margin: 0 0 10px; padding: 6px 10px;
        background: #f8fafc; border: 1px dashed var(--grac-line, #e2e7f0);
        border-radius: 6px; color: var(--grac-muted, #758095); font-size: 12px;
    }
    /* A disabled field here is one waiting to be looked at, not a broken
       one -- keep its value legible instead of greying it into the
       background. Same treatment .pp-root select:disabled already uses
       in practice-management.css, reused here since #rwRoot is a
       different root and does not inherit it. */
    #rwRoot.rw-view-only input:disabled,
    #rwRoot.rw-view-only select:disabled,
    #rwRoot.rw-view-only textarea:disabled {
        background: #f6f8fc; color: var(--grac-muted, #758095); cursor: default;
        opacity: 1;
    }

    /* Header strip: the instance facts, one line of chips, no scrolling.
       Below it, the profile edit row lines up with the same chips, so
       both rows should breathe and share horizontal rhythm. */
    #rwRoot .rw-facts {
        display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 0 0 16px;
    }
    #rwRoot .rw-facts div { min-width: 150px; }
    #rwRoot .rw-facts dt {
        font-size: 10px; text-transform: uppercase; letter-spacing: .04em;
        color: var(--grac-muted, #758095);
    }
    #rwRoot .rw-facts dd { margin: 0; font-size: 13px; color: var(--grac-ink, #25345a); }

    /* Stacked, not side by side.
       Obligations first, dependencies underneath.

       These were two columns on a wide screen. An obligation card now
       opens to a typed detail block that can run to a dozen labelled
       fields (see .rw-typed below), and half a screen is not enough
       width for it -- the columns turned every open card into a narrow
       ribbon of wrapped text. Reading order is also the working order:
       adopt the obligations, then resolve what they depend on. */
    #rwRoot .rw-columns {
        display: block; margin-top: 14px;
    }
    #rwRoot .rw-columns > .pm-panel + .pm-panel { margin-top: 14px; }

    /* Typed obligation detail -- what the admin module captured for this
       obligation's type. Definition-list rather than the free-form
       .rw-published strip it replaces, because the field NAMES differ
       per type and have to be visible. */
    #rwRoot .rw-typed {
        border: 1px solid var(--grac-line, #e2e7f0); border-radius: 6px;
        background: #f8fafc; padding: 10px 12px; margin: 10px 0;
    }
    #rwRoot .rw-typed h4 {
        margin: 0 0 8px; font-size: 12px; font-weight: 600;
        color: var(--grac-ink, #25345a);
    }
    #rwRoot .rw-typed h4 .pm-badge { margin-left: 6px; }
    #rwRoot .rw-typed-item + .rw-typed-item {
        margin-top: 10px; padding-top: 10px;
        border-top: 1px dashed var(--grac-line, #e2e7f0);
    }
    /* auto-FILL, not auto-fit, and a capped track.
       auto-fit collapses the tracks nothing landed in and stretches the
       survivors to 1fr, so an item rendering three short values ("Monthly",
       "5 days", "Yes") got three ~350px columns with the value pinned to
       the left of each. genericFields drops every empty value, so that was
       the normal case, not the edge case. auto-fill keeps the empty tracks
       and the 220px cap stops any one value sprawling. */
    #rwRoot .rw-typed dl {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(170px, 220px));
        gap: 6px 18px; margin: 0;
    }
    #rwRoot .rw-typed dt {
        font-size: 10px; text-transform: uppercase; letter-spacing: .04em;
        color: var(--grac-muted, #758095);
    }
    #rwRoot .rw-typed dd {
        margin: 0 0 4px; font-size: 13px; color: var(--grac-ink, #25345a);
        overflow-wrap: anywhere;
    }
    /* A rule reads as a sentence -- attribute, operator, value -- so it
       gets one wide line rather than three cramped columns. */
    #rwRoot .rw-typed dl .rw-span { grid-column: 1 / -1; }
    #rwRoot .rw-typed .rw-rule {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 13px;
    }
    #rwRoot .rw-description {
        margin: 10px 0; font-size: 13px; color: var(--grac-ink, #25345a);
        white-space: pre-wrap;
    }

    /* Published detail beside the organisation's answers.
       minmax(0, 1fr) rather than 1fr: a grid track's default minimum is
       min-content, and one long unbroken value (a URL, a locator) would
       otherwise push its column wider than half and shove the other one
       off. Below 1000px the two stack, which is the pre-existing layout --
       half of a narrow card is not enough for either side. */
    #rwRoot .rw-split {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 0 16px; align-items: start;
    }
    @@media (max-width: 1000px) {
        #rwRoot .rw-split { grid-template-columns: minmax(0, 1fr); }
    }
    /* Same chrome as .rw-typed so the pair reads as two of a kind rather
       than a titled box next to a loose form. Margin matches .rw-typed's
       so the two columns start on the same line. */
    #rwRoot .rw-answers {
        border: 1px solid var(--grac-line, #e2e7f0); border-radius: 6px;
        background: #fff; padding: 10px 12px; margin: 10px 0;
    }
    #rwRoot .rw-answers h4 {
        margin: 0 0 8px; font-size: 12px; font-weight: 600;
        color: var(--grac-ink, #25345a);
    }
    /* Scoped to this column, not to .rw-fields generally -- the profile
       box and the dialog use the same class and are not in a split.
       Two tracks at most, so a card whose only inputs are Owner and
       Implementation status does not render one select half a card wide. */
    #rwRoot .rw-answers .rw-fields {
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    }
    @@media (min-width: 1001px) {
        #rwRoot .rw-answers .rw-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        #rwRoot .rw-answers .rw-fields .full { grid-column: 1 / -1; }
    }
    /* The .rw-dialog* and .rw-evidence-line rules that used to sit here
       styled the inline add/edit obligation modal. They moved with it into
       Partials/_obligation-form-dialog.cshtml, renamed to a `gof-` prefix
       and made self-contained -- half of what the modal borrowed was
       scoped to #rwRoot, so on any other page (Practice View authors the
       same form) that half would have rendered unstyled. */

    #rwRoot .rw-description-label {
        font-size: 10px; text-transform: uppercase; letter-spacing: .04em;
        color: var(--grac-muted, #758095); display: block; margin-bottom: 2px;
    }

    #rwRoot .rw-card {
        border: 1px solid var(--grac-line, #e2e7f0); border-radius: 8px;
        background: #fff; margin-bottom: 8px; overflow: hidden;
    }
    #rwRoot .rw-card.adopted  { border-left: 3px solid #16a34a; }
    #rwRoot .rw-card.modified { border-left: 3px solid #2563eb; }
    #rwRoot .rw-card.resolved { border-left: 3px solid #16a34a; }
    #rwRoot .rw-card.pending  { border-left: 3px solid #d97706; }

    /* The whole summary row is the toggle, so a card opens without hunting
       for a chevron. */
    #rwRoot .rw-card-head {
        display: flex; align-items: center; gap: 10px;
        padding: 9px 12px; cursor: pointer; width: 100%;
        background: none; border: 0; text-align: left; font: inherit;
    }
    #rwRoot .rw-card-head:hover { background: #f8fafc; }
    #rwRoot .rw-card-title { flex: 1 1 auto; font-size: 13px; color: var(--grac-ink, #25345a); }
    #rwRoot .rw-card-title small { display: block; color: var(--grac-muted, #758095); font-size: 11px; }
    #rwRoot .rw-card-body { padding: 0 12px 12px; border-top: 1px solid var(--grac-line, #e2e7f0); }
    #rwRoot .rw-card-body[hidden] { display: none; }

    /* .rw-published removed with migration 224 -- the fixed four-fact
       strip it styled is now .rw-typed, which is driven by the
       obligation's type. */

    #rwRoot .rw-fields {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 10px 16px; align-items: end;
    }
    #rwRoot .rw-fields label { display: block; font-size: 11px; color: var(--grac-muted, #758095); }
    #rwRoot .rw-fields input, #rwRoot .rw-fields select, #rwRoot .rw-fields textarea {
        width: 100%; font-size: 12px; padding: 4px 6px;
        border: 1px solid var(--grac-line, #e2e7f0); border-radius: 5px;
    }
    #rwRoot .rw-fields .full { grid-column: 1 / -1; }
    #rwRoot .rw-card-actions { display: flex; gap: 8px; align-items: center; margin-top: 10px; }
    #rwRoot .rw-resolve-form {
        border: 1px solid var(--grac-line, #e2e7f0); border-radius: 8px;
        background: #f8fafc; padding: 12px; margin-bottom: 12px;
    }

    /* Instance Profile is its own .pm-panel now, sibling to the Facts
       panel above it -- was one row stacked under the read-only facts
       inside a single panel, which read as one editable field among
       non-editable ones with nothing marking where the line was. Same
       14px gap the Obligations/Dependencies panels already use for
       "next panel down" (.rw-columns > .pm-panel + .pm-panel below),
       just not scoped to .rw-columns since this pair sits above it. */
    #rwRoot > .pm-panel + .pm-panel { margin-top: 14px; }
    /* Pin the Save button to the bottom edge so it aligns with the
       select inputs (which sit under their labels). */
    #rwRoot .rw-freq-actions {
        display: flex; align-items: end; gap: 8px;
        padding-bottom: 1px; /* baseline nudge to sit flush with select bottom */
    }
    #rwRoot .rw-freq-actions .pm-button { align-self: end; }

    /* Evidence sits inside the obligation that produced it, indented so
       the nesting is obvious without another level of card chrome. */
    #rwRoot .rw-evidence {
        margin-top: 12px; padding-top: 10px;
        border-top: 1px dashed var(--grac-line, #e2e7f0);
    }
    #rwRoot .rw-evidence h4 {
        margin: 0 0 4px; font-size: 12px; text-transform: uppercase;
        letter-spacing: .04em; color: var(--grac-muted, #758095);
    }
    #rwRoot .rw-evidence-row {
        border-left: 2px solid #d97706; padding: 8px 0 8px 10px; margin-top: 8px;
    }
    #rwRoot .rw-evidence-row.done { border-left-color: #16a34a; }
    /* Migration 334. An evidence row the operator can fill in BEFORE the
       obligation is adopted. Its practice_instance_evidence row does not
       exist yet -- it is created by the same Save that adopts the
       obligation -- so the rule is dashed rather than solid: the fields
       are real and will be saved, but nothing is stored behind them yet.
       Same colour as the unresolved state, because that is what it is. */
    #rwRoot .rw-evidence-row.pending { border-left-style: dashed; }
    #rwRoot .rw-evidence-head {
        display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: 13px;
    }
    /* Evidence keeps the full card width, but its short inputs stop
       stretching to fill it -- with .rw-fields' auto-fit, Location and
       Locator were two ~650px boxes on a wide screen while the split above
       them sat in tidy columns. Capped tracks for the short fields; .full
       still spans every track, so Evidence name and Description keep the
       width that long text actually needs. */
    #rwRoot .rw-evidence .rw-fields {
        grid-template-columns: repeat(auto-fill, minmax(220px, 360px));
    }
    #rwRoot .rw-note { font-size: 11px; color: var(--grac-muted, #758095); }
    /* Migration 306. The published remark sits between the evidence head
       and its input grid, so it needs its own margins -- .rw-note carries
       none, and against the head the sentence read as part of the title.
       pre-wrap because a remark is authored text and its line breaks are
       the author's, the same treatment practice-view gives it. */
    #rwRoot .rw-evidence-remark {
        margin: 0 0 8px; line-height: 1.45; white-space: pre-wrap;
    }
    #rwRoot .rw-warn { color: #b45309; }
    #rwRoot .rw-ok   { color: #166534; }
    #rwRoot .rw-sticky {
        position: sticky; bottom: 0; background: #fff; padding: 10px 0;
        border-top: 1px solid var(--grac-line, #e2e7f0); display: flex; gap: 8px; align-items: center;
    }
</style>

<div class="pm-page-heading compact">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1 id="rwHeading">Operationalize</h1>
        <p id="rwSubheading">Loading...</p>
    </div>
    <div>
        @* Migration 222. Migration 139 reserved retirement for the Practice
           Instances screen -- "Retiring an instance stays an explicit act" --
           which is the last thing that screen was needed for. It is an act,
           not a field, so it sits with the page actions rather than in the
           profile box, and it confirms before it fires. *@
        <button class="pm-button ghost" id="rwRetireBtn" type="button" hidden>
            <i class="fa-solid fa-box-archive"></i> Retire instance
        </button>
        @* 287. The other half of the door. Retire was one-way until now:
           a retired instance dropped out of every list and nothing could
           bring it back. Exactly one of these two is ever visible, so
           the action area does not grow. *@
        <button class="pm-button ghost" id="rwRestoreBtn" type="button" hidden>
            <i class="fa-solid fa-box-open"></i> Restore instance
        </button>
        <a class="pm-button ghost" id="rwBackBtn" href="#"><i class="fa-solid fa-arrow-left"></i> Back to Resolve</a>
    </div>
</div>

@* 287. A retired instance opens normally -- its obligations, evidence
   and history are all still there and are exactly what someone opening
   it wants to read. What must not happen is a reader taking it for a
   live one, so the state is stated before the content rather than left
   to be inferred from a missing button. *@
<div class="pm-note pm-note-warn" id="rwRetiredBanner" hidden>
    <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
    <span><strong>This practice instance is retired.</strong>
          It no longer appears in work queues or assurance scheduling.
          Its obligations, evidence and history are kept, and
          <em>Restore instance</em> brings it back.</span>
</div>

<section class="pm-panel" id="rwUnavailable" hidden>
    <div class="pm-empty">
        <i class="fa-solid fa-link pm-empty-icon" aria-hidden="true"></i>
        <h2 id="rwUnavailableTitle">This practice instance could not be opened.</h2>
        <p id="rwUnavailableBody">Open it from the Resolve list.</p>
    </div>
</section>

<div id="rwRoot" hidden>
    @* Read-only facts, on their own -- was the top half of the panel
       below, which put a plain summary and an editable form in one
       box with nothing marking the line between them. Split into its
       own .pm-panel so "look" and "edit" read as two different things,
       the way Obligations/Dependencies below are already separate
       panels rather than one. *@
    <section class="pm-panel">
        <dl class="rw-facts" id="rwFacts"></dl>
    </section>

    @* The instance-level Save frequency box was retired. Frequency now
       belongs to each obligation, and is only meaningful for the types
       that use it (Execution and Assurance) -- so a single instance-
       wide cadence was a value that could not answer for a mixed
       obligation set.

       The practice_instance columns (execution_frequency_id,
       assurance_frequency_id, frequency_id, frequency_type) still
       exist and are still populated by sp_practice_instance_configure
       for the Calendar page's assurance-schedule generator. Nothing
       else reads them from the UI now. *@

    @* Migration 222 -- the instance's own profile, in its own panel
       (was a second, unlabelled row inside the facts panel above --
       see the note on #rwRoot > .pm-panel + .pm-panel in the <style>
       block for why the two were split).

       These four were captured only on the Practice Instance form.
       Unlike frequency they are not derived from anything: nobody
       publishes an organisation's criticality, so this is where they
       are decided.

       Owner is admin-only. Every Resolve procedure scopes a non-admin
       to the instances they own, so an owner who reassigned their own
       instance would lose it on save. The server refuses it too
       (52673); this only decides whether the control appears. *@
    <section class="pm-panel" id="rwProfileBox" hidden>
        <div class="pm-toolbar" style="padding:0 0 6px">
            <h2 class="pm-panel-title">Instance Profile</h2>
        </div>
        <div class="rw-fields">
            <div><label>Practice type
                <select id="rwPracticeType">
                    <option value="">Not set</option>
                    <option value="Manual">Manual</option>
                    <option value="Automated">Automated</option>
                </select>
            </label></div>
            <div><label>Criticality
                <select id="rwCriticality">
                    <option value="">Not set</option>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </label></div>
            <div><label>Business function
                <select id="rwBusinessFunction"><option value="">Not set</option></select>
            </label></div>
            <div id="rwOwnerField" hidden><label>Owner
                <select id="rwOwner"><option value="">Not set</option></select>
            </label></div>
            <div class="rw-freq-actions">
                <button class="pm-button ghost small" id="rwProfileSave" type="button">
                    <i class="fa-solid fa-floppy-disk"></i> Save profile
                </button>
                <span class="rw-note" id="rwProfileMsg"></span>
            </div>
        </div>
        <p class="rw-note" id="rwProfileNote">How this instance is carried out and how much it matters.</p>
    </section>

    <div class="rw-columns">
        <section class="pm-panel">
            <div class="pm-toolbar" style="padding:0 0 6px">
                <h2 class="pm-panel-title">Obligations</h2>
                <span class="pm-badge" id="rwObligationCount"></span>
                <button class="pm-button ghost small" id="rwExpandAll" type="button">Expand all</button>
                <button class="pm-button ghost small" id="rwCollapseAll" type="button">Collapse all</button>
                @* Migration 227. An organisation can add an obligation of
                   its own alongside the published ones. *@
                <button class="pm-button small" id="rwAddObligation" type="button" hidden>
                    <i class="fa-solid fa-plus"></i> Add obligation
                </button>
            </div>

            @* The add / edit obligation form used to live here inline --
               ~110 lines of dialog and ~600 of JS. It is now the shared
               component Partials/_obligation-form-dialog.cshtml +
               wwwroot/js/Shared/obligation-form.js, included at the bottom
               of this file, because Practice View authors the same kind of
               obligation at practice level and a second copy of the form
               would mean two validations and two field lists.

               This screen opens it with scope "instance", which is exactly
               the behaviour that was here: same endpoint, same payload,
               same fields. See openLocalForm below -- it is now an adapter
               that hands the row and the lookups over. *@
            <p class="pm-hint">
                Published against this practice by the authority, from releases this
                organization subscribes to. Tick one to take it on as published, or
                open it and change the parameters that differ here.
            </p>
            <div class="pm-message" id="rwObligationMessage" style="display:none"></div>
            <div id="rwObligations"><div class="pm-empty compact">Loading obligations...</div></div>
            @* Migration 245 -- bulk sticky Save is retired. Each obligation
               card now carries its own Save that flushes the obligation
               and any dirty evidence rows for it in one click, and the
               API side then reconciles the persistent gap tables. The
               dirty counter still lives here as a summary. *@
            <div class="rw-sticky" id="rwObligationBar" hidden>
                <span class="rw-note" id="rwObligationDirty"></span>
            </div>
        </section>

        @* Migration 238 -- the dependency table.

           Practice Instance stopped declaring categories, so the declared
           set is now decided here: tick a row, pick the objects, save. An
           empty pick against a ticked row saves nothing yet; unticking a
           category with objects clears them (the procedure retires the
           resolutions and the matching declaration rows).

           Tool and Application were retired from the workspace view --
           the master rows stay in dependency_type_master so historical
           resolutions still render, but they are not offered as new
           options here. *@
        <section class="pm-panel">
            <div class="pm-toolbar" style="padding:0 0 6px">
                <h2 class="pm-panel-title">Dependencies</h2>
                <span class="pm-badge" id="rwDependencyCount"></span>
            </div>
            <p class="pm-hint">
                Answer every category: <strong>Yes</strong> if this instance depends on it,
                then pick the objects that resolve it -- <strong>No</strong> if it does not.
                Rows saved as No clear their stored resolutions. Save is available once
                nothing is left on Select.
            </p>
            <div class="pm-message" id="rwDependencyMessage" style="display:none"></div>

            @* Category first, then Applicability: the question is "does
               this instance depend on Asset?", so the thing being asked
               about has to come before the answer to it. The answer used
               to lead, which read as a column of Yes/No with the subject
               to its right.

               Applicability is Select / Yes / No and starts at Select --
               an unanswered row. Anything other than Yes leaves the row's
               editors disabled, so a category the instance does not
               depend on reads as inert rather than half-filled. Store
               contract unchanged: Yes = apply the objects, anything else
               = save an empty resolution set. *@
            <table class="pm-table rw-dep-table" id="rwDepTable" style="width:100%;table-layout:fixed">
                <thead>
                    <tr>
                        <th style="width:160px">Category</th>
                        <th style="width:130px">Applicability</th>
                        <th style="width:auto">Objects</th>
                    </tr>
                </thead>
                <tbody id="rwDepTableBody">
                    <tr><td colspan="3"><div class="pm-empty compact">Loading dependencies...</div></td></tr>
                </tbody>
            </table>

            @* Disabled in the markup: only a rendered table can say
               whether every category has been answered, so the button is
               enabled by syncDepSaveState and by nothing else. A load
               that fails therefore leaves it off rather than offering to
               save a table that is not on screen. *@
            <div class="rw-sticky" id="rwDepSaveBar" hidden>
                <button class="pm-button primary" id="rwDepSaveAll" type="button" disabled>
                    <i class="fa-solid fa-floppy-disk"></i> Save dependencies
                </button>
                <span class="rw-note" id="rwDepSaveHint"></span>
            </div>
        </section>
    </div>
</div>

<partial name="Partials/_workflow-common" model="Model" />

@*
    The add / edit obligation form. Included once, before the script
    below, so window.gracObligationForm exists by the time init() primes
    it -- the same shape the shared task form is included with in
    tasks.cshtml and risk-centre.cshtml.
*@
<partial name="Partials/_obligation-form-dialog" />
<script src="~/js/Shared/obligation-form.js" asp-append-version="true"></script>

<script>
(function () {
    'use strict';
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();

    const U    = p => String(window.appBasePath || window.pmPathBase || '').replace(/\/+$/, '') + p;
    const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || '';
    const esc  = v => window.__wfCommon.escape(v);
    // 291. "Vinod - Risk Owner" for the dependency Person picker. Same
    // delegation as esc above, so the format is defined once and the
    // Risk Centre pickers render people identically.
    const personWithRole = (n, r) => window.__wfCommon.personWithRole(n, r);

    let instanceId = null, orgId = null, instance = null;
    let obligations = [], frequencies = [], employees = [], evidence = [];
    // Migration 342: the functional-user subset of `employees`, used for the
    // Instance Owner picker (owners must be Functional Users). `employees`
    // itself stays the full org-scoped list -- it also resolves stored owner
    // names for display (ownerIdOf), which must match legacy owners too.
    let functionalEmployees = [], functionalOwnerIds = null;
    let functionalOwnersFetch = null;
    // Migration 222. isAdmin decides whether the Owner control appears;
    // businessFunctions and dependencyTypes back the profile and category
    // editors. All three default to "nothing", so a database that has not
    // run 222 simply leaves those editors hidden.
    let isAdmin = false, businessFunctions = [], dependencyTypes = [];
    // Migration 226. Responsibility and Approval authority are chosen from
    // the organisation's own Role Master rather than typed, so the same
    // role is not recorded under five spellings.
    let roles = [];
    // Fixed, like the Practice type on the instance profile -- these two
    // values are the vocabulary, not configurable master data, and the
    // CHECK constraint on practice_instance_obligation says so.
    const assuranceTypes = [
        { value: 'Manual',    label: 'Manual' },
        { value: 'Automated', label: 'Automated' }
    ];
    // Migration 242: implementation status master (Not Started, In
    // Progress, Fully Implemented, Partially Implemented, Not Implemented,
    // N/A). Populated by loadLookups from the master endpoint; empty
    // until the fetch lands, so the dropdown shows just the placeholder
    // during that window.
    let implementationStatuses = [];
    // Migration 244: connection_type_master rows (API today; SDK / JDBC /
    // SSH etc. are added to the table -- no code change). Loaded by
    // loadConnectionTypes() the first time an obligation card renders a
    // connection dropdown. Cached across renders through a promise on
    // ensureConnectionTypes.
    let connectionTypes = [];
    let connectionTypesFetch = null;
    // Migration 232. Evidence types -- the obligation form's picker, and
    // the read-side renderer's lookup for an evidence_type_id. Filled by
    // loadLookups from the shared lookups feed.
    let evidenceTypes = [];

    // The shared obligation form (Shared/obligation-form.js). Resolved on
    // use rather than captured, because the script tag that defines it
    // sits above this one but the module is what owns the two
    // vocabularies below.
    const obligationForm = () => window.gracObligationForm;

    // Migration 230. The Assurance vocabulary has one home -- the shared
    // form fetches it, and this screen reads the result rather than
    // fetching the same endpoint a second time. Empty until prime()
    // lands, which is also what a database without 230 leaves it.
    const vocabulary = () => (obligationForm()
        ? obligationForm().vocabulary()
        : { triggerModes: [], eventTypes: [] });
    const dirty = new Set();          // obligation ids with unsaved edits
    const open  = new Set();          // expanded card keys
    // mode=view opens the workspace read-only -- every action control
    // (Save profile, Retire instance, per-obligation Save, Add obligation,
    // dependency save, evidence save) is hidden, AND every input/select/
    // textarea on the page is disabled, so nothing can be typed into or
    // changed even though it cannot be saved. The Resolve list's 3-dot
    // menu reaches this URL with &mode=view.
    let readOnlyView = false;

    // ------------------------------------------------------------------
    async function init() {
        const q = new URLSearchParams(window.location.search);
        instanceId = Number(q.get('instanceId') || 0) || null;
        orgId      = Number(q.get('organizationId') || 0) || null;
        readOnlyView = String(q.get('mode') || '').toLowerCase() === 'view';

        document.getElementById('rwBackBtn').href = U('/Practice/Index/resolve');
        if (!instanceId) {
            return unavailable('No practice instance was identified in the link.',
                               'Open it from the Resolve list.');
        }

        // Read-only mode: mark rwRoot so a stylesheet hides every action
        // control -- every Save / Retire / Add button is display:none. Any
        // new action added below picks this up automatically as long as it
        // uses .pm-button or the retirement/save class conventions the CSS
        // selects on.
        if (readOnlyView) {
            document.getElementById('rwRoot').classList.add('rw-view-only');
            // A visible banner so it is obvious this page cannot be saved
            // from -- otherwise a viewer might try to type into a field and
            // wonder why it won't take input.
            const heading = document.getElementById('rwSubheading');
            if (heading) heading.textContent = (heading.textContent || '')
                + ' - view only';

            // Every field, not just the action buttons, is locked -- a
            // control that still looked editable (even though nothing
            // typed into it could ever be saved, with Save itself hidden)
            // read as broken rather than read-only. This covers plain
            // input/select/textarea plus the object picker's own trigger
            // button (.pm-checkcombo-trigger, data-checkcombo-trigger) --
            // it opens a checkbox menu of its own and is not a .pm-button,
            // so the rule above that hides every .pm-button does not reach
            // it. Disabled rather than hidden, same as the plain fields,
            // so its summary text (which asset/object is selected) stays
            // visible -- .pm-checkcombo-trigger:disabled already has a
            // legible style in practice-management.css, just never applied
            // here before. Most of this page's fields do not exist yet at
            // this point: obligations, dependencies, the profile form and
            // evidence rows all populate later via their own async loads,
            // and re-render again on every card expand, dependency edit
            // and evidence add. A one-time disable pass here would miss
            // all of that, so a MutationObserver disables every matching
            // control as soon as it appears in rwRoot, however it got
            // there, instead of this having to chase down and edit every
            // render function on the page by hand.
            const LOCK_SELECTOR = 'input, select, textarea, [data-checkcombo-trigger]';
            const lockFields = (root) => {
                root.querySelectorAll(LOCK_SELECTOR).forEach(el => { el.disabled = true; });
            };
            const rwRootEl = document.getElementById('rwRoot');
            lockFields(rwRootEl);
            new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    mutation.addedNodes.forEach((node) => {
                        if (node.nodeType !== 1) return;
                        if (node.matches && node.matches(LOCK_SELECTOR)) node.disabled = true;
                        lockFields(node);
                    });
                });
            }).observe(rwRootEl, { childList: true, subtree: true });
        }

        document.getElementById('rwExpandAll').addEventListener('click', function () {
            obligations.forEach(o => open.add('ob-' + keyOf(o)));
            renderObligations();
        });
        document.getElementById('rwCollapseAll').addEventListener('click', function () {
            obligations.forEach(o => open.delete('ob-' + keyOf(o)));
            renderObligations();
        });
        // Migration 245: rwSaveObligations is gone; each card now carries
        // its own Save button, wired in wireObligationCards().
        // rwFreqSave / saveFrequency retired -- instance no longer has a
        // frequency of its own; per-obligation frequency covers it.
        document.getElementById('rwProfileSave').addEventListener('click', saveProfile);
        // rwCategorySave / saveCategories retired -- the dependency table
        // (migration 238) does both the declaration and the resolution
        // in one action, so a separate "Save categories" button no longer
        // has anything to save.
        document.getElementById('rwDepSaveAll').addEventListener('click', saveAllDependencies);
        document.getElementById('rwRetireBtn').addEventListener('click', retireInstance);
        document.getElementById('rwRestoreBtn').addEventListener('click', restoreInstance);
        document.getElementById('rwAddObligation').addEventListener('click', function () { openLocalForm(null); });
        // Every other control of the add/edit obligation modal -- Cancel,
        // Close, Esc, Save, the Type cascade, the Assurance type cascade,
        // Add evidence -- is wired by the shared module itself, once, on
        // its first open. There is nothing left here to bind.

        // wireDependencyForm retired -- the table's Save is wired per row
        // in renderDependencyTable, so nothing lives outside a rendered
        // row that needs binding here.

        if (!(await loadInstance())) return;
        loadLookups();
        loadObligations();
        loadDependencies();
        loadDependencyTypes();
        // Warms the obligation type list and the Assurance vocabulary
        // (what loadObligationTypes + loadObligationVocabulary used to do
        // here) and settles whether the Add button can appear.
        primeObligationForm();
    }

    function unavailable(title, body) {
        document.getElementById('rwRoot').hidden = true;
        document.getElementById('rwSubheading').textContent = '';
        window.__wfCommon.unavailable('rwUnavailable', 'rwUnavailableTitle', 'rwUnavailableBody', title, body);
    }

    const F = (row, k) => row?.[k] ?? row?.[k.charAt(0).toUpperCase() + k.slice(1)] ?? null;

    // ---------- 1. Instance ------------------------------------------
    async function loadInstance() {
        try {
            const r = await fetch(U('/practice/api/workflow/resolve/instances/' + encodeURIComponent(instanceId))
                        + (orgId ? '?organizationId=' + encodeURIComponent(orgId) : ''),
                        { credentials: 'same-origin' });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
                // The API refuses an instance the caller does not own, so
                // say that rather than a bare HTTP code.
                unavailable('This practice instance could not be opened.',
                            body.error || ('HTTP ' + r.status));
                return false;
            }
            instance = body.data || body.Data;
            if (!instance) { unavailable('This practice instance could not be loaded.', ''); return false; }

            isAdmin = body.isAdmin === true || body.IsAdmin === true;
            orgId = orgId || Number(F(instance, 'organizationId') || 0) || null;
            renderInstance();
            renderProfile();
            renderRetire();
            document.getElementById('rwRoot').hidden = false;
            return true;
        } catch (err) {
            console.error('resolve-workspace: instance load failed', err);
            unavailable('This practice instance could not be loaded.', 'Check that the API is running.');
            return false;
        }
    }

    function renderInstance() {
        document.getElementById('rwHeading').textContent = F(instance, 'instanceName') || 'Operationalize';
        document.getElementById('rwSubheading').textContent =
            [F(instance, 'instanceCode'),
             [F(instance, 'practiceCode'), F(instance, 'practiceName')].filter(Boolean).join(' - '),
             F(instance, 'organizationName')].filter(Boolean).join('  |  ');

        // Execution and Assurance frequency were removed from this strip
        // when the instance stopped carrying a cadence of its own -- each
        // obligation now owns its frequency, and only the types that use
        // one (Execution, Assurance) hold it. Migration 236 stopped the
        // detail procedure projecting them at all.
        const facts = [
            ['Owner',          F(instance, 'ownerName')],
            ['Department',     F(instance, 'department')],
            ['Practice Type',  F(instance, 'assuranceMode')],
            ['Criticality',    F(instance, 'criticality')],
            ['Implementation', F(instance, 'implementationStatus')]
        ].filter(([, v]) => v);

        document.getElementById('rwFacts').innerHTML = facts
            .map(([k, v]) => '<div><dt>' + esc(k) + '</dt><dd>' + esc(v) + '</dd></div>').join('');
    }

    // renderFrequency / saveFrequency retired with rwFrequencyBox. The
    // instance no longer carries a cadence of its own -- every obligation
    // does, and only the types that need one (Execution, Assurance) hold
    // it. The remaining reader of pi.execution_frequency_id /
    // pi.assurance_frequency_id is the Calendar page's assurance-schedule
    // generator, which reads them straight from the DB.

    // ---------- lookups ----------------------------------------------
    // Frequencies for the edit fields, employees for a dependency's
    // resolution owner. Both come from the same lookups feed the rest of
    // the app uses; failure is not fatal -- the fields fall back to free
    // text and a blank owner list.
    //
    // THE EMPLOYEE LIST MUST BE FILTERED BY ORGANIZATION.
    // The lookups procedure returns every employee of every organization
    // the caller may see -- and for a system admin, every employee in the
    // database. Each row carries its OrganizationId for exactly this
    // reason, and practice.js narrows the same lookup with
    // lookupItemsFor(). Dropping that column here would offer a colleague
    // from another organization as this instance's resolution owner.
    //
    // Rows with no OrganizationId are global master data (frequencies,
    // criticalities) and are left alone.
    async function loadLookups() {
        try {
            const r = await fetch(U('/practice-management-gateway/lookups'), { credentials: 'same-origin' });
            if (!r.ok) return;
            const rows = rowsOf(await r.json());
            const pick = key => rows
                .filter(x => String(x.LookupKey ?? x.lookupKey ?? '') === key)
                .map(x => ({
                    value: String(x.Value ?? x.value),
                    label: String(x.Label ?? x.label ?? ''),
                    organizationId: String(x.OrganizationId ?? x.organizationId ?? '')
                }));

            // frequencies is still populated for the two type-specific
            // editors (Execution frequency and Assurance frequency inside
            // the typed panel, plus the local-obligation form). The
            // instance-level renderer that used to run here is gone.
            frequencies = pick('frequency-master');
            // Migration 248: the /lookups payload's 'implementation-status'
            // entry emits Value = status_code (kept for the Practice
            // Instance form). The Resolve save path writes an INT
            // (practice_instance_obligation.implementation_status_id),
            // so this workspace fetches the id-valued shim instead --
            // otherwise the parse to INT returns NULL and the row keeps
            // no status silently. ensureImplementationStatuses fills
            // `implementationStatuses` with id/name rows.
            //
            // The old pick('implementation-status') stayed as a fallback:
            // if the shim fetch fails (e.g. against a database without
            // 248 applied) the dropdown at least renders with labels,
            // and the save simply keeps the stored NULL rather than
            // corrupting anything.
            implementationStatuses = pick('implementation-status');

            const all = pick('users-id');
            // Fail closed: without an organization in hand, offer nobody
            // rather than everybody.
            employees = orgId
                ? all.filter(e => !e.organizationId || e.organizationId === String(orgId))
                : [];
            // Migration 342: narrow the Owner picker to Functional Users.
            // Derived from the same org-scoped `employees` list so the org
            // scoping is inherited; the full list is kept for name lookups.
            deriveFunctionalEmployees();
            ensureFunctionalOwners();

            // Business functions are organization-scoped master data, so
            // the same filter applies for the same reason -- offering
            // another organization's function would be refused by the
            // procedure (52676) after the user had already picked it.
            businessFunctions = orgId
                ? pick('business-functions').filter(b => !b.organizationId || b.organizationId === String(orgId))
                : [];

            // Role Master, organisation-scoped for the same reason as the
            // two above. The option VALUE is the role name, not the id:
            // practice_instance_obligation is an adoption snapshot -- it
            // already copies obligation_name out of GRAC_New -- and
            // renaming a role later should not silently rewrite what an
            // organisation recorded as its answer at adoption time.
            // De-duplicated by name, because two organisations the caller
            // can see may both have a role called Approver.
            const roleNames = new Set();
            roles = (orgId
                ? pick('roles').filter(r => !r.organizationId || r.organizationId === String(orgId))
                : []
            ).reduce(function (acc, r) {
                const name = String(r.label || '').trim();
                if (!name || roleNames.has(name)) return acc;
                roleNames.add(name);
                acc.push({ value: name, label: name });
                return acc;
            }, []);

            // Evidence types for the obligation modal (232). Global master
            // data, so no organisation filter.
            evidenceTypes = pick('evidence-types');

            // Migration 244: connection-type master. Fetched here so the
            // Connection type dropdown on an Automated-Assurance obligation
            // is populated the first time it appears. Failure is silent --
            // the dropdown is small, and an empty list still lets the URL
            // input do its job.
            ensureConnectionTypes();
            // Migration 248: id-valued implementation-status. Overwrites
            // the code-valued fallback set from pick() above so the
            // dropdown post the numeric id the schema requires.
            ensureImplementationStatuses();

            renderProfile();
            renderObligations();
            renderDependencies();
        } catch (_) { /* fields degrade to free text */ }
    }

    // Migration 248: id-valued implementation-status loader. Fetches
    // the shim proc and swaps the (code-valued) fallback array for one
    // whose Value is the master row's numeric id. Promise-cached like
    // ensureConnectionTypes below; failure keeps the fallback in place
    // so the dropdown still renders.
    let implementationStatusesFetch = null;
    function ensureImplementationStatuses() {
        if (implementationStatusesFetch) return implementationStatusesFetch;
        implementationStatusesFetch = fetch(U('/practice-management-gateway/implementation-status-id/query'), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type':  'application/json',
                'X-CSRF-TOKEN':  CSRF
            },
            body: JSON.stringify({ data: { pageNumber: 1, pageSize: 200 } })
        }).then(r => r.ok ? r.json() : { data: [] })
          .then(json => {
              const rows = rowsOf(json);
              if (rows.length) {
                  implementationStatuses = rows.map(x => ({
                      value: String(x.Value ?? x.value),
                      label: String(x.Label ?? x.label ?? '')
                  }));
                  // Any card already rendered from the fallback needs
                  // to pick up the id values so the next Save round-
                  // trips correctly.
                  renderObligations();
              }
              return implementationStatuses;
          }).catch(() => implementationStatuses);
        return implementationStatusesFetch;
    }

    // Migration 244: lazy loader shared between loadLookups (pre-fetch on
    // page open) and renderObligations (fallback if the pre-fetch failed
    // or the master lookup fetch was skipped). Promise-cached so parallel
    // calls collapse to one network request.
    function ensureConnectionTypes() {
        if (connectionTypesFetch) return connectionTypesFetch;
        connectionTypesFetch = fetch(U('/practice-management-gateway/connection-types/query'), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type':  'application/json',
                'X-CSRF-TOKEN':  CSRF
            },
            body: JSON.stringify({ data: { pageNumber: 1, pageSize: 200 } })
        }).then(r => r.ok ? r.json() : { data: [] })
          .then(json => {
              const rows = rowsOf(json);
              connectionTypes = rows.map(x => ({
                  value: String(x.Value ?? x.value),
                  label: String(x.Label ?? x.label ?? '')
              }));
              return connectionTypes;
          }).catch(() => { connectionTypes = []; return []; });
        return connectionTypesFetch;
    }

    // Migration 342: Functional-User-only owner list for the Instance Owner
    // picker. The `owners` shim returns only Functional Users; we keep just
    // the ids and intersect with the already-org-scoped `employees` list so
    // the picker offers this organization's Functional Users. Failure falls
    // back to the full employee list so the picker keeps working (no
    // functional filter available).
    function deriveFunctionalEmployees() {
        functionalEmployees = functionalOwnerIds
            ? employees.filter(e => functionalOwnerIds.has(String(e.value)))
            : employees;
    }
    function ensureFunctionalOwners() {
        if (functionalOwnersFetch) return functionalOwnersFetch;
        functionalOwnersFetch = fetch(U('/practice-management-gateway/owners/query'), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type':  'application/json',
                'X-CSRF-TOKEN':  CSRF
            },
            body: JSON.stringify({ data: { pageNumber: 1, pageSize: 5000 } })
        }).then(r => r.ok ? r.json() : { data: [] })
          .then(json => {
              const rows = rowsOf(json);
              functionalOwnerIds = new Set(rows.map(x => String(x.Value ?? x.value)));
              deriveFunctionalEmployees();
              // The profile may already be rendered from the full list;
              // re-render so the picker reflects the functional subset.
              renderProfile();
              return functionalEmployees;
          }).catch(() => { functionalOwnerIds = null; return employees; });
        return functionalOwnersFetch;
    }

    // ---------- instance profile  (migration 222) ---------------------
    // Practice type, criticality, business function and -- for an admin
    // only -- the owner. The four the Practice Instance form was the sole
    // home for; see docs/practice-instance-form-slimming.md.
    //
    // The whole box stays hidden until the API says migration 222 is
    // applied. profileEditable reports whether the detail result set
    // carried the 222 columns; BusinessFunctionId itself cannot answer it,
    // since it is null both when 222 is missing and when the instance
    // simply has no business function. An editor whose Save can only fail
    // is worse than no editor.
    function profileAvailable() {
        return Boolean(instance) && F(instance, 'profileEditable') === true;
    }

    function renderProfile() {
        const box = document.getElementById('rwProfileBox');
        if (!profileAvailable()) { box.hidden = true; return; }
        box.hidden = false;

        document.getElementById('rwPracticeType').value = F(instance, 'assuranceMode') || '';
        document.getElementById('rwCriticality').value  = F(instance, 'criticality')   || '';

        const bfId = F(instance, 'businessFunctionId');
        document.getElementById('rwBusinessFunction').innerHTML =
            options(businessFunctions, bfId ? String(bfId) : '', 'Not set');

        // Owner is admin-only: every Resolve procedure scopes a non-admin
        // to the instances they own, so reassigning your own instance
        // would lock you out of it the moment you saved.
        const ownerField = document.getElementById('rwOwnerField');
        ownerField.hidden = !isAdmin;
        if (isAdmin) {
            const ownerId = F(instance, 'ownerEmployeeId');
            const ownerText = ownerId ? String(ownerId) : '';
            // Migration 342: offer only Functional Users. If this instance's
            // current owner is not a Functional User, keep them visible so the
            // saved value survives an unrelated edit (new picks stay functional).
            let ownerList = functionalEmployees;
            if (ownerText && !ownerList.some(e => String(e.value) === ownerText)) {
                const current = employees.find(e => String(e.value) === ownerText);
                if (current) ownerList = ownerList.concat([current]);
            }
            document.getElementById('rwOwner').innerHTML =
                options(ownerList, ownerText, 'Not set');
        }
        document.getElementById('rwProfileNote').textContent = isAdmin
            ? 'How this instance is carried out, how much it matters, and who owns it.'
            : 'How this instance is carried out and how much it matters. Only an administrator can change the owner.';
    }

    async function saveProfile() {
        const msg = document.getElementById('rwProfileMsg');
        const read = id => {
            const v = document.getElementById(id)?.value || '';
            return v.trim() ? v : null;
        };
        const ownerId = isAdmin ? read('rwOwner') : null;

        msg.textContent = 'Saving...';
        try {
            const r = await fetch(U('/practice/api/workflow/resolve/profile'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                body: JSON.stringify({
                    practiceInstanceId: instanceId,
                    assuranceMode:      read('rwPracticeType'),
                    criticality:        read('rwCriticality'),
                    businessFunctionId: read('rwBusinessFunction') ? Number(read('rwBusinessFunction')) : null,
                    primaryOwnerId:     ownerId ? Number(ownerId) : null
                })
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
                msg.textContent = body.error || ('Could not save (HTTP ' + r.status + ').');
                return;
            }
            msg.textContent = body.message || 'Saved.';
            // Reload rather than patch the local copy: the procedure also
            // rewrites the denormalised owner name and department, and the
            // header strip reads those.
            await loadInstance();
            renderProfile();
        } catch (err) {
            console.error('resolve-workspace: save profile failed', err);
            msg.textContent = 'Could not save the profile.';
        }
    }

    // ---------- retire  (migration 222) -------------------------------
    // Migration 139 reserved this for the Practice Instances screen. It is
    // not a delete: practice_instance_id is a foreign key in roughly
    // twenty tables, so the row stays and its status changes.
    function renderRetire() {
        const btn     = document.getElementById('rwRetireBtn');
        const restore = document.getElementById('rwRestoreBtn');
        const isActive = String(F(instance, 'status') || '') === 'Active';
        const may      = profileAvailable();
        // Same availability test as the profile box, plus: an instance
        // that is already retired has nothing to retire -- and one that
        // is active has nothing to restore. Exactly one shows. (287)
        btn.hidden     = !may || !isActive;
        restore.hidden = !may ||  isActive;

        // A retired instance is still fully browsable -- that is the
        // point of 287 -- so the banner explains the state rather than
        // the page pretending nothing is different.
        const banner = document.getElementById('rwRetiredBanner');
        if (banner) banner.hidden = isActive;
    }

    // Reason is asked for in the same dialog that confirms the act
    // (migration 355) rather than as a separate popup afterward. Typing a
    // reason and clicking Retire IS the confirmation; Cancel (or Escape)
    // aborts exactly as the plain confirm() did before.
    async function retireInstance() {
        const name = F(instance, 'instanceName') || 'this practice instance';
        const remark = await window.gracUi.promptRequired(
                'Retire ' + name + '? '
                + 'It stops appearing as an active instance. Its assurance history, '
                + 'evidence and closed tasks are kept.',
                { type: 'warning', title: 'Retire instance', confirmText: 'Retire',
                  inputLabel: 'Reason for retiring',
                  requiredNote: 'A reason for retiring is required.' });
        if (remark === null) return;

        const btn = document.getElementById('rwRetireBtn');
        btn.disabled = true;
        try {
            const r = await fetch(U('/practice/api/workflow/resolve/retire'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                body: JSON.stringify({ practiceInstanceId: instanceId, remark: remark })
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
                window.alert(body.error || ('Could not retire this instance (HTTP ' + r.status + ').'));
                btn.disabled = false;
                return;
            }
            // Nothing left to resolve on a retired instance, so go back to
            // the list rather than leaving the workspace open on it.
            window.location.assign(U('/Practice/Index/resolve'));
        } catch (err) {
            console.error('resolve-workspace: retire failed', err);
            window.alert('Could not retire this instance.');
            btn.disabled = false;
        }
    }

    // ---------- restore (migration 287) -------------------------------
    // Retire's inverse. Unlike retire it does NOT navigate away: the
    // instance the user just brought back is the one they want to carry
    // on working in, so the workspace reloads in place.
    async function restoreInstance() {
        const name = F(instance, 'instanceName') || 'this practice instance';
        const remark = await window.gracUi.promptRequired(
                'Restore ' + name + '? '
                + 'It becomes an active instance again and returns to work queues '
                + 'and assurance scheduling.',
                { title: 'Restore instance', confirmText: 'Restore',
                  inputLabel: 'Reason for restoring',
                  requiredNote: 'A reason for restoring is required.' });
        if (remark === null) return;

        const btn = document.getElementById('rwRestoreBtn');
        btn.disabled = true;
        try {
            const r = await fetch(U('/practice/api/workflow/resolve/restore'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                body: JSON.stringify({ practiceInstanceId: instanceId, remark: remark })
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
                // 52814 -- parent practice inactive -- arrives here as a
                // sentence naming the actual blocker, so it is shown as
                // sent rather than replaced with a generic failure.
                window.alert(body.error || ('Could not restore this instance (HTTP ' + r.status + ').'));
                btn.disabled = false;
                return;
            }
            window.location.reload();
        } catch (err) {
            console.error('resolve-workspace: restore failed', err);
            window.alert('Could not restore this instance.');
            btn.disabled = false;
        }
    }

    // ---------- dependency category catalogue (migration 222/238) -----
    // Fetched once to know the ids for the fixed five rows. The table is
    // rendered from dependencyCategories (loadDependencies) so a category
    // with resolutions still appears even if the catalogue drops it.
    async function loadDependencyTypes() {
        try {
            const r = await fetch(
                U('/practice/api/workflow/resolve/instances/' + encodeURIComponent(instanceId) + '/dependency-types'),
                { credentials: 'same-origin' });
            if (!r.ok) return;
            dependencyTypes = rowsOf(await r.json());
            // The catalogue arrived after the table's first paint --
            // re-render so any row that only knew the category by name
            // (a legacy resolution) picks up its id.
            if (Array.isArray(dependencyCategories) && dependencyCategories.length) renderDependencyTable();
        } catch (_) { /* the table quietly falls back to the resolutions endpoint */ }
    }

    function unwrap(v) {
        if (typeof v === 'string') {
            const t = v.trim();
            if ((t.startsWith('{') && t.endsWith('}')) || (t.startsWith('[') && t.endsWith(']'))) {
                try { return unwrap(JSON.parse(t)); } catch (_) { return v; }
            }
        }
        if (v && typeof v === 'object' && Array.isArray(v.$values)) return v.$values.map(unwrap);
        if (Array.isArray(v)) return v.map(unwrap);
        return v;
    }
    function rowsOf(body) {
        const d = unwrap(body?.data ?? body?.Data ?? body ?? []);
        if (!Array.isArray(d)) return [];
        return (d.length && Array.isArray(d[0])) ? d.flat() : d;
    }

    function options(list, selected, blank) {
        return '<option value="">' + esc(blank || 'As published') + '</option>'
            + list.map(o => '<option value="' + esc(o.value) + '"'
                + (String(o.value) === String(selected ?? '') ? ' selected' : '') + '>'
                + esc(o.label) + '</option>').join('');
    }

    // ---------- 2. Obligations ---------------------------------------
    async function loadObligations() {
        const host = document.getElementById('rwObligations');
        try {
            const r = await fetch(U('/practice/api/workflow/resolve/instances/'
                        + encodeURIComponent(instanceId) + '/obligations'), { credentials: 'same-origin' });
            if (!r.ok) {
                const b = await r.json().catch(() => ({}));
                host.innerHTML = '<div class="pm-empty compact">'
                    + esc(b.error || ('Could not load obligations (HTTP ' + r.status + ').')) + '</div>';
                return;
            }
            const body = await r.json();
            // assuranceType is the form's field name; the procedure calls
            // it AdoptedAssuranceType to keep it on the "as adopted here"
            // side of its result set. Aliased once here rather than at
            // every read, so val() and the dirty bag key on one name.
            obligations = (body.data || body.Data || []).map(o => Object.assign({}, o, {
                _edit: null,
                assuranceType: F(o, 'adoptedAssuranceType') || ''
            }));
            await loadEvidence();      // the cards render evidence inline
            renderObligations();
        } catch (err) {
            console.error('resolve-workspace: obligations failed', err);
            host.innerHTML = '<div class="pm-empty compact">Could not load obligations.</div>';
        }
    }

    async function loadEvidence() {
        try {
            const r = await fetch(U('/practice/api/workflow/resolve/instances/'
                        + encodeURIComponent(instanceId) + '/evidence'), { credentials: 'same-origin' });
            evidence = r.ok ? ((await r.json()).data || []) : [];
        } catch (err) {
            // Not fatal: the obligation cards still work, they just show
            // no evidence rows.
            console.error('resolve-workspace: evidence failed', err);
            evidence = [];
        }
    }

    // Migration 334: the POST, extracted from saveEvidence so it has
    // exactly one caller shape and two callers.
    //
    //   saveEvidence          -- reads the values off the DOM of a row
    //                            that is on screen. Unchanged behaviour.
    //   saveOneObligation     -- passes the pre-adoption draft for a row
    //                            that was created moments earlier by the
    //                            adopt and has never been rendered.
    //
    // It does NOT reload or re-render: the caller decides when, which is
    // what lets the obligation save flush several rows and then reload
    // once instead of once per row.
    //
    // Returns true on success so a caller can count what landed.
    async function postEvidenceValues(evidenceId, values) {
        try {
            const r = await fetch(U('/practice/api/workflow/resolve/evidence'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                body: JSON.stringify({
                    practiceInstanceId:    instanceId,
                    evidenceId:            Number(evidenceId),
                    // collectionFrequencyId and retentionPeriod are no
                    // longer on the form (migration 226). Omitted rather
                    // than sent as null, so the procedure reads "no
                    // opinion" and keeps what the authority published.
                    //
                    // Migration 245: ownerEmployeeId also omitted. The
                    // owner of the assurance obligation IS the owner of
                    // its evidence -- the second picker asked the same
                    // question twice. Omitting the key (rather than
                    // sending null with clearOwner:true) preserves any
                    // owner the row already had and keeps the endpoint
                    // free to derive it obligation-side later.
                    // Migration 254: the organisation's own label for this
                    // row. || null keeps the "absent means unchanged"
                    // contract the other fields use -- clearing the box
                    // leaves the stored name alone rather than blanking it.
                    evidenceName:          values.evidenceName        || null,
                    evidenceDescription:   values.evidenceDescription || null,
                    evidenceLocation:      values.evidenceLocation    || null,
                    evidenceLocator:       values.evidenceLocator     || null
                })
            });
            const body = await r.json().catch(() => ({}));
            return { ok: r.ok, message: body.message, error: body.error
                        || (r.ok ? null : ('Could not save (HTTP ' + r.status + ').')) };
        } catch (err) {
            console.error('resolve-workspace: save evidence failed', err);
            return { ok: false, error: 'Could not save the evidence.' };
        }
    }

    async function saveEvidence(evidenceId) {
        const rowEl = document.querySelector('[data-ev="' + evidenceId + '"]');
        const msgEl = document.querySelector('[data-ev-msg="' + evidenceId + '"]');
        if (!rowEl) return;

        const read = name => {
            const label = rowEl.querySelector('[data-ev-field="' + name + '"]');
            const input = label ? label.querySelector('input, select, textarea') : null;
            return input ? input.value : '';
        };

        if (msgEl) msgEl.textContent = 'Saving...';
        const res = await postEvidenceValues(evidenceId, {
            evidenceName:        read('evidenceName'),
            evidenceDescription: read('evidenceDescription'),
            evidenceLocation:    read('evidenceLocation'),
            evidenceLocator:     read('evidenceLocator')
        });
        if (!res.ok) {
            if (msgEl) msgEl.textContent = res.error;
            return;
        }
        if (msgEl) msgEl.textContent = res.message || 'Saved.';
        await loadEvidence();
        renderObligations();
    }

    // Current value of a field: an unsaved edit wins, then what was
    // adopted, then nothing (meaning "as published").
    function val(o, key) {
        if (o._edit && key in o._edit) return o._edit[key];
        return F(o, key);
    }

    // Migration 242: an obligation carries only implementationStatusId; its
    // human label comes from the implementationStatuses master (id -> name)
    // -- the very list the "Implementation status" dropdown is built from.
    // Returns '' until that master finishes loading, at which point
    // ensureImplementationStatuses() re-renders the cards and the label
    // resolves. Reads val() so an unsaved edit in the dropdown is reflected
    // in the head badge immediately.
    function implStatusLabel(o) {
        const id = val(o, 'implementationStatusId');
        if (id === null || id === undefined || id === '') return '';
        const hit = implementationStatuses.find(s => String(s.value) === String(id));
        return hit ? hit.label : '';
    }

    // The card's identity. Migration 227 lets an organisation add an
    // obligation of its own, and such a row has no obligationId -- there
    // is no row in GRAC_New behind it -- so the procedure supplies
    // RowKey ("p<obligationId>" or "l<adoptionId>") and everything that
    // used to key on the obligation id keys on this instead: the dirty
    // bag, the expanded set, the adopt checkbox and the field labels.
    //
    // The fallback keeps a pre-227 database working unchanged.
    const keyOf = o => String(F(o, 'rowKey') || ('p' + F(o, 'obligationId')));

    // ---------- published obligation detail  (migration 224) ----------
    //
    // The card used to show the same four facts for every obligation --
    // frequency, responsibility, approval, retention. Those are the
    // columns the PRE-TAXONOMY flat model had. Control Management now
    // captures a different field set per obligation type, and a State
    // obligation rendered as those four reads as four dashes while the
    // rule it carries ("password length >= 12") appears nowhere.
    //
    // So the block is driven by the row's TypeCode: whichever of the six
    // JSON arrays matches is what the admin module actually captured.
    // Field labels come from the same vocabulary the admin forms use.
    //
    // Falls back to the published four when there is no typed detail --
    // true for every obligation Control Management 027 back-filled as
    // Execution without detail rows, and for a database that has not run
    // migration 224 at all.

    function parseJsonArray(row, key) {
        const raw = F(row, key);
        if (!raw) return [];
        if (Array.isArray(raw)) return raw;              // already unwrapped
        try {
            const parsed = JSON.parse(raw);
            return Array.isArray(parsed) ? parsed : [];
        } catch (_) { return []; }
    }

    // Which array belongs to which type, and what to call it.
    //
    // Deliberately NOT a list of fields per type. Migration 225 projects
    // the whole detail row, because Control Management owns those tables
    // and keeps adding to them -- trigger mode and the event-driven
    // fields on the assurance spec arrived after the original list was
    // written, and a screen that names its fields cannot show a field it
    // does not name. It showed Scope and Remarks and looked complete.
    //
    // So the renderer shows every key it receives, hides the empty ones,
    // and only opts OUT of the housekeeping columns below. A column
    // Control Management adds appears here on the next page load.
    const typedArrays = {
        State:         ['stateRulesJson',        'State rule'],
        Execution:     ['executionSpecsJson',    'Execution'],
        Assurance:     ['assuranceSpecsJson',    'Assurance'],
        EventResponse: ['eventResponsesJson',    'Event response'],
        Constraint:    ['constraintRulesJson',   'Constraint'],
        // Evidence and Retention were removed from the taxonomy by
        // Control Management (migration 228), so neither is offered when
        // adding a new obligation. Both stay MAPPED here, because
        // obligations adopted before the removal still carry those codes
        // and their detail must keep rendering -- which is why the view
        // still emits both columns rather than dropping them.
        Retention:     ['retentionSpecsJson',    'Retention'],
        Evidence:      ['publishedEvidenceJson', 'Evidence']
    };

    // The "not offered when adding" set (Evidence, Retention) moved with
    // the form: it filters the type dropdown and reinstates a retired
    // code when an obligation already saved under one is edited, both of
    // which are the form's job. window.gracObligationForm.retiredTypes if
    // this side ever needs it. The MAP above deliberately keeps both
    // types, because their detail still has to render.

    // Never shown: row plumbing, audit stamps, and the surrogate keys.
    // Matched case-insensitively against the JSON key with underscores
    // stripped, so obligation_id / ObligationId / obligationId all hit.
    const hiddenDetailKeys = new Set([
        'status', 'recordstatusid', 'obligationid', 'displayorder',
        'enteredby', 'entereddt', 'updatedby', 'updateddt',
        'staterule', 'stateruleid', 'executionspecid', 'assurancespecid',
        'eventresponseid', 'constraintruleid', 'retentionspecid',
        'obligationevidenceid', 'id', 'source', 'linktypecode',

        // Retired from Control Management's own obligation panel
        // (`hidden: true` in its TYPE_SCHEMA). The columns are still
        // there and old rows still carry values, but CM stopped showing
        // them -- so this card stops too, or the display and the add form
        // would disagree about what an obligation consists of.
        //
        // Execution: trigger_condition, responsible_party
        // Assurance:  scope, assurance_party
        // EventResponse: escalation_path
        // Constraint: scope, exception_policy
        'triggercondition', 'responsibleparty', 'assuranceparty',
        'escalationpath', 'exceptionpolicy', 'scope',

        // Remarks retired from the obligation detail display. Every typed
        // array carries a remarks column (224 projects roe.remarks and the
        // per-type equivalents), so it appeared on every card as free text
        // the authority had written for itself -- not something the
        // organisation operationalising the obligation acts on. The
        // columns and the JSON are untouched; this card just stops
        // rendering them.
        'remarks'
    ]);

    // Nicer than the humanised column name where it matters. Anything not
    // listed still renders -- "trigger_mode" becomes "Trigger mode" -- so
    // this map is presentation polish, never a gate on what is shown.
    const detailLabels = {
        slavalue: 'SLA', slaunit: 'SLA unit',
        minretentionvalue: 'Minimum retention', minretentionunit: 'Minimum retention unit',
        maxretentionvalue: 'Maximum retention', maxretentionunit: 'Maximum retention unit',
        evidencetype: 'Evidence type', retentionrequirement: 'Retention'
    };

    const normKey = k => String(k).replace(/_/g, '').toLowerCase();

    function humanise(key) {
        const n = normKey(key);
        if (detailLabels[n]) return detailLabels[n];
        return String(key)
            .replace(/_/g, ' ')
            .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
            .replace(/^./, c => c.toUpperCase());
    }

    // A raw foreign key is noise when its resolved label is in the same
    // object: assurance_frequency_id next to AssuranceFrequency. Hide the
    // id, keep the label.
    function idHasLabel(item, key) {
        const n = normKey(key);
        if (!n.endsWith('id')) return false;
        const base = n.slice(0, -2);
        return Object.keys(item).some(k => normKey(k) === base);
    }

    // An id with NO label beside it used to be printed raw -- which is
    // how an organisation-defined obligation came to read
    // "ASSURANCE FREQUENCY ID  4". A published obligation never showed
    // that, because migration 224's view projects the resolved name
    // alongside the id and idHasLabel above hides the id. A LOCAL
    // obligation's typed_detail_json is written by the add form, which
    // stores column names only -- so there is no sibling name to find,
    // and the number was the only thing there was.
    //
    // "4" tells the reader nothing. So the id is resolved here against
    // the same master lists the form chose it from, and the field prints
    // the NAME with the trailing "Id" dropped from its label.
    //
    // Unresolved ids are still shown as numbers, deliberately: that means
    // the lookup has not loaded yet or the row points at something
    // retired, and inventing a name for it would be worse than admitting
    // the number.
    const idLookups = {
        assurancefrequencyid:   () => frequencies,
        executionfrequencyid:   () => frequencies,
        frequencyid:            () => frequencies,
        eventtypeid:            () => vocabulary().eventTypes.map(e => ({
                                          value: String(F(e, 'eventTypeId')),
                                          label: String(F(e, 'eventName') || '')
                                      })),
        connectiontypeid:       () => connectionTypes,
        implementationstatusid: () => implementationStatuses,
        evidencetypeid:         () => evidenceTypes
    };

    // { label, value } when the id resolves to a name, null otherwise.
    function resolvedId(key, value) {
        const n = normKey(key);
        const source = idLookups[n];
        if (!source) return null;
        if (value === null || value === undefined || String(value).trim() === '') return null;

        let list = [];
        try { list = source() || []; } catch (_) { list = []; }
        const hit = list.find(o => String(o.value) === String(value));
        if (!hit || !String(hit.label || '').trim()) return null;

        // "Assurance frequency id" -> "Assurance frequency". The label is
        // built from the key, so the "Id" is stripped from the humanised
        // text rather than from the key itself.
        return { label: humanise(key).replace(/\s*\bid\b\s*$/i, ''), value: hit.label };
    }

    function dtdd(label, value, span) {
        if (value === null || value === undefined || String(value).trim() === '') return '';
        return '<div' + (span ? ' class="rw-span"' : '') + '>'
             + '<dt>' + esc(label) + '</dt><dd>' + esc(value) + '</dd></div>';
    }

    // A State rule reads as a sentence -- attribute, operator, value,
    // unit -- and splitting "password length >= 12" across four columns
    // hides the thing being said. The four keys are then consumed, so the
    // generic pass below does not repeat them.
    function ruleLine(type, item, consumed) {
        if (type !== 'State') return '';
        const parts = ['attribute', 'operator', 'value', 'unit']
            .map(k => { consumed.add(k); return F(item, k); })
            .filter(v => v !== null && v !== undefined && String(v).trim() !== '');
        return parts.length
            ? '<div class="rw-span"><dt>Rule</dt><dd class="rw-rule">' + esc(parts.join(' ')) + '</dd></div>'
            : '';
    }

    // Every remaining key, in the order the procedure emitted it, minus
    // the housekeeping and minus ids whose label is already present.
    // Empty values are dropped -- which is how the conditional shape
    // renders itself: an assurance spec with trigger mode Scheduled has
    // null event columns, so they simply are not there, and an event
    // driven one has no frequency.
    function genericFields(item, consumed) {
        return Object.keys(item).map(function (key) {
            const n = normKey(key);
            if (consumed.has(n) || hiddenDetailKeys.has(n)) return '';
            if (idHasLabel(item, key)) return '';
            const value = item[key];
            if (value === null || value === undefined || String(value).trim() === '') return '';

            // An id with no sibling name: print the name it points at.
            const named = resolvedId(key, value);
            if (named) return dtdd(named.label, named.value, false);

            const long = n === 'remarks' || String(value).length > 80;
            return dtdd(humanise(key), value, long);
        }).join('');
    }

    // The keys that this obligation's type lets the organisation OVERRIDE.
    // A published item can be read-only elsewhere but editable here, and
    // this is the one place that decides which is which. Anything not in
    // the returned set falls through to the read-only generic renderer.
    //
    //   Execution                          -> execution_frequency
    //   Assurance + trigger_mode Scheduled -> assurance_frequency
    //   Assurance + trigger_mode EventDriven
    //                                      -> event_type_id, sla_value, sla_unit
    //
    // Returns a set of *normalised* keys, so genericFields can skip them
    // and the editor can render its own row.
    function editableOverrideKeys(type, item) {
        const set = new Set();
        if (type === 'Execution') {
            set.add('executionfrequency');
            set.add('executionfrequencyid');
        } else if (type === 'Assurance') {
            const mode = String(F(item, 'triggerMode') || F(item, 'trigger_mode') || '');
            if (mode === 'Scheduled') {
                set.add('assurancefrequency');
                set.add('assurancefrequencyid');
            } else if (mode === 'EventDriven') {
                set.add('eventtypeid');
                set.add('eventname');
                set.add('slavalue');
                set.add('slaunit');
            }
        }
        return set;
    }

    // One editable row inside publishedBlock. Binds through the same
    // [data-field][data-ob] pattern the parameter row uses, so
    // wireObligationCards's existing scanner marks the obligation dirty
    // and saveObligations sends the value in the same payload.
    //
    // The blank option carries the authority's value in its label, so the
    // organisation always sees what "As published" here would mean.
    function overrideRow(id, label, storeField, control) {
        return '<div class="rw-span rw-override">'
             + '<dt>' + esc(label) + '</dt>'
             + '<dd><label data-field="' + esc(storeField) + '" data-ob="' + esc(id) + '">'
             +     control
             + '</label></dd>'
             + '</div>';
    }

    function overrideEditor(id, o, type, item) {
        const parts = [];
        if (type === 'Execution') {
            const pubLabel = String(F(item, 'executionFrequency') || F(item, 'execution_frequency') || '');
            parts.push(overrideRow(id, 'Execution frequency', 'executionFrequencyId',
                '<select>' + options(frequencies, val(o, 'executionFrequencyId'),
                    pubLabel ? 'As published (' + pubLabel + ')' : 'As published') + '</select>'));
            // Migration 336-338: WHEN the recurring schedule starts. The
            // cadence above is the obligation's; this is the one thing the
            // calendar cannot derive. Blank means "start today" for a new
            // stream, or "keep the current anchor" for an existing one.
            parts.push(overrideRow(id, 'First occurrence', 'firstOccurrenceDate',
                '<input type="date" value="' + esc(val(o, 'firstOccurrenceDate') || '') + '">'));
        } else if (type === 'Assurance') {
            const mode = String(F(item, 'triggerMode') || F(item, 'trigger_mode') || '');
            if (mode === 'Scheduled') {
                const pubLabel = String(F(item, 'assuranceFrequency') || F(item, 'assurance_frequency') || '');
                parts.push(overrideRow(id, 'Assurance frequency', 'assuranceFrequencyId',
                    '<select>' + options(frequencies, val(o, 'assuranceFrequencyId'),
                        pubLabel ? 'As published (' + pubLabel + ')' : 'As published') + '</select>'));
                // Migration 336-338: first occurrence for the Scheduled
                // Assurance stream. Only Scheduled -- an EventDriven
                // Assurance has no cadence, so no schedule and no anchor.
                parts.push(overrideRow(id, 'First occurrence', 'firstOccurrenceDate',
                    '<input type="date" value="' + esc(val(o, 'firstOccurrenceDate') || '') + '">'));
            } else if (mode === 'EventDriven') {
                // The flat event vocabulary from migration 230, read from
                // the shared obligation form -- it fetches that endpoint
                // for its own Assurance panel, so this side reads the
                // result instead of fetching it a second time.
                // Only the leaves are picker options -- a parent domain
                // is a grouping, never an event you can pick.
                const allEvents = vocabulary().eventTypes;
                const leaves = allEvents
                    .filter(e => F(e, 'parentEventTypeId'))
                    .map(e => ({ value: String(F(e, 'eventTypeId')),
                                 label: String(F(e, 'eventName') || '') }));
                const pubEventId = F(item, 'eventTypeId') ?? F(item, 'event_type_id');
                const pubEventLabel = pubEventId != null
                    ? String((allEvents.find(e => String(F(e, 'eventTypeId')) === String(pubEventId)) || {}).eventName || '')
                    : '';

                parts.push(overrideRow(id, 'Event', 'eventTypeId',
                    '<select>' + options(leaves, val(o, 'eventTypeId'),
                        pubEventLabel ? 'As published (' + pubEventLabel + ')' : 'As published') + '</select>'));

                // SLA is two paired inputs. Number + unit -- same shape
                // CM uses in its own admin panel, kept side by side so
                // reading them as one phrase ("5 Days") still works.
                const pubValue = F(item, 'slaValue') ?? F(item, 'sla_value');
                const pubUnit  = String(F(item, 'slaUnit')  || F(item, 'sla_unit')  || '');
                const curVal   = val(o, 'slaValue');
                const curUnit  = val(o, 'slaUnit');

                const pubSlaLabel = (pubValue != null && String(pubValue) !== '')
                    ? String(pubValue) + (pubUnit ? ' ' + pubUnit : '')
                    : '';

                parts.push(overrideRow(id, 'SLA value', 'slaValue',
                    '<input type="number" min="0" value="' + esc(curVal ?? '')
                    + '" placeholder="' + esc(pubSlaLabel || 'As published') + '">'));

                // Unit picker: just the units this obligation has ever
                // referred to. An earlier draft tried to sweep every
                // sibling item for units, which referenced a variable
                // outside its scope and broke the whole card. The
                // published value and the stored override are enough --
                // nothing on screen refers to a value the user cannot
                // re-pick, and CM has no separate unit vocabulary to
                // borrow from.
                const unitValues = new Set();
                if (curUnit) unitValues.add(curUnit);
                if (pubUnit) unitValues.add(pubUnit);
                const unitOptions = Array.from(unitValues).map(u => ({ value: u, label: u }));

                parts.push(overrideRow(id, 'SLA unit', 'slaUnit',
                    '<select>' + options(unitOptions, curUnit,
                        pubUnit ? 'As published (' + pubUnit + ')' : 'As published') + '</select>'));
            }
        }
        return parts.join('');
    }

    function publishedBlock(o) {
        const type  = String(F(o, 'typeCode') || '');
        const spec  = typedArrays[type];
        const items = spec ? parseJsonArray(o, spec[0]) : [];
        const local = F(o, 'isOrganizationDefined') === true;
        const id    = keyOf(o);

        if (items.length) {
            const body = items.map(function (item) {
                // consumed holds normalised keys already rendered by a
                // special case, so nothing appears twice.
                const consumed = new Set();
                const head = ruleLine(type, item, consumed);
                // Editable-override keys are consumed before the generic
                // pass, so the read-only display stops repeating them.
                // Locals aren't overridden -- they were authored here, so
                // the same fields are edited on the Add form instead.
                if (!local) editableOverrideKeys(type, item).forEach(k => consumed.add(k));
                const rest = genericFields(item, consumed);
                const editor = local ? '' : overrideEditor(id, o, type, item);
                return '<div class="rw-typed-item"><dl>'
                     + ((head + rest + editor) || '<div class="rw-span"><dd class="rw-note">No detail recorded.</dd></div>')
                     + '</dl></div>';
            }).join('');
            return '<div class="rw-typed">'
                 + '<h4>As published'
                   + '<span class="pm-badge">' + esc(F(o, 'typeName') || spec[1]) + '</span>'
                   + (items.length > 1 ? '<span class="rw-note"> ' + items.length + ' rules</span>' : '')
                 + '</h4>' + body + '</div>';
        }

        // No typed detail for this obligation. Show the flat published
        // fields, and say why they are the ones on screen -- otherwise a
        // State obligation with four dashes looks like a rendering fault
        // rather than an unclassified row.
        const flat = dtdd('Execution frequency', F(o, 'publishedExecutionFrequency'))
                   + dtdd('Responsibility',      F(o, 'publishedResponsibility'))
                   + dtdd('Approval authority',  F(o, 'publishedApprovalAuthority'))
                   + dtdd('Retention',           F(o, 'publishedRetention'));
        return '<div class="rw-typed">'
             + '<h4>As published'
               + (F(o, 'typeName') ? '<span class="pm-badge">' + esc(F(o, 'typeName')) + '</span>' : '')
             + '</h4>'
             + '<dl>' + (flat || '<div class="rw-span"><dd class="rw-note">Nothing published.</dd></div>') + '</dl>'
             // Only claim nothing was recorded when we actually looked.
             // On a database without migration 224 the typed columns are
             // absent, not empty, and the detail may well exist -- saying
             // "none recorded" there would send someone to the admin
             // module to fix a database that is fine.
             + (spec && F(o, 'typedDetailAvailable') === true
                    ? '<p class="rw-note">No ' + esc(spec[1].toLowerCase())
                      + ' detail has been recorded for this obligation in the admin module.</p>'
                    : '')
             + '</div>';
    }

    function description(o) {
        // ObligationDescription is the authority's own wording for what
        // this obligation asks for. ObligationText is the same value under
        // the older column name. Either is fine as the source.
        //
        // Historically we suppressed this block when the obligation had no
        // separate name and the procedure had fallen back to LEFT(text,300)
        // for the title -- so as not to print the same sentence twice.
        // That was too aggressive: the resolve card is the ONE place where
        // an operator reads what the obligation actually requires, and
        // hiding it because it happened to equal the card header was
        // worse than a small repetition. Users read the details expecting
        // the description here (and were seeing only their own Remarks
        // textarea, which is org-side, not the authority's wording).
        //
        // So: always print if we have text; the header stays a short title
        // and the description carries the requirement in full.
        const text = F(o, 'obligationDescription') || F(o, 'obligationText');
        if (!text) return '';
        return '<div class="rw-description">'
             + '<span class="rw-description-label">Description</span>'
             + esc(text) + '</div>';
    }

    function renderObligations() {
        const host = document.getElementById('rwObligations');
        const adopted = obligations.filter(o => F(o, 'isAdopted')).length;
        document.getElementById('rwObligationCount').textContent =
            adopted + ' / ' + obligations.length + ' adopted';

        if (!obligations.length) {
            host.innerHTML = '<div class="pm-empty compact">'
                + 'No obligations are published against this practice from a subscribed release. '
                + 'Check the organization\'s repository subscriptions.</div>';
            document.getElementById('rwObligationBar').hidden = true;
            return;
        }

        host.innerHTML = obligations.map(function (o) {
            const id  = keyOf(o);
            const key = 'ob-' + id;
            const isOpen   = open.has(key);
            const adoptedF = !!val(o, 'isAdopted');
            const modified = !!F(o, 'organizationModified');
            const local    = F(o, 'isOrganizationDefined') === true;
            const cls = adoptedF ? (modified ? 'modified' : 'adopted') : '';

            const pubEv  = Number(F(o, 'publishedEvidenceCount') || 0);
            const gotEv  = Number(F(o, 'resolvedEvidenceCount') || 0);
            const evNote = pubEv
                ? (gotEv >= pubEv
                    ? '<span class="rw-ok">' + gotEv + ' evidence</span>'
                    : '<span class="rw-warn">' + gotEv + ' / ' + pubEv + ' evidence</span>')
                : '<span class="rw-note">no evidence published</span>';

            return '<article class="rw-card ' + cls + '">'
              + '<button class="rw-card-head" type="button" data-toggle="' + esc(key) + '">'
                // An organisation-defined obligation is not adopted from
                // anywhere -- it exists because this organisation added
                // it. A tick box offering to un-adopt it would be the
                // wrong verb; Remove, inside the card, is the right one.
                + (local
                    ? '<i class="fa-solid fa-building-columns" title="Added by this organisation"></i>'
                    : '<input type="checkbox" data-adopt="' + esc(id) + '"' + (adoptedF ? ' checked' : '') + '>')
                + '<span class="rw-card-title">' + esc(F(o, 'obligationName'))
                  + '<small>' + esc(F(o, 'typeName') || F(o, 'typeCode') || '')
                  + (F(o, 'frameworkRelease') ? '  |  ' + esc(F(o, 'frameworkRelease')) : '')
                  + (local ? '  |  Added by this organisation' : '  |  ' + evNote) + '</small></span>'
                // The head badge shows the obligation's IMPLEMENTATION STATUS
                // (migration 242) instead of its adoption source. A published
                // obligation that has not been adopted carries no status yet,
                // so it shows nothing -- exactly as before. An adopted
                // obligation (or an organisation-defined one, which is always
                // in effect) shows its status, defaulting to "Not set" when
                // none is stored. Nothing is lost by dropping the old
                // Organisation / Modified badges: the org-defined origin is
                // still signalled by the building-columns icon and the "Added
                // by this organisation" subtitle, and a parameter override
                // still tints the whole card via the 'modified' class above.
                + ((adoptedF || local)
                    ? '<span class="pm-badge">' + esc(implStatusLabel(o) || 'Not set') + '</span>'
                    : '')
                + '<i class="fa-solid fa-chevron-' + (isOpen ? 'up' : 'down') + '"></i>'
              + '</button>'
              + '<div class="rw-card-body"' + (isOpen ? '' : ' hidden') + '>'
                + description(o)
                // Two columns on a wide screen: what the authority
                // published on the left, what this organisation answers on
                // the right. Stacked before this, which left the whole
                // right-hand half of a full-width card empty -- the fields
                // are few and short, and .rw-fields' auto-fit stretched
                // three of them across 1100px. Collapses back to stacked
                // under 1000px (see .rw-split).
                + '<div class="rw-split">'
                  + '<div class="rw-split-col">'
                    + publishedBlock(o)
                  + '</div>'
                  + '<div class="rw-split-col">'
                    + '<div class="rw-answers">'
                      // Mirrors publishedBlock's "As published" heading so
                      // the two columns read as a matched pair rather than
                      // one titled box beside a loose form.
                      + '<h4>Your answers</h4>'
                // A local obligation is edited and removed through its own
                // endpoint, so the card offers those two actions instead of
                // the adopt-time parameter row's "leave blank to keep the
                // published value" -- there is no published value.
                + (local
                    ? '<div class="rw-card-actions" style="margin:0 0 10px">'
                        + '<button class="pm-button ghost small" type="button" data-local-edit="' + esc(F(o, 'adoptionId')) + '">'
                          + '<i class="fa-solid fa-pen"></i> Edit obligation</button>'
                        + '<button class="pm-button ghost small" type="button" data-local-remove="' + esc(F(o, 'adoptionId')) + '">'
                          + '<i class="fa-solid fa-trash"></i> Remove</button>'
                      + '</div>'
                    : '<p class="rw-note" style="margin:0 0 8px">Leave a field blank to keep the published value.</p>')
                // Migration 226. Assurance frequency and Retention are
                // gone: the typed block above now carries whatever the
                // admin module recorded for this obligation's type,
                // including its own cadence, so asking again here was
                // asking twice and inviting the two to disagree.
                //
                // Responsibility and Approval authority are role pickers
                // rather than free text -- "who answers for this" is a
                // role in this system, and typing it meant five spellings
                // of the same one.
                //
                // Execution frequency stays: it was not named for removal
                // and, unlike the others, it is read back -- migration 145
                // derives the instance cadence from it through
                // vw_pm_practice_default_frequency.
                + '<div class="rw-fields">'
                  // Execution frequency used to live here regardless of
                  // type. Migration 234 and the typed-panel editors made
                  // that repetitious for an Execution obligation and
                  // meaningless for the others -- the editable execution
                  // frequency now lives inside publishedBlock's typed
                  // item, next to the value it overrides.
                  //
                  // field(..., isSelect=true) wraps the options in a
                  // <select> itself -- passing '<select>...</select>' as
                  // the control here produced a nested <select>, which the
                  // HTML parser splits into an empty outer picker and the
                  // options loose beneath it. Hand over the option list
                  // only.
                  // Owner (was Responsibility). Empty option carries no
                  // "As published" label -- migration 244: nothing about
                  // this is published, it is always an organisation-side
                  // answer, and offering "As published" as a fallback was
                  // pointing at data that does not exist.
                  + field(id, 'responsibility', 'Owner',
                          options(roles, val(o, 'responsibility'), 'Not set'), true)
                  // Approval authority is hidden for now (temporary). The
                  // field, its save-path plumbing and its store remain
                  // untouched -- the control just does not render.
                  // + field(id, 'approvalAuthority', 'Approval authority',
                  //         options(roles, val(o, 'approvalAuthority'), 'Not set'), true)
                  // Assurance type is meaningful only for an Assurance
                  // obligation. AssuranceTypeAvailable is always true when
                  // the API projects AdoptedAssuranceType, which happens
                  // regardless of type -- so gate on the obligation's own
                  // typeCode here instead.
                  + (String(F(o, 'typeCode') || '') === 'Assurance'
                      ? field(id, 'assuranceType', 'Assurance type',
                              options(assuranceTypes, val(o, 'assuranceType'), 'Not set'), true)
                      : '')
                  // Migration 244: an Assurance obligation whose Assurance
                  // type is Automated needs a connection to run against.
                  // Both inputs appear only in that case; a Manual
                  // assurance keeps its stored NULL through the save via
                  // COALESCE on the procedure side.
                  + (String(F(o, 'typeCode') || '') === 'Assurance'
                     && String(val(o, 'assuranceType') || '') === 'Automated'
                      ? field(id, 'connectionTypeId', 'Connection type',
                              options(connectionTypes, val(o, 'connectionTypeId'), 'Not set'), true)
                        + field(id, 'connectionUrl', 'Connection URL',
                                '<input type="text" value="' + esc(val(o, 'connectionUrl') || '') + '">', false)
                      : '')
                  // Migration 242: per-obligation implementation status.
                  // Ties directly to Task Center's gap detection --
                  // Not Implemented / Partially Implemented flow through
                  // to the instance's gap entry in 243.
                  + field(id, 'implementationStatusId', 'Implementation status',
                          options(implementationStatuses, val(o, 'implementationStatusId'), 'Not set'), true)
                  // Remarks textarea retired alongside the published
                  // Remarks in hiddenDetailKeys -- the card no longer
                  // shows or asks for remarks at all.
                  //
                  // The column, the endpoint and the procedure are
                  // untouched. buildObligationPayloadRow still sends
                  // remarks, and with no input on screen val() falls
                  // through to the stored value, so a save round-trips
                  // whatever is already there instead of blanking it.
                      + '</div>'   // .rw-fields
                    + '</div>'     // .rw-answers
                  + '</div>'       // .rw-split-col
                + '</div>'         // .rw-split
                // Evidence stays full width under both columns -- a row
                // carries a name, a location and a locator, and squeezing
                // it into half a card is what the single-column decision
                // above .rw-columns was avoiding in the first place.
                + evidenceBlock(o)
                // Migration 245: per-obligation Save. The bulk sticky
                // Save at the top of the panel is retired -- each card
                // saves itself, and its evidence rows are flushed with
                // the same click. keyOf(o) is what dirty and open track
                // this card by.
                //
                // Organisation-defined obligations now get the same inline
                // Save. It posts the row's inline parameters (Owner /
                // Assurance type / Implementation status) to the local
                // endpoint -- preserving the definition and evidence LIST
                // the Edit dialog owns (typed_detail_json and evidence_json
                // are sent NULL, which the procedure reads as "leave alone")
                // -- and flushes the evidence rows in the same click, exactly
                // as an adopted card does. Edit obligation stays for the
                // definition and for adding evidence types. See
                // saveOneObligation, which branches on isOrganizationDefined.
                + '<div class="rw-card-actions" style="margin-top:10px">'
                    + '<button class="pm-button primary small" type="button" '
                       + 'data-save-obligation="' + esc(keyOf(o)) + '">'
                        + '<i class="fa-solid fa-circle-check"></i> Save obligation'
                    + '</button>'
                    + '<span class="rw-note" data-save-note="' + esc(keyOf(o)) + '"></span>'
                  + '</div>'
                + (F(o, 'adoptedBy')
                    ? '<p class="rw-note" style="margin-top:8px">Adopted by ' + esc(F(o, 'adoptedBy')) + '.</p>' : '')
              + '</div>'
            + '</article>';
        }).join('');

        wireObligationCards();
        document.getElementById('rwObligationBar').hidden = false;
        document.getElementById('rwObligationDirty').textContent =
            dirty.size ? dirty.size + ' unsaved change' + (dirty.size === 1 ? '' : 's') : '';
    }

    // What the authority publishes for this obligation, as {type, remark}.
    //
    // Straight off publishedEvidenceJson, which sp_resolve_obligation_list
    // already carries on every card (it projects the typed detail view's
    // EvidenceJson). No extra call, and it is the same data the Practice
    // View renders on its obligation cards.
    //
    // De-duplicated because migration 302's view de-duplication only
    // exists from 302 onwards: the app and the database deploy
    // separately, and against a pre-302 database the same evidence
    // arrives twice, once per path to it.
    //
    // Migration 334 changed the key from ObligationEvidenceId to the
    // EVIDENCE TYPE. That is not a tidying preference -- it is what
    // adoption actually creates. sp_resolve_evidence_reconcile_for_instance
    // inserts practice_instance_evidence GROUP BY (ObligationId,
    // evidence_type_id), so two published rows of the same type produce
    // ONE row here. Keyed on the published id, this preview promised
    // "adopting will create these to fill in" and then created fewer,
    // and -- since 334 makes these boxes editable -- the operator would
    // have typed into a box with no row waiting for it. Remarks from the
    // rows that merge are joined, so no published instruction is lost.
    //
    // `key` is the match token: the same normalisation is applied to the
    // EvidenceType coming back from sp_resolve_evidence_list, which is
    // how a draft typed here finds the row adoption just created. The
    // two names are identical by construction -- the insert joins
    // grac_practice.evidence_type_master to GRAC_New.evidence_type_master
    // ON evidence_type_name.
    const typeKeyOf = t => String(t || '').trim().toLowerCase();

    function publishedEvidenceOf(o) {
        const byType = new Map();
        parseJsonArray(o, 'publishedEvidenceJson').forEach(function (e) {
            const type = String(e.EvidenceType || e.evidenceType || '').trim();
            if (!type) return;
            const key    = typeKeyOf(type);
            const remark = String(e.Remarks ?? e.remarks ?? '').trim();
            const hit    = byType.get(key);
            if (!hit) { byType.set(key, { key: key, type: type, remark: remark }); return; }
            if (remark && hit.remark.indexOf(remark) < 0)
                hit.remark = hit.remark ? (hit.remark + '\n' + remark) : remark;
        });
        return [...byType.values()];
    }

    // ---------- pre-adoption evidence drafts  (migration 334) ---------
    //
    // What the operator types into an evidence row that does not exist
    // yet, held on the obligation row as o._evidenceDraft, keyed by the
    // evidence type key above:
    //
    //     o._evidenceDraft = { 'policy document': { evidenceName: ...,
    //                          evidenceLocation: ..., evidenceLocator: ...,
    //                          evidenceDescription: ... } }
    //
    // It has to be held in JS rather than read off the DOM at save time,
    // the way the adopted rows are: ticking the adopt box calls
    // renderObligations(), which rebuilds the card's HTML and would throw
    // the typed values away. o._edit has exactly this problem and exactly
    // this solution, so the draft follows it -- captured on `change`,
    // re-rendered from the buffer, and dropped when loadObligations()
    // rehydrates from the procedure after a successful save.
    function evidenceDraftOf(o, key) {
        return (o._evidenceDraft && o._evidenceDraft[key]) || {};
    }

    // ---------- evidence, inside the obligation card ------------------
    // Four states, and each gets its own sentence. Collapsing them into
    // one "no evidence" line was wrong: an obligation that publishes
    // evidence but has not been saved yet was being told the authority
    // publishes none, which the summary line above it flatly contradicted.
    function evidenceBlock(o) {
        const id    = Number(F(o, 'obligationId'));
        // Migration 334. The card's identity, not the obligation id: a
        // pre-adoption evidence draft is stored on the obligation ROW, and
        // everything that addresses a row here -- dirty, open, the adopt
        // checkbox, the Save button -- keys on keyOf(o).
        const rowKey = keyOf(o);
        const local = F(o, 'isOrganizationDefined') === true;
        const pub   = Number(F(o, 'publishedEvidenceCount') || 0);
        // A locally added obligation has no GRAC_New id, so its evidence is
        // matched on the link column migrations 231/232 added instead.
        const mine  = local
            ? evidence.filter(e => String(F(e, 'sourcePracticeInstanceObligationId') || '')
                                   === String(F(o, 'adoptionId') || ''))
            : evidence.filter(e => Number(F(e, 'sourceObligationId')) === id);

        // What the server has recorded, versus what the checkbox currently
        // shows. Ticking is not adopting -- the rows appear on Save.
        const savedAdopted   = !!F(o, 'isAdopted');
        const pendingAdopted = !!val(o, 'isAdopted');

        if (!pub && !mine.length) {
            return '<div class="rw-evidence"><h4>Evidence</h4>'
                + '<p class="rw-note">'
                + (local
                    // Nobody published it, so nobody can be waiting on it --
                    // the organisation decides, and Edit obligation is where.
                    ? 'No evidence declared for this obligation. Add some with Edit obligation.'
                    : 'The authority publishes no evidence for this obligation.')
                + '</p></div>';
        }

        if (!mine.length) {
            // No rows yet. Show WHAT the authority publishes rather than a
            // count, so evidence is visible under its obligation whether or
            // not it has been adopted.
            //
            // The "N are published but no row exists here -- press Save to
            // try again" line is gone with migration 304: the reconcile runs
            // when the workspace loads, so an ADOPTED obligation now arrives
            // with its rows already created and never reaches this branch.
            // Reaching it while adopted means the reconcile could not run,
            // which is a fault to report, not a chore to hand the operator.
            //
            // -------------------------------------------------------------
            // Migration 334. This branch was READ-ONLY: type name, a "Not
            // started" badge and the published remark. Expanding an
            // obligation therefore showed the evidence but offered no way
            // to answer it, and the operator had to save the obligation
            // once, wait for the reload, and come back to the same card to
            // find the boxes. Two saves for one decision.
            //
            // The same four inputs the adopted branch renders are rendered
            // here instead, holding their values in o._evidenceDraft.
            // saveOneObligation posts the obligation (which adopts it, and
            // the adopt creates these rows), reloads the evidence, and then
            // posts each draft against the row that now exists for its
            // type -- so the card's one Save button saves the obligation
            // AND its evidence, exactly as it already does once the rows
            // exist. Nothing new is stored and no endpoint is added: this
            // is the existing /resolve/evidence save, reached at a moment
            // the screen previously refused to offer it.
            // -------------------------------------------------------------
            const published = publishedEvidenceOf(o);
            // Migration 334. An organisation-defined obligation is NOT
            // offered the inputs. Its evidence is authored in the modal
            // Edit obligation opens, it is matched on the 231/232 link
            // column rather than created by the reconcile, and
            // saveOneObligation refuses local rows outright -- so boxes
            // here would be boxes that never save. It keeps the read-only
            // list it had.
            const editable = !local;
            const note = savedAdopted
                ? 'These are published for this obligation, and their rows could not be created. '
                  + 'Reload the page; if they are still missing, this is a fault worth reporting.'
                : editable
                  ? 'Fill these in now if you want -- they are saved together with the obligation, '
                    + 'and saving adopts it.'
                  : 'Add or change these with Edit obligation.';

            return '<div class="rw-evidence"><h4>Evidence'
                + (published.length
                    ? ' <span class="pm-badge">0 / ' + published.length + ' resolved</span>' : '')
                + '</h4>'
                + '<p class="rw-note">' + esc(note) + '</p>'
                + published.map(function (p) {
                    const d = editable ? evidenceDraftOf(o, p.key) : {};
                    // "Ready on save" means the two fields IsResolved is
                    // computed from are both filled. Same test the
                    // procedure applies, said before the row exists.
                    const ready = !!(String(d.evidenceLocation || '').trim()
                                  && String(d.evidenceLocator  || '').trim());
                    return '<div class="rw-evidence-row pending' + (ready ? ' done' : '') + '">'
                      + '<div class="rw-evidence-head">'
                        + '<i class="fa-solid ' + (ready ? 'fa-circle-check rw-ok' : 'fa-circle-dot rw-warn') + '"></i>'
                        + '<strong>' + esc(d.evidenceName || p.type) + '</strong>'
                        + (d.evidenceName ? '<span class="pm-badge">' + esc(p.type) + '</span>' : '')
                        + '<span class="pm-badge">'
                          + (ready ? 'Ready on save' : (pendingAdopted ? 'Created on save' : 'Not started'))
                        + '</span>'
                      + '</div>'
                      // Read-only, exactly as on the adopted branch: this
                      // is what the authority asks for, not an answer.
                      + (p.remark ? '<p class="rw-note rw-evidence-remark">' + esc(p.remark) + '</p>' : '')
                      + (editable
                        ? '<div class="rw-fields">'
                          + '<div class="full">' + pevField(rowKey, p.key, 'evidenceName', 'Evidence name',
                              '<input type="text" value="' + esc(d.evidenceName || '')
                              + '" placeholder="' + esc(p.type) + '">', true) + '</div>'
                          + pevField(rowKey, p.key, 'evidenceLocation', 'Location',
                              '<input type="text" value="' + esc(d.evidenceLocation || '')
                              + '" placeholder="Where it is kept">')
                          + pevField(rowKey, p.key, 'evidenceLocator', 'Locator',
                              '<input type="text" value="' + esc(d.evidenceLocator || '')
                              + '" placeholder="Path, link or reference">')
                          + '<div class="full">' + pevField(rowKey, p.key, 'evidenceDescription', 'Description',
                              '<textarea rows="2">' + esc(d.evidenceDescription || '') + '</textarea>', true) + '</div>'
                        + '</div>'
                        : '')
                    + '</div>';
                  }).join('')
                + '</div>';
        }

        return '<div class="rw-evidence"><h4>Evidence <span class="pm-badge">'
             + mine.filter(e => F(e, 'isResolved')).length + ' / ' + mine.length + ' resolved</span></h4>'
             + '<p class="rw-note">A location and a locator are both needed before evidence counts as resolved.</p>'
             + mine.map(function (e) {
                 const eid  = F(e, 'evidenceId');
                 const done = !!F(e, 'isResolved');
                 return '<div class="rw-evidence-row' + (done ? ' done' : '') + '" data-ev="' + esc(eid) + '">'
                   + '<div class="rw-evidence-head">'
                     + '<i class="fa-solid ' + (done ? 'fa-circle-check rw-ok' : 'fa-circle-dot rw-warn') + '"></i>'
                     // Migration 254: the row's own name leads, with the
                     // catalogue type beside it. An unnamed row still
                     // reads by its type exactly as it did before.
                     + '<strong>' + esc(F(e, 'evidenceName')
                                        || F(e, 'evidenceType') || 'Evidence') + '</strong>'
                     + (F(e, 'evidenceName') && F(e, 'evidenceType')
                         ? '<span class="pm-badge">' + esc(F(e, 'evidenceType')) + '</span>' : '')
                     + (F(e, 'organizationModified') ? '<span class="pm-badge">Organization defined</span>' : '')
                   + '</div>'
                   // Migration 306. The published remark, under the name.
                   // It was already shown this way on the not-yet-adopted
                   // branch above; once the rows existed it disappeared,
                   // which took the instruction away at exactly the moment
                   // the operator started filling the evidence in. Same
                   // rw-note class, so the two branches read alike.
                   //
                   // Read-only: this is what the authority asks for, not an
                   // organization answer. Description below is the box for
                   // the organization's own words.
                   + (F(e, 'evidenceRemarks')
                       ? '<p class="rw-note rw-evidence-remark">'
                         + esc(F(e, 'evidenceRemarks')) + '</p>' : '')
                   + '<div class="rw-fields">'
                     // Migration 254. First field on the row: it is what
                     // the operator identifies this evidence by, and the
                     // catalogue type it was created from is not editable.
                     + '<div class="full">' + evField(eid, 'evidenceName', 'Evidence name',
                         '<input type="text" value="' + esc(F(e, 'evidenceName') || '')
                         + '" placeholder="' + esc(F(e, 'evidenceType') || 'Name this evidence') + '">',
                         true) + '</div>'
                     + evField(eid, 'evidenceLocation', 'Location',
                         '<input type="text" value="' + esc(F(e, 'evidenceLocation') || '')
                         + '" placeholder="Where it is kept">')
                     + evField(eid, 'evidenceLocator', 'Locator',
                         '<input type="text" value="' + esc(F(e, 'evidenceLocator') || '')
                         + '" placeholder="Path, link or reference">')
                     // Migration 245: evidence Owner input retired. The
                     // owner of the assurance obligation is by definition
                     // the owner of its evidence -- a second picker here
                     // asked the same question twice and could disagree
                     // with itself. The column stays; saveEvidence just
                     // stops sending an owner from this row (falls
                     // through to the "no opinion" path on the API side,
                     // which keeps whatever the obligation-side owner is
                     // being propagated as).
                     //
                     // Collection frequency and Retention removed by
                     // migration 226. The published evidence spec carries
                     // both, and the typed block above now shows it, so
                     // these two were a second answer to a question the
                     // authority had already answered.
                     //
                     // The columns and the save endpoint are untouched --
                     // saveEvidence simply stops sending the two keys, and
                     // the procedure leaves what is stored alone.
                     + '<div class="full">' + evField(eid, 'evidenceDescription', 'Description',
                         '<textarea rows="2">' + esc(F(e, 'evidenceDescription') || '') + '</textarea>', true) + '</div>'
                   + '</div>'
                   // Migration 245: per-evidence Save button retired --
                   // the card's Save obligation button now flushes every
                   // evidence row inside the card in one action, so a
                   // second Save here would just be a slower path to the
                   // same result. The [data-ev-msg] span stays so
                   // saveEvidence can still post a per-row status when
                   // called (e.g. from saveOneObligation's parallel flush).
                   + '<div class="rw-card-actions">'
                     + '<span class="rw-note" data-ev-msg="' + esc(eid) + '"></span>'
                   + '</div>'
                 + '</div>';
             }).join('')
             + '</div>';
    }

    // Migration 334 split this in two. The markup -- a <label> carrying
    // the addressing attributes, wrapped in a <div> unless it is a .full
    // track -- is identical for a saved evidence row and a pre-adoption
    // draft; only WHICH attributes address it differs, because a draft has
    // no evidence_id to be addressed by. So the shape lives once, in
    // evLabel, and the two callers below name their own attributes.
    function evLabel(attrs, label, control, bare) {
        const a = Object.keys(attrs)
            .map(k => ' ' + k + '="' + esc(attrs[k]) + '"').join('');
        const inner = '<label' + a + '>' + esc(label) + control + '</label>';
        return bare ? inner : '<div>' + inner + '</div>';
    }

    // A row that exists: addressed by its practice_instance_evidence id,
    // and read straight off the DOM by saveEvidence at save time.
    function evField(eid, name, label, control, bare) {
        return evLabel({ 'data-ev-field': name, 'data-ev-id': eid }, label, control, bare);
    }

    // Migration 334. A row that does not exist yet: addressed by the card
    // it sits in plus the evidence type it will become, because that pair
    // is what the save resolves to a real evidence_id once the adopt has
    // created the row. Its value is buffered into o._evidenceDraft rather
    // than left on the DOM -- see evidenceDraftOf.
    function pevField(rowKey, typeKey, name, label, control, bare) {
        return evLabel({ 'data-pev-field': name, 'data-pev-ob': rowKey, 'data-pev-type': typeKey },
                       label, control, bare);
    }

    // evidence_owner is a name column -- the existing form fills it from a
    // lookup whose value IS the name. The picker here works in ids, so map
    // the stored name back to one for display. An owner who has since left
    // the organization simply shows as unassigned rather than silently
    // matching somebody else.
    function ownerIdOf(name) {
        if (!name) return '';
        const hit = employees.find(e => e.label === name || e.label.endsWith(' - ' + name));
        return hit ? hit.value : '';
    }

    function field(id, name, label, control, isSelect, bare) {
        const inner = isSelect ? '<select>' + control + '</select>' : control;
        const wrapped = '<label data-field="' + esc(name) + '" data-ob="' + esc(id) + '">'
            + esc(label) + inner + '</label>';
        return bare ? wrapped : '<div>' + wrapped + '</div>';
    }

    function wireObligationCards() {
        const host = document.getElementById('rwObligations');

        host.querySelectorAll('[data-toggle]').forEach(function (b) {
            b.addEventListener('click', function (e) {
                // The checkbox lives inside the toggle so the row reads as
                // one control; clicking it must tick, not expand.
                if (e.target.matches('input[type="checkbox"]')) return;
                const key = this.getAttribute('data-toggle');
                open.has(key) ? open.delete(key) : open.add(key);
                renderObligations();
            });
        });

        host.querySelectorAll('input[data-adopt]').forEach(function (cb) {
            cb.addEventListener('change', function () {
                const id = this.getAttribute('data-adopt');
                const o  = obligations.find(x => keyOf(x) === id);
                if (!o) return;
                o._edit = o._edit || {};
                o._edit.isAdopted = this.checked;
                dirty.add(id);
                renderObligations();
            });
        });

        // Migration 245: the per-evidence Save button is retired; its
        // wiring goes with it. saveEvidence is still called by
        // saveOneObligation's parallel flush, so the function stays.

        // Migration 334: the pre-adoption evidence inputs. Deliberately
        // the same handler shape as the [data-field] scanner below --
        // buffer the value, tick adopt, mark the card dirty -- because it
        // is the same decision being recorded, just about an evidence row
        // instead of an obligation parameter.
        host.querySelectorAll('[data-pev-field]').forEach(function (label) {
            const input = label.querySelector('input, select, textarea');
            if (!input) return;
            input.addEventListener('change', function () {
                const rowKey  = label.getAttribute('data-pev-ob');
                const typeKey = label.getAttribute('data-pev-type');
                const name    = label.getAttribute('data-pev-field');
                const o       = obligations.find(x => keyOf(x) === rowKey);
                if (!o) return;
                o._evidenceDraft = o._evidenceDraft || {};
                o._evidenceDraft[typeKey] = o._evidenceDraft[typeKey] || {};
                o._evidenceDraft[typeKey][name] = this.value;
                // Filling in evidence is a statement of intent to take the
                // obligation on -- and here it is more than that: the row
                // this text belongs to is CREATED by the adopt, so an
                // un-adopted obligation has nowhere to put it. Ticking is
                // the only reading of the gesture that can be honoured.
                o._edit = o._edit || {};
                if (!val(o, 'isAdopted')) o._edit.isAdopted = true;
                dirty.add(rowKey);
                document.getElementById('rwObligationDirty').textContent =
                    dirty.size + ' unsaved change' + (dirty.size === 1 ? '' : 's');
                const cb = host.querySelector('input[data-adopt="' + rowKey + '"]');
                if (cb) cb.checked = true;
                // No re-render. The head's badge and tick would refresh,
                // but re-rendering on every keystroke-commit would move the
                // caret out of the box the operator is still working in.
                // The badge catches up on the next render, and the buffer
                // -- not the DOM -- is what the save reads.
            });
        });

        // Migration 227 -- the two actions only an organisation-defined
        // obligation carries.
        host.querySelectorAll('[data-local-edit]').forEach(function (b) {
            b.addEventListener('click', function () {
                const adoptionId = this.getAttribute('data-local-edit');
                const row = obligations.find(x => String(F(x, 'adoptionId')) === String(adoptionId));
                if (row) openLocalForm(row);
            });
        });

        host.querySelectorAll('[data-local-remove]').forEach(function (b) {
            b.addEventListener('click', function () {
                removeLocalObligation(this.getAttribute('data-local-remove'));
            });
        });

        // Migration 245: per-obligation Save. keyOf(o) matches the
        // data-save-obligation attribute; saveOneObligation flushes the
        // obligation row and any dirty evidence rows attached to it in
        // one action.
        host.querySelectorAll('[data-save-obligation]').forEach(function (b) {
            b.addEventListener('click', function () {
                saveOneObligation(this.getAttribute('data-save-obligation'));
            });
        });

        host.querySelectorAll('[data-field]').forEach(function (label) {
            const input = label.querySelector('input, select, textarea');
            if (!input) return;
            input.addEventListener('change', function () {
                const id   = label.getAttribute('data-ob');
                const name = label.getAttribute('data-field');
                const o    = obligations.find(x => keyOf(x) === id);
                if (!o) return;
                o._edit = o._edit || {};
                o._edit[name] = this.value === '' ? null : this.value;
                // Editing a parameter is a statement of intent to take the
                // obligation on, so tick it rather than silently discarding
                // the edit at save time.
                if (!val(o, 'isAdopted')) o._edit.isAdopted = true;
                dirty.add(id);
                document.getElementById('rwObligationDirty').textContent =
                    dirty.size + ' unsaved change' + (dirty.size === 1 ? '' : 's');
                const cb = host.querySelector('input[data-adopt="' + id + '"]');
                if (cb) cb.checked = true;
                // Migration 244: changing Assurance type between Manual and
                // Automated toggles whether the Connection type / URL
                // inputs are visible. Re-render the card so those inputs
                // appear or disappear in place. The re-render preserves
                // o._edit, so the value the user just picked survives.
                if (name === 'assuranceType') {
                    ensureConnectionTypes().then(() => {
                        // Keep this card open across the re-render.
                        open.add('ob-' + id);
                        renderObligations();
                    });
                }
            });
        });
    }

    // ---------- organisation-defined obligations  (migration 227) -----
    //
    // The FORM is the shared component:
    //     Views/Practice/Partials/_obligation-form-dialog.cshtml
    //     wwwroot/js/Shared/obligation-form.js   (window.gracObligationForm)
    //
    // It used to be ~600 lines here: the type dropdown, the typed rule
    // panel mirrored from Control Management, the Assurance -> Automated
    // -> Connection cascade, the evidence list, the validation and the
    // save. Practice View authors the same kind of obligation at practice
    // level (docs/practice-level-obligations.md), and a second copy would
    // have meant two validations, two field lists and two places to change
    // whenever CM adds a field.
    //
    // What stayed here is what this SCREEN owns: which row is being
    // edited, which evidence belongs to it, the lookups, and what to
    // reload afterwards. Behaviour is unchanged -- scope 'instance' posts
    // the same payload to the same endpoint it always did.
    // obligationForm / evidenceTypes / vocabulary are declared with the
    // other lookups at the top of this script: the obligation card's
    // read-side renderer resolves ids through them, and having them
    // declared here -- below their first use -- read like a forward
    // reference even though arrow bodies made it safe.

    // Gathered at open time, not captured once: loadLookups fills these
    // arrays asynchronously, and a snapshot taken at page load would hand
    // the form an empty Owner list.
    function obligationFormLookups() {
        return {
            frequencies:            frequencies,
            roles:                  roles,
            assuranceTypes:         assuranceTypes,
            implementationStatuses: implementationStatuses,
            evidenceTypes:          evidenceTypes,
            connectionTypes:        connectionTypes
        };
    }

    function openLocalForm(row) {
        // The row's typed detail sits in one of the seven arrays
        // typedArrays names, keyed by the row's own type -- including the
        // two retired ones, which is why that map stays on this side.
        const rowType = row ? String(F(row, 'typeCode') || '') : '';
        const spec    = typedArrays[rowType];

        obligationForm().open({
            scope:              'instance',
            practiceInstanceId: instanceId,
            row:                row || null,
            recordId:           row ? Number(F(row, 'adoptionId') || 0) : 0,
            detailJson:         (row && spec) ? F(row, spec[0]) : null,
            // Its evidence, as currently stored. A new obligation starts
            // empty. `locked` is what stops the form offering to remove a
            // row somebody has already worked on -- the procedure keeps it
            // anyway, and a control that appears to delete it would be a
            // lie.
            evidence: row
                ? evidence
                    .filter(e => String(F(e, 'sourcePracticeInstanceObligationId') || '')
                                 === String(F(row, 'adoptionId') || ''))
                    .map(e => ({
                        evidenceTypeId:  Number(F(e, 'evidenceTypeId')),
                        evidenceType:    String(F(e, 'evidenceType') || ''),
                        isMandatory:     F(e, 'isMandatory') !== false,
                        retentionPeriod: String(F(e, 'retentionPeriod') || ''),
                        // 340: the dialog Description is stored on the evidence
                        // row as evidence_description; seed it back so editing
                        // shows the current text (it travels as `remarks`).
                        remarks:         String(F(e, 'evidenceDescription') || ''),
                        locked: Boolean(String(F(e, 'evidenceLocation') || '').trim()
                                     || String(F(e, 'evidenceLocator')  || '').trim()
                                     || String(F(e, 'evidenceOwner')    || '').trim())
                    }))
                : [],
            lookups:               obligationFormLookups(),
            ensureConnectionTypes: ensureConnectionTypes,
            onSaved:               loadObligations
        });
    }

    async function removeLocalObligation(adoptionId) {
        if (!await window.gracUi.confirm(
                'Remove this obligation from the instance? '
              + 'It was added by this organisation, so nothing republishes it.',
                { type: 'warning', title: 'Remove obligation', confirmText: 'Remove' })) return;
        try {
            await obligationForm().retire({
                scope:              'instance',
                practiceInstanceId: instanceId,
                recordId:           Number(adoptionId)
            });
            await loadObligations();
        } catch (err) {
            console.error('resolve-workspace: remove local obligation failed', err);
            window.alert(err && err.message ? err.message : 'Could not remove the obligation.');
        }
    }

    // The Add button appears only when there is a type list to choose
    // from: no types means no way to say what an obligation IS, and the
    // save procedure refuses one without a type -- so the button does not
    // appear rather than leading somewhere that cannot succeed.
    async function primeObligationForm() {
        try {
            await obligationForm().prime();
            const types = await obligationForm().loadTypes();
            document.getElementById('rwAddObligation').hidden = !types.length;
        } catch (err) {
            console.error('resolve-workspace: obligation form prime failed', err);
        }
    }

    // Migration 245: build the /resolve/obligations payload row for one
    // obligation. Extracted so both the retired bulk saveObligations
    // (used by nothing on screen after 245, kept for reference) and the
    // new saveOneObligation share exactly one place where the payload
    // shape lives.
    function buildObligationPayloadRow(o) {
        const num = v => (v === null || v === undefined || v === '') ? null : Number(v);
        return {
            obligationId:         Number(F(o, 'obligationId')),
            isAdopted:            !!val(o, 'isAdopted'),
            executionFrequencyId: num(val(o, 'executionFrequencyId')),
            executionFrequency:   labelOf(frequencies, val(o, 'executionFrequencyId')),
            assuranceFrequencyId: num(val(o, 'assuranceFrequencyId')),
            assuranceFrequency:   labelOf(frequencies, val(o, 'assuranceFrequencyId')),
            responsibility:       val(o, 'responsibility') || null,
            approvalAuthority:    val(o, 'approvalAuthority') || null,
            assuranceType:        val(o, 'assuranceType') || null,
            // Migration 336-338: first occurrence of the calendar schedule
            // for a schedulable (Execution / Assurance) obligation. Null =
            // leave an existing stream's anchor as-is; a new stream with no
            // date starts today. Carried past the adopt proc to the schedule
            // sync (see SyncScheduleRulesForInstanceAsync).
            firstOccurrenceDate:  val(o, 'firstOccurrenceDate') || null,
            // The Remarks input is gone from the card, so val() resolves
            // to the stored value and this round-trips it unchanged.
            // Kept rather than dropped because sp_resolve_obligation_adopt
            // assigns remarks directly -- omitting the key would blank the
            // column on every save.
            remarks:              val(o, 'remarks') || null,
            eventTypeId:          num(val(o, 'eventTypeId')),
            slaValue:             num(val(o, 'slaValue')),
            slaUnit:              val(o, 'slaUnit') || null,
            implementationStatusId: num(val(o, 'implementationStatusId')),
            connectionTypeId:     num(val(o, 'connectionTypeId')),
            connectionUrl:        val(o, 'connectionUrl') || null
        };
    }

    // The row shape for an ORGANISATION-DEFINED obligation's inline Save,
    // posted to /resolve/local-obligation (sp_resolve_local_obligation_save).
    //
    // That procedure REQUIRES obligation_name + type_code and OVERWRITES the
    // definition fields (name, description, execution frequency, approval,
    // assurance type, responsibility, remarks) with whatever it is sent -- so
    // every one of them is resent from the row, and only the three the card
    // actually edits inline (Owner / Assurance type / Implementation status)
    // carry a val() override. typed_detail_json and evidence are the two it
    // COALESCEs / reads NULL as "leave alone": sending NULL keeps the stored
    // rule detail and the declared evidence LIST exactly as the Edit dialog
    // left them. The evidence ROWS' own fields (location, locator,
    // description...) are saved separately, per row, by saveEvidence -- the
    // same path an adopted card uses.
    function buildLocalObligationPayloadRow(o) {
        const num = v => (v === null || v === undefined || v === '') ? null : Number(v);
        return {
            practiceInstanceId:           instanceId,
            practiceInstanceObligationId: Number(F(o, 'adoptionId')),
            obligationName:        F(o, 'obligationName'),
            obligationDescription: F(o, 'obligationDescription') || null,
            obligationTypeCode:    F(o, 'typeCode'),
            typedDetailJson:       null,   // leave the stored rule untouched
            executionFrequencyId:  num(val(o, 'executionFrequencyId')),
            executionFrequency:    labelOf(frequencies, val(o, 'executionFrequencyId')),
            responsibility:        val(o, 'responsibility') || null,
            approvalAuthority:     val(o, 'approvalAuthority') || null,
            assuranceType:         val(o, 'assuranceType') || null,
            implementationStatusId: num(val(o, 'implementationStatusId')),
            connectionTypeId:      num(val(o, 'connectionTypeId')),
            connectionUrl:         val(o, 'connectionUrl') || null,
            remarks:               val(o, 'remarks') || null,
            evidence:              null,   // leave the declared evidence list untouched
            retire:                false
        };
    }

    // Migration 245: save exactly ONE obligation, and flush the
    // evidence rows sitting inside its card in the same click. The API
    // side reconciles the persistent gap tables after the save so a
    // move to / out of Not Implemented / Partially Implemented is
    // reflected on Task Center immediately.
    //
    // The obligation goes through the same /resolve/obligations
    // endpoint the bulk save used, with a single-item array. That keeps
    // one path through sp_resolve_obligation_adopt rather than two.
    async function saveOneObligation(key) {
        const o = obligations.find(x => keyOf(x) === String(key));
        if (!o) return;
        // An organisation-defined obligation has no published side to adopt,
        // so its inline Save posts to the local endpoint rather than the
        // adopt path. Everything else about the flow is identical: the
        // parameters go up here, and the evidence rows in the card are
        // flushed in the same click below.
        const local = F(o, 'isOrganizationDefined') === true;
        const btn = document.querySelector('[data-save-obligation="' + key + '"]');
        const msg = document.querySelector('[data-save-note="' + key + '"]');
        if (btn) btn.disabled = true;
        if (msg) msg.textContent = 'Saving...';

        try {
            // 1. The obligation itself.
            const r = await fetch(
                local ? U('/practice/api/workflow/resolve/local-obligation')
                      : U('/practice/api/workflow/resolve/obligations'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                body: JSON.stringify(
                    local ? buildLocalObligationPayloadRow(o)
                          : {
                        practiceInstanceId: instanceId,
                        organizationId:     orgId,
                        obligations:        [buildObligationPayloadRow(o)]
                    })
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
                if (msg) msg.textContent = body.error || ('Could not save (HTTP ' + r.status + ').');
                if (btn) btn.disabled = false;
                return;
            }

            // 2. Its evidence rows. Any dirty edit sitting on an
            //    evidence line under this card is sent through the same
            //    /resolve/evidence endpoint saveEvidence uses. Runs in
            //    parallel so a card with several evidence rows does not
            //    fan out sequentially.
            const card = btn ? btn.closest('article.rw-card') : null;
            const evidenceIds = card
                ? [...card.querySelectorAll('[data-ev]')].map(el => el.getAttribute('data-ev'))
                : [];
            if (evidenceIds.length) {
                await Promise.all(evidenceIds.map(id => saveEvidence(id)));
            }

            // 2b. Migration 334. The rows that did NOT exist when the card
            //     was drawn: the operator filled in the pre-adoption
            //     preview, and the POST above has just adopted the
            //     obligation, which is what creates them
            //     (sp_resolve_obligation_adopt -> 304's
            //     sp_resolve_evidence_reconcile_for_instance, in the same
            //     call -- so by the time this line runs, the rows are
            //     there).
            //
            //     Re-read the evidence list and match each draft to the row
            //     now standing for its evidence type. The reconcile inserts
            //     one row per (obligation, evidence type), and
            //     publishedEvidenceOf is keyed the same way, so the match
            //     is exact rather than a best guess.
            // Pre-adoption evidence drafts are a PUBLISHED-obligation concept
            // (the boxes shown before adoption creates the rows). A local
            // obligation's evidence rows already exist -- its types are
            // declared in the Edit dialog -- so it never has drafts to place.
            let unplaced = 0;
            const drafts = local ? {} : (o._evidenceDraft || {});
            const draftKeys = Object.keys(drafts);
            if (draftKeys.length) {
                await loadEvidence();
                const obId = Number(F(o, 'obligationId'));
                const rows = evidence.filter(e => Number(F(e, 'sourceObligationId')) === obId);
                await Promise.all(draftKeys.map(function (tk) {
                    const row = rows.find(e => typeKeyOf(F(e, 'evidenceType')) === tk);
                    // No row for this type means the evidence type the
                    // authority published has no active match in this
                    // organisation's catalogue -- the same condition the
                    // bulk save reports as unmappedEvidenceTypes. Counted
                    // and said out loud rather than dropped quietly.
                    if (!row) { unplaced++; return Promise.resolve(); }
                    return postEvidenceValues(F(row, 'evidenceId'), drafts[tk]);
                }));
                // Whatever landed is now stored, and loadObligations below
                // re-reads it. Whatever did not could not be stored at all,
                // so keeping it would leave a draft that never saves.
                o._evidenceDraft = null;
            }

            // 3. Report + refresh. loadObligations rehydrates from the
            //    procedure, so the card picks up any server-side change
            //    (organization_modified, gap status change) on the same
            //    click.
            dirty.delete(String(key));
            if (msg) msg.textContent = body.message || 'Saved.';
            // Migration 334. The dropped-draft warning goes to the PANEL
            // message, not the card's note: loadObligations below rebuilds
            // every card's HTML, so [data-save-note] is destroyed a moment
            // after it is written. "Saved." can afford to flash past --
            // the card redraws as adopted and says so itself. "What you
            // typed was not stored" cannot.
            if (unplaced) {
                window.__wfCommon.setMessage('rwObligationMessage',
                    unplaced + ' evidence detail' + (unplaced === 1 ? '' : 's')
                    + ' could not be saved: that evidence type has no active match in this '
                    + 'organisation\'s catalogue, so no row was created to hold it. '
                    + 'The obligation itself was saved.', 'info');
            }
            await loadObligations();
        } catch (err) {
            console.error('resolve-workspace: save one obligation failed', err);
            if (msg) msg.textContent = 'Could not save the obligation.';
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    async function saveObligations() {
        if (!dirty.size) {
            window.__wfCommon.setMessage('rwObligationMessage', 'Nothing has changed.', 'info');
            return;
        }
        // Migration 245: bulk save is no longer wired to a UI control.
        // The function stays for programmatic use (e.g. tests) but must
        // not depend on the retired rwSaveObligations button.
        window.__wfCommon.setMessage('rwObligationMessage', 'Saving...', 'info');

        // Organisation-defined rows are saved through their own endpoint
        // (migration 227). buildObligationPayloadRow is the single source
        // of truth for the /resolve/obligations row shape.
        const payload = obligations
            .filter(o => dirty.has(keyOf(o)) && F(o, 'isOrganizationDefined') !== true)
            .map(buildObligationPayloadRow);

        try {
            const r = await fetch(U('/practice/api/workflow/resolve/obligations'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                body: JSON.stringify({
                    practiceInstanceId: instanceId,
                    organizationId:     orgId,
                    obligations:        payload
                })
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
                window.__wfCommon.setMessage('rwObligationMessage',
                    body.error || ('Could not save (HTTP ' + r.status + ').'), 'error');
                return;
            }

            // Say what happened, including the part that did not: an
            // evidence type with no practice-side match produced no row,
            // and a silent count would disagree with the obligation.
            const adopted = Number(body.adoptedCount ?? 0);
            const removed = Number(body.removedCount ?? 0);
            const unmapped = Number(body.unmappedEvidenceTypes ?? 0);
            const parts = [];
            if (adopted) parts.push(adopted + ' adopted');
            if (removed) parts.push(removed + ' removed');
            if (unmapped) parts.push(unmapped + ' evidence type'
                + (unmapped === 1 ? '' : 's') + ' had no match here and were skipped');
            window.__wfCommon.setMessage('rwObligationMessage',
                (parts.join('. ') || 'Saved') + '.', unmapped ? 'info' : 'ok');

            dirty.clear();
            await loadObligations();
        } catch (err) {
            console.error('resolve-workspace: save obligations failed', err);
            window.__wfCommon.setMessage('rwObligationMessage', 'Could not save obligations.', 'error');
        }
    }

    function labelOf(list, value) {
        if (value === null || value === undefined || value === '') return null;
        const hit = list.find(o => String(o.value) === String(value));
        return hit ? hit.label : null;
    }

    // ---------- 3. Dependencies --------------------------------------
    let dependencyCategories = [], dependencyResolutions = [];

    async function loadDependencies() {
        const bodyEl = document.getElementById('rwDepTableBody');
        try {
            const r = await fetch(U('/practice/api/workflow/resolve/instances/'
                        + encodeURIComponent(instanceId) + '/dependencies'), { credentials: 'same-origin' });
            if (!r.ok) {
                const b = await r.json().catch(() => ({}));
                bodyEl.innerHTML = '<tr><td colspan="4"><div class="pm-empty compact">'
                    + esc(b.error || ('Could not load dependencies (HTTP ' + r.status + ').'))
                    + '</div></td></tr>';
                return;
            }
            const body = await r.json();
            dependencyCategories  = body.data || body.Data || [];
            dependencyResolutions = body.resolutions || body.Resolutions || [];
            renderDependencyTable();
        } catch (err) {
            console.error('resolve-workspace: dependencies failed', err);
            document.getElementById('rwDepTableBody').innerHTML =
                '<tr><td colspan="4"><div class="pm-empty compact">Could not load dependencies.</div></td></tr>';
        }
    }

    // ---------- migration 238: dependency table ----------------------
    //
    // Fixed five rows. Tool and Application still exist in
    // dependency_type_master (older instances may still carry
    // resolutions) but are not offered here -- the same principle CM
    // followed when it retired obligation types from the front end.
    //
    // Names match dependency_type_master.dependency_type_name exactly.
    // Person maps to the organization_employee register through
    // dependency_type_source_config, so no on-screen rename is needed.
    const DEP_TABLE_CATEGORIES = ['Asset', 'Vendor', 'Person', 'Team', 'Committee'];

    // Cache of loaded object lists per category id -- keeps re-renders
    // and re-ticks from re-hitting dependency-options, which is a
    // relatively expensive query.
    const dependencyObjectCache = new Map();

    // Asset taxonomy cache -- migration 241's lookup endpoint returns
    // categories + sub-categories + asset types in one call. The Resolve
    // workspace uses it to render three multi-select filters above the
    // asset picker so a large asset register can be narrowed down
    // before the user starts hunting.
    let assetTaxonomyCache = null;
    // Builds the three multi-select checkcombos that sit above the
    // Asset row's picker. Each is a checkcombo containing all items at
    // its level (categories all shown, sub-categories all shown; sub /
    // type do not cascade-narrow their OPTIONS -- selecting a category
    // narrows the ASSET picker, not the sub-category list, so the user
    // is free to widen or drill sideways without losing prior ticks).
    // Client-side filtering is intersection: an asset must satisfy
    // every non-empty filter set.
    // Returns just the three filter cells. The caller wraps them with
    // the picker cell inside one flex row so filters and picker sit on
    // the same line -- keeping the row's vertical footprint at one line
    // was the reason the filters were factored out.
    function buildAssetFilterCells(tax) {
        const bucket = (label, dataAttr, items) =>
              '<div class="rw-asset-filter" style="flex:1 1 0;min-width:0">'
            + '<label class="rw-note" style="display:block;margin-bottom:2px">' + esc(label) + '</label>'
            + '<div class="pm-field pm-checkcombo" data-checkcombo ' + dataAttr + ' style="width:100%">'
            + '<button class="pm-checkcombo-trigger" type="button" data-checkcombo-trigger>'
            +   '<span data-checkcombo-text>All</span>'
            +   '<span class="pm-checkcombo-caret" aria-hidden="true"></span>'
            + '</button>'
            + '<div class="pm-checkcombo-menu" data-checkcombo-menu hidden>'
            +   '<input class="pm-checkcombo-search" type="search" placeholder="Search..." data-checkcombo-search>'
            +   '<div class="pm-checkcombo-options">'
            +     items.map(o =>
                    '<label data-checkcombo-option>'
                    + '<input type="checkbox" value="' + esc(String(o.id)) + '"> '
                    + '<span>' + esc(o.name) + '</span></label>').join('')
            +   '</div>'
            + '</div>'
            + '</div>'
            + '</div>';

        return bucket('Asset category',     'data-asset-cat-filter',    tax.cats)
             + bucket('Asset sub-category', 'data-asset-subcat-filter', tax.subs)
             + bucket('Asset type',         'data-asset-type-filter',   tax.types);
    }

    async function loadAssetTaxonomy() {
        if (assetTaxonomyCache) return assetTaxonomyCache;
        try {
            const r = await fetch(U('/practice-management-gateway/asset-taxonomy/query'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                body: JSON.stringify({ data: { pageNumber: 1, pageSize: 1000 } })
            });
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const rows = rowsOf(await r.json());
            const bucket = { cats: [], subs: [], types: [] };
            rows.forEach(row => {
                const kind = String(row.EntityType || row.entityType || '');
                const item = {
                    id: Number(row.Value ?? row.value),
                    name: String(row.Label ?? row.label ?? ''),
                    parent: row.Parent != null ? Number(row.Parent) : null
                };
                if (!item.id) return;
                if (kind === 'asset-categories')     bucket.cats.push(item);
                else if (kind === 'asset-subcategories') bucket.subs.push(item);
                else if (kind === 'asset-types')     bucket.types.push(item);
            });
            assetTaxonomyCache = bucket;
        } catch (_) {
            // 241 not yet deployed here -- the Asset row falls back to
            // the flat asset picker without the three cascade filters.
            assetTaxonomyCache = { cats: [], subs: [], types: [] };
        }
        return assetTaxonomyCache;
    }

    async function loadDependencyObjectsFor(dependencyTypeId) {
        const key = Number(dependencyTypeId);
        if (dependencyObjectCache.has(key)) return dependencyObjectCache.get(key);
        try {
            const r = await fetch(U('/practice-management-gateway/dependency-options/query'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                body: JSON.stringify({ data: {
                    organizationId:   orgId,
                    dependencyTypeId: key,
                    pageNumber: 1, pageSize: 500
                }})
            });
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const list = rowsOf(await r.json())
                .map(x => ({
                    // Asset options carry three taxonomy ids so the
                    // Resolve workspace can filter a large asset register
                    // down before the picker (migration 242 in the API's
                    // dependency-options query).
                    id:                Number(x.Value ?? x.value ?? x.Id ?? 0),
                    name:              String(x.Label ?? x.label ?? x.Name ?? ''),
                    // 291. Person options carry the employee's active
                    // roles. Kept separate from name because name is what
                    // saveAllDependencies persists (as data-object-name).
                    roleNames:         x.RoleNames ?? x.roleNames ?? null,
                    assetCategoryId:   x.AssetCategoryId ?? x.assetCategoryId ?? null,
                    assetSubcategoryId:x.AssetSubcategoryId ?? x.assetSubcategoryId ?? null,
                    assetTypeId:       x.AssetTypeId ?? x.assetTypeId ?? null
                }))
                .filter(x => x.id && x.name);
            dependencyObjectCache.set(key, list);
            return list;
        } catch (_) {
            return [];
        }
    }

    // A stable id for the category, resolved through several fallbacks so
    // catalogue and resolutions rows can match even when their casing
    // drifts.
    function findCategoryId(categoryName) {
        const norm = String(categoryName || '').trim().toLowerCase();
        const fromCat = dependencyCategories.find(c => String(F(c, 'dependencyCategory')).trim().toLowerCase() === norm);
        if (fromCat) return Number(F(fromCat, 'dependencyTypeId'));
        const fromCatalogue = dependencyTypes.find(t => String(F(t, 'dependencyCategory')).trim().toLowerCase() === norm);
        if (fromCatalogue) return Number(F(fromCatalogue, 'dependencyTypeId'));
        return null;
    }

    // Reuse the project's .pm-checkcombo styles (practice.js uses them
    // throughout for combo pickers, and practice-management.css defines
    // trigger/menu/search/options/chip styling). Only the delegated
    // trigger/change handlers are ours -- practice.js binds its own to
    // fieldsHost, which this partial does not live inside.
    function comboMenuText(combo) {
        const labels = [...combo.querySelectorAll('input[type="checkbox"]:checked')]
            .map(cb => cb.closest('label').querySelector('span').textContent.trim());
        return labels.join(', ') || 'Select...';
    }

    // Wires every checkcombo in the row -- the object picker AND, on the
    // Asset row, the three cascade filters. Each combo gets its own
    // open/close, per-menu search, and trigger text update. The Asset
    // row additionally wires an intersection filter: whenever any of
    // the three filter combos changes, the asset picker's options
    // become hidden unless their category/subcategory/type matches every
    // non-empty filter set.
    function wireCheckcombo(row) {
        const combos = row.querySelectorAll('[data-checkcombo]');
        if (!combos.length) return;

        combos.forEach(function (combo) {
            const trigger = combo.querySelector('[data-checkcombo-trigger]');
            const menu    = combo.querySelector('[data-checkcombo-menu]');
            const search  = combo.querySelector('[data-checkcombo-search]');
            trigger.addEventListener('click', function (ev) {
                ev.preventDefault();
                document.querySelectorAll('[data-checkcombo-menu]').forEach(m => { if (m !== menu) m.hidden = true; });
                menu.hidden = !menu.hidden;
                if (!menu.hidden) search?.focus();
            });
            combo.addEventListener('change', function (ev) {
                const cb = ev.target.closest('input[type="checkbox"]');
                if (!cb) return;
                combo.querySelector('[data-checkcombo-text]').textContent = comboMenuText(combo);
            });
            if (search) search.addEventListener('input', function () {
                const q = this.value.toLowerCase().trim();
                combo.querySelectorAll('[data-checkcombo-option]').forEach(function (opt) {
                    const text = opt.querySelector('span').textContent.toLowerCase();
                    opt.hidden = q && !text.includes(q);
                });
            });
            document.addEventListener('mousedown', function (ev) {
                if (!combo.contains(ev.target)) menu.hidden = true;
            });
        });

        // Asset row: the three filter checkcombos narrow the asset
        // picker. Selecting nothing on a filter means "no restriction".
        const catFilter    = row.querySelector('[data-asset-cat-filter]');
        const subFilter    = row.querySelector('[data-asset-subcat-filter]');
        const typeFilter   = row.querySelector('[data-asset-type-filter]');
        const assetPicker  = row.querySelector('.rw-dep-object [data-checkcombo]');
        if (!catFilter && !subFilter && !typeFilter) return;

        const readTicks = combo => new Set([...combo.querySelectorAll('input[type="checkbox"]:checked')].map(cb => cb.value));
        const applyFilters = () => {
            if (!assetPicker) return;
            const cats  = catFilter  ? readTicks(catFilter)  : new Set();
            const subs  = subFilter  ? readTicks(subFilter)  : new Set();
            const types = typeFilter ? readTicks(typeFilter) : new Set();
            assetPicker.querySelectorAll('[data-checkcombo-option]').forEach(function (opt) {
                const okCat  = !cats.size  || cats.has(opt.dataset.assetCategory || '');
                const okSub  = !subs.size  || subs.has(opt.dataset.assetSubcategory || '');
                const okType = !types.size || types.has(opt.dataset.assetType || '');
                opt.hidden = !(okCat && okSub && okType);
            });
        };
        [catFilter, subFilter, typeFilter].forEach(f => { if (f) f.addEventListener('change', applyFilters); });
    }

    // "Ticking" the row now only means "you intend this category to
    // apply"; the checkcombo carries what is picked. Anything other than
    // Yes -- No, or the unanswered Select -- clears the ticks, so a save
    // from that row retires its resolutions and the picker never shows a
    // selection the save would not send.
    function wireApplyTick(row) {
        const tick = row.querySelector('[data-dep-tick]');
        if (!tick) return;
        // Every checkcombo trigger in the row -- picker + any filter
        // combos (Asset row carries three). Disabling them all keeps a
        // No row inert; a picker-only disable let the user still open a
        // filter menu on a row they had said "No" to.
        const triggers = [...row.querySelectorAll('[data-checkcombo-trigger]')];
        const picker   = row.querySelector('.rw-dep-object [data-checkcombo]')
                       || row.querySelector('.rw-dep-picker > .pm-checkcombo');
        const apply = () => {
            const on = tick.value === 'Yes';
            triggers.forEach(t => { t.disabled = !on; });
            // No -> also clear the picker selection so the empty payload
            // the save loop sends really reflects an unresolved row.
            // Filter combos are left alone (their state is not part of
            // what gets saved, and losing filters after a toggle would
            // be pointless annoyance).
            if (!on && picker) {
                picker.querySelectorAll('input[type="checkbox"]:checked').forEach(cb => cb.checked = false);
                const txt = picker.querySelector('[data-checkcombo-text]');
                if (txt) txt.textContent = 'Select...';
                const menu = picker.querySelector('[data-checkcombo-menu]');
                if (menu) menu.hidden = true;
            }
        };
        tick.addEventListener('change', function () {
            apply();
            // Answering one row may be the last one Save was waiting on.
            syncDepSaveState();
        });
        // First paint: reflect the unanswered Select / stored Yes without
        // requiring a change event.
        apply();
    }

    async function renderDependencyTable() {
        const bodyEl = document.getElementById('rwDepTableBody');
        if (!bodyEl) return;

        // Load the object lists for every visible category up front so
        // each row can present a fully populated picker. The caches
        // memoise and the five categories are small. Asset also pulls
        // the taxonomy so its three cascade filters can be built.
        const taxonomyPromise = loadAssetTaxonomy();
        const rowData = await Promise.all(DEP_TABLE_CATEGORIES.map(async function (categoryName) {
            const typeId = findCategoryId(categoryName);
            const mine   = dependencyResolutions.filter(r =>
                (typeId !== null && Number(F(r, 'dependencyTypeId')) === typeId)
                || String(F(r, 'dependencyCategory')).trim().toLowerCase() === categoryName.toLowerCase());
            const list   = typeId ? await loadDependencyObjectsFor(typeId) : [];
            return { categoryName, typeId, mine, list };
        }));
        const assetTaxonomy = await taxonomyPromise;

        let ticked = 0;
        bodyEl.innerHTML = rowData.map(function (r) {
            const { categoryName, typeId, mine, list } = r;
            const isTicked    = mine.length > 0;
            if (isTicked) ticked++;
            const selectedIds = new Set(mine.map(x => Number(F(x, 'resolvedDependencyId'))));
            const isAsset     = categoryName === 'Asset';

            // Asset gets three cascade multi-select filter cells that sit
            // on the SAME row as the asset picker itself -- otherwise the
            // Asset row is twice as tall as every other one and the eye
            // has to jump between filter and picker. Non-Asset rows still
            // render a plain picker.
            const showAssetFilters = isAsset && assetTaxonomy.cats.length > 0;
            const assetFilterCells = showAssetFilters ? buildAssetFilterCells(assetTaxonomy) : '';

            // Same "Name - Role" format in the collapsed trigger text as
            // in the open option list below.
            const selectedLabels = list.filter(o => selectedIds.has(o.id))
                                       .map(o => personWithRole(o.name, o.roleNames)).join(', ');

            const options = list.map(o =>
                '<label data-checkcombo-option'
                + (o.assetCategoryId != null ? ' data-asset-category="' + esc(String(o.assetCategoryId)) + '"' : '')
                + (o.assetSubcategoryId != null ? ' data-asset-subcategory="' + esc(String(o.assetSubcategoryId)) + '"' : '')
                + (o.assetTypeId != null ? ' data-asset-type="' + esc(String(o.assetTypeId)) + '"' : '')
                + '><input type="checkbox" value="' + esc(String(o.id)) + '"'
                // Bare name: saveAllDependencies persists this attribute.
                + ' data-object-name="' + esc(o.name) + '"'
                + (selectedIds.has(o.id) ? ' checked' : '') + '> '
                + '<span>' + esc(personWithRole(o.name, o.roleNames)) + '</span></label>').join('');

            // The main picker checkcombo (wrapped in .rw-dep-object cell
            // so wireApplyTick / saveAllDependencies can select it apart
            // from the filter combos on the Asset row).
            const objectComboHtml =
                  '<div class="rw-dep-object" style="flex:2 1 0;min-width:0">'
                // The "Objects" column header already names this cell, so the
                // per-picker label is redundant on a plain row (Person / Team /
                // Committee / Vendor). It is kept ONLY on the Asset row, where
                // the picker shares one flex row with the Category / Subcategory
                // / Type filter combos and the label is what tells them apart.
                +   (isAsset ? '<label class="rw-note" style="display:block;margin-bottom:2px">Objects</label>' : '')
                +   '<div class="pm-field pm-checkcombo" data-checkcombo style="width:100%">'
                +     '<button class="pm-checkcombo-trigger" type="button"'
                +       ' data-checkcombo-trigger' + (isTicked ? '' : ' disabled') + '>'
                +       '<span data-checkcombo-text>' + esc(selectedLabels || 'Select...') + '</span>'
                +       '<span class="pm-checkcombo-caret" aria-hidden="true"></span>'
                +     '</button>'
                +     '<div class="pm-checkcombo-menu" data-checkcombo-menu hidden>'
                +       '<input class="pm-checkcombo-search" type="search"'
                +         ' placeholder="Search..." data-checkcombo-search>'
                +       '<div class="pm-checkcombo-options">' + options + '</div>'
                +     '</div>'
                +   '</div>'
                + '</div>';

            // Both fall-throughs render in the SAME box the picker would
            // have occupied (.pm-field-empty mirrors
            // .pm-checkcombo-trigger), so a category with nothing to pick
            // keeps the row on the same grid as the ones above it instead
            // of collapsing to a bare line of text. Static text, not a
            // control -- saveAllDependencies reads [data-checkcombo] and
            // [data-dep-tick], neither of which exists here, so the save
            // path sees exactly what it saw before.
            const picker = (typeId === null)
                ? '<div class="pm-field-empty warn">This category is not in the catalogue on this database.</div>'
                : (list.length
                    ? (showAssetFilters
                        // Asset: filters + picker share ONE flex row and
                        // together fill the Objects td. nowrap so the row
                        // never breaks into two lines; each cell has
                        // flex:1/2 with min-width:0 so long labels do not
                        // push the row past its container.
                        ? '<div class="rw-asset-row" style="display:flex;gap:8px;align-items:flex-end;width:100%">'
                              + assetFilterCells
                              + objectComboHtml
                          + '</div>'
                        : objectComboHtml)
                    : '<div class="pm-field-empty">No active ' + esc(categoryName.toLowerCase())
                      + ' records for this organization yet.</div>');

            // data-dep-tick is a Select / Yes / No select whose value
            // === 'Yes' stands in for what the old checkbox called
            // "checked". Existing selectors on wireApplyTick +
            // saveAllDependencies still find it by that data attribute,
            // so nothing else needs to change to read the flag.
            //
            // It starts at Select -- an UNANSWERED row -- and Save stays
            // disabled until every answerable row has been moved off it.
            // A row that already had objects stored comes back as Yes, so
            // a reload does not silently un-adopt the category.
            //
            // There is no third state in the STORE: a category saved as
            // No and one never answered both hold zero resolution rows,
            // and nothing distinguishes them on the way back in. So a
            // reload shows Select again for a row saved as No. Recording
            // the answer itself would need a column on
            // practice_dependency_resolution (or a row with no object) --
            // a schema change, deliberately not made here.
            const applyDisabledAttr = (typeId === null || !list.length) ? ' disabled' : '';
            const applyValue = isTicked ? 'Yes' : '';
            return '<tr class="rw-dep-row"'
                 + ' data-category-name="' + esc(categoryName) + '"'
                 + ' data-category-id="' + esc(typeId ?? '') + '">'
                 + '<td><strong>' + esc(categoryName) + '</strong>'
                 +   (mine.length ? ' <span class="rw-note">(' + mine.length + ')</span>' : '')
                 + '</td>'
                 + '<td>'
                 +   '<select data-dep-tick' + applyDisabledAttr + ' style="width:100%">'
                 +     '<option value=""' + (applyValue === ''    ? ' selected' : '') + '>Select</option>'
                 +     '<option value="Yes"' + (applyValue === 'Yes' ? ' selected' : '') + '>Yes</option>'
                 +     '<option value="No"' + (applyValue === 'No'  ? ' selected' : '') + '>No</option>'
                 +   '</select>'
                 + '</td>'
                 + '<td class="rw-dep-picker">' + picker + '</td>'
                 + '</tr>';
        }).join('');

        document.getElementById('rwDependencyCount').textContent =
            ticked + ' / ' + DEP_TABLE_CATEGORIES.length + ' with resolutions';
        document.getElementById('rwDepSaveBar').hidden = false;

        bodyEl.querySelectorAll('.rw-dep-row').forEach(function (row) {
            wireCheckcombo(row);
            wireApplyTick(row);
        });
        syncDepSaveState();
    }

    // Save is available only once every answerable row says Yes or No.
    // The table is one save for all five categories -- a partially
    // answered table would post "no dependencies of this kind" for the
    // rows nobody had looked at yet, which is an answer the operator
    // never gave.
    //
    // A row whose select is DISABLED is excluded: the category is not in
    // this database's catalogue, or the organisation has no records of
    // that kind yet (Committee, in a fresh tenant). Requiring an answer
    // no control can give would leave Save dead forever. Those rows still
    // save exactly as they did before -- an empty resolution set.
    function syncDepSaveState() {
        const btn  = document.getElementById('rwDepSaveAll');
        const hint = document.getElementById('rwDepSaveHint');
        if (!btn) return;

        const pending = [...document.querySelectorAll('.rw-dep-row')]
            .map(row => ({ row: row, sel: row.querySelector('[data-dep-tick]') }))
            .filter(x => x.sel && !x.sel.disabled && !x.sel.value)
            .map(x => x.row.getAttribute('data-category-name'));

        btn.disabled = pending.length > 0;
        if (hint) {
            hint.textContent = pending.length
                ? 'Answer ' + pending.join(', ') + ' to save.'
                : '';
        }
    }

    // One button for the whole table. Loops the rows, one POST per
    // category. A category with the tick off sends an empty array, which
    // the procedure treats as "retire everything of this category on
    // this instance" -- the same complete-set rule the local-obligation
    // evidence sync uses.
    async function saveAllDependencies() {
        const btn  = document.getElementById('rwDepSaveAll');
        const hint = document.getElementById('rwDepSaveHint');
        btn.disabled = true;
        hint.textContent = 'Saving...';

        const rows = [...document.querySelectorAll('.rw-dep-row')];
        let ok = 0, failed = [];
        for (const row of rows) {
            const categoryId = Number(row.getAttribute('data-category-id')) || null;
            if (!categoryId) continue;
            const tick  = row.querySelector('[data-dep-tick]');
            // The asset row has three filter checkcombos in front of the
            // object picker; save only reads the object picker itself,
            // which lives inside .rw-dep-picker. Every other row still
            // has exactly one checkcombo, so this selector matches it too.
            // .rw-dep-object wraps the object picker on every row (single
        // wrapper on non-Asset, sits alongside the three filter combos
        // in the flex row on Asset). Ensures we always target the
        // picker rather than a filter.
        const combo = row.querySelector('.rw-dep-object [data-checkcombo]') || row.querySelector('.rw-dep-picker > .pm-checkcombo');
            // The row Applicability control is a Yes/No select (was a
            // checkbox pre-change). Yes -> collect the picker's selected
            // objects; No -> empty payload, which the procedure treats
            // as "retire whatever is stored for this category on this
            // instance".
            const isYes = tick && tick.value === 'Yes';
            const objects = (isYes && combo)
                ? [...combo.querySelectorAll('input[type="checkbox"]:checked')].map(cb => ({
                    id:   Number(cb.value),
                    name: cb.getAttribute('data-object-name') || cb.closest('label').querySelector('span').textContent.trim()
                }))
                : [];
            try {
                const r = await fetch(U('/practice/api/workflow/resolve/dependency-category'), {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF },
                    body: JSON.stringify({
                        practiceInstanceId: instanceId,
                        dependencyTypeId:   categoryId,
                        objects:            objects
                    })
                });
                if (!r.ok) {
                    const b = await r.json().catch(() => ({}));
                    failed.push(row.getAttribute('data-category-name') + ': ' + (b.error || ('HTTP ' + r.status)));
                } else { ok++; }
            } catch (err) {
                failed.push(row.getAttribute('data-category-name') + ': network error');
            }
        }

        // Back to whatever the table's own state says, rather than a flat
        // re-enable: if a row is still unanswered -- which a failed save
        // leaves possible -- Save has to stay disabled. loadDependencies
        // below re-renders and syncs again, but this covers the window in
        // between and the case where that reload itself fails.
        hint.textContent = '';
        syncDepSaveState();
        if (failed.length) {
            window.__wfCommon.setMessage('rwDependencyMessage',
                'Saved ' + ok + ' of ' + rows.length + '. ' + failed.join('; '), 'error');
        } else {
            window.__wfCommon.setMessage('rwDependencyMessage',
                'Saved ' + ok + ' categor' + (ok === 1 ? 'y' : 'ies') + '.', 'ok');
        }
        await loadDependencies();
    }
})();
</script>
