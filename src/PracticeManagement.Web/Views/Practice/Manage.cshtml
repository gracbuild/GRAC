@model PracticeManagement.Web.Models.PracticeScreen
@{
    ViewData["Title"] = Model.Title;
    var permissions = ViewBag.Permissions as string[] ?? [];

    // === Workflow-layer dispatch (charter §12.1.3+) ===
    // Screens registered in the workflow layer render through their own
    // partial under Views/Practice/Partials/{key}.cshtml. If the key
    // matches, render the partial and skip the generic Manage layout.
    // Every workflow-layer screen is feature-flagged OFF at the DB via
    // grac_practice.feature_flag (§7). The partial performs its own
    // feature-flag check via /api/practice/feature-flags at page load.
    var workflowScreens = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "tasks", "gaps", "waivers", "applicability-decision", "ownership-tree",
        // Migration 345: Ownership Management -- select a user, list every
        // active item they own, reassign each to an active Functional User.
        // Custom page (not the generic grid), so it renders its own partial.
        "ownership-management",
        "my-assignments", "gap-view", "handover", "auditor-workbench",
        "risk-register", "kri-dashboard", "adapter-bindings",
        // Workflow & Event-Driven Assurance Engine (BRD v1.0).
        // Each key resolves to Views/Practice/Partials/{key}.cshtml.
        "workflows", "workflow-stages", "workflow-entity-types",
        "workflow-events", "workflow-checklists", "workflow-event-mappings",
        "event-assurance", "workflow-dashboard",
        // Role / asset-category scoped event assurance (migrations 123/124/125).
        // "workflow-event-inbox" retired -- see Task Center's Event Driven
        // Assurance tab (migration 135).
        // "workflow-scope-mapping" retired -- role checklists are a section on
        // the Role Master form; asset-category checklists are the screen below
        // (migration 138).
        "asset-category-assurance",
        // Event Profiles (migrations 329-332) -- attribute-based people
        // populations replacing role-only checklist scoping. Listed here AS
        // WELL AS in PracticeScreen.cs: a PracticeScreen entry alone does not
        // dispatch a route screen, and without this line the request falls
        // through to the generic entity-grid layout and 400s against the
        // API's entity whitelist.
        "event-profiles",
        // Full-page practice view (migration 139) -- replaces the view modal.
        "practice-view",
        // Resolve (migrations 140/141): a flat owner-scoped list, and a
        // full-page workspace per instance. "resolve" moves here from the
        // generic grid, so practice.js no longer renders the old tabbed
        // dependency workbench for it.
        "resolve", "resolve-workspace",
        // Phase 2 Assurance Management (BRD Part 2) -- NEW independent
        // module. Each key resolves to Views/Practice/Partials/{key}.cshtml.
        // Menu rows seeded under nav-assurance by migrations 071 / 075 / 078 / 081.
        // Audit Management containers (migration 276) -- tab/stepper shells
        // that host the screens below as steps. Navigation only: they add
        // no data, no API and no second copy of any screen.
        "org-audit-definition",
        "org-audit-configuration",
        "org-assurance-definitions",
        "org-assurance-scope-builder",
        "org-assurance-question-sets",
        "org-assurance-evidence-config",
        "org-assurance-workflow-config",
        "org-assurance-scoring-config",
        "org-assurance-plans",
        "org-assurance-triggers",
        "org-assurance-scope-resolution",
        "org-assurance-executions",
        "org-assurance-observations",
        // "org-assurance-gaps" retired (109-113); Assurance gaps now
        // land in the unified Gap Center (Practice/Index/gaps).
        // Document Upload + Acknowledgement module (migrations 146-154).
        // Phase 1: register + upload + review/approve workflow.
        // Phase 2: admin acknowledgement batches over published docs.
        // Phase 3: employee-side inbox for pending acknowledgements.
        "document-uploads",
        "document-acknowledgements",
        "my-acknowledgements",
        // Task Centre v2 Phase 4 (migrations 201-203) -- the in-app
        // dispatcher for SLA task notifications. Personal inbox, scoped to
        // the session's employee id.
        "my-notifications",
        // Gap Centre v1.0 -- dedicated lifecycle detail page. The existing
        // "gaps" partial is untouched; this is the drill-down landing.
        "gap-detail",
        "exception-centre",
        "exception-analysis",
        "risk-centre",
        // Organization SLA Configuration (migrations 178/179/180).
        // Adopts Control Management SLA masters into per-org configs with
        // warning/escalation thresholds, notify roles and process bindings.
        "org-sla-config",
        // Organization -> Risk Acceptance Approval Authority (271).
        // An Organization configuration screen, not a Risk module one:
        // it configures the organisation's approval authority, and the
        // Risk Centre reads it. Menu row is a child of nav-organization.
        "risk-acceptance-authority",
        // Task View / Exception View (326) -- dedicated read-only full-page
        // views. Same "route" screen convention as gap-view/gap-detail:
        // no menu row, reached only by ?taskId=/?exceptionId= links from
        // tasks.cshtml/exception-centre.js/gap-view.js. Without an entry
        // here the request falls through to the generic Manage grid layout,
        // which has no "task-view"/"exception-view" entity type and 400s
        // ("Unsupported practice area") from PracticeRepositoryController's
        // secure/query -- exactly the failure this entry prevents.
        "task-view",
        "exception-view",
        // Add Source Statements (Release -> Source Structure -> Source
        // Statements), added for Custom Release authoring without an
        // Organization selector. No menu row of its own -- reached only by
        // a link from the Standards & Frameworks screen below. See the
        // PracticeScreen.cs entry and PracticeController.ScreenPermissionArea
        // for the rest of the no-menu-row wiring.
        "custom-source-statements"
    };
    if (workflowScreens.Contains(Model.Key))
    {
        @* Emitted before the early return below, so BOTH paths get it: the
           workflow partials rendered here, and the generic layout further
           down that loads practice.js. Without this the asset screen would
           need its own copy of the editor. *@
        <script src="~/js/scope-checklist-editor.js" asp-append-version="true"></script>
        <partial name="Partials/@Model.Key" model="Model" />
        return;
    }

    // Per-screen add-on partials — additive only. Rendered AT THE END of
    // the generic Manage layout so the modal / script sit alongside the
    // existing grid without disturbing it. Kept keyed by screen so future
    // add-ons follow the same pattern.
    var perScreenAddOns = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["practice-instances"] = "_add-implementation-task-modal"
    };

    var isOrganizationOnboarding = Model.Key == "organization-setup";
    var isOrganizationAdministration = Model.Key == "organization-administration";
    var isOrganizationDependencies = Model.Key == "organization-dependencies";
    var isDependencyWorkbench = Model.Key.StartsWith("workbench-", StringComparison.OrdinalIgnoreCase);
    var isResolve = Model.Key == "resolve" || Model.Key == "practice-operationalization";
    var isReadOnlyAssuranceView = Model.Key == "assurance-dashboard" || Model.Key == "assurance-trends" || Model.Key == "practice-health" || Model.Key == "audit-intelligence" || Model.Key == "risk-intelligence";
    var isOrganizationWorkspace = isOrganizationOnboarding || isOrganizationAdministration || isOrganizationDependencies;
    var setupChildTabs = isOrganizationDependencies
        ? new[] {
            // Applications and Tools tabs retired -- the Asset taxonomy
            // (migration 239-241) subsumed both. A business application is
            // now an Asset under sub-category "Business Application", a
            // utility tool is an Asset under "Utility Tool" -- so keeping
            // separate tabs would create two ways to enter the same thing
            // and two rows for one truth. The dependency-applications /
            // dependency-tools schemas still exist for legacy reads
            // (workbench pages) but the setup tabs no longer surface them.
            new { Key = "dependency-vendors", Title = "Vendors", Description = "Third parties providing services or products." },
            new { Key = "dependency-assets", Title = "Assets", Description = "Physical or logical assets (applications, tools, hardware, facilities) supporting practices." },
            new { Key = "dependency-processes", Title = "Processes", Description = "Business processes supporting organizational execution." }
        }
        : isOrganizationAdministration
        ? new[] {
            new { Key = "locations", Title = "Location", Description = "Locations under the selected organization." },
            new { Key = "departments", Title = "Department", Description = "Departments under the selected organization." },
            new { Key = "business-functions", Title = "Business Function", Description = "Business functions under the selected organization." },
            new { Key = "teams", Title = "Teams", Description = "Teams under the selected organization." },
            new { Key = "committees", Title = "Committees", Description = "Committees under the selected organization." },
            new { Key = "users", Title = "Users / Employees", Description = "Employees and users available for ownership and assignment." }
        }
        : new[] {
            new { Key = "locations", Title = "Location", Description = "Locations under the selected organization." },
            new { Key = "departments", Title = "Department", Description = "Departments under the selected organization." },
            new { Key = "business-functions", Title = "Business Function", Description = "Business functions under the selected organization." },
            new { Key = "teams", Title = "Teams", Description = "Teams under the selected organization." },
            new { Key = "committees", Title = "Committees", Description = "Committees under the selected organization." },
            new { Key = "users", Title = "Users / Employees", Description = "Employees and users available for ownership and assignment." }
        };
}

<div class="pm-page-heading @(isOrganizationWorkspace || Model.Key == "organizations" ? "compact" : "")">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
    <div class="pm-actions">
        @if (!isOrganizationWorkspace && Model.Key != "organizations")
        {
        <a class="pm-button" id="pageBackBtn" asp-controller="Practice" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</a>
        }
        @if (!isOrganizationWorkspace && !isDependencyWorkbench && Model.Key != "organizations" && Model.Key != "audit-trace" && Model.Key != "control-applicability" && !isResolve && !isReadOnlyAssuranceView && permissions.Contains("ADD"))
        {
            <button class="pm-button primary" id="addRecord" type="button"><i class="fa-solid fa-plus" aria-hidden="true"></i> @(Model.Key == "organization-controls" ? "Add Release" : Model.Key == "organization-requirements" || Model.Key == "practices" ? "Add Practice" : Model.Key == "practice-instances" ? "Add New Instance" : Model.Key == "assurance-generation" ? "Generate Activity" : Model.Key == "assurance-activities" ? "Add Activity" : Model.Key == "roles" ? "Add Role" : "Add Record")</button>
        }
        @* The "Add Source Statements" toolbar link (Release -> Source Structure ->
             Source Statements standalone screen) was removed here per change request
             2026-09-22: Source Structure and Statement Classification are now managed
             in-place from the Add Control Statement dialog itself (see the "Manage"
             buttons wired in openCustomStatementForm in practice.js), so the separate
             entry point is no longer needed. The custom-source-statements screen/route
             (PracticeScreen.cs, ScreenPermissionArea) is left in place, unlinked --
             removing only the button here per the minimum-change request. *@
        @* Q13/Q14/Q15 v2 — the "Add Implementation Task" action now lives in the row-level 3-dot menu.
             Row-level injection happens in _add-implementation-task-modal.cshtml when ImplementationStatus = "Not Implemented". *@
    </div>
</div>

@if (isOrganizationWorkspace)
{
<section class="pm-panel pm-setup" id="organizationSetup">
    <div class="pm-setup-toolbar">
        <label><span>Organization</span><select id="setupOrganization"><option value="">@(isOrganizationOnboarding ? "New Organization" : "Select Organization")</option></select></label>
        @if (isOrganizationOnboarding)
        {
            <button class="pm-button primary" id="saveOrganizationSetup" type="button">Save Organization Setup</button>
        }
    </div>
    <div id="setupMessage" class="pm-message" hidden></div>
    <div class="pm-tabs" role="tablist" aria-label="Organization Setup Sections">
        @if (!isOrganizationDependencies)
        {
        <button type="button" class="active" data-setup-tab="organization">Organization</button>
        }
        @for (var i = 0; i < setupChildTabs.Length; i++)
        {
            var tab = setupChildTabs[i];
            var activeClass = isOrganizationDependencies && i == 0 ? "active" : "";
            <button type="button" class="@activeClass" data-setup-tab="@tab.Key">@tab.Title</button>
        }
    </div>
    @if (!isOrganizationDependencies)
    {
    <div class="pm-setup-tab-panel active" data-setup-panel="organization">
    <div class="pm-setup-layout">
        <div class="pm-setup-main">
            <section class="pm-setup-card">
                <div class="pm-section-heading">
                    <h2>Organization Basic Details</h2>
                    <p>Core organization profile used across practice intelligence.</p>
                </div>
                <div class="pm-form-grid pm-form-grid-compact" id="setupBasicFields" data-setup-readonly="@isOrganizationAdministration.ToString().ToLowerInvariant()"></div>
            </section>
            @* Organization Attributes is removed from Organization Administration's
               Organization tab (change request 2026-09-20): the page is read-only
               there, and the request was to drop this section from that view
               entirely -- not just make its fields non-interactive. Attribute
               data, the API and #setupAttributeFields' own rendering (JS
               renderSetupAttributes(), which already no-ops when the element
               isn't in the DOM) are untouched; this only removes the SECTION
               from Organization Administration's markup. Onboarding still gets
               the editable section exactly as before. *@
            @if (!isOrganizationAdministration)
            {
            <section class="pm-setup-card">
                <div class="pm-section-heading">
                    <h2>Organization Attributes</h2>
                    <p>Applicability drivers, business profile, and technology context.</p>
                </div>
                <div class="pm-form-grid pm-form-grid-compact" id="setupAttributeFields" data-setup-readonly="@isOrganizationAdministration.ToString().ToLowerInvariant()"></div>
            </section>
            }
        </div>
        @if (isOrganizationOnboarding)
        {
        <aside class="pm-setup-card pm-subscription-card">
            <div class="pm-section-heading">
                <h2>Standards & Frameworks</h2>
                <p>Select applicable Authority / Artifact / Release items.</p>
            </div>
            <div class="pm-tree-toolbar">
                <input id="subscriptionSearch" placeholder="Search authority, artifact, release..." />
                <button class="pm-button icon pm-compact-icon" id="expandSubscriptionTree" type="button" title="Expand All" aria-label="Expand All">+</button>
                <button class="pm-button icon pm-compact-icon" id="collapseSubscriptionTree" type="button" title="Collapse All" aria-label="Collapse All">-</button>
            </div>
            <div class="pm-recommendation-toolbar">
                <button class="pm-button recommendation" id="recommendFrameworks" type="button">Recommended Frameworks</button>
                <button class="pm-button recommendation clear" id="clearRecommendations" type="button">Clear</button>
                <span id="recommendationSummary">Recommendations are user-confirmed before save.</span>
            </div>
            <div class="pm-subscription-tree" id="subscriptionTree">Loading repository tree...</div>
        </aside>
        }
        else if (isOrganizationAdministration)
        {
        @* Organization Administration is read-only: instead of the interactive
           subscription tree, show a plain Subscribed Releases list so the
           user can see which Authority / Artifact / Release each org is
           subscribed to without leaving the Organization Details tab. *@
        <aside class="pm-setup-card pm-subscription-card">
            <div class="pm-section-heading">
                <h2>Subscribed Releases</h2>
                <p>Framework releases the selected organization is currently subscribed to.</p>
            </div>
            <div id="subscribedReleasesList" class="pm-subscription-tree pm-subscription-readonly">Select an organization to view subscribed releases.</div>
        </aside>
        }
    </div>
    </div>
    }
    @for (var i = 0; i < setupChildTabs.Length; i++)
    {
        var tab = setupChildTabs[i];
        var activeClass = isOrganizationDependencies && i == 0 ? "active" : "";
        <div class="pm-setup-tab-panel @activeClass" data-setup-panel="@tab.Key">
            <section class="pm-setup-card">
                <div class="pm-section-heading inline">
                    <div>
                        <h2>@tab.Title</h2>
                        <p>@tab.Description</p>
                    </div>
                    <button class="pm-button primary small" type="button" data-setup-add="@tab.Key"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add @tab.Title</button>
                </div>
                <div class="pm-toolbar compact">
                    <input data-setup-search="@tab.Key" placeholder="Search @tab.Title..." />
                    <button class="pm-button icon" type="button" data-setup-refresh="@tab.Key" title="Refresh"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>
                </div>
                <div class="pm-table-wrap compact">
                    <table>
                        <thead data-setup-head="@tab.Key"></thead>
                        <tbody data-setup-body="@tab.Key"><tr><td class="pm-empty">Select an organization.</td></tr></tbody>
                    </table>
                </div>
            </section>
        </div>
    }
    <dialog id="recordDialog">
        <form id="recordForm">
            <div class="pm-dialog-heading">
                <div><h2 id="dialogTitle">Organization Setup</h2><p>Complete the required fields and save your changes.</p></div>
                <div class="pm-dialog-heading-actions">
                    @* View -> Edit (change request 2026-09-20): Location/Department/Teams
                       only, top-right next to Close per feedback. Hidden by default;
                       practice.js shows it only in View mode for those three entities,
                       and only with Edit/Add permission -- see editButton.hidden in
                       openForm()/openSetupChildForm(). Reuses the existing Edit flow
                       (openForm/openSetupChildForm with mode="edit"), never a second
                       save path. *@
                    <button type="button" class="pm-button primary" id="editRecord" hidden><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</button>
                    <button type="button" id="closeRecord" class="pm-icon-button" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                </div>
            </div>
            <div id="formMessage" class="pm-message" hidden></div>
            <div id="recordFields" class="pm-form-grid"></div>
            <div class="pm-dialog-actions">
                <button type="button" class="pm-button" id="cancelRecord">Cancel / Back</button>
                <button type="button" class="pm-button primary" id="saveRecord">Save</button>
            </div>
        </form>
    </dialog>

    @* Add Designation (change request 2026-09-22): a SEPARATE, independent
         <dialog> from #recordDialog just above -- same nested-popup-over-
         #recordDialog reasoning as #manageStructureDialog/#manageClassification
         Dialog further down this file for the Control Statement screens: it
         opens on top of the still-open Add/Edit Committee form so whatever
         the user already picked (Employee, other members already added)
         stays exactly as it was underneath. Replaces the inline expand/
         collapse panel that used to live inside the Designation table cell
         (see committeeMemberAddRowMarkup in practice.js) -- that panel made
         the Designation cell taller than the Employee/Add cells beside it,
         which practice-management.css's now-removed vertical-align: top /
         toggle-link margin-top rules were patched around; a real popup
         removes the cell-height problem at its source instead of
         compensating for it. Kept to the single-field-plus-Save/Cancel
         shape #implStatusDialog uses for a similar "quick add to a master
         list" popup, rather than the heavier .pm-manage-structure-dialog
         list-and-form shape those two Control Statement dialogs use -- a
         Designation is one field, not a list. Wired in practice.js's
         existing Committee Members click-delegation block (same
         document.body listener as Add Member / Remove Member / the old
         toggle it replaces), not a separate addEventListener like the
         Control Statement dialogs below -- keeps every Committee Members
         interaction in the one place the top-of-file comment on that
         listener already explains. *@
    <dialog id="committeeDesignationDialog" style="border:none; border-radius:8px; padding:0; max-width:420px; width:92%; box-shadow:0 10px 40px rgba(15,23,42,.25);">
        <form id="committeeDesignationForm" method="dialog" style="margin:0; padding:20px 24px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h2 style="margin:0; font-size:18px;">Add Designation</h2>
                <button type="button" id="closeCommitteeDesignation" aria-label="Close" style="background:none; border:none; font-size:20px; cursor:pointer;">&times;</button>
            </div>
            <div id="committeeDesignationMessage" style="display:none; margin-bottom:10px; padding:8px 12px; border-radius:4px; font-size:13px;"></div>
            <label style="display:flex; flex-direction:column; font-size:12px; color:#475569;">Designation Name <span style="color:#b91c1c;">*</span>
                <input id="committeeDesignationName" type="text" maxlength="200" style="padding:6px 8px; border:1px solid #cbd5e1; border-radius:4px; font:inherit; margin-top:2px;" />
            </label>
            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
                <button type="button" id="cancelCommitteeDesignation" class="pm-button">Cancel</button>
                <button type="button" id="saveCommitteeDesignation" class="pm-button primary">Save</button>
            </div>
        </form>
    </dialog>
</section>
}
else
{
var usesApplicabilityFilters = Model.Key == "organization-requirements" || Model.Key == "organization-controls";
<section class="pm-panel">
    <div class="pm-toolbar @(usesApplicabilityFilters ? "pm-toolbar-compact" : "")">
        @* On every other screen, search stays first -- unchanged. Organization
           Practices moves it to the end of the filter row instead (right
           before Clear Filter), so Organization -> Framework -> Applicability
           Status all read left-to-right before the free-text box. Exactly one
           of the two branches below renders #search, never both. *@
        @if (Model.Key != "organization-requirements")
        {
            <input id="search" placeholder="Search..." />
        }
        <select id="organizationFilter"><option value="">All organizations</option></select>
        @if (Model.Key == "organization-requirements" || Model.Key == "organization-controls")
        {
            <select id="subscribedFrameworkFilter"><option value="">All subscribed frameworks</option></select>
        }
        @if (Model.Key == "organization-controls")
        {
            <select id="sourceFilter"><option value="">All sources</option><option value="repository">Repository</option><option value="organization">Organization</option></select>
        }
        <select id="status" @(Model.Key == "organization-controls" ? "hidden" : "")><option value="">@(usesApplicabilityFilters ? "All applicability statuses" : "All statuses")</option></select>
        @if (Model.Key == "organization-requirements")
        {
            <input id="search" placeholder="Search practices..." />
        }
        <select id="originTypeFilter" @(usesApplicabilityFilters ? "hidden" : "")><option value="">All origins</option></select>
        <select id="criticalityFilter" @(Model.Key == "organization-requirements" || Model.Key == "organization-controls" ? "hidden" : "")><option value="">All criticalities</option></select>
        <input id="ownerFilter" placeholder="Owner..." @(usesApplicabilityFilters ? "hidden" : "") />
        <input id="dateFromFilter" type="date" title="Entered from" @(usesApplicabilityFilters ? "hidden" : "") />
        <input id="dateToFilter" type="date" title="Entered to" @(usesApplicabilityFilters ? "hidden" : "") />
        @if (usesApplicabilityFilters)
        {
            <button class="pm-button" id="clearFilters" type="button">Clear Filter</button>
        }
        <button class="pm-button icon" id="refresh" type="button" title="Refresh" aria-label="Refresh"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>
        @* Bulk applicability. Rendered on the two screens that mark
           applicability in a list -- Source Statements (an alias of
           organization-controls) and Organization Practices -- and kept hidden
           by practice.js until at least one eligible row is ticked. The count
           lives in its own span so the label does not reflow as the selection
           changes. *@
        @if (Model.Key == "organization-controls" || Model.Key == "source-statements" || Model.Key == "organization-requirements")
        {
            <button class="pm-button primary" id="bulkApplicability" type="button" hidden>
                <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
                Mark Applicability<span id="bulkApplicabilityCount"></span>
            </button>
        }
    </div>
    <div class="@(isResolve ? "pm-workbench-layout" : "")">
        @if (isResolve)
        {
        <aside class="pm-workbench-categories" aria-label="Resolve Registers">
            <div class="pm-workbench-title">Registers</div>
            <div id="workbenchCategories" class="pm-workbench-category-list">
                <button type="button" class="active">Loading...</button>
            </div>
        </aside>
        }
        <div class="@(isResolve ? "pm-workbench-main" : "")">
            @if (isResolve)
            {
            <div class="pm-workbench-context">
                <strong id="workbenchHeading">Resolve</strong>
                <span id="workbenchHint">Showing Practice Instances assigned to you.</span>
            </div>
            }
            <div class="pm-table-wrap" data-screen-key="@Model.Key">
                <table>
                    <thead id="practiceGridHead"><tr>@foreach (var column in Model.Columns) { <th>@column</th> }<th>Actions</th></tr></thead>
                    <tbody id="practiceRows"><tr><td colspan="@(Model.Columns.Length + 1)" class="pm-empty">Loading...</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>
    @* Pager host. pm-grid renders Previous / range / Next / rows-per-page
       into this div and owns the page number, so the generic grid no
       longer hand-wires its own -- see docs/grid-and-pagination-standard.md.
       The markup pm-grid emits is the same .pm-pager shape this div used
       to contain, so the screen looks identical. Left empty on purpose:
       if pm-grid.js fails to load, attach() returns null, practice.js
       falls back to page 1 with no pager and the grid still renders. *@
    <div id="practiceGridPager"></div>
</section>

<dialog id="recordDialog">
    <form id="recordForm">
        <div class="pm-dialog-heading">
            <div><h2 id="dialogTitle">@Model.Title</h2><p>Complete the required fields and save your changes.</p></div>
            <div class="pm-dialog-heading-actions">
                @* View -> Edit (change request 2026-09-20): Location/Department/Teams
                   only, top-right next to Close per feedback. Hidden by default;
                   practice.js shows it only in View mode for those three entities,
                   and only with Edit/Add permission -- see editButton.hidden in
                   openForm()/openSetupChildForm(). Reuses the existing Edit flow
                   (openForm/openSetupChildForm with mode="edit"), never a second
                   save path. *@
                <button type="button" class="pm-button primary" id="editRecord" hidden><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</button>
                <button type="button" id="closeRecord" class="pm-icon-button" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </div>
        </div>
        <div id="formMessage" class="pm-message" hidden></div>
        <div id="recordFields" class="pm-form-grid"></div>
        <div class="pm-dialog-actions">
            <button type="button" class="pm-button" id="cancelRecord">Cancel / Back</button>
            <button type="button" class="pm-button primary" id="saveRecord">Save</button>
        </div>
    </form>
</dialog>

@* Manage Source Structure / Statement Classification (change request 2026-09-22):
     a SEPARATE, independent <dialog> from #recordDialog above -- deliberately not
     reusing it -- because it opens AS A NESTED POPUP on top of the Add/Edit Control
     Statement form (#recordDialog), which needs to stay open with whatever the user
     already typed (Statement Title/Text/Keywords etc.) still in it underneath. It is
     entirely self-contained in practice.js (its own fetch calls against the existing
     custom-release-source-structure query/save entity -- no new API, no new table:
     Statement Classification IS the Level-1 Source Structure nodes, so both the
     "Manage" button beside Source Structure Node and the one beside Statement
     Classification in openCustomStatementForm open this exact same dialog). Its
     native <dialog> "close" event (fires on the X button, Esc, or dialog.close()) is
     what openManageStructureDialog()'s onClose callback hooks, so the Structure
     Node / Classification combos on the Control Statement form behind it always
     refresh, regardless of how this popup was dismissed. *@
<dialog id="manageStructureDialog" class="pm-manage-structure-dialog">
    <form id="manageStructureForm" onsubmit="return false;">
        <div class="pm-dialog-heading">
            <div><h2 id="manageStructureDialogTitle">Manage Source Structure</h2><p>Add, edit or inactivate nodes for this release.</p></div>
            <div class="pm-dialog-heading-actions">
                <button type="button" id="closeManageStructure" class="pm-icon-button" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </div>
        </div>
        <div id="manageStructureMessage" class="pm-message" hidden></div>
        <div id="manageStructureBody" class="pm-form-grid"></div>
    </form>
</dialog>

@* Manage Statement Classification (change request 2026-09-22, part 2): a
     SEPARATE, independent <dialog> from #manageStructureDialog above -- the
     user pointed out that both "Manage" buttons were opening the Source
     Structure popup, and that Statement Classification is backed by a
     completely different table (grac_practice.custom_statement_classification,
     merged with the shared grac_new.statement_classification reference
     values -- see the comment above manageClassificationState in
     practice.js). Same nested-popup-over-#recordDialog pattern as
     #manageStructureDialog: opens on top of the still-open Add/Edit
     Control Statement form, and its native <dialog> "close" event is what
     refreshes the Structure Node / Classification combos on that form
     behind it. *@
<dialog id="manageClassificationDialog" class="pm-manage-structure-dialog">
    <form id="manageClassificationForm" onsubmit="return false;">
        <div class="pm-dialog-heading">
            <div><h2 id="manageClassificationDialogTitle">Manage Statement Classification</h2><p>Add, edit or inactivate this organization's custom classifications for this release.</p></div>
            <div class="pm-dialog-heading-actions">
                <button type="button" id="closeManageClassification" class="pm-icon-button" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </div>
        </div>
        <div id="manageClassificationMessage" class="pm-message" hidden></div>
        <div id="manageClassificationBody" class="pm-form-grid"></div>
    </form>
</dialog>

@if (perScreenAddOns.TryGetValue(Model.Key, out var addOnPartial))
{
    <partial name="Partials/@addOnPartial" model="Model" />
}
}

@section Scripts {
    <script>
        window.pmScreen=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        window.pmApi="@ViewBag.ApiBaseUrl";
        window.pmPermissions=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(permissions));
        // Rules 3 + 4 — role scope drives per-row actions and release filtering on Source Statements.
        window.pmDataScope="@(ViewBag.DataScope ?? "ORGANIZATION")";
        window.pmRoleName="@(ViewBag.RoleName ?? "")";
        window.pmEmployeeId="@(ViewBag.EmployeeId ?? "")";
    </script>
    <script src="~/js/scope-checklist-editor.js" asp-append-version="true"></script>
    @* pm-grid before practice.js: the grid mounts its pager during init. *@
    <script src="~/js/pm-grid.js" asp-append-version="true"></script>
    <script src="~/js/practice.js" asp-append-version="true"></script>
}
