@*
    Shared "Related Tasks" panel  (BRD §15 + §14)

    ONE implementation, mounted by every screen that owns a task source:
    Gap Centre, Risk Centre and Assurance Observations. Duplicating this
    three times would mean three places to fix when the wording of a §14
    status message changes.

    Follows the same shape as _event-assurance-panel.cshtml: the partial
    is included once, and the host screen mounts it against a record.

    USAGE
        Include the partial ONCE in the host screen (a plain
        <partial> tag naming Partials/_related-tasks-panel), then:

        // whenever the host opens/changes a record:
        window.__gracRelatedTasks.mount(containerEl, {
            sourceTypeCode: 'Gap',        // Gap | Risk | ContinuousAssurance | Exception | EventAssurance
            sourceRecordId: 101,
            organizationId: selectedOrgId // optional, scopes the read
        });

        // and to clear it when the host closes the record:
        window.__gracRelatedTasks.clear(containerEl);

    WHAT IT SHOWS, AND WHY BOTH KINDS
        BRD §15 asks the source to display "associated tasks, their status
        and links". Once the candidate stage exists (Phase 2) a source can
        have work that is identified but not yet an accountable task, and a
        panel that hid that would tell a gap owner "nothing is happening"
        when in fact something is waiting on validation. So candidates and
        tasks arrive in ONE list from sp_task_source_items, discriminated
        by ItemKind.

        The §14 line above the table is the task-action status. It never
        says the source is resolved — that decision belongs to the source
        module, and the message wording hands it back explicitly.
*@

<div class="pm-related-tasks-template" hidden aria-hidden="true"></div>

<script>
(function () {
    'use strict';
    if (window.__gracRelatedTasks) return;   // included by more than one host

    // Published deployments run under a PathBase; resolve it lazily at
    // call time for the same reason tasks.cshtml does.
    const U = p => String(window.appBasePath || window.pmPathBase || '').replace(/\/+$/, '') + p;

    function esc(v) {
        if (v === null || v === undefined) return '';
        return String(v).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function fmtDate(v) {
        if (!v) return '';
        const d = new Date(v);
        return isNaN(d.getTime()) ? String(v).slice(0, 10) : d.toISOString().slice(0, 10);
    }

    const SLA_STYLE = {
        OnTrack:   { bg: '#dcfce7', fg: '#166534', label: 'On Track'  },
        DueSoon:   { bg: '#fef9c3', fg: '#854d0e', label: 'Due Soon'  },
        DueToday:  { bg: '#ffedd5', fg: '#9a3412', label: 'Due Today' },
        Breached:  { bg: '#fee2e2', fg: '#991b1b', label: 'Breached'  },
        Extended:  { bg: '#e0e7ff', fg: '#3730a3', label: 'Extended'  },
        Completed: { bg: '#f1f5f9', fg: '#475569', label: 'Completed' },
        NotSet:    { bg: '#f1f5f9', fg: '#64748b', label: 'No SLA'    }
    };

    function badge(text, bg, fg) {
        return '<span class="pm-badge" style="background:' + bg + '; color:' + fg + ';">' + esc(text) + '</span>';
    }

    function slaBadge(code) {
        if (!code) return '';
        const s = SLA_STYLE[code] || { bg: '#f1f5f9', fg: '#475569', label: code };
        return badge(s.label, s.bg, s.fg);
    }

    // A candidate is not yet accountable work; saying so plainly is more
    // useful than showing a status code the source owner has no context for.
    function kindBadge(row) {
        return row.itemKind === 'Candidate'
            ? badge('Awaiting validation', '#fef9c3', '#854d0e')
            : badge('Task', '#e2e8f0', '#334155');
    }

    // BRD §14 — the message always ends by handing the closure decision
    // back to the source module, so it is rendered verbatim from the API
    // rather than reworded here.
    function renderStatusLine(state) {
        if (!state) {
            return '<p style="margin:0 0 10px; color:#64748b; font-size:12px;">'
                 + 'No task action has been raised for this record yet.</p>';
        }
        const done = state.actionStatusCode === 'Completed';
        return '<div style="margin:0 0 12px; padding:8px 12px; border-radius:6px; font-size:12px;'
             + ' background:' + (done ? '#dcfce7' : '#f8fafc') + ';'
             + ' border:1px solid ' + (done ? '#86efac' : '#e2e8f0') + ';'
             + ' color:' + (done ? '#166534' : '#334155') + ';">'
             + '<strong>' + esc(state.actionStatusCode) + '</strong> — ' + esc(state.actionStatusMessage)
             + '</div>';
    }

    function renderRows(rows) {
        if (!rows.length) {
            return '<p class="pm-empty" style="margin:0;">No tasks or candidates have been raised from this record.</p>';
        }
        const out = ['<div class="pm-table-wrap"><table><thead><tr>',
                     '<th>Ref</th><th>Kind</th><th>Action</th><th>Owner</th>',
                     '<th>Priority</th><th>Due</th><th>SLA</th><th>Status</th>',
                     '</tr></thead><tbody>'];
        for (const r of rows) {
            // Children are indented rather than hidden: BRD §11 says the
            // parent owns the commitment, but a source owner still wants to
            // see how the work was distributed.
            const indent = r.isChild ? 'padding-left:22px; color:#475569;' : '';
            const childNote = (!r.isChild && r.childCount)
                ? ' <span style="font-size:11px; color:#64748b;">(' + esc(r.childCount) + ' child)</span>' : '';
            out.push('<tr>',
                '<td style="' + indent + '">' + esc(r.itemNumber || r.itemId) + '</td>',
                '<td>' + kindBadge(r) + '</td>',
                '<td>' + esc(r.title) + childNote + '</td>',
                '<td>' + esc(r.ownerName || '') + '</td>',
                '<td>' + esc(r.priority || '') + '</td>',
                '<td>' + esc(fmtDate(r.dueAt)) + '</td>',
                '<td>' + slaBadge(r.slaStatusCode) + '</td>',
                '<td>' + esc(r.statusName || r.statusCode || '') + '</td>',
                '</tr>');
        }
        out.push('</tbody></table></div>');
        return out.join('');
    }

    async function mount(container, opts) {
        if (!container || !opts || !opts.sourceTypeCode || !opts.sourceRecordId) return;

        container.innerHTML = '<p class="pm-empty" style="margin:0;">Loading related tasks...</p>';

        const q = '?sourceTypeCode=' + encodeURIComponent(opts.sourceTypeCode)
                + '&sourceRecordId=' + encodeURIComponent(opts.sourceRecordId)
                + (opts.organizationId ? '&organizationId=' + encodeURIComponent(opts.organizationId) : '');

        try {
            // Both reads in parallel: the §14 status line and the §15 list
            // are independent, and one failing should not blank the other.
            const [itemsResp, stateResp] = await Promise.all([
                fetch(U('/practice/api/task-candidates/source-items') + q, { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; }),
                fetch(U('/practice/api/task-candidates/source-state') + q, { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; })
            ]);

            if (itemsResp === null && stateResp === null) {
                container.innerHTML = '<p class="pm-empty" style="margin:0;">Related tasks could not be loaded.</p>';
                return;
            }

            const rows  = (itemsResp && itemsResp.data) || [];
            const state = (stateResp && stateResp.data) || null;

            container.innerHTML =
                '<h3 style="font-size:13px; margin:0 0 8px;">Related tasks</h3>'
                + renderStatusLine(state)
                + renderRows(rows);
        } catch (err) {
            container.innerHTML = '<p class="pm-empty" style="margin:0;">Failed to load: ' + esc(err.message) + '</p>';
        }
    }

    function clear(container) {
        if (container) container.innerHTML = '';
    }

    window.__gracRelatedTasks = { mount: mount, clear: clear };
})();
</script>
