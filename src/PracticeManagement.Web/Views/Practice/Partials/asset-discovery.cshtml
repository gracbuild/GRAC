@* ======================= Stale review window (443) ======================= *@
<div class="pm-modal" id="adcStaleModal" hidden>
    <div class="pm-modal-panel pm-modal-wide">
        <header>
            <h2 id="adcSrTitle">Stale asset</h2>
            <button class="pm-modal-close" type="button" data-close-adc="adcStaleModal" aria-label="Close">&times;</button>
        </header>
        <div class="adc-info" id="adcSrInfo"></div>
        <p class="pm-message" id="adcSrMessage" role="status" aria-live="polite" hidden></p>
        <div class="pm-modal-footer" id="adcSrStartBar" hidden>
            <button class="pm-button primary" type="button" id="adcSrStart"><i class="fa-solid fa-clipboard-check"></i> Start stale review</button>
        </div>

        <div id="adcSrSteps" hidden>
            <h3 class="adc-sub">1. Source confirmation</h3>
            <p class="adc-note" id="adcSrSourceDone" hidden></p>
            <form id="adcSrSourceForm" class="pm-form-grid">
                <label><span>Source owner confirms *</span>
                    <select id="adcSrOutcome"><option value="">--</option><option value="ABSENT">Absent from the source</option><option value="PRESENT">Still present (connector or scope issue)</option></select></label>
                <label class="full"><span>Confirmation note *</span><textarea id="adcSrSourceNote" rows="2" maxlength="1000"></textarea></label>
                <footer class="pm-modal-footer full"><button type="submit" class="pm-button"><i class="fa-solid fa-check"></i> Record confirmation</button></footer>
            </form>

            <h3 class="adc-sub">2. Dependency review</h3>
            <p class="adc-note" id="adcSrDepDone" hidden></p>
            <form id="adcSrDepForm" class="pm-form-grid">
                <label class="full"><span>Review note * (what was checked and agreed for the items below)</span><textarea id="adcSrDepNote" rows="2" maxlength="1000"></textarea></label>
                <footer class="pm-modal-footer full"><button type="submit" class="pm-button"><i class="fa-solid fa-check"></i> Record dependency review</button></footer>
            </form>

            <h3 class="adc-sub">3. Decision</h3>
            <form id="adcSrDecisionForm" class="pm-form-grid">
                <label class="full"><span>Reason *</span><textarea id="adcSrDecisionNote" rows="2" maxlength="1000"></textarea></label>
                <p class="adc-note full">Request decommission moves the asset to Pending Decommission through its lifecycle rules (Asset Register permission needed). Dismiss keeps the asset; it is not listed again for one aging period.</p>
                <footer class="pm-modal-footer full">
                    <button type="button" class="pm-button" id="adcSrDismiss"><i class="fa-solid fa-xmark"></i> Dismiss (still in use)</button>
                    <button type="button" class="pm-button primary" id="adcSrDecom"><i class="fa-solid fa-box-archive"></i> Request decommission</button>
                </footer>
            </form>
        </div>

        <h3 class="adc-sub">Source records</h3>
        <div class="pm-table-wrap">
            <table>
                <thead><tr><th>Source</th><th>Record ID</th><th>Link</th><th>Last seen</th><th>Days unseen</th><th>Source last run</th></tr></thead>
                <tbody id="adcSrLinkBody"></tbody>
            </table>
        </div>
        <h3 class="adc-sub">Dependencies</h3>
        <div class="pm-table-wrap">
            <table>
                <thead><tr><th>Kind</th><th>Item</th><th>Detail</th><th></th></tr></thead>
                <tbody id="adcSrDepBody"></tbody>
            </table>
        </div>
        <h3 class="adc-sub">Reviews</h3>
        <div class="pm-table-wrap">
            <table>
                <thead><tr><th>Opened</th><th>Status</th><th>Source</th><th>Dependency review</th><th>Decision</th><th>Closed</th></tr></thead>
                <tbody id="adcSrHistBody"></tbody>
            </table>
        </div>
    </div>
</div>

@* ======================= Asset confidence window ======================= *@
