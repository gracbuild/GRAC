@*
    My Acknowledgements (Phase 3) -- employee inbox for pending doc
    acknowledgements. Rendered from Manage.cshtml when
    Model.Key == "my-acknowledgements".

    Three views inside the partial, swapped by JS:
      1. Batch list  -- outstanding + completed batches for the signed-in user
      2. Batch docs  -- documents inside a chosen batch, mine only
      3. Acknowledge -- split pane: doc info + Acknowledge button (left),
                        PDF viewer (right); matches Review/Approve layout.
*@
@model PracticeManagement.Web.Models.PracticeScreen

<div class="pm-page-heading compact">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1>@Model.Title</h1>
        <p>Documents you are asked to acknowledge. Pick a batch, review each document, and confirm.</p>
    </div>
</div>

@* ------------ View 1: batch list ------------ *@
<section class="pm-panel" id="myAckListView" hidden>
    <div class="pm-toolbar">
        @* Org selector -- shown only in admin mode; JS un-hides it. *@
        <select id="myAckFilterOrganization" hidden>
            <option value="">Select organization</option>
        </select>
        <label style="display:flex; align-items:center; gap:6px; font-size: 13px;">
            <input type="checkbox" id="myAckIncludeCompleted" /> Include completed
        </label>
        <button class="pm-button icon" id="myAckRefreshBtn" type="button" title="Refresh" aria-label="Refresh">
            <i class="fa-solid fa-arrows-rotate"></i>
        </button>
    </div>

    <div class="pm-table-wrap">
        <table id="myAckTable">
            <thead>
                <tr>
                    <th>Batch</th>
                    <th>Due</th>
                    <th>My Docs</th>
                    <th>Acknowledged</th>
                    <th>Pending</th>
                    <th style="min-width: 180px;">Progress</th>
                    <th>Status</th>
                    <th aria-label="Actions"></th>
                </tr>
            </thead>
            <tbody id="myAckTableBody">
                <tr><td colspan="8" class="pm-empty-row">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</section>

@* ------------ View 2: docs in a batch ------------ *@
<section class="pm-panel" id="myAckDocsView" hidden>
    <div class="pm-toolbar">
        <button type="button" class="pm-button" data-my-ack-back>
            <i class="fa-solid fa-arrow-left"></i> Back to batches
        </button>
        <h2 id="myAckDocsTitle" style="margin: 0 0 0 8px; font-size: 18px;">Batch</h2>
    </div>

    <dl class="ack-detail-meta" id="myAckDocsMeta"></dl>

    <div class="pm-table-wrap">
        <table id="myAckDocsTable">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Version</th>
                    <th>Status</th>
                    <th>Acknowledged</th>
                    <th aria-label="Actions"></th>
                </tr>
            </thead>
            <tbody id="myAckDocsBody">
                <tr><td colspan="6" class="pm-empty-row">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</section>

@* ------------ View 3: Acknowledge (split pane with PDF) ------------ *@
<section class="pm-panel" id="myAckActView" hidden>
    <div class="pm-toolbar">
        <button type="button" class="pm-button" data-my-ack-back-docs>
            <i class="fa-solid fa-arrow-left"></i> Back to documents
        </button>
        <h2 id="myAckActTitle" style="margin: 0 0 0 8px; font-size: 18px;">Acknowledge Document</h2>
    </div>

    <div class="doc-workflow-split">
        <aside class="doc-workflow-form">
            <dl class="doc-workflow-meta" id="myAckActMeta"></dl>

            <form id="myAckActForm">
                <input type="hidden" id="myAckActBatchId" />
                <input type="hidden" id="myAckActDocId" />

                <label>
                    <span>Remark <span class="pm-hint">(optional)</span></span>
                    <textarea id="myAckActRemark" rows="4" maxlength="5000"
                              placeholder="Add a note if you like..."></textarea>
                </label>

                <p class="pm-form-message" id="myAckActMessage" role="status" aria-live="polite"></p>

                <div class="pm-toolbar" style="justify-content: flex-end;">
                    <button type="button" class="pm-button" data-my-ack-back-docs>Cancel</button>
                    <button type="submit" class="pm-button primary" id="myAckActSubmit">
                        <i class="fa-solid fa-check"></i> Acknowledge
                    </button>
                </div>

                <p class="pm-hint" id="myAckActAlreadyDone" hidden>
                    You already acknowledged this document on <span id="myAckActAlreadyDate"></span>.
                </p>
            </form>
        </aside>

        <div class="doc-workflow-viewer">
            <iframe id="myAckActPdf" title="Document preview" src="about:blank"></iframe>
            <div id="myAckActPdfEmpty" class="doc-workflow-pdf-fallback" hidden>
                <p id="myAckActPdfMessage">Loading document preview...</p>
            </div>
        </div>
    </div>
</section>

<style>
    /* Reuses the shared ack-progress / ack-status-chip styles defined in
       document-acknowledgements.cshtml when both partials are on the same
       Manage.cshtml render. Duplicating minimal styles here so this
       partial renders correctly even when opened directly. */
    .ack-progress { display: inline-block; width: 160px; height: 8px; background: #edf2f7; border-radius: 4px; overflow: hidden; vertical-align: middle; }
    .ack-progress > span { display: block; height: 100%; background: #48bb78; }
    .ack-progress-label { display: inline-block; margin-left: 8px; font-size: 12px; color: #4a5568; vertical-align: middle; }

    .ack-status-chip {
        display: inline-block; padding: 2px 8px; border-radius: 999px;
        font-size: 11px; font-weight: 600; text-transform: uppercase;
    }
    .ack-status-open { background: #fefcbf; color: #744210; }
    .ack-status-progress { background: #bee3f8; color: #2c5282; }
    .ack-status-completed { background: #c6f6d5; color: #22543d; }
    .ack-status-pending { background: #fed7d7; color: #742a2a; }
    .ack-status-ack { background: #c6f6d5; color: #22543d; }

    /* Reuse the same split-pane rules as the review/approve view. */
    .doc-workflow-split {
        display: grid; grid-template-columns: minmax(340px, 400px) 1fr;
        gap: 16px; height: calc(100vh - 240px); min-height: 520px;
    }
    @@media (max-width: 900px) { .doc-workflow-split { grid-template-columns: 1fr; height: auto; } }
    .doc-workflow-form {
        display: flex; flex-direction: column;
        padding: 16px; background: #fff;
        border: 1px solid #e2e8f0; border-radius: 6px; overflow-y: auto;
    }
    .doc-workflow-form form { display: flex; flex-direction: column; gap: 14px; }
    .doc-workflow-form label { display: flex; flex-direction: column; gap: 6px;
        font-size: 13px; font-weight: 600; color: #4a5568; }
    .doc-workflow-form textarea {
        font-weight: normal; color: #2d3748;
        border: 1px solid #cbd5e0; border-radius: 4px; padding: 8px 10px;
        font-family: inherit; font-size: 13px; width: 100%; box-sizing: border-box;
        resize: vertical;
    }
    .doc-workflow-meta {
        margin: 0 0 16px 0; padding: 12px 14px;
        background: #f7fafc; border-radius: 6px; font-size: 13px;
        display: grid; grid-template-columns: 100px 1fr; row-gap: 6px; column-gap: 12px;
    }
    .doc-workflow-meta dt { color: #718096; font-weight: 600; margin: 0;
        text-transform: uppercase; font-size: 11px; align-self: center; }
    .doc-workflow-meta dd { margin: 0; color: #2d3748; word-break: break-word; }
    .doc-workflow-viewer {
        position: relative; border: 1px solid #e2e8f0; border-radius: 6px;
        overflow: hidden; background: #fafafa; min-height: 400px;
    }
    .doc-workflow-viewer iframe { position: absolute; inset: 0;
        width: 100%; height: 100%; border: 0; background: #fff; }
    .doc-workflow-pdf-fallback {
        position: absolute; inset: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; padding: 24px; text-align: center; color: #718096; background: #fafafa;
    }

    .ack-detail-meta {
        display: grid; grid-template-columns: 120px 1fr 120px 1fr;
        gap: 6px 12px; margin: 0 0 16px 0;
        padding: 12px 14px; background: #f7fafc; border-radius: 6px; font-size: 13px;
    }
    .ack-detail-meta dt { color: #718096; font-weight: 600; margin: 0;
        text-transform: uppercase; font-size: 11px; }
    .ack-detail-meta dd { margin: 0; color: #2d3748; }
</style>

<script src="~/js/DocumentAcknowledgement/my-acknowledgements.js" asp-append-version="true"></script>
