<style>
    .adc-note { color: var(--fg-secondary); font-size: 12px; margin: 0 0 8px; }
    .adc-check { display: inline-flex; gap: 4px; align-items: center; font-size: 13px; }
    .adc-chip { display: inline-block; padding: 2px 8px; border-radius: var(--radius-pill); font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .adc-st-open    { background: var(--primary-100); color: var(--primary-800); }
    .adc-st-wait    { background: var(--warning-50); color: var(--warning-700); }
    .adc-st-active  { background: var(--success-100); color: var(--success-700); }
    .adc-st-ended   { background: var(--neutral-200); color: var(--fg-muted); }
    .adc-st-bad     { background: var(--danger-100); color: var(--danger-700); }
    .adc-sub { font-size: 13px; font-weight: 600; color: var(--fg-strong); margin: 16px 0 8px; }
    .adc-info { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px 16px; font-size: 13px; margin-bottom: 12px; }
    .adc-info span { display: block; color: var(--fg-secondary); font-size: 11px; }
    .adc-payload { font-size: 12px; background: var(--neutral-100); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px; white-space: pre-wrap; word-break: break-all; max-height: 240px; overflow: auto; }
    #adcImpText { font-family: monospace; font-size: 12px; }
</style>

