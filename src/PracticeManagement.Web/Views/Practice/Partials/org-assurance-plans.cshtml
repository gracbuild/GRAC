    async function savePlan() {
        const idStr = document.getElementById('oaPlPlanEditId').value;
        // 121 hybrid Owner -- read picker state; SP auto-resolves the missing side.
        const ownerState = (window.__roleHolderPicker && typeof window.__roleHolderPicker.readState === 'function')
            ? window.__roleHolderPicker.readState('oaPlPlanOwnerRole', 'oaPlPlanOwner')
            : { roleId: null, roleName: null, employeeId: null, employeeName: null };

        const body = {
            organizationId    : Number(state.orgId),
            planId            : idStr ? Number(idStr) : null,
            planCode          : document.getElementById('oaPlPlanCode').value.trim(),
            planName          : document.getElementById('oaPlPlanName').value.trim(),
            planType          : document.getElementById('oaPlPlanType').value,
            periodFrom        : document.getElementById('oaPlPlanFrom').value || null,
            periodTo          : document.getElementById('oaPlPlanTo').value || null,
            ownerRoleId       : ownerState.roleId       || null,
            ownerRoleName     : ownerState.roleName     || null,
            ownerEmployeeId   : ownerState.employeeId   || null,
            ownerDisplayName  : ownerState.employeeName || null,
            description       : document.getElementById('oaPlPlanDescription').value || null,
            // 565: the annual plan fields.
            financialYear     : document.getElementById('oaPlPlanFy').value.trim() || null,
            plannedBudget     : document.getElementById('oaPlPlanBudget').value !== '' ? Number(document.getElementById('oaPlPlanBudget').value) : null,
            budgetCurrency    : document.getElementById('oaPlPlanCurrency').value.trim() || null,
            plannedEffortDays : document.getElementById('oaPlPlanEffort').value !== '' ? Number(document.getElementById('oaPlPlanEffort').value) : null,
            objectives        : document.getElementById('oaPlPlanObjectives').value.trim() || null,
            plannedCoverage   : document.getElementById('oaPlPlanCoverage').value.trim() || null,
            resourcesNote     : document.getElementById('oaPlPlanResources').value.trim() || null,
            actor             : null
        };
        try {
            const r = await fetch(U(API + '/plans'), {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const j = await safeJson(r);
            if (!r.ok) { showPlanMessage('error', ((j && (j.error || j.Error)) || 'HTTP ' + r.status)); return; }
            closePlanDialog();
            await reloadPlans();
            // 546: a new plan made from Add to Plan takes the audit next.
            const newId = j && (j.planId || j.PlanId);
            if (!idStr && state.presetDefinitionId && newId) continueWithPlan(newId);
        } catch (err) { showPlanMessage('error', err.message || String(err)); }
    }

    async function deletePlan(id) {
        if (!await window.gracUi.confirm('Delete this plan (and its engagements)?',
              { type: 'warning', title: 'Delete plan', confirmText: 'Delete' })) return;
        try {
            const url = U(API + '/plans/' + id + '?organizationId=' + encodeURIComponent(state.orgId));
            const r = await fetch(url, { method: 'DELETE', credentials: 'same-origin' });
            const j = await safeJson(r);
            if (!r.ok) { alert('Delete failed: ' + ((j && (j.error || j.Error)) || 'HTTP ' + r.status)); return; }
            if (String(state.selectedPlanId) === String(id)) { state.selectedPlanId = null; state.selectedPlan = null; }
            state.expanded.delete(String(id));
            Array.from(state.showAll).forEach(function (k) { if (k.split(':')[0] === String(id)) state.showAll.delete(k); });   // 565
            delete state.itemsByPlan[String(id)];
            reloadPlans();
        } catch (err) { alert('Delete failed: ' + (err.message || err)); }
    }

    async function transition(id, action) {
        try {
            const url = U(API + '/plans/' + id + '/' + action);
            const r = await fetch(url, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ organizationId: Number(state.orgId), planId: Number(id), actor: null })
            });
            const j = await safeJson(r);
            if (!r.ok) { alert('Failed: ' + ((j && (j.error || j.Error)) || 'HTTP ' + r.status)); return; }
            // 546: the plan's status decides Add Item and the slot menus;
            // the list re-renders and an open plan's slots are read again.
            await reloadPlans();
        } catch (err) { alert('Failed: ' + (err.message || err)); }
    }

    // -----------------------------------------------------------------
    // 546: slot status and Start Execution
    // -----------------------------------------------------------------
    const SLOT_LABEL = { Planned: 'Planned', InProgress: 'In Progress', Completed: 'Completed', NotExecuted: 'Not executed' };
    function slotStatusHtml(row) {
        const st   = row.slotStatus || row.SlotStatus || 'Planned';
        const code = row.executionCode || row.ExecutionCode || '';
        const retired = (row.definitionStatusCode || row.DefinitionStatusCode) === 'Retired';
        // 552: an engagement of several audits shows "done / audits".
        const n    = Number(row.definitionCount ?? row.DefinitionCount ?? 1) || 1;
        const done = Number(row.executionDoneCount ?? row.ExecutionDoneCount ?? 0);
        const live = Number(row.executionCount ?? row.ExecutionCount ?? 0);
        return wf.badge(SLOT_LABEL[st] || st)
             + (n > 1 ? ' <span style="color:var(--fg-subtle);">' + done + ' / ' + n + ' done' + (live > done ? ', ' + (live - done) + ' running' : '') + '</span>'
                      : (code ? ' <span style="color:var(--fg-subtle);">' + wf.escape(code) + '</span>' : ''))
             + (retired && n === 1 ? ' <span style="color:var(--fg-subtle);">(audit retired)</span>' : '');
    }
