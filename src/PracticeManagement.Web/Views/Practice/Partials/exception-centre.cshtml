@*
    Exception Centre (migrations 161-163).
    Rendered from Manage.cshtml when Model.Key == "exception-centre".

    Admin lands on a list of Pending / Approved / Rejected requests
    (org-scoped), can Approve (effective-until + note + optional
    attachment) or Reject (reason). Auto-populated from gap analysis
    when analyst ticks "Recommend an exception".
*@
@model PracticeManagement.Web.Models.PracticeScreen

<div class="pm-page-heading compact">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1>@Model.Title</h1>
        <p>Requests raised from gap analyses. Approve with an effective-until date + note, or reject with a reason.</p>
    </div>
</div>

<section class="pm-panel" id="excListView" hidden>
    @* Migration 255. The two-tab strip (184: Gap Candidate / SLA
       Candidate) is gone — sir asked for SLA Candidate to stop being a
       tab. Both buckets were already one table with one column set; the
       tabs only filtered requestType, and Type was already a column.

       SLA Candidate rows are NOT hidden from the system, only from the
       tab strip: they move behind the Type filter below, defaulted to
       Gap Candidate. Dropping them entirely would strand the
       TASK_SLA_EXTENSION and TASK_PRIORITY_REDUCTION approvals that
       Task Centre routes here — nobody could approve them again. *@
    <div class="pm-toolbar">
        <select id="excFilterOrganization"><option value="">Select organization</option></select>
        <select id="excFilterType" title="Filter by request type">
            <option value="GAP_CANDIDATE" selected>Gap Candidate</option>
            <option value="SLA_CANDIDATE">SLA Candidate</option>
            @* Migration 327. *@
            <option value="CUSTOM">Custom Exception</option>
            <option value="">All types</option>
        </select>
        <select id="excFilterStatus">
            @* Default. A Pending default hid a request as soon as it was
               submitted for approval — the row is SubmittedForApproval by
               then, and the grid read "No Pending exception requests". *@
            <option value="" selected>All statuses</option>
            <option value="Pending">Pending</option>
            @* Migration 257: the state between analysis and decision. *@
            <option value="SubmittedForApproval">Submitted for approval</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
            <option value="Withdrawn">Withdrawn</option>
            <option value="Expired">Expired</option>
        </select>
        @* Migration 327. Mirrors gaps.cshtml's "+ Add Gap" -- same
           pm-button primary styling, same "opens a dialog, Save posts,
           list refreshes" interaction -- but the dialog itself follows
           THIS file's own .pm-modal pattern (Approve/Reject below),
           not gaps.cshtml's inline-styled <dialog>. *@
        <button class="pm-button primary" id="excAddCustomBtn" type="button" title="Add Custom Exception">
            <i class="fa-solid fa-plus"></i> Add Custom Exception
        </button>
        <button class="pm-button" id="excExpireDueBtn" type="button" title="Sweep and expire Approved rows past their Valid Until date">
            <i class="fa-solid fa-hourglass-end"></i> Expire due
        </button>
        <button class="pm-button icon" id="excRefreshBtn" type="button" title="Refresh" aria-label="Refresh">
            <i class="fa-solid fa-arrows-rotate"></i>
        </button>
    </div>

    <div class="pm-table-wrap">
        <table id="excTable">
            @* Column order + the Request cell's display text (change request
               2026-09-22): "Request, Request Date, Status, Owner, Expiry
               Date, Approved By", with Actions still last. Type/Gap/Att
               were dropped from the grid -- their data, and the Type
               filter above, are untouched; they are just no longer
               columns here. "Owner" is the existing requester
               (requestedByName), split out of what used to be one
               "Requested" cell holding both the date and the name -- the
               list API has no separate assigned-owner field (that only
               exists on the single-request detail read), and adding one
               would mean changing the API/stored proc, which this change
               deliberately does not touch. See exception-centre.js's
               refresh() for the matching row markup and displayRequestTitle()
               for the "Exception: " prefix strip (display only -- the
               stored request_title is untouched). *@
            <thead>
                <tr>
                    <th>Request</th>
                    <th>Request Date</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th>Expiry Date</th>
                    <th>Approved By</th>
                    <th aria-label="Actions"></th>
                </tr>
            </thead>
            <tbody id="excTableBody">
                <tr><td colspan="7" class="pm-empty-row">Select an organization to load requests.</td></tr>
            </tbody>
        </table>
    </div>

    @* Standard grid pager (pm-grid.js). sp_exception_request_list has
       always paged at 25; this screen sent no page parameter, so request
       26 onwards was unreachable. *@
    <div id="excPager"></div>
</section>

@* Approve / Reject modals -- moved into a shared partial (change
   request, 2026-09-22): Exception View's own "Actions" menu must open
   the *exact same* dialogs this row menu opens -- same markup, same
   field ids, same validation -- rather than a second copy for Exception
   View. Both screens now include
   Partials/_exception-action-dialogs.cshtml and drive it through the
   shared wwwroot/js/Shared/exception-actions.js module
   (window.gracExceptionActions), so there is exactly one Approve form
   and one Reject form in the product, used from both screens. See that
   partial's own header comment. *@
<partial name="Partials/_exception-action-dialogs" />

@* Add Custom Exception modal (migration 327).
   Enter Basic Details -> Save -> Exception Request Created (Pending,
   request_type_code = 'CUSTOM') -> the existing Analysis / Submit /
   Approve-Reject flow, unchanged from here on. Same .pm-modal /
   .pm-modal-panel / .pm-modal-footer structure as Approve and Reject
   above -- not gaps.cshtml's inline-styled <dialog>, because this is
   the pattern already established in THIS file. *@
<div class="pm-modal" id="excAddCustomModal" hidden>
    <div class="pm-modal-panel pm-modal-wide">
        <header>
            <h2>Add Custom Exception</h2>
            <button class="pm-modal-close" type="button" data-close-exc-add-custom aria-label="Close">&times;</button>
        </header>
        <form id="excAddCustomForm">
            <dl class="exc-meta" id="excAddCustomOrgMeta"></dl>
            @* Layout fix (change request 2026-09-24): "pm-form-grid-full" is
               not a real class -- practice-management.css only styles a bare
               ".full" (".pm-form-grid label.full { grid-column: 1 / -1 }").
               Every field below was silently landing in the ordinary 2-column
               flow instead of spanning full width, which is what produced
               the misaligned Title/Description row (a one-line input paired
               against a 3-row textarea) sir flagged. Title now genuinely
               spans full width, alone; Description and Reason are placed
               deliberately side by side (sir's own request) rather than
               left to the accidental pairing the typo produced; Related
               Control/Practice (below) now genuinely spans full width too,
               matching what its own header comment already said it was
               designed to do. *@
            <div class="pm-form-grid">
                <label class="full">
                    <span>Exception Title / Subject<span class="pm-required">*</span></span>
                    <input type="text" id="newExcTitle" maxlength="300" required
                           placeholder="A short, specific title for this exception" />
                </label>
                <label>
                    <span>Exception Description</span>
                    <textarea id="newExcDescription" rows="3" maxlength="4000"
                              placeholder="What is being excepted, and from what requirement..."></textarea>
                </label>
                <label>
                    <span>Reason / Justification</span>
                    <textarea id="newExcJustification" rows="3" maxlength="4000"
                              placeholder="Why this exception is being requested..."></textarea>
                </label>
                <label>
                    <span>Exception Type</span>
                    <select id="newExcType">
                        <option value="">-- select --</option>
                    </select>
                </label>
                <label>
                    <span>Owner</span>
                    <select id="newExcOwner">
                        <option value="">-- unassigned --</option>
                    </select>
                </label>
                @* Migration 329 -- the picker itself moved into its own
                   popup (#newExcPracticeModal), the same "button opens a
                   dialog, pick, Confirm adds it and closes" shape Risk
                   Centre's own "Map a practice" dialog
                   (#riskMapPracticeModal) already uses. Migration 328 kept
                   all four cascading Framework/Source Structure/Control/
                   Practice dropdowns open inline in this form at all
                   times -- full width, always visible, even before
                   anything was picked -- which is what made the dialog
                   read as congested. Only the trigger button and the
                   resulting compact list live in the form now; the picker
                   (window.__practicePicker, practice-picker.js) is
                   unchanged, just mounted into the popup instead. *@
                <div class="form-field full">
                    <span>Related Control / Practice(s) <span class="pm-hint">(where applicable -- add as many as apply)</span></span>
                    <div class="exc-practice-add-row">
                        <button type="button" class="pm-button" id="newExcPracticeAddBtn">
                            <i class="fa-solid fa-plus"></i> Add a practice
                        </button>
                    </div>
                    <ul class="exc-practice-list" id="newExcPracticeList"></ul>
                </div>
                @* Related Obligation/Requirement and Related Gap ID removed from
                   this form (change request 2026-09-24) -- both remain on the
                   data model (LinkedRequirementRef / CustomGapId) and still
                   display on Exception View when set another way (e.g. an
                   automatically-created GAP_CANDIDATE request); this form
                   simply no longer captures them, so a Custom Exception is
                   always created with both null. *@
                <label>
                    <span>Valid From</span>
                    <input type="date" id="newExcValidFrom" />
                </label>
                <label>
                    <span>Valid Until / Expiry Date</span>
                    <input type="date" id="newExcValidUntil" />
                </label>
            </div>
            @* Sir's requirement #4: a visible, non-disruptive marker.
               Read-only -- this is not a field the analyst sets, it is
               what request_type_code = 'CUSTOM' will read back as on
               every screen that already shows Type (grid, row menu,
               Exception View). *@
            <p class="pm-hint">Source: Custom Exception. Requested By, requested date and status (Pending) are set
               automatically -- Requested By is recorded as you, the signed-in user, not a field you choose.
               Supporting evidence can be attached once the record is saved, from the same Analysis / Approve
               screens every exception already uses.</p>
            <p class="pm-form-message" id="excAddCustomMessage" role="status" aria-live="polite"></p>
            <footer class="pm-modal-footer">
                <button type="button" class="pm-button" data-close-exc-add-custom>Cancel</button>
                <button type="submit" class="pm-button primary" id="excAddCustomSubmit">
                    <i class="fa-solid fa-plus"></i> Save
                </button>
            </footer>
        </form>
    </div>
</div>

@* ================= Add a practice (Practice Picker) ==================
   Migration 329. Same reason and same shape as Risk Centre's own
   #riskMapPracticeModal: the four cascading dropdowns need a full row
   each, which does not fit inline in the Add Custom Exception form
   without crowding every other field. A dialog gives them the room and
   keeps the form itself down to one button plus the picked-practice
   list. Nested on top of #excAddCustomModal, which stays open behind
   it -- the same "second .pm-modal opens over the first" stacking
   Risk Centre relies on (its Map dialog opens over the risk panel,
   which is not itself a modal here, but the overlay/z-index mechanics
   are identical either way). *@
<div class="pm-modal" id="newExcPracticeModal" hidden>
    <div class="pm-modal-panel pm-modal-wide">
        <header>
            <h2>Add a practice</h2>
            <button class="pm-modal-close" type="button" data-close-exc-practice aria-label="Close">&times;</button>
        </header>
        <p class="pm-hint">
            Choose the framework, then narrow down to the practice. Each list loads only
            what sits under the selection above it. Practices already added to this
            exception are not offered again.
        </p>
        <div id="newExcPracticePickerHost"></div>
        <p class="pm-form-message" id="newExcPracticeAddHint" role="status" aria-live="polite"></p>
        <footer class="pm-modal-footer">
            <button type="button" class="pm-button" data-close-exc-practice>Cancel</button>
            <button type="button" class="pm-button primary" id="newExcPracticeConfirm">
                <i class="fa-solid fa-plus"></i> Add practice
            </button>
        </footer>
    </div>
</div>

<style>
    .exc-status-chip { display: inline-block; padding: 2px 8px; border-radius: 999px;
        font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .exc-pending   { background: #fefcbf; color: #744210; }
    .exc-approved  { background: #c6f6d5; color: #22543d; }
    .exc-rejected  { background: #fed7d7; color: #742a2a; }
    .exc-withdrawn { background: #edf2f7; color: #4a5568; }

    .exc-meta {
        display: grid; grid-template-columns: 120px 1fr; row-gap: 6px; column-gap: 12px;
        margin: 0 0 16px 0; padding: 12px 14px; background: #f7fafc; border-radius: 6px; font-size: 13px;
    }
    .exc-meta dt { color: #718096; font-weight: 600; margin: 0;
                   text-transform: uppercase; font-size: 11px; align-self: center; }
    .exc-meta dd { margin: 0; color: #2d3748; word-break: break-word; }

    /* Modal overlay (same defensive CSS as gap-detail so pm-modal
       renders as a proper popup regardless of global stylesheet). */



    /* Wider variant for the Approve modal (12+ fields fit comfortably). */
    .pm-modal-panel.pm-modal-wide { max-width: 900px; }


    /* .pm-modal / .pm-modal-panel / .pm-modal-footer moved to
           practice-management.css -- they were identical in three
           views and absent from any fourth that used the classes.
           The .pm-modal-close override below is kept deliberately:
           the global rule is a bordered button, this is a glyph. */
        .pm-modal-close { background: transparent; border: 0; padding: 0;
        font-size: 26px; line-height: 1; cursor: pointer; color: #718096; }
    .pm-modal-close:hover { color: #e53e3e; }

    /* Migration 328 -- the Add Custom Exception dialog's own
       Practice Picker "Add to list" row and the resulting list. */
    .exc-practice-add-row { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
    .exc-practice-list { list-style: none; margin: 8px 0 0; padding: 0;
        display: flex; flex-direction: column; gap: 6px; }
    .exc-practice-list li { display: flex; align-items: center; justify-content: space-between;
        gap: 10px; background: #f7fafc; border-radius: 6px; padding: 6px 10px;
        font-size: 13px; color: #2d3748; }
    .exc-practice-list button { background: transparent; border: 0; color: #718096;
        cursor: pointer; font-size: 15px; line-height: 1; padding: 2px 4px; }
    .exc-practice-list button:hover { color: #e53e3e; }

</style>

@* Before the screen's own script -- the pager is mounted during init. *@
<script src="~/js/pm-grid.js" asp-append-version="true"></script>
@* Migration 328. Reusable cascading Practice Picker (migration 282) --
   the same file Risk Centre's own Map Practice dialog loads. Before
   exception-centre.js, which mounts it as soon as the Add Custom
   Exception dialog opens (same ordering reason risk-centre.cshtml
   states for its own load of this file). *@
<script src="~/js/practice-picker.js" asp-append-version="true"></script>
<script src="~/js/ExceptionCentre/exception-centre.js" asp-append-version="true"></script>
<script src="~/js/Shared/exception-actions.js" asp-append-version="true"></script>
