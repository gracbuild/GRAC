@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model PracticeManagement.Web.Models.ChangePasswordViewModel
@{
    Layout = null;
    // Same explicit action construction as Login/Index.cshtml — Url.Action can
    // pick the organization-management-login route via LinkGenerator scoring
    // and emit /OrganizationManagement/Login on a Practice Management host,
    // which then gets double-prefixed by PathBase.
    var pathBase = Context.Request.PathBase.Value?.TrimEnd('/') ?? "";
    var isOrgMgmt = string.Equals(Configuration["Module:Key"], "OrganizationManagement", StringComparison.OrdinalIgnoreCase)
        || string.Equals(pathBase, "/OrganizationManagement", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrEmpty(pathBase) && Context.Request.Path.StartsWithSegments("/OrganizationManagement", StringComparison.OrdinalIgnoreCase));
    var loginRoot = isOrgMgmt && string.IsNullOrEmpty(pathBase)
        ? "/OrganizationManagement/Login"
        : $"{pathBase}/Login";
    var changePasswordAction = $"{loginRoot}/ChangePassword";
    var minimumLength = Configuration.GetValue("UserProvisioning:MinimumPasswordLength", 8);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GRAC | Change password</title>
    <link rel="icon" type="image/x-icon" href="~/css/Images/favicon.ico" />
    <link rel="stylesheet" href="~/lib/FrontEnd/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/FrontEnd/plugins/icheck-bootstrap/icheck-bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/sweet-alert.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/FrontEnd/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cacca-styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-split">
    <div id="Loader" class="div-loader" style="display:none;">
        <div class="loader"></div>
    </div>

    <div class="login-wrapper">
        <div class="split-card">
            <div class="brand-panel">
                <div class="brand-inner">
                    <div class="brand-logo">
                        <img src="~/css/Images/Logo.png" alt="GRAC Logo" loading="lazy" />
                    </div>
                </div>
            </div>

            <div class="form-panel">
                <div class="form-card">
                    <div class="greeting">
                        <h1>Set your password</h1>
                    </div>

                    @if (Model.IsForced)
                    {
                        <p class="validation-message" role="status">
                            Your account is still using the password it was created with.
                            Choose your own password to continue.
                        </p>
                    }

                    <form action="@changePasswordAction" method="post" id="ChangePasswordForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input asp-for="IsForced" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>

                        <div class="form-group mb-3">
                            <label asp-for="LoginId" class="form-label">User ID / Email ID</label>
                            <input asp-for="LoginId" type="text" class="form-control" placeholder="Enter User ID or Email ID" autocomplete="username" tabindex="1" readonly="@(!string.IsNullOrEmpty(Model.LoginId))" />
                            <span asp-validation-for="LoginId" class="validation-message"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" autocomplete="current-password" tabindex="2" autofocus />
                            <span asp-validation-for="CurrentPassword" class="validation-message"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="NewPassword" class="form-label">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="At least @minimumLength characters" autocomplete="new-password" tabindex="3" />
                            <span asp-validation-for="NewPassword" class="validation-message"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter the new password" autocomplete="new-password" tabindex="4" />
                            <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
                        </div>

                        <button type="submit" id="btnChangePassword" class="btn btn-primary btn-signin mt-4" tabindex="5">Save and Sign In</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/FrontEnd/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/FrontEnd/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/FrontEnd/dist/js/adminlte.min.js"></script>
    <script src="~/js/crypto-js.min.js"></script>
    <script src="~/js/sweet-alert.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
