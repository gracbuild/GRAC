@*
    The login screens' brand side.

    One copy, rendered by both Login/Index.cshtml and
    Login/ChangePassword.cshtml -- the two screens are the same flow.

    2026-11-03 restyle (change request: "make the login page like the
    picture"). The earlier navy card with the Requirement -> Evidence
    flow diagram is replaced by the full-bleed scene from the reference
    image: a glowing "Practice Core" hub with the frameworks and
    capabilities it connects, the "Continuous Compliance Assured" line,
    and the module strip. The GRAC logo sits in the top-left corner of
    the screen (moved out of the sign-in card on request, same day).

    The hub's chips and their dashed connectors are drawn from ONE list
    below, so a chip and its line can never drift apart. Positions are
    percentages of the hub stage; the connector SVG uses a 700 x 420
    viewBox and the stage has the same aspect ratio (login.css), so a
    percentage maps to the same point in both.
*@
@{
    // (label, isFramework, x %, y %, tilt deg, cycle)
    //   isFramework = true  -> rectangular framework tile (ISO 27001 ...)
    //   isFramework = false -> rounded capability pill with the gold dot
    //   cycle = labels the chip rotates through, starting with Label
    //           (js/login.js); null = a fixed label. To add or change a
    //           standard, edit the list here -- nothing else.
    var hubChips = new (string Label, bool IsFramework, double X, double Y, double Tilt, string[]? Cycle)[]
    {
        ("ISO 27001",           true,  30, 14, -8,
            new[] { "ISO 27001", "ISO 9001", "ISO 42000", "ISO 33000" }),
        ("RBI CSF",             true,  68,  9,  6, null),
        ("Live Risk",           false, 13, 33, -6, null),
        ("Continuous Evidence", false, 82, 31,  5, null),
        ("SOC 2",               true,  15, 56, -4, null),
        ("PCI DSS",             true,  84, 57,  4, null),
        ("Audit Readiness",     false, 14, 84, -6, null),
        ("Real-time Posture",   false, 83, 85,  5, null),
    };

    // The module strip under the tagline. Font Awesome 5 free icons
    // (the version under lib/FrontEnd/plugins/fontawesome-free).
    var modules = new (string Icon, string Label)[]
    {
        ("fas fa-landmark",    "Governance"),
        ("fas fa-shield-alt",  "Risk Management"),
        ("fas fa-search",      "Audit Assurance"),
        ("fas fa-users",       "TPRM"),
        ("far fa-file-alt",    "Policy Management"),
        ("far fa-chart-bar",   "Practice Management"),
    };

    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="brand-panel">
    @* Top-left of the screen. Positioned against .login-wrapper, which
       reserves the room for it (login.css), so it never sits over the
       hub or the card. *@
    <div class="brand-logo">
        <img src="~/css/Images/Logo.png" alt="GRAC - Continuous Compliance Assured" />
    </div>

    @* Decorative particle wave along the bottom of the screen, drawn by
       js/login.js. Positioned against .login-wrapper, behind both columns. *@
    <canvas class="login-wave" aria-hidden="true"></canvas>

    @* Decorative: the hub says what the tagline below already says, so it
       is hidden from assistive technology. *@
    <div class="hub-stage" aria-hidden="true">
        <svg class="hub-lines" viewBox="0 0 700 420" preserveAspectRatio="none" role="presentation">
            @foreach (var chip in hubChips)
            {
                <line x1="@((chip.X * 7).ToString(inv))" y1="@((chip.Y * 4.2).ToString(inv))" x2="350" y2="210" />
            }
        </svg>

        <div class="hub-core">
            <span>Practice</span>
            <span class="hub-core-accent">Core</span>
        </div>

        @foreach (var chip in hubChips)
        {
            <div class="hub-chip @(chip.IsFramework ? "is-framework" : "is-capability")"
                 style="--x:@(chip.X.ToString(inv))%;--y:@(chip.Y.ToString(inv))%;--r:@(chip.Tilt.ToString(inv))deg"
                 data-cycle="@(chip.Cycle is null ? null : string.Join("|", chip.Cycle))"><span class="hub-chip-text">@chip.Label</span></div>
        }
    </div>

    <h2 class="brand-tagline">Continuous <span>Compliance</span> Assured</h2>

    <ul class="brand-modules">
        @foreach (var module in modules)
        {
            <li><i class="@module.Icon" aria-hidden="true"></i><span>@module.Label</span></li>
        }
    </ul>
</div>
