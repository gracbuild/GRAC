@*
    Organization SLA Configuration -- migrations 178 / 179 / 180 / 181.

    Screen key : `org-sla-config`
    Group      : Governance
    Menu       : nav-governance -> SLA Configuration (migration 180)
    Feature    : screen.org-sla-config

    Master-first flow (post-186):
      * Grid lists EVERY grac_new.sla_master row for the org with
        one of three statuses: Not Configured / Active / Inactive.
      * 3-dot menu:
          Not Configured -> Configure
          Active         -> Configure, Inactivate
          Inactive       -> Configure, Reactivate
      * Configure dialog is the one-stop shop -- thresholds AND all
        three notify-role sets (WARNING / BREACH / ESCALATION) are
        edited here. The old separate Notifies dialog was retired
        in 182; the Bind Processes dialog was retired in 186.
      * Configuring a Not Configured row auto-activates it (server
        side: sp_org_sla_config_upsert on 181).
      * SLA-to-gap resolution uses severity -> classification match
        (sp_org_sla_match_for_severity, 184). No process-binding
        surface remains.

    Backend:
        GET  /practice/api/org-sla/masters-with-config?organizationId=&search=   (grid)
        GET  /practice/api/org-sla/configs/{id}?organizationId=                  (detail for notify + bindings dialogs)
        POST /practice/api/org-sla/configs                                       (create or update -- idempotent by master)
        POST /practice/api/org-sla/configs/set-active                            (toggle is_active)
        POST /practice/api/org-sla/configs/{id}/notify-roles                     (full-replace notify roles)
        POST /practice/api/org-sla/configs/{id}/process-bindings                 (full-replace bindings)
        GET  /practice/api/org-sla/process-types                                 (bindings dropdown)
        GET  /practice/api/org-roles?organizationId=                             (roles feed, shared)
*@
@model PracticeManagement.Web.Models.PracticeScreen

<div class="pm-page-heading compact">
    <div>
        <p class="pm-eyebrow">@Model.Group / @Model.Title</p>
        <h1 id="oaSlaHeading">@Model.Title</h1>
        <p id="oaSlaSubtitle">@Model.Description</p>
    </div>
</div>

<section class="pm-panel" id="oaSlaRoot">
    @* Picker toolbar *@
    <div class="pm-toolbar" style="flex-wrap:wrap; gap:8px; align-items:end;">
        <label class="pm-field">
            <span>Organization</span>
            <select class="pm-input" id="oaSlaPickOrg" style="min-width:260px;">
                <option value="">Loading...</option>
            </select>
        </label>
        <label class="pm-field" style="flex:1; min-width:220px;">
            <span>Search</span>
            <input class="pm-input" id="oaSlaSearch" type="text" placeholder="Search SLA code / classification / process..." maxlength="200"
                   />
        </label>
        <div style="display:flex; gap:6px;">
            <button class="pm-button" id="oaSlaReloadBtn" type="button">Reload</button>
        </div>
    </div>

    <div id="oaSlaMessage" hidden
         style="margin:8px 0; padding:8px 12px; border-radius:var(--radius-md); font-size:13px;"></div>

    <div class="pm-table-wrap" style="margin-top:12px;">
        <table>
            <thead>
                <tr>
                    <th>SLA</th>
                    <th>Process</th>
                    <th>Classification</th>
                    <th style="width:110px;">Duration</th>
                    <th style="width:110px;">Time Basis</th>
                    <th style="width:80px;">Warning %</th>
                    <th style="width:80px;">Escalation %</th>
                    <th style="width:120px;">Status</th>
                    <th style="width:70px;">Roles</th>
                    <th style="width:60px;"></th>
                </tr>
            </thead>
            <tbody id="oaSlaGridBody">
                <tr><td colspan="10" class="pm-empty">Pick an organization to see the SLA masters.</td></tr>
            </tbody>
        </table>
    </div>
</section>

@* ================== Configure dialog ==================
   One-stop dialog (post-182): master identity header, threshold
   inputs, AND the three notify-role multi-selects (WARNING / BREACH
   / ESCALATION). The old separate Notifies dialog was retired.
*@
<dialog id="oaSlaConfigDialog"
        style="max-width:920px; width:96%; min-height:640px; max-height:92vh; overflow:visible;">
    <form id="oaSlaConfigForm" method="dialog">
        <div class="pm-dialog-heading">
            <h2 id="oaSlaConfigTitle">Configure SLA</h2>
            <button class="pm-icon-button" type="button" id="oaSlaConfigClose" aria-label="Close"
                   >&times;</button>
        </div>
        <div class="pm-message" id="oaSlaConfigMessage" style="display:none;"></div>

        @* Read-only master identity header -- master is fixed by the
           clicked grid row (no picker needed post-181). *@
        <div id="oaSlaConfigMasterCard"
             style="padding:10px 12px; background:var(--neutral-50); border:1px solid var(--border); border-radius:var(--radius-md); margin-bottom:12px; font-size:13px; color:var(--fg-strong);">
            <div><strong id="oaSlaConfigMasterName">--</strong>
                 <span id="oaSlaConfigMasterCode" style="color:var(--fg-muted); margin-left:6px;"></span></div>
            <div id="oaSlaConfigMasterMeta" style="color:var(--fg-secondary); font-size:12px; margin-top:2px;"></div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:10px; align-items:start;">
            <label class="pm-field">
                <span>Timeline</span>
                <input class="pm-input" id="oaSlaConfigTotal" type="number" min="0" step="1" placeholder="from master"
                       />
            </label>
            <label class="pm-field">
                <span>Warning % <span class="required">*</span></span>
                <input class="pm-input" id="oaSlaConfigWarning" type="number" min="0" max="100" step="0.01" required
                       />
            </label>
            <label class="pm-field">
                <span>Escalation % <span class="required">*</span></span>
                <input class="pm-input" id="oaSlaConfigEsc" type="number" min="0" max="100" step="0.01" required
                       />
            </label>
            <label class="pm-field">
                <span>Time Basis</span>
                <select class="pm-input" id="oaSlaConfigTimeBasis"
                       >
                    <option value="">-- from master --</option>
                    <option value="Calendar Days">Calendar Days</option>
                    <option value="Business Days">Business Days</option>
                    <option value="Calendar Hours">Calendar Hours</option>
                    <option value="Business Hours">Business Hours</option>
                </select>
            </label>
        </div>
        <p style="margin:6px 0 0; color:var(--fg-subtle); font-size:11px;">
            Warning % must be less than or equal to Escalation %. Both fire before BREACH (100% of SLA).
        </p>

        <label class="pm-field" style="margin-top:10px;">
            <span>Notes</span>
            <textarea class="pm-input" id="oaSlaConfigNotes" rows="2" maxlength="1000"
                     ></textarea>
        </label>

        @* Notify roles -- three events, each with a role multi-select.
           Roles are resolved to current holders at notify time via
           sp_org_role_holders_list (117). *@
        <div style="margin-top:16px; padding-top:12px; border-top:1px solid var(--border);">
            <h3 style="margin:0 0 4px; font-size:14px; color:var(--fg-strong);">Notify Roles</h3>
            <p style="margin:0 0 10px; color:var(--fg-secondary); font-size:12px;">
                Pick the roles to notify when each event fires. The current holder(s)
                of the role are resolved at fire time.
            </p>
            @* Collapsible multi-select combo: the underlying <select
               multiple> stays as the semantic backing (submit code reads
               selectedOptions); the visible UI is a trigger + popover
               built by mountMultiDropdown() in JS.  *@
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; align-items:start;">
                <label class="pm-field">
                    <span>Warning</span>
                    <div class="pm-multi-host" data-target="oaSlaConfigNotifyWarning" style="margin-top:2px; position:relative;"></div>
                    <select id="oaSlaConfigNotifyWarning" multiple style="display:none;"></select>
                </label>
                <label class="pm-field">
                    <span>Escalation</span>
                    <div class="pm-multi-host" data-target="oaSlaConfigNotifyEsc" style="margin-top:2px; position:relative;"></div>
                    <select id="oaSlaConfigNotifyEsc" multiple style="display:none;"></select>
                </label>
                <label class="pm-field">
                    <span>SLA Breach</span>
                    <div class="pm-multi-host" data-target="oaSlaConfigNotifyBreach" style="margin-top:2px; position:relative;"></div>
                    <select id="oaSlaConfigNotifyBreach" multiple style="display:none;"></select>
                </label>
            </div>
        </div>

        <div class="pm-dialog-actions">
            <button type="button" id="oaSlaConfigCancel" class="pm-button">Cancel</button>
            <button type="submit" id="oaSlaConfigSubmit" class="pm-button primary">Save</button>
        </div>
    </form>
</dialog>

@* Process bindings dialog retired in migration 186. Severity ->
   classification match (via sp_org_sla_match_for_severity) is now the
   only SLA lookup pattern. *@

<script src="~/js/OrgSlaConfig/org-sla-config.js" asp-append-version="true"></script>
