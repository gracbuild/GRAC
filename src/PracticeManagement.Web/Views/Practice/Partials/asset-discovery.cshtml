                </table>
            </div>
            <h3 class="adc-sub">Impact</h3>
            <div class="pm-table-wrap">
                <table>
                    <thead id="adcMgImpactHead"></thead>
                    <tbody id="adcMgImpactBody"></tbody>
                </table>
            </div>
            <h3 class="adc-sub">Field values</h3>
            <p class="adc-note">The survivor keeps its values; empty survivor values are filled from the first duplicate holding one. Tick a duplicate value to take it instead (saved with the draft).</p>
            <div class="pm-table-wrap">
                <table>
                    <thead><tr><th>Field</th><th>Survivor</th><th>Duplicate value</th><th>Take</th></tr></thead>
