<script src="~/js/practice-picker.js" asp-append-version="true"></script>

@* Reuse the existing Add Implementation Task modal — exposes window.__openAddImplTask *@
<partial name="Partials/_add-implementation-task-modal" model="Model" />

@* Shared pager (and escape/badge helpers) — exposes window.__wfCommon.
   Self-guards on re-render, so rendering it here is safe even when the
   host page has already pulled it in for another partial. *@
<partial name="Partials/_workflow-common" />

@* NOTE — see the equivalent comment in tasks.cshtml. Razor @section blocks
   are ignored inside partial views, so keep this script inline. *@
<script>
(function () {
    'use strict';
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();

    // Published deployments run under a PathBase (e.g. "/Practicemanagement"
    // per appsettings.json). The layout exposes it as window.appBasePath;
    // prepend it to every same-origin fetch so the URL becomes
    // `${basePath}/practice/api/...` -- otherwise the request hits
    // `/practice/api/...` at the origin root and returns 404 in production
    // even though it works locally where PathBase is empty.
    //
    // IMPORTANT: this IIFE runs at script-parse time -- BEFORE the layout's
    // trailing inline script that sets window.pmPathBase. If we captured
    // APP_BASE eagerly here it would always be '' in published builds.
    // Resolve lazily inside U() so the actual fetch URL is computed at call
    // time (which happens on DOMContentLoaded / user interaction -- well
    // after every inline layout script has run).
    const U = p => String(window.appBasePath || window.pmPathBase || '').replace(/\/+$/, '') + p;

    let selectedOrgId = null;
    // Migration 382: practices mapped in the Add Custom Gap dialog.
    let selectedPractices = [];
    let gapMapPicker = null;
    // Migration 255: one list, so one page counter instead of pagesByTab.
    let page          = 1;
    // Stage 4b -- Assurance-side filter via ?observationId= in URL.
    let assuranceObservationFilter = (function () {
        try {
            const q = new URLSearchParams(window.location.search);
            const v = q.get('observationId');
            const n = v ? Number(v) : NaN;
            return Number.isFinite(n) && n > 0 ? n : null;
        } catch (_) { return null; }
    })();
    // Migration 255: ?tab=assurance used to switch tabs. There are no
    // tabs now, so the same intent becomes a preset on the Source filter
    // — every existing deep link keeps landing on the same rows.
    let initialSource = (function () {
        try {
            const q = new URLSearchParams(window.location.search);
            const s = q.get('source');
            if (s) return s;
            const t = q.get('tab');
            if (t === 'assurance' || assuranceObservationFilter !== null) return 'Assurance';
            if (t === 'custom')         return 'Custom';
            if (t === 'implementation') return 'Implementation';
        } catch (_) { /* ignore */ }
        return '';
    })();
    const PAGE_SIZE   = 25;
    let searchDebounce = null;
    let openMenuEl      = null;
    let openMenuTrigger = null;

    async function init() {
        const orgs = await loadOrgs();
        const root    = document.getElementById('gapCenterRoot');
        const unavail = document.getElementById('gapCenterUnavailable');
        if (!orgs.length) {
            unavail.hidden = false;
            document.getElementById('gapCenterUnavailableTitle').textContent = 'No organizations are available for your account.';
            document.getElementById('gapCenterUnavailableBody').textContent  = 'Ask a GRAC Admin to map your account to an organization.';
            return;
        }
        root.hidden = false;
        populateOrgSelect(orgs);
        document.getElementById('gapFilterOrganization').addEventListener('change', onOrgChange);
        document.getElementById('gapRefreshBtn').addEventListener('click', reloadCurrentTab);
        document.getElementById('gapCenterSearch').addEventListener('input', function () {
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(function () { page = 1; reloadCurrentTab(); }, 300);
        });
        // Migration 255: the Source filter replaces the three tabs.
        document.getElementById('gapFilterSource').addEventListener('change', function () {
            page = 1;
            reloadCurrentTab();
        });
        // The Clear button on the observation banner had no handler at
        // all -- the banner rendered, the button did nothing. Wired here
        // because 255 makes that banner part of the one list rather than
        // a fixture of a tab nobody could leave.
        const obsClear = document.getElementById('assuranceObsFilterClear');
        if (obsClear) obsClear.addEventListener('click', function () {
            assuranceObservationFilter = null;
            page = 1;
            reloadCurrentTab();
        });
        wirePagers();
        wireRowMenu();
        wireAddGapDialog();

        const addBtn = document.getElementById('gapAddBtn');
        if (addBtn) addBtn.addEventListener('click', openAddGapDialog);

        // Feature-flag probe for the chosen (or auto-selected) org.
        await onOrgChange();
    }

    async function loadOrgs() {
        try {
            const r = await fetch(U('/practice/api/organizations/allowed'), { credentials: 'same-origin' });
            if (!r.ok) return [];
            const b = await r.json();
            const rows = (b && (b.data || b.Data)) || [];
            return rows.map(function (row) {
                return {
                    value: String(row.organizationId || row.OrganizationId || ''),
                    label: String(row.organizationName || row.OrganizationName || '')
                };
            }).filter(function (o) { return o.value; });
        } catch (_) { return []; }
    }
    function populateOrgSelect(orgs) {
        // Unified behavior (Gap Center + Task Center):
        //   * No "Select organization" placeholder -- first permitted
        //     org is auto-selected so records load on initial page.
        //   * Single-org users: dropdown disabled (nothing to switch to).
        //   * Multi-org users: dropdown enabled, change handler reloads.
        //   * Empty list handled upstream in init() (unavailable banner).
        const sel = document.getElementById('gapFilterOrganization');
        sel.innerHTML = '';
        for (const o of orgs) {
            const opt = document.createElement('option');
            opt.value = o.value; opt.textContent = o.label || ('Organization ' + o.value);
            sel.appendChild(opt);
        }
        if (orgs.length > 0) sel.value = orgs[0].value;
        sel.disabled = orgs.length <= 1;
    }

    async function checkFeatureFlagFor(orgId) {
        try {
            const resp = await fetch(
                U('/practice/api/gaps/feature-status?organizationId=') + encodeURIComponent(orgId),
                { credentials: 'same-origin' });
            if (!resp.ok) return false; // fail-closed (mirrors Task Center)
            const body = await resp.json();
            return !!(body && (body.enabled === true || body.Enabled === true));
        } catch (_) { return false; }
    }

    async function onOrgChange() {
        closeRowMenu();
        selectedOrgId = document.getElementById('gapFilterOrganization').value || null;
        page = 1;
        const root    = document.getElementById('gapCenterRoot');
        const unavail = document.getElementById('gapCenterUnavailable');
        if (!selectedOrgId) {
            // Multi-org caller has not picked one yet — keep toolbar visible,
            // clear the grid, no feature-flag probe.
            unavail.hidden = true;
            setBody('<tr><td colspan="9" class="pm-empty">Select an organization to load gaps.</td></tr>');
            return;
        }
        const enabled = await checkFeatureFlagFor(selectedOrgId);
        if (!enabled) {
            unavail.hidden = false;
            root.hidden    = true;
            return;
        }
        unavail.hidden = true;
        root.hidden    = false;
        // Source options carry per-source counts, so this is also what
        // replaced the three tab badges.
        await loadSourceFilter();
        await reloadCurrentTab();
    }

    // -----------------------------------------------------------------
    // Migration 255 -- one list, Source as a column and a filter.
    //
    // Replaces refreshCounts/setCounts (three tab badges), switchTab, and
    // the three loadX/renderX pairs. The three tabs were three views of
    // one question split by where the gap came from, and "where it came
    // from" is an attribute of a gap, not a kind of gap.
    //
    // The list is sp_gap_centre_list, which UNIONs custom_gap (every
    // source module) with practice_gap rows nobody has materialized yet
    // -- so an implementation gap is still visible before it has a
    // custom_gap row, which is the whole reason that tab existed.
    // -----------------------------------------------------------------
    const SOURCE_LABELS = {
        Implementation: 'Implementation',
        Assurance:      'Assurance',
        Custom:         'Custom',
        Exception:      'Exception',
        Risk:           'Risk',
        Audit:          'Audit'
    };

    // Populated from sp_gap_centre_source_counts, which returns the whole
    // CHECK-constraint vocabulary including zeroes. A stable dropdown: an
    // operator who filters to Audit and sees "0" has learned something;
    // one who cannot find Audit in the list has not.
    async function loadSourceFilter() {
        const sel = document.getElementById('gapFilterSource');
        if (!sel || !selectedOrgId) return;
        const keep = sel.value || initialSource || '';
        try {
            const r = await fetch(
                U('/practice/api/gaps/custom/centre/sources?organizationId=') + encodeURIComponent(selectedOrgId),
                { credentials: 'same-origin' });
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const rows = await r.json();
            sel.innerHTML = '<option value="">All sources</option>';
            (rows || []).forEach(function (row) {
                const code = row.sourceModuleCode || row.SourceModuleCode || '';
                const n    = row.gapCount || row.GapCount || 0;
                if (!code) return;
                const opt = document.createElement('option');
                opt.value = code;
                opt.textContent = (SOURCE_LABELS[code] || code) + ' (' + n + ')';
                sel.appendChild(opt);
            });
            sel.value = keep;
            if (sel.value !== keep) sel.value = '';   // preset no longer offered
        } catch (_) {
            // Non-fatal: the list still works unfiltered.
        }
        initialSource = '';
    }

    async function reloadCurrentTab() {
        closeRowMenu();
        if (!selectedOrgId) return;
        return loadGaps();
    }

    async function loadGaps() {
        const q      = document.getElementById('gapCenterSearch').value.trim();
        const source = document.getElementById('gapFilterSource').value || '';
        const params = new URLSearchParams();
        params.set('organizationId', String(selectedOrgId));
        params.set('page',           String(page));
        params.set('pageSize',       String(PAGE_SIZE));
        if (q)      params.set('search',           q);
        if (source) params.set('sourceModuleCode', source);
        // Assurance Observations deep-links here with ?observationId=.
        // sp_gap_centre_list takes it and suppresses its practice_gap arm
        // when set -- an instance gap has no observation link, so the
        // alternative was returning unrelated rows under a banner
        // claiming they were filtered.
        if (assuranceObservationFilter) params.set('observationId', String(assuranceObservationFilter));

        const banner = document.getElementById('assuranceObsFilterBanner');
        const label  = document.getElementById('assuranceObsFilterLabel');
        if (banner && label) {
            banner.hidden = !assuranceObservationFilter;
            if (assuranceObservationFilter) label.textContent = '#' + assuranceObservationFilter;
        }

        setBody('<tr><td colspan="9" class="pm-empty">Loading...</td></tr>');
        try {
            const r = await fetch(U('/practice/api/gaps/custom/centre?' + params.toString()),
                                  { credentials: 'same-origin' });
            if (!r.ok) {
                // Show what the server said, not just the status code. A
                // bare "HTTP 500" sends people looking at the wrong layer;
                // the API names the cause (e.g. an un-applied migration).
                const b = await r.json().catch(function () { return {}; });
                throw new Error(b.error || ('HTTP ' + r.status));
            }
            renderGaps(await r.json());
        } catch (err) {
            setBody('<tr><td colspan="9" class="pm-empty">Failed to load: ' + escape(err.message) + '</td></tr>');
        }
    }

    // Rows are kept so the 3-dot menu can read the whole row object by
    // index instead of round-tripping every field through data- attributes.
    let currentRows = [];

    function renderGaps(payload) {
        const body = document.getElementById('gapBody');
        if (!body) return;
        currentRows = (payload && (payload.rows || payload.Rows)) || [];
        body.innerHTML = '';
        if (!currentRows.length) {
            body.innerHTML = '<tr><td colspan="9" class="pm-empty">No gaps for this filter.</td></tr>';
            updatePager(payload);
            return;
        }
        currentRows.forEach(function (row, i) {
            const tr    = document.createElement('tr');
            tr.setAttribute('data-row-index', String(i));
            // Row click-to-View (change request, 2026-09-22): only a
            // materialized gap has a Gap View to open -- an un-materialized
            // practice-instance row is not a gap yet (buildRowMenu's own
            // "Analysis" branch for it goes through materializeThenGoto,
            // not a plain navigation), so it gets no click target and no
            // pointer cursor. See wireRowMenu() below for the click itself.
            if (row.isMaterialized || row.IsMaterialized) tr.className = 'pm-row-clickable';
            const linked = Number(row.linkedCount || row.LinkedCount || 0);
            // What the count MEANS differs by origin, so the label does
            // too -- obligations for an instance gap, observations for an
            // assurance one. One unlabelled number in a shared column
            // would have been two different facts wearing one hat.
            const linkedNote = !linked ? ''
                : (row.isMaterialized || row.IsMaterialized
                    ? '<div style="font-size:11px; color:#64748b;">' + linked + ' observation' + (linked === 1 ? '' : 's') + '</div>'
                    : '<div style="font-size:11px; color:#64748b;">' + linked + ' obligation' + (linked === 1 ? '' : 's') + '</div>');
            tr.innerHTML = [
                '<td><div>' + escape(row.title || row.Title || '') + '</div>' + linkedNote + sourceNote(row) + '</td>',
                '<td>' + escape(row.statusText || row.StatusText || '') + '</td>',
                '<td>' + statusOrDash(row.practiceInstanceStatusText || row.PracticeInstanceStatusText) + '</td>',
                '<td>' + statusOrDash(row.taskStatusText || row.TaskStatusText) + '</td>',
                '<td>' + statusOrDash(row.riskStatusText || row.RiskStatusText) + '</td>',
                '<td>' + statusOrDash(row.exceptionStatusText || row.ExceptionStatusText) + '</td>',
                '<td>' + escape(row.ownerText || row.OwnerText || '') + '</td>',
                '<td>' + fmtDate(row.openedDt || row.OpenedDt) + '</td>',
                '<td>' + actionTrigger(i) + '</td>'
            ].join('');
            body.appendChild(tr);
        });
        updatePager(payload);
    }

    // An implementation gap with no custom_gap row behind it yet cannot
    // be analysed until it is materialized. Saying so on the row is
    // cheaper than letting somebody discover it from the menu. Moved into
    // the Gap title cell (change request, 2026-09-23) when the Source
    // column it used to live in was dropped from the grid.
    function sourceNote(row) {
        const isMat = row.isMaterialized || row.IsMaterialized;
        return isMat ? '' : '<div style="font-size:11px; color:#64748b;">not yet analysed</div>';
    }

    // Practice Instance / Task / Risk / Exception Status (migration 371):
    // each is NULL when the Gap has nothing of that kind linked. Same
    // em-dash-on-empty convention task-actions.js already uses for an
    // unset value, so an absent status reads as "nothing here" rather
    // than a blank that could be mistaken for a loading gap.
    function statusOrDash(v) {
        return v ? escape(v) : '<span style="font-weight:400; color:#94a3b8;">&mdash;</span>';
    }

    function fmtDate(v) {
        if (typeof window.gracFormatDisplayDate === "function" && v != null && v !== "") { var _g = window.gracFormatDisplayDate(v); if (_g !== v) return _g; }
        if (!v) return '';
        const d = new Date(v);
        return isNaN(d.getTime()) ? escape(String(v).slice(0, 10)) : escape(d.toISOString().slice(0, 10));
    }

    async function loadGapOwnerOptions(orgId) {
        const sel = document.getElementById('newGapOwner');
        sel.innerHTML = '<option value="">Loading employees...</option>';
        sel.disabled  = true;
        try {
            const r = await fetch(U('/practice/api/organizations/') + encodeURIComponent(orgId) + '/employees',
                                  { credentials: 'same-origin' });
            const arr = r.ok ? await r.json() : [];
            sel.innerHTML = '';
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = (arr && arr.length) ? '(no owner)' : 'No active employees for this organization';
            sel.appendChild(placeholder);
            (arr || []).forEach(function (emp) {
                const opt = document.createElement('option');
                opt.value = String(emp.employeeId);
                let label = emp.employeeName || '';
                if (emp.employeeCode) label += ' (' + emp.employeeCode + ')';
                opt.textContent = label;
                if (emp.email) opt.title = emp.email;
                sel.appendChild(opt);
            });
        } catch (_) {
            sel.innerHTML = '<option value="">Failed to load employees</option>';
        } finally { sel.disabled = false; }
    }
    // Was called throughout the Add Gap dialog's own handlers below
    // (openAddGapDialog, and the form's submit handler) but never
    // defined -- clicking Add Gap threw "setGapMsg is not defined"
    // before the dialog could even open. #newGapMessage is the
    // dialog's own message banner (line ~117); _workflow-common.cshtml
    // (included below, line ~209) already exposes the same ok/error/info
    // banner logic as window.__wfCommon.setMessage(id, text, kind) --
    // used the same way by wirePagers()/updatePager() just below -- so
    // this reuses that instead of a third copy of the colour rules
    // (gap-detail.js's showSlaMsg is the second).
    function setGapMsg(text, kind) {
        const wf = window.__wfCommon;
        if (!wf) { console.error('__wfCommon missing - _workflow-common partial not rendered'); return; }
        wf.setMessage('newGapMessage', text, kind);
    }
    // ---- Migration 382: mapped-practices helpers (reuse __practicePicker) ----
    function gapEsc(v) {
        return (window.__wfCommon && window.__wfCommon.escape) ? window.__wfCommon.escape(v) : String(v == null ? '' : v);
    }
    function renderGapPractices() {
        const list = document.getElementById('newGapPracticeList');
        if (!list) return;
        if (!selectedPractices.length) {
            list.innerHTML = '<span class="pm-hint" style="font-size:12px; color:#94a3b8;">No practices mapped yet.</span>';
            return;
        }
        list.innerHTML = selectedPractices.map(function (pr) {
            return '<span style="display:inline-flex; align-items:center; gap:6px; background:#eef2ff; border:1px solid #c7d2fe; color:#3730a3; border-radius:12px; padding:2px 10px; font-size:12px;">'
                + gapEsc(pr.practiceName)
                + ' <button type="button" data-remove-practice="' + pr.practiceId + '" aria-label="Remove practice" style="background:none; border:none; cursor:pointer; color:#3730a3; font-size:14px; line-height:1;">&times;</button></span>';
        }).join('');
    }
    function closeGapMapPractice() {
        const m = document.getElementById('gapMapPracticeModal');
        if (!m) return;
        if (typeof m.close === 'function' && m.open) m.close();
        else { m.removeAttribute('open'); m.style.display = 'none'; }
    }
    function openGapMapPractice() {
        const modal = document.getElementById('gapMapPracticeModal');
        const host  = document.getElementById('gapMapPickerHost');
        const msg   = document.getElementById('gapMapPickerMessage');
        if (!modal || !host) return;
        if (msg) { msg.textContent = ''; msg.className = 'pm-form-message'; }
        const showMap = function () { if (typeof modal.showModal === 'function') modal.showModal(); else { modal.setAttribute('open','open'); modal.style.display='block'; } };
        if (!window.__practicePicker) { host.innerHTML = '<span class="pm-hint">Practice picker unavailable - practice-picker.js did not load.</span>'; showMap(); return; }
        if (!selectedOrgId) { host.innerHTML = '<span class="pm-hint">Select an organization first.</span>'; showMap(); return; }
        // Fresh instance each open: exclude what is already mapped so the
        // same practice cannot be added twice (same behaviour as Risk Analysis).
        const excluded = selectedPractices.map(function (pr) { return pr.practiceId; });
        try { if (gapMapPicker && gapMapPicker.destroy) gapMapPicker.destroy(); } catch (e) {}
        gapMapPicker = window.__practicePicker.attach({
            host: host,
            organizationId: Number(selectedOrgId),
            excludePracticeIds: excluded
        });
        showMap();
    }
    function confirmGapMapPractice() {
        const msg = document.getElementById('gapMapPickerMessage');
        const st  = (gapMapPicker && gapMapPicker.getState) ? gapMapPicker.getState() : null;
        const pid = st && st.practiceId ? Number(st.practiceId) : null;
        if (!pid) { if (msg) { msg.textContent = 'Select a practice first.'; msg.className = 'pm-form-message error'; } return; }
        if (!selectedPractices.some(function (pr) { return pr.practiceId === pid; })) {
            selectedPractices.push({ practiceId: pid, practiceName: st.practiceName || ('Practice #' + pid) });
            renderGapPractices();
        }
        closeGapMapPractice();
    }

    function openAddGapDialog() {
        if (!selectedOrgId) { alert('Select an organization first.'); return; }
        const dlg = document.getElementById('newCustomGapDialog');
        if (!dlg) return;
        setGapMsg(null);
        ['newGapTitle','newGapDescription','newGapDueDate','newGapRemarks'].forEach(function (id) {
            const el = document.getElementById(id); if (el) el.value = '';
        });
        const pr = document.getElementById('newGapPriority'); if (pr) pr.value = 'Medium';
        const st = document.getElementById('newGapStatus');   if (st) st.value = 'Open';
        const sub = document.getElementById('newGapSubmit');  if (sub) sub.disabled = false;
        const orgSel = document.getElementById('gapFilterOrganization');
        const lbl = document.getElementById('newGapOrgLabel');
        if (lbl) lbl.textContent = (orgSel && orgSel.options[orgSel.selectedIndex]
                                    && orgSel.options[orgSel.selectedIndex].textContent)
                                   || ('Organization ' + selectedOrgId);
        loadGapOwnerOptions(selectedOrgId);
        selectedPractices = [];
        renderGapPractices();
        if (typeof dlg.showModal === 'function') dlg.showModal();
        else { dlg.setAttribute('open','open'); dlg.style.display='block'; }
        setTimeout(function () { const t = document.getElementById('newGapTitle'); if (t) t.focus(); }, 40);
    }
    function closeAddGapDialog() {
        const dlg = document.getElementById('newCustomGapDialog');
        if (!dlg) return;
        if (typeof dlg.close === 'function') dlg.close();
        else { dlg.removeAttribute('open'); dlg.style.display = 'none'; }
    }
    function wireAddGapDialog() {
        const dlg = document.getElementById('newCustomGapDialog');
        if (!dlg) return;
        const closeB = document.getElementById('newGapClose');
        const canB   = document.getElementById('newGapCancel');
        const form   = document.getElementById('newCustomGapForm');
        if (closeB) closeB.addEventListener('click', closeAddGapDialog);
        if (canB)   canB.addEventListener('click',   closeAddGapDialog);
        // Backdrop-click-to-close. Was a coordinate check (e.clientX/
        // e.clientY against the dialog's own rect) -- that misfires on
        // ANY click event whose coordinates are not real, including a
        // programmatic click a browser extension, clipboard-sync tool
        // (common over RDP/Citrix), or assistive technology can dispatch
        // on the focused field -- clientX/clientY default to 0 on such an
        // event, which reads as "outside" this centred dialog, so
        // pressing Ctrl+C while a field inside the dialog was focused
        // could close the whole Add Custom Gap dialog out from under the
        // user. event.target is the standard, coordinate-free way to
        // detect a native <dialog> backdrop click: a real click on
        // anything INSIDE the dialog (an input, a label, this dialog's
        // own padding) always targets that descendant element -- only a
        // genuine click on the backdrop targets the <dialog> node itself.
        dlg.addEventListener('click', function (e) {
            if (e.target === dlg) closeAddGapDialog();
        });
        // Migration 382: mapped-practices controls.
        const mapBtn = document.getElementById('newGapMapPracticeBtn');
        if (mapBtn) mapBtn.addEventListener('click', openGapMapPractice);
        const list = document.getElementById('newGapPracticeList');
        if (list) list.addEventListener('click', function (e) {
            const rm = e.target.closest('[data-remove-practice]');
            if (!rm) return;
            const pid = Number(rm.getAttribute('data-remove-practice'));
            selectedPractices = selectedPractices.filter(function (pr) { return pr.practiceId !== pid; });
            renderGapPractices();
        });
        const mapModal = document.getElementById('gapMapPracticeModal');
        if (mapModal) {
            mapModal.querySelectorAll('[data-close-gap-map]').forEach(function (b) { b.addEventListener('click', closeGapMapPractice); });
            mapModal.addEventListener('click', function (e) { if (e.target === mapModal) closeGapMapPractice(); });
        }
        const mapConfirm = document.getElementById('gapMapPickerConfirm');
        if (mapConfirm) mapConfirm.addEventListener('click', confirmGapMapPractice);
        if (!form) return;
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const title = document.getElementById('newGapTitle').value.trim();
            if (!title) { setGapMsg('Title is required.', 'error'); return; }
            if (!selectedPractices.length) { setGapMsg('Map at least one Practice.', 'error'); return; }
            const submit = document.getElementById('newGapSubmit');
            submit.disabled = true; setGapMsg('Saving...');
            const owner = document.getElementById('newGapOwner').value;
            const due   = document.getElementById('newGapDueDate').value;
            // Migration 250: detection method + severity flow through
            // the Add-Gap payload. Empty -> null (proc keeps its
            // priority-derived severity fallback).
            const detMeth = document.getElementById('newGapDetectionMethod').value;
            const sev     = document.getElementById('newGapSeverity').value;
            const payload = {
                organizationId:  Number(selectedOrgId),
                gapTypeCode:     'Custom',
                title:           title,
                description:     document.getElementById('newGapDescription').value.trim() || null,
                priority:        document.getElementById('newGapPriority').value,
                ownerEmployeeId: owner ? Number(owner) : null,
                dueDate:         due ? new Date(due + 'T00:00:00Z').toISOString() : null,
                status:          document.getElementById('newGapStatus').value,
                remarks:         document.getElementById('newGapRemarks').value.trim() || null,
                severityCode:         sev     || null,
                severityName:         sev     || null,
                detectionMethodCode:  detMeth || null,
                // Same label the analysis form's dropdown carries; kept
                // for parity in downstream reports.
                detectionMethodName:  detMeth || null,
                // Migration 382: mapped practices saved with the gap.
                practiceIds:          selectedPractices.map(function (p) { return p.practiceId; })
            };
            try {
                const r = await fetch(U('/practice/api/gaps/custom'), {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin', body: JSON.stringify(payload)
                });
                const b = await r.json().catch(function () { return {}; });
                if (r.ok) {
                    setGapMsg('Custom Gap #' + (b.customGapId || '?') + ' created.', 'ok');
                    setTimeout(async function () {
                        closeAddGapDialog();
                        // Migration 255: no tab to switch to. The new gap
                        // is a Custom-source row in the one list -- so
                        // clear any Source filter that would hide it,
                        // refresh the counts, and reload.
                        const sel = document.getElementById('gapFilterSource');
                        if (sel && sel.value && sel.value !== 'Custom') sel.value = 'Custom';
                        page = 1;
                        await loadSourceFilter();
                        await reloadCurrentTab();
                    }, 700);
                } else {
                    setGapMsg((b.error || 'Request failed'), 'error');
                    submit.disabled = false;
                }
            } catch (err) {
                setGapMsg('Network error: ' + err.message, 'error');
                submit.disabled = false;
            }
        });
    }

    // Migration 255: no tab to name, so the trigger carries only the row
    // index. buildRowMenu reads the row object itself and branches on
    // Source / IsMaterialized instead of on which tab was open.
    function actionTrigger(index) {
        return '<button type="button" class="pm-action-trigger" data-row-index="' + index + '" aria-haspopup="menu" aria-expanded="false" title="Actions">'
             + '<i class="fas fa-ellipsis-v fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>'
             + '<span class="visually-hidden">Actions</span>'
             + '</button>';
    }
    function formatBadge(v) { return v ? '<span class="pm-badge">' + escape(v) + '</span>' : ''; }
    function setBody(html) {
        const el = document.getElementById('gapBody');
        if (el) el.innerHTML = html;
    }
    // -----------------------------------------------------------------
    // Pager
    //
    // The label, the row range and the Prev/Next disabling live in
    // _workflow-common.cshtml, which every other paged screen already
    // uses. This screen keeps `page` as the single source of truth and
    // only reports which way the user moved; the shared helper decides
    // whether the button that moved them should have been enabled.
    //
    // The old local copy paged with a bare `page++` and no upper bound,
    // so Next stayed clickable past the last page and landed the user on
    // an empty grid. It also had no page size to work from, so it could
    // only ever print "Page 3".
    // -----------------------------------------------------------------
    function wirePagers() {
        const wf = window.__wfCommon;
        if (!wf) { console.error('__wfCommon missing - _workflow-common partial not rendered'); return; }
        wf.wirePager('all', function (delta) {
            const target = page + delta;
            if (target < 1) return;
            page = target;
            reloadCurrentTab();
        });
    }
    function updatePager(payload) {
        const wf = window.__wfCommon;
        if (!wf) return;
        const rows = (payload && (payload.rows || payload.Rows)) || [];
        wf.updatePager('all', Object.assign({}, payload, {
            pageSize: PAGE_SIZE,
            rowCount: rows.length
        }));
    }
    function escape(v) {
        if (v === null || v === undefined) return '';
        return String(v).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    // -----------------------------------------------------------------
    // Row 3-dot menu
    //   Implementation Gaps →
    //     * View Existing Tasks   (only if at least one exists)
    // Add Implementation Task was removed from this menu; the task is
    // raised from the practice instance itself, not from the gap list.
    // -----------------------------------------------------------------
    function closeRowMenu() {
        if (openMenuEl)      { openMenuEl.remove(); openMenuEl = null; }
        if (openMenuTrigger) { openMenuTrigger.setAttribute('aria-expanded', 'false'); openMenuTrigger = null; }
    }
    function positionRowMenu(trigger) {
        if (!openMenuEl) return;
        const r  = trigger.getBoundingClientRect();
        const mr = openMenuEl.getBoundingClientRect();
        const gap = 6;
        let top = r.bottom + gap, left = r.right - mr.width;
        if (top + mr.height > window.innerHeight - 8) top = Math.max(8, r.top - mr.height - gap);
        if (left < 8) left = 8;
        if (left + mr.width > window.innerWidth - 8) left = window.innerWidth - mr.width - 8;
        openMenuEl.style.top = top + 'px';
        openMenuEl.style.left = left + 'px';
    }
    function openRowMenu(trigger, items) {
        closeRowMenu();
        openMenuTrigger = trigger;
        trigger.setAttribute('aria-expanded', 'true');
        openMenuEl = document.createElement('div');
        openMenuEl.className = 'pm-action-menu';
        openMenuEl.setAttribute('role', 'menu');
        for (const it of items) {
            const b = document.createElement('button');
            b.type = 'button'; b.setAttribute('role', 'menuitem');
            b.innerHTML = '<i class="fa-solid ' + escape(it.icon) + '" aria-hidden="true"></i> ' + escape(it.label);
            if (it.disabled) { b.disabled = true; b.title = it.disabledReason || ''; }
            b.addEventListener('click', function (e) {
                e.preventDefault(); e.stopPropagation();
                closeRowMenu();
                try { it.action(); } catch (err) { console.error('[gap-center] menu action failed', err); }
            });
            openMenuEl.appendChild(b);
        }
        document.body.appendChild(openMenuEl);
        positionRowMenu(trigger);
    }
    // Migration 255: one menu, branched on the ROW rather than on which
    // tab is open. Every action the three tabs offered is preserved --
    // which action applies is decided by Source and IsMaterialized, the
    // same two facts the columns show.
    //
    // ACTIONS MENU (change request, 2026-09-22): the item list and every
    // applicability/disabled rule now come from window.gracGapActions.
    // buildMenu() (wwwroot/js/Shared/gap-actions.js) -- Gap View's own
    // "Actions" button calls the exact same function, so there is
    // exactly one implementation of these rules, used from both screens.
    // gotoDetail/materializeThenGoto stay local: the un-materialized
    // "Analysis" branch they cover can only ever be reached from THIS
    // grid (Gap View is only ever opened for an already-materialized
    // gap), so moving it into the shared module would not remove any
    // duplication -- see that module's own header comment.
    function gotoDetail(id) {
        // orgId is passed so the detail page can populate the task
        // combo for Link Existing mode.
        window.location.href = U('/Practice/Index/gap-detail')
            + '?gapId=' + encodeURIComponent(id)
            + '&orgId=' + encodeURIComponent(selectedOrgId || '');
    }
    async function materializeThenGoto(instId) {
        try {
            const r = await fetch(U('/practice/api/gap-lifecycle/materialize-from-instance'), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    practiceInstanceId: Number(instId),
                    organizationId:     Number(selectedOrgId || 0)
                })
            });
            const b = await r.json().catch(function () { return {}; });
            if (!r.ok || !b.customGapId) {
                alert(b.error || 'Could not materialize gap (HTTP ' + r.status + ').');
                return;
            }
            gotoDetail(b.customGapId);
        } catch (err) {
            alert('Network error: ' + err.message);
        }
    }
    function buildRowMenu(tr) {
        const i   = Number(tr.getAttribute('data-row-index'));
        const row = currentRows[i];
        if (!row) return [];

        const src      = row.sourceModuleCode || row.SourceModuleCode || '';
        const isMat    = !!(row.isMaterialized || row.IsMaterialized);
        const gapId    = row.customGapId || row.CustomGapId || null;
        const instId   = row.practiceInstanceId || row.PracticeInstanceId || null;
        const code     = row.instanceCode || row.InstanceCode || '';
        const name     = row.instanceName || row.InstanceName || '';
        const nOpen    = Number(row.existingTaskCount || row.ExistingTaskCount || 0);
        // Migration 318: statusText is now the lifecycle stage (New /
        // Analysed / ...), shown in the grid's Status column. The Close
        // Gap "already closed" check below needs the record's own
        // Open/InProgress/Closed/Cancelled code instead, which the API
        // now carries separately as rawStatusCode.
        const rawStatus = row.rawStatusCode || row.RawStatusCode || '';
        // Migration 324: the raw lifecycle state_code (not the display
        // text in statusText -- 175/319 already show that label can be
        // reworded). 'Delegated' is the code Analysed displays as; once
        // a gap is there, re-analysis is rejected server-side (55143),
        // so the menu offers View instead of Analysis for it.
        const lifecycleCode = row.lifecycleStateCode || row.LifecycleStateCode || '';
        const isAnalysed    = lifecycleCode === 'Delegated';

        if (!window.gracGapActions) {
            console.error('[gap-center] Shared/gap-actions.js did not load -- row menu unavailable.');
            return [];
        }

        return window.gracGapActions.buildMenu(
            {
                gapId: gapId, isMaterialized: isMat, isAnalysed: isAnalysed,
                sourceModuleCode: src, statusCode: rawStatus,
                practiceInstanceId: instId, existingTaskCount: nOpen
            },
            {
                onAnalysis: isMat
                    ? function () { gotoDetail(gapId); }
                    : function () { materializeThenGoto(instId); },
                onView: function () {
                    window.location.href = U('/Practice/Index/gap-view')
                        + '?gapId=' + encodeURIComponent(gapId)
                        + '&orgId=' + encodeURIComponent(selectedOrgId || '');
                },
                onViewExistingTasks: function () {
                    // Task Center is one list too now, so the deep link
                    // carries only the search term -- no tab to name.
                    window.location.href = '/Practice/Index/tasks#search='
                        + encodeURIComponent(code || name || '');
                },
                onCloseGap: function () {
                    window.gracGapActions.closeGap(gapId, 'Closed from Gap Center 3-dot menu.', reloadCurrentTab);
                }
            }
        );
    }
    function wireRowMenu() {
        const root = document.getElementById('gapCenterRoot');
        if (root) {
            root.addEventListener('click', function (e) {
                const trigger = e.target.closest('.pm-action-trigger');
                if (trigger && root.contains(trigger)) {
                    e.preventDefault(); e.stopPropagation();
                    const tr = trigger.closest('tr');
                    if (!tr) return;
                    if (openMenuTrigger === trigger) { closeRowMenu(); return; }
                    openRowMenu(trigger, buildRowMenu(tr));
                    return;
                }
                // Row click-to-View (change request, 2026-09-22): a plain
                // click anywhere else on a materialized gap's row (the
                // .pm-row-clickable class set in renderGaps()) opens the
                // same Gap View the row's own "View" menu item does --
                // the 3-dot menu is still there for every other action.
                // !e.target.closest('a') is defensive: this grid has no
                // in-row links today, but a future one should keep its own
                // destination rather than being hijacked by the row.
                const tr = e.target.closest('tr.pm-row-clickable');
                if (!tr || !root.contains(tr) || e.target.closest('a')) return;
                const i = Number(tr.getAttribute('data-row-index'));
                const row = currentRows[i];
                const gapId = row && (row.customGapId || row.CustomGapId);
                if (!gapId) return;
                window.location.href = U('/Practice/Index/gap-view')
                    + '?gapId=' + encodeURIComponent(gapId)
                    + '&orgId=' + encodeURIComponent(selectedOrgId || '');
            });
        }
        document.addEventListener('click', function (e) {
            if (!openMenuEl) return;
            if (e.target.closest('.pm-action-menu')) return;
            if (e.target.closest('.pm-action-trigger')) return;
            closeRowMenu();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeRowMenu(); });
        window.addEventListener('resize', closeRowMenu);
        window.addEventListener('scroll',  closeRowMenu, true);
    }
})();
</script>
<script src="~/js/Shared/gap-actions.js" asp-append-version="true"></script>
